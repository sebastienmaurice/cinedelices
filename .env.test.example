# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement pour les tests Playwright — Ciné Délices
#
# Copier ce fichier en .env.test et renseigner les valeurs.
# Ne jamais committer .env.test (il contient des mots de passe).
# ─────────────────────────────────────────────────────────────────────────────

# URL du serveur de test (doit tourner avant de lancer les tests)
BASE_URL=http://localhost:3000

# Credentials d'un compte admin existant en base
# Requis pour les tests : admin/validation.spec.ts et rbac/permissions.rbac.spec.ts
TEST_ADMIN_PSEUDO=votre_pseudo_admin
TEST_ADMIN_PASS=votre_mot_de_passe_admin

# Credentials d'un compte super_admin existant en base
# Requis pour les tests RBAC super_admin
TEST_SUPERADMIN_PSEUDO=votre_pseudo_superadmin
TEST_SUPERADMIN_PASS=votre_mot_de_passe_superadmin
