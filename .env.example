PORT=3000
BASE_URL=http://localhost:3000


PG_URL=postgresql://utilisateur:mdp@localhost:5432/bdd


JWT_SECRET= openssl rand -hex 64

# ── Google OAuth ──
# Créer un projet sur https://console.cloud.google.com/
# Activer "Google Identity Services" et créer des identifiants OAuth 2.0
# Ajouter l'origine autorisée : http://localhost:3000 (dev) + votre domaine (prod)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com

# ── Envoi d'emails (optionnel) ──
# En dev : laisser vide. Un compte Ethereal (boîte de test) est créé à la volée,
# le lien de prévisualisation des emails est logué en console.
# En prod : renseigner ces 4 variables pour activer un vrai SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=changeme
# SMTP_FROM=Ciné Délices <no-reply@example.com>
