# ─────────────────────────────────────────────
#  CINÉ DÉLICES — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────

# ── Serveur ──
PORT=3000
NODE_ENV=development
# En production sur Render : https://votre-domaine.com
BASE_URL=http://localhost:3000

# ── Base de données PostgreSQL ──
# Format : postgresql://user:password@host:5432/dbname
# Sur Render, utiliser la "Internal Database URL" fournie par le service PostgreSQL
PG_URL=postgresql://utilisateur:mdp@localhost:5432/cinedelices

# ── Sécurité JWT ──
# Générer avec : openssl rand -hex 64
JWT_SECRET=remplacer_par_une_cle_aleatoire_longue

# ── Google OAuth ──
# Créer un projet sur https://console.cloud.google.com/
# Activer "Google Identity Services" et créer des identifiants OAuth 2.0
# Ajouter l'origine autorisée : http://localhost:3000 (dev) + votre domaine (prod)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret

# ── TMDB (The Movie Database) ──
# Créer un compte sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=votre-cle-api-tmdb

# ── Cloudinary (stockage des images) ──
# Créer un compte sur https://cloudinary.com/
# Clés disponibles dans : Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# ── Envoi d'emails SMTP ──
# En dev : laisser vide → un compte Ethereal (boîte de test) est créé automatiquement
#          Le lien de prévisualisation des emails est logué en console.
# En prod : renseigner ces variables pour activer un vrai SMTP (Brevo, Mailgun, Resend...)
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre-email@domaine.com
# SMTP_PASS=votre-mot-de-passe-smtp
# SMTP_FROM=Ciné Délices <no-reply@cinedelices.fr>
