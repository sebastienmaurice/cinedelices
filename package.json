{
  "name": "dwwm-cinedelices",
  "version": "1.0.0",
  "description": "## Installation",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "db:init": "psql -U cinedelices -d cinedelices -f ./app/data/create_db.sql",
    "db:migrate": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_tmdb_id.sql",
    "db:migrate-genres": "psql -U cinedelices -d cinedelices -f ./app/data/migration_update_genres.sql",
    "db:migrate-type": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_type_column.sql",
    "db:migrate-user-preferences": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_user_preferences.sql",
    "db:migrate-user-picture-status": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_user_picture_status.sql",
    "db:migrate-user-ownership": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_user_ownership.sql",
    "db:migrate-movie-delete-request": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_movie_delete_request.sql",
    "db:migrate-pending-edits": "psql -U cinedelices -d cinedelices -f ./app/data/migration_add_pending_edits.sql",
    "docs:confirm-actions": "node ./scripts/generate-confirm-actions-doc.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/O-clock-Dundee/dwwm-cinedelices.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/O-clock-Dundee/dwwm-cinedelices/issues"
  },
  "homepage": "https://github.com/O-clock-Dundee/dwwm-cinedelices#readme",
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-xss-sanitizer": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7"
  }
}