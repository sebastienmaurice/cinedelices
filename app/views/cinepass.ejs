<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Ciné Délices — Votre CinéPass : parcours, progression et collection de cinéphile gourmand" />
    <title>Mon CinéPass - Ciné Délices</title>
    <%- include("partials/head-resources") %>
    <!-- Réutilisées telles quelles depuis /auth/profil/# — Collection de cadres + avatar cadré -->
    <link rel="stylesheet" href="/css/user-profile.css?v=39" />
    <link rel="stylesheet" href="/css/badge-strange.css" />
    <link rel="stylesheet" href="/css/cinepass.css?v=59" />
  </head>

  <body class="cp-page">
    <%- include("partials/header") %>

    <%
      const cpTier = level >= 11 ? 'legendary' : level >= 7 ? 'gold' : level >= 4 ? 'silver' : 'bronze';
      const cpUnlockedBadges = 0; // Aperçu mock — aucun badge réellement débloqué pour l'instant
    %>

    <main class="cp-main">
      <h1 class="sr-only">Mon CinéPass — Ciné Délices</h1>

      <!-- ══════════════════════════════════════════
           HERO — bannière cinéma + avatar cadré + identité
           (même technique que /auth/profil/#, en lecture seule)
      ══════════════════════════════════════════ -->
      <section class="cp-hero">
        <div class="cp-hero__banner">
          <img src="/images/banner-cinepass-hero-3.webp" alt="" />
        </div>
        <div class="cp-hero__banner-grad"></div>

        <div class="cp-hero__spotlight" aria-hidden="true"></div>
        <div class="cp-hero__dust" aria-hidden="true"></div>
        <div class="cp-hero__scanlines" aria-hidden="true"></div>
        <div class="cp-hero__vignette" aria-hidden="true"></div>

        <nav class="cp-breadcrumb cp-hero__breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <i data-lucide="chevron-right" width="12" height="12" aria-hidden="true"></i>
          <span>CinéPass</span>
        </nav>

        <p class="cp-hero__eyebrow">
          <i data-lucide="ticket" width="12" height="12" aria-hidden="true"></i>
          CinéPass
        </p>

        <!-- Identité — carte de membre premium, centrée verticalement dans le hero -->
        <div class="cp-hero__content">
          <div class="cp-hero__inner">
            <div class="cp-hero__row">

              <!-- Colonne 1 — Avatar seul -->
              <div class="cp-hero__avatar-block">
                  <% if (activeFrameCode === 'strange') { %>
                  <!-- Cadre CSS pur — mêmes classes que /auth/profil/# -->
                  <div class="profile-badge-hero profile-badge-hero--css-only"
                       id="profileBadgeHero"
                       data-frame-code="strange"
                       data-photo-src="<%= cldCard(user.picture || '/images/image-default-profile.jpg') %>">
                    <%- include('partials/badge-strange-avatar', {
                      photoSrc: cldCard(user.picture || '/images/image-default-profile.jpg'),
                      photoAlt: 'Avatar de ' + user.pseudo
                    }) %>
                  </div>
                  <% } else { %>
                  <!-- Standard — photo + cadre PNG (BadgeEngine si animé) -->
                  <div class="profile-badge-hero"
                     id="profileBadgeHero"
                     data-frame-code="<%= activeFrameCode || 'cine' %>"
                     data-photo-src="<%= cldCard(user.picture || '/images/image-default-profile.jpg') %>">
                    <img
                      id="pbhPhoto"
                      class="pbh-photo"
                      src="<%= cldCard(user.picture || '/images/image-default-profile.jpg') %>"
                      alt="Avatar de <%= user.pseudo %>"
                    />
                    <% if (activeFrameUrl) { %>
                    <img class="pbh-frame" src="<%= activeFrameUrl %>" alt="" aria-hidden="true" />
                    <% } else { %>
                    <div class="pbh-ring"></div>
                    <% } %>
                  </div>
                  <% } %>
                  <!-- Template caché : badge Dr Strange CSS — cloné par gamification.js lors d'un changement de cadre -->
                  <template id="bds-badge-tpl">
                    <%- include('partials/badge-strange-avatar', {
                      photoSrc: cldCard(user.picture || '/images/image-default-profile.jpg'),
                      photoAlt: 'Avatar de ' + user.pseudo
                    }) %>
                  </template>
              </div>

              <!-- Colonne 2 — Identité texte + CTA -->
              <div class="cp-hero__identity-text">
                <p class="cp-hero__welcome">Bienvenue</p>
                <p class="cp-hero__name"><%= (user.pseudo || '').toUpperCase() %></p>
                <p class="cp-hero__rank"><%= rank %></p>
                <p class="cp-hero__tagline">Votre parcours de cinéphile gourmand. Chaque recette publiée, chaque avis partagé et chaque découverte racontent votre histoire sur Ciné Délices. Ici, votre passion pour le cinéma et la gastronomie prend vie et devient, contribution après contribution, votre identité de cinéphile.</p>

                <div class="cp-hero__cta-row">
                  <% if (hasAuthorPage) { %>
                  <a href="/auteur/<%= user.id %>" class="cp-hero__cta" target="_blank" rel="noopener">Voir ma Page Auteur</a>
                  <% } else { %>
                  <a href="/add-recipes-movies/" class="cp-hero__cta">Publier ma première recette</a>
                  <% } %>
                  <a href="/auth/profil/<%= user.id %>#profil" class="cp-hero__cta cp-hero__cta--ghost">Éditer mon profil</a>
                </div>
              </div>

              <!-- Colonne 3 — Statut / progression -->
              <div class="cp-hero__status">
                <div class="cp-hero__status-top">
                  <div class="cp-hero__status-ring" style="--pct:<%= xpProg.pct %>">
                    <span class="cp-hero__status-ring-inner"><%= level %></span>
                  </div>
                  <div class="cp-hero__status-info">
                    <p class="cp-hero__status-eyebrow">Niveau actuel</p>
                    <p class="cp-hero__status-lvl">Niveau <%= level %></p>
                    <p class="cp-hero__status-rank"><i data-lucide="flame" width="14" height="14" aria-hidden="true"></i> <%= rank %></p>
                  </div>
                </div>

                <div class="cp-hero__status-progress">
                  <div class="cp-hero__status-track">
                    <div class="cp-hero__status-fill" style="width:<%= xpProg.pct %>%"></div>
                    <span class="cp-hero__status-dot" style="left:<%= xpProg.pct %>%"></span>
                  </div>
                  <div class="cp-hero__status-labels">
                    <span><%= xp.toLocaleString('fr-FR') %> XP</span>
                    <% if (xpProg.needed > 0) { %>
                    <span class="cp-hero__status-labels-mid"><%= xpProg.needed.toLocaleString('fr-FR') %> XP avant le niveau <%= level + 1 %></span>
                    <% } else { %>
                    <span class="cp-hero__status-labels-mid">Niveau maximum atteint</span>
                    <% } %>
                    <span><%= (xp + xpProg.needed).toLocaleString('fr-FR') %> XP</span>
                  </div>
                </div>

                <!-- Statistiques — relevé discret, dans la même colonne que le statut -->
                <div class="cp-hero__stats-strip">
                  <div class="cp-hero__stat">
                    <span class="cp-hero__stat-icon"><i data-lucide="zap" width="15" height="15" aria-hidden="true"></i></span>
                    <span>XP gagnés</span>
                    <strong><%= xp.toLocaleString('fr-FR') %></strong>
                  </div>
                  <div class="cp-hero__stat">
                    <span class="cp-hero__stat-icon"><i data-lucide="utensils" width="15" height="15" aria-hidden="true"></i></span>
                    <span>Recettes</span>
                    <strong><%= recipesCount %></strong>
                  </div>
                  <div class="cp-hero__stat">
                    <span class="cp-hero__stat-icon"><i data-lucide="message-square" width="15" height="15" aria-hidden="true"></i></span>
                    <span>Avis</span>
                    <strong><%= notices.length %></strong>
                  </div>
                  <div class="cp-hero__stat">
                    <span class="cp-hero__stat-icon"><i data-lucide="layout-grid" width="15" height="15" aria-hidden="true"></i></span>
                    <span>Cadres</span>
                    <strong><%= unlockedFrames.length %>/<%= frames.length %></strong>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════
           MA COLLECTION — Cadres (réel, même composant historiquement partagé avec le profil, désormais propre à CinéPass)
      ══════════════════════════════════════════ -->
      <section class="cp-card cp-card--collection cp-frames-wrap" id="cp-collection-frames">
        <%- include('partials/frames-collection', {
          user,
          userLevel: level,
          userXP: xp,
          userActiveFrameId: activeFrameCode,
          userFrames: frames,
        }) %>
      </section>

      <!-- ══════════════════════════════════════════
           MA PROGRESSION  +  MES UNIVERS (mock)
      ══════════════════════════════════════════ -->
      <div class="cp-row cp-row--progress">

        <section class="cp-card cp-progress">
          <p class="cp-card__eyebrow">Ma progression</p>

          <!-- Médaillon — même composant que /cinepass/ (ctb2-main-row) -->
          <div class="level-medallion level-medallion--<%= cpTier %>" aria-label="Niveau <%= level %>">
            <span class="level-medallion__gem level-medallion__gem--top"></span>
            <span class="level-medallion__gem level-medallion__gem--bottom"></span>
            <div class="level-medallion__ring">
              <div class="level-medallion__face">
                <span class="level-medallion__num"><%= level %></span>
              </div>
            </div>
          </div>

          <p class="cp-progress__lvl">Niveau <%= level %></p>
          <p class="cp-progress__rank"><%= rank %></p>

          <p class="cp-progress__xp"><%= xp.toLocaleString('fr-FR') %> / <%= (xp + xpProg.needed).toLocaleString('fr-FR') %> XP</p>
          <div class="cp-xp-track">
            <div class="cp-xp-fill" style="width:<%= xpProg.pct %>%"></div>
            <% xpCheckpoints.forEach(function (cp) { %>
            <span class="cp-xp-cp<%= cp.reached ? ' cp-xp-cp--done' : '' %>" style="left:<%= cp.pct %>%" title="<%= cp.xp.toLocaleString('fr-FR') %> XP"></span>
            <% }); %>
          </div>
          <% if (xpProg.needed > 0) { %>
          <p class="cp-progress__left"><strong><%= xpProg.needed.toLocaleString('fr-FR') %> XP</strong> avant le niveau <%= level + 1 %></p>
          <% } else { %>
          <p class="cp-progress__left">Niveau maximum atteint</p>
          <% } %>

          <% if (upcomingLevels.length) { %>
          <div class="cp-levelup">
            <p class="cp-levelup__title">Montée en niveau</p>
            <div class="cp-levelup__list">
              <% upcomingLevels.forEach(function (u) { %>
              <div class="cp-levelup__row">
                <span class="cp-levelup__badge"><%= u.num %></span>
                <div class="cp-levelup__info">
                  <span class="cp-levelup__lvl">Niv. <%= u.num %></span>
                  <span class="cp-levelup__rank"><%= u.title %></span>
                </div>
                <span class="cp-levelup__xp"><%= u.xpRequired.toLocaleString('fr-FR') %> XP</span>
              </div>
              <% }); %>
            </div>
          </div>
          <% } %>

          <!-- Gains récents — mêmes montants que XP_ACTIONS (gamification.utils.js), texte statique -->
          <div class="cp-gains">
            <p class="cp-gains__title">Gains récents</p>
            <div class="cp-gains__row"><i data-lucide="utensils" width="13" height="13" aria-hidden="true"></i><span>Recette publiée</span><strong>+50 XP</strong></div>
            <div class="cp-gains__row"><i data-lucide="film" width="13" height="13" aria-hidden="true"></i><span>Film accepté</span><strong>+25 XP</strong></div>
            <div class="cp-gains__row"><i data-lucide="message-square" width="13" height="13" aria-hidden="true"></i><span>Avis approuvé</span><strong>+10 XP</strong></div>
          </div>

          <a href="#cp-collection-frames" class="cp-link-btn">Voir tous les niveaux <i data-lucide="arrow-right" width="13" height="13" aria-hidden="true"></i></a>
        </section>

        <section class="cp-card cp-univers">
          <div class="cp-card__head">
            <p class="cp-card__eyebrow">Mes univers cinématographiques</p>
            <span class="cp-card__mock-tag">Aperçu à venir</span>
          </div>
          <p class="cp-univers__intro">Les mondes cinématographiques dans lesquels vous vous êtes aventuré.</p>
          <div class="cp-univers__grid">
            <% mockUnivers.forEach(function (u) { %>
            <div class="cp-univers__card<%= u.progress >= u.total ? ' is-mastered' : '' %>" data-accent="<%= u.accent %>">
              <div class="cp-univers__poster">
                <img src="<%= u.img %>" alt="" loading="lazy" />
                <div class="cp-univers__poster-grad"></div>
                <div class="cp-univers__poster-sheen" aria-hidden="true"></div>
                <% if (u.progress >= u.total) { %>
                <span class="cp-univers__mastered">Maîtrisé</span>
                <% } %>
                <div class="cp-univers__poster-foot">
                  <p class="cp-univers__label"><%= u.label %></p>
                  <div class="cp-univers__dots">
                    <% for (let i = 0; i < u.total; i++) { %>
                    <span class="cp-univers__dot<%= i < u.progress ? ' is-on' : '' %>"></span>
                    <% } %>
                  </div>
                </div>
                <div class="cp-univers__reveal">
                  <p class="cp-univers__count"><%= u.progress %> / <%= u.total %> cadres découverts</p>
                  <div class="cp-univers__xp-track"><div class="cp-univers__xp-fill" style="width:<%= Math.round((u.xp / u.xpMax) * 100) %>%"></div></div>
                  <p class="cp-univers__xp"><%= u.xp %> / <%= u.xpMax %> XP</p>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <p class="cp-card__mock-hint">Les Univers ne sont pas encore calculés dynamiquement — aperçu du futur système Ciné Délices.</p>
        </section>

      </div>

      <!-- Badges — aperçu du futur système (mock, distinct des cadres) -->
      <section class="cp-card cp-card--badges">
        <div class="cp-card__head">
          <p class="cp-card__eyebrow">Mes trophées</p>
          <span class="cp-badges__count"><strong><%= mockBadges.filter(b => b.unlocked).length %></strong>/<%= mockBadgesTotal %> débloqués</span>
          <span class="cp-card__mock-tag">Aperçu du futur système</span>
        </div>
        <div class="cp-badges">
          <% mockBadges.forEach(function (b) { %>
          <div class="cp-badge cp-badge--<%= b.tier %><%= !b.unlocked ? ' cp-badge--locked' : '' %>" title="<%= b.label %><%= !b.unlocked ? ' — Verrouillé' : '' %>">
            <% if (b.unlocked) { %>
            <span class="cp-badge__medal">
              <img src="<%= b.image %>" alt="<%= b.label %>" loading="lazy" />
            </span>
            <% } else { %>
            <!-- Verrouillé : aucune image réelle du trophée envoyée au client, seulement le
                 blason générique Ciné Délices (identique pour tous, ne révèle rien). -->
            <span class="cp-badge__medal">
              <img class="cp-badge__medal-locked" src="/images/trophees/trophee-locked-generic.webp" alt="" loading="lazy" />
              <span class="cp-badge__medal-lock"><i data-lucide="lock" width="14" height="14" aria-hidden="true"></i></span>
            </span>
            <% } %>
            <span class="cp-badge__label"><%= b.label %></span>
          </div>
          <% }); %>
        </div>
        <p class="cp-card__mock-hint">Ces trophées n'existent pas encore en base — aucun accomplissement réel n'est calculé ici.</p>
      </section>

      <!-- ══════════════════════════════════════════
           PROCHAINES ÉTAPES · DERNIÈRES CONTRIBUTIONS
      ══════════════════════════════════════════ -->
      <div class="cp-row cp-row--two">

        <section class="cp-card cp-objectives">
          <p class="cp-card__eyebrow">Prochaines étapes</p>
          <div class="cp-objective">
            <div class="cp-objective__icon"><i data-lucide="trending-up" width="16" height="16" aria-hidden="true"></i></div>
            <div class="cp-objective__body">
              <% if (xpProg.needed > 0) { %>
              <p class="cp-objective__title">Encore <%= xpProg.needed.toLocaleString('fr-FR') %> XP</p>
              <p class="cp-objective__sub">→ atteindre le niveau <%= level + 1 %></p>
              <% } else { %>
              <p class="cp-objective__title">Niveau maximum</p>
              <p class="cp-objective__sub">→ vous avez atteint le sommet du CinéPass</p>
              <% } %>
            </div>
          </div>
          <% if (nextFrame) { %>
          <div class="cp-objective">
            <% if (nextFrame.thumbUrl) { %>
            <div class="cp-objective__thumb"><img src="<%= nextFrame.thumbUrl %>" alt="" loading="lazy" /></div>
            <% } else { %>
            <div class="cp-objective__icon"><i data-lucide="layout-grid" width="16" height="16" aria-hidden="true"></i></div>
            <% } %>
            <div class="cp-objective__body">
              <p class="cp-objective__title">Niveau <%= nextFrame.minLvl %> requis</p>
              <p class="cp-objective__sub">→ débloquer le cadre « <%= nextFrame.label %> »</p>
            </div>
          </div>
          <% } %>
          <div class="cp-objective">
            <div class="cp-objective__icon cp-objective__icon--gold"><i data-lucide="crown" width="16" height="16" aria-hidden="true"></i></div>
            <div class="cp-objective__body">
              <p class="cp-objective__title">Grande étape</p>
              <p class="cp-objective__sub">→ <%= hasAuthorPage ? 'votre identité de cinéphile est en ligne' : 'développer votre identité de cinéphile' %></p>
            </div>
          </div>
        </section>

        <section class="cp-card cp-activity">
          <div class="cp-card__head">
            <p class="cp-card__eyebrow">Dernières contributions</p>
            <a href="/contributions/" class="cp-card__more">Voir toutes <i data-lucide="arrow-right" width="12" height="12" aria-hidden="true"></i></a>
          </div>
          <% if (recentActivity.length > 0) { %>
          <div class="cp-activity__filters" id="cpActivityFilters">
            <button type="button" class="cp-activity__filter is-active" data-filter="all">Tout</button>
            <button type="button" class="cp-activity__filter" data-filter="recipe">Recettes</button>
            <button type="button" class="cp-activity__filter" data-filter="movie">Films</button>
            <button type="button" class="cp-activity__filter" data-filter="notice">Avis</button>
          </div>
          <div class="cp-activity__list" id="cpActivityList">
            <% recentActivity.forEach(function (a) { %>
            <div class="cp-activity__item" data-type="<%= a.type %>">
              <div class="cp-activity__icon cp-activity__icon--<%= a.type %>">
                <% if (a.type === 'recipe') { %><i data-lucide="utensils" width="14" height="14" aria-hidden="true"></i>
                <% } else if (a.type === 'movie') { %><i data-lucide="film" width="14" height="14" aria-hidden="true"></i>
                <% } else { %><i data-lucide="message-square" width="14" height="14" aria-hidden="true"></i><% } %>
              </div>
              <div class="cp-activity__body">
                <p class="cp-activity__title"><%= a.title %></p>
                <p class="cp-activity__time"><%= a.time %></p>
              </div>
              <span class="cp-activity__xp">+<%= a.xp %> XP</span>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <p class="cp-card__empty">Aucune contribution pour le moment. Publiez votre première recette pour gagner vos premiers XP !</p>
          <% } %>
        </section>

      </div>

      <!-- ══════════════════════════════════════════
           PAGE AUTEUR — récompense majeure, mise en scène dédiée
      ══════════════════════════════════════════ -->
      <section class="cp-showcase<%= hasAuthorPage ? ' is-unlocked' : '' %>">
        <div class="cp-showcase__bg">
          <img src="/images/pre-footer-bg-1.jpg" alt="" />
        </div>
        <div class="cp-showcase__grad"></div>

        <div class="cp-showcase__text">
          <p class="cp-showcase__eyebrow"><i data-lucide="film" width="12" height="12" aria-hidden="true"></i> La récompense ultime</p>
          <h3 class="cp-showcase__title">Votre propre page<br><em>cinématographique</em></h3>
          <p class="cp-showcase__desc">Une page à votre image pour mettre en avant vos recettes, vos films favoris et votre passion du cinéma gourmand.</p>
          <ul class="cp-showcase__list">
            <li><i data-lucide="check" width="13" height="13" aria-hidden="true"></i> Bannière et thème personnalisés</li>
            <li><i data-lucide="check" width="13" height="13" aria-hidden="true"></i> Recettes et films à la une</li>
            <li><i data-lucide="check" width="13" height="13" aria-hidden="true"></i> Vos badges et cadres affichés</li>
          </ul>
          <% if (hasAuthorPage) { %>
          <a href="/auteur/<%= user.id %>" class="cp-showcase__cta" target="_blank" rel="noopener">
            Découvrir ma Page Auteur <i data-lucide="arrow-right" width="14" height="14" aria-hidden="true"></i>
          </a>
          <% } else { %>
          <a href="/add-recipes-movies/" class="cp-showcase__cta">
            Publier ma première recette <i data-lucide="arrow-right" width="14" height="14" aria-hidden="true"></i>
          </a>
          <p class="cp-showcase__hint">Publiez votre 1ère recette approuvée pour débloquer</p>
          <% } %>
        </div>

        <div class="cp-showcase__preview">
          <% if (!hasAuthorPage) { %>
          <span class="cp-showcase__lock"><i data-lucide="lock" width="18" height="18" aria-hidden="true"></i></span>
          <% } %>
          <div class="cp-showcase__preview-row">
            <img class="cp-showcase__preview-avatar" src="<%= cldAvatar(user.picture || '/images/image-default-profile.jpg') %>" alt="" />
            <div class="cp-showcase__preview-info">
              <span class="cp-showcase__preview-name"><%= (user.pseudo || '').toUpperCase() %></span>
              <span class="cp-showcase__preview-lvl">Niveau <%= level %> · <%= rank %></span>
            </div>
          </div>
          <div class="cp-showcase__preview-stats">
            <div><strong><%= recipesCount %></strong><span>Recettes</span></div>
            <div><strong><%= notices.length %></strong><span>Avis</span></div>
            <div><strong><%= unlockedFrames.length %></strong><span>Cadres</span></div>
          </div>
          <% if (hasAuthorPage) { %>
          <div class="cp-showcase__status"><i data-lucide="check" width="13" height="13" aria-hidden="true"></i> Page Auteur débloquée</div>
          <% } %>
        </div>
      </section>

      <!-- ── CTA inviter / partager — même bloc historiquement partagé avec le profil ── -->
      <div class="ctb-invite">
        <div class="ctb-invite__bg-img" aria-hidden="true">
          <img src="/images/banner-gamification-section.webp" alt="" />
        </div>
        <div class="ctb-invite__inner">
          <div class="ctb-invite__left">
            <span class="ctb-invite__eyebrow">Rejoignez la communauté</span>
            <h3 class="ctb-invite__title"><span>Partagez Ciné Délices</span><br><em>avec vos amis cinéphiles</em></h3>
            <p class="ctb-invite__text">Invitez vos amis à rejoindre la plateforme et cuisinez ensemble les plats de vos films préférés.</p>
            <div class="ctb-invite__actions">
              <a href="/contact-about" class="ctb-invite__btn ctb-invite__btn--ghost">
                <i data-lucide="share-2" width="13" height="13" aria-hidden="true"></i>
                Partager le site
              </a>
              <a href="/add-recipes-movies/" class="ctb-invite__btn ctb-invite__btn--primary">
