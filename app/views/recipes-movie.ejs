<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title>Recettes du film - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/recipes-movie.css" />

    <!-- scripts -->
    <script src="/js/filtred-category.js" defer></script>
    <script src="/js/more-views.js" defer></script>
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <% const bannerImage = movie ? (movie.bannerPath || movie.picture) : "/images/image-default-film.jpg"; %>
      <% const hasAuthorFilter = typeof isAuthorFiltered !== "undefined" ? isAuthorFiltered : false; %>
      <section class="banner__image__film" aria-hidden="true">
        <div class="banner__image__film__overlay"></div>
        <img
          src="<%= bannerImage %>"
          alt="<%= movie ? `Image du film ${movie.title}` : 'Image de présentation des recettes' %>"
          width="1440"
          height="350"
          decoding="async"
        />
      </section>

      <section class="banner <%= movie ? '' : 'banner--recipes' %>" aria-labelledby="movie-title">
        <div class="banner__title" id="movie" data-id="<%= movie ? movie.id : '' %>">
          <% if (movie) { %>
            <p class="banner__meta">Film ou série culte</p>
            <h2 id="movie-title"><%= movie.title %></h2>
            <p class="banner__subtitle">
              <span class="film-year"><%= movie.year %></span>
              <span class="film-separator">•</span>
              <span class="film-genre"><%= movie.genre %></span>
            </p>
          <% } else { %>
            <p class="banner__meta">Recettes Ciné Délices</p>
            <h2 id="movie-title">
              <%= hasAuthorFilter && authorDisplayName ? `Recettes de ${authorDisplayName}` : "Toutes les recettes" %>
            </h2>
            <p class="banner__subtitle">
              Découvrez toutes les recettes inspirées du cinéma et partagez vos créations.
            </p>
            <% if (hasAuthorFilter) { %>
              <a class="banner__reset-link" href="/recipes-movie">
                Voir toutes les recettes
              </a>
            <% } %>
          <% } %>
        </div>

        <% if (movie) { %>
          <div class="banner__search__films">
            <label for="search" class="search__label">
              Rechercher une recette par catégorie :
            </label>

            <select name="recipes" id="search" class="search__select__film">
              <option value="" selected>Catégories</option>
              <option value="all">Toutes les recettes</option>
              <option value="entrée">Entrée</option>
              <option value="plat">Plat</option>
              <option value="dessert">Dessert</option>
            </select>
          </div>
        <% } %>
      </section>

      <!-- SECTION RECETTES -->
      <section id="recipes">
        <div class="presentation__recipes">
          <div class="presentation__text__recipes">
            <% if (movie) { %>
              <h3>Nos recettes cultes</h3>
              <p>
                Découvrez les recettes inspirées de ce film ou de cette série et
                revivez les saveurs du grand écran
              </p>
            <% } else { %>
              <h3>
                <%= hasAuthorFilter && authorDisplayName ? `Recettes de ${authorDisplayName}` : "Nos recettes cultes" %>
              </h3>
              <p>
                Explorez les recettes inspirées du cinéma et trouvez votre prochaine inspiration.
              </p>
            <% } %>
          </div>

          <div class="presentation__button__recipes">
            <a
              class="btn btn--gold"
              href="<%= movie ? `/add-recipes-movies/${movie.id}` : '/add-recipes-movies/' %>"
            >
              Ajouter ma recette
            </a>
          </div>
        </div>

        <div id="recipes__list" class="articles only__display__9__recipes">
          <% if (!recipes || recipes.length === 0) { %>
          <p class="no-recipes">
            Aucune recette n'est disponible pour ce film.
          </p>
          <% } else { %> <% recipes.forEach(recipe => { %>
          <article>
            <div class="recipe-card-image">
              <img
                src="<%= recipe.picture %>"
                alt="<%= recipe.name %>"
                loading="lazy"
                width="640"
                height="360"
                decoding="async"
              />
            </div>

            <div class="recipe-card-info">
              <h4 class="recipe-title"><%= recipe.name %></h4>
              <div class="recipe-meta">
                <span class="recipe-meta-tag recipe-meta-tag--category">
                  <%= recipe.category %>
                </span>
                <span class="recipe-meta-tag recipe-meta-tag--duration">
                  <%= recipe.duration %> min
                </span>
                <span class="recipe-meta-tag recipe-meta-tag--difficulty">
                  <%= recipe.difficulty %>
                </span>
              </div>

              <div class="recipe-card-actions">
                <a
                  class="btn btn--red"
                  href="/recipes-movie/details/<%= recipe.id %>"
                >
                  Voir la recette
                </a>
                <div
                  class="recipe-card-rating"
                  aria-label="Note générale de la recette : <%= recipe.quote %>/5"
                >
                  <div class="stars-caption">
                    Note générale&nbsp;: <strong><%= recipe.quote %>/5</strong>
                  </div>
                  <div
                    class="stars stars--readonly"
                    data-rating="<%= recipe.quote %>"
                  >
                    <% for (let i = 1; i <= 5; i++) { %>
                    <span
                      class="star <%= i <= recipe.quote ? 'is-active' : '' %>"
                      >★</span
                    >
                    <% } %>
                    <span class="stars-value"><%= recipe.quote %>/5</span>
                  </div>
                </div>
              </div>
            </div>
          </article>
          <% }) %> <% } %>
        </div>

        <% if (recipes && recipes.length > 9) { %>
        <div class="center-button">
          <button
            id="see__all__recipes__button"
            class="btn btn--gold-special"
            aria-label="Voir plus de recettes"
          >
            Voir plus
          </button>
        </div>
        <% } %>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/films.js" defer></script>
  </body>
</html>
