<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title><%= movie ? `${movie.title} — Recettes · Ciné Délices` : 'Recettes - Ciné Délices' %></title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/recipes-movie.css" />

    <!-- scripts -->
    <script src="/js/filtred-category.js" defer></script>
    <script src="/js/more-views.js" defer></script>
  </head>

  <body class="<%= movie ? 'film-page' : '' %>">
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <% const hasAuthorFilter = typeof isAuthorFiltered !== "undefined" ? isAuthorFiltered : false; %>
      <% const authorImg = typeof authorProfileImage !== "undefined" ? authorProfileImage : null; %>
      <% const authorBanner = typeof authorBannerImage !== "undefined" ? authorBannerImage : null; %>
      <% const currentAuthorId = typeof authorId !== "undefined" ? authorId : null; %>
      <% const bannerStatus = typeof authorBannerStatus !== "undefined" ? authorBannerStatus : null; %>
      <% const isOwner = hasAuthorFilter && userId && currentAuthorId && String(userId) === String(currentAuthorId); %>
      <% const bannerImage = (hasAuthorFilter && authorBanner) ? authorBanner : (movie ? (movie.bannerPath || movie.picture) : "/images/image-banner-movie-default.jpg"); %>

      <% if (movie) { %>

        <!-- ╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔
             VUE FICHE FILM — Design cinématographique
        ╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔╔ -->

        <!-- ID film (caché) — nécessaire pour filtred-category.js -->
        <div id="movie" data-id="<%= movie.id %>" style="display:none" aria-hidden="true"></div>

        <!-- â”€â”€ BREADCRUMB â”€â”€ -->
        <div class="bc-bar">
          <nav class="bc" aria-label="Fil d'Ariane">
            <a href="/">Accueil</a>
            <span class="bc-sep" aria-hidden="true">›</span>
            <a href="/movies">Films</a>
            <span class="bc-sep" aria-hidden="true">›</span>
            <span class="bc-cur"><%= movie.title %></span>
          </nav>
        </div>

        <!-- ╔╔ HERO FILM ╔╔ -->
        <section class="film-hero" aria-labelledby="filmTitle">
          <div class="film-hero__bg" style="background-image: url('<%= bannerImage %>')"></div>
          <div class="film-hero__overlay"></div>
          <div class="film-hero__lisere" aria-hidden="true"></div>
          <div class="film-hero__scanlines" aria-hidden="true"></div>
          <div class="film-hero__vignette" aria-hidden="true"></div>
          <div class="film-hero__watermark" aria-hidden="true"><%= movie.title.toUpperCase() %></div>

          <div class="film-hero__content">

            <!-- Infos film — colonne gauche -->
            <div class="fh-info">

              <div class="fh-badges">
                <span class="fh-badge fh-badge--type">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                  Film
                </span>
                <% if (movie.genre) { %>
                <span class="fh-badge fh-badge--genre"><%= movie.genre %></span>
                <% } %>
              </div>

              <% if (movie.year) { %>
              <p class="fh-eyebrow"><%= movie.year %></p>
              <% } %>

              <h1 class="fh-title" id="filmTitle"><%= movie.title %></h1>

              <div class="fh-meta-row">
                <% if (movie.year) { %>
                <div class="fh-meta">
                  <span class="fh-meta__label">Année</span>
                  <span class="fh-meta__val"><%= movie.year %></span>
                </div>
                <div class="fh-meta-sep"></div>
                <% } %>
                <% if (movie.genre) { %>
                <div class="fh-meta">
                  <span class="fh-meta__label">Genre</span>
                  <span class="fh-meta__val"><%= movie.genre %></span>
                </div>
                <div class="fh-meta-sep"></div>
                <% } %>
                <div class="fh-meta">
                  <span class="fh-meta__label">Recettes</span>
                  <span class="fh-meta__val fh-meta__val--gold">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                    <%= recipes.length %> recette<%= recipes.length > 1 ? 's' : '' %>
                  </span>
                </div>
              </div>

              <% if (movie.synopsis) { %>
              <p class="fh-synopsis"><%= movie.synopsis %></p>
              <% } %>

              <div class="fh-actions">
                <a href="#film-recipes" class="btn btn--red">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                  Voir les recettes
                </a>
                <a class="btn btn--outline-silver" href="/add-recipes-movies/<%= movie.id %>">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  Ajouter ma recette
                </a>
              </div>
            </div>

            <!-- Poster film — colonne droite -->
            <div class="fh-poster-wrap" aria-hidden="true">
              <div class="fh-poster">
                <div class="fh-poster__lbox fh-poster__lbox--t">
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                </div>
                <img
                  src="<%= movie.picture || '/images/image-banner-movie-default.jpg' %>"
                  alt="Affiche <%= movie.title %>"
                  loading="lazy"
                />
                <div class="fh-poster__lbox fh-poster__lbox--b">
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                  <div class="fh-perf"></div>
                </div>
              </div>
              <div class="fh-poster__badge">
                <div class="fhpb-icon">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                </div>
                <div>
                  <div class="fhpb-num"><%= recipes.length %></div>
                  <div class="fhpb-label">Recettes liées</div>
                </div>
              </div>
            </div>

          </div>
        </section>

        <!-- ╔╔ MAIN CONTENT ╔╔ -->
        <div class="film-main" id="film-recipes">
          <div class="film-main__inner">

            <!-- ╔╔ RECETTES DU FILM ╔╔ -->
            <section id="recipes" aria-labelledby="recipes-title">

              <!-- Header section + toolbar -->
              <div class="fh-recipes-header">
                <div class="sec-h">
                  <span class="sec-h__eye">Inspirées du film</span>
                  <h2 class="sec-h__title" id="recipes-title">RECETTES DU FILM</h2>
                </div>
                <div class="fh-toolbar">
                  <label for="search" class="fh-filter__label">Catégorie</label>
                  <select name="recipes" id="search" class="search__select__film">
                    <option value="all" selected>Toutes</option>
                    <option value="entrée">Entrée</option>
                    <option value="plat">Plat</option>
                    <option value="dessert">Dessert</option>
                  </select>
                  <a class="btn btn--primary" href="/add-recipes-movies/<%= movie.id %>">
                    <span class="btn__shimmer"></span>
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    <span class="btn__text">Ajouter ma recette</span>
                  </a>
                </div>
              </div>

              <!-- Grille de recettes -->
              <div id="recipes__list" class="recipes-grid only__display__9__recipes">

                <% if (!recipes || recipes.length === 0) { %>
                <p class="no-recipes">Aucune recette n'est disponible pour ce film.</p>
                <% } else { %>
                  <% recipes.forEach(recipe => { %>
                  <%
                    const displayRating = recipe.avgRating || recipe.quote || '0';
                    const authorName = recipe.contributor.pseudo;
                    const authorAvatar = recipe.contributor.picture || null;
                    const recipeDescription = recipe.description || recipe.anecdote || 'Découvrez cette délicieuse recette inspirée du cinéma...';
                    const truncatedDescription = recipeDescription.length > 80 ? recipeDescription.substring(0, 80) + '...' : recipeDescription;
                    const badgesMap = typeof contributorBadgesMap !== 'undefined' ? contributorBadgesMap : {};
                    const cardBadge = badgesMap[recipe.contributor.id] || null;
                  %>
                  <article class="recipe-card">
                    <!-- Image paysage 3:2 -->
                    <div class="recipe-card__img">
                      <img
                        src="<%= recipe.picture || '/images/image-default-recipe-1.jpg' %>"
                        alt="<%= recipe.name %>"
                        loading="lazy"
                        width="600"
                        height="400"
                        decoding="async"
                      />
                      <!-- Overlay top : badge catégorie + favori -->
                      <div class="recipe-card__ot">
                        <span class="badge badge--type-b"><%= recipe.category %></span>
                        <button
                          class="btn-fav"
                          data-entity-id="<%= recipe.id %>"
                          data-entity-type="recipe"
                          data-is-favorite="<%= recipe.isFavorite || false %>"
                          aria-label="<%= recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                          title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
                        >
                          <svg class="icon" viewBox="0 0 24 24" fill="<%= recipe.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                        </button>
                      </div>
                      <!-- Badge film en bas à gauche -->
                      <div class="recipe-card__ob">
                        <span class="badge badge--film-dk">
                          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                          <%= movie.title %>
                        </span>
                      </div>
                    </div>

                    <!-- Corps de la card -->
                    <div class="recipe-card__body">
                      <h3 class="recipe-ttl"><%= recipe.name %></h3>

                      <div class="recipe-card__meta">
                        <span class="tag <%= !recipe.difficulty ? 'tag--gris' : recipe.difficulty.toLowerCase().includes('facile') ? 'tag--recette-facile' : recipe.difficulty.toLowerCase().includes('difficile') ? 'tag--recette-difficile' : 'tag--recette-moyen' %>"><%= recipe.difficulty || 'N/A' %></span>
                        <% if (recipe.isNew) { %><span class="badge-new badge-new--new">Nouveau</span><% } %>
                      </div>

                      <div class="recipe-card__row">
                        <div class="rating rating--sm" data-entity-id="<%= recipe.id %>" data-entity-type="recipe" data-average="<%= displayRating %>">
                          <% for (let i = 1; i <= 5; i++) { %>
                          <span class="rating__star <%= i <= Math.round(parseFloat(displayRating)) ? 'rating__star--filled' : '' %>">
                            <svg class="icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          </span>
                          <% } %>
                          <span class="rating__value"><%= displayRating %></span>
                        </div>
                        <div class="recipe-card__infos">
                          <span class="recipe-info-item">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <%= recipe.duration || recipe.time %> min
                          </span>
                        </div>
                      </div>

                      <p class="recipe-card__desc"><%= truncatedDescription %></p>

                      <div class="recipe-card__foot">
                        <span class="author<%= cardBadge ? ' ' + cardBadge.cssClass : '' %>">
                          <span class="author__av">
                            <% if (authorAvatar) { %>
                            <img src="<%= authorAvatar %>" alt="<%= authorName %>" />
                            <% } else { %>
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                            <% } %>
                          </span>
                          <span class="author__info">
                            <span class="author__name"><%= authorName %></span>
                            <% if (cardBadge) { %>
                            <span class="author__lvl"><%= cardBadge.cssClass.includes('lvl1') ? '★' : cardBadge.cssClass.includes('lvl2') ? '★★' : cardBadge.cssClass.includes('lvl3') ? '★★★' : cardBadge.cssClass.includes('lvl4') ? '★★★★' : '★★★★★' %></span>
                            <% } %>
                          </span>
                        </span>
                        <a class="btn btn--red btn--sm" href="/recipes-movie/details/<%= recipe.slug || recipe.id %>">
                          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                          Voir la recette →
                        </a>
                      </div>
                    </div>
                  </article>
                  <% }) %>
                <% } %>

              </div><!-- /#recipes__list -->

              <!-- Gold CTA card — hors grille -->
              <div class="gold-cta-card gold-cta-card--standalone">
                <div class="gcc-perfs gcc-perfs--l" aria-hidden="true">
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                </div>
                <div class="gcc-perfs gcc-perfs--r" aria-hidden="true">
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                  <div class="gcc-perf"></div>
                </div>
                <div class="gold-cta-card__inner">
                  <div class="gcc-icons" aria-hidden="true">
                    <svg class="gcc-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                    <span class="gcc-plus">+</span>
                    <svg class="gcc-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                  </div>
                  <div class="gcc-body">
                    <p class="gcc-eyebrow">Rejoignez la communauté</p>
                    <h3 class="gcc-title">CUISINEZ CE QUE VOUS AIMEZ.</h3>
                    <p class="gcc-sub">Vous avez une recette inspirée de <em><%= movie.title %></em> ? Partagez-la avec des milliers de cinéphiles gourmands.</p>
                  </div>
                  <div class="gcc-actions">
                    <a href="/add-recipes-movies/<%= movie.id %>" class="btn-gcc">
                      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                      Ajouter ma recette
                    </a>
                  </div>
                </div>
              </div>

              <% if (recipes && recipes.length > 9) { %>
              <div class="center-button">
                <button
                  id="see__all__recipes__button"
                  class="btn btn--red"
                  aria-label="Voir plus de recettes"
                >
                  <span class="btn__shimmer"></span>
                  <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" x2="18" y1="17" y2="17"/></svg>
                  <span class="btn__text">Voir plus</span>
                </button>
              </div>
              <% } %>

            </section><!-- /#recipes -->

          </div><!-- /.film-main__inner -->
        </div><!-- /.film-main -->

      <% } %>

    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Synopsis toggle (vue film) -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const toggle = document.getElementById("synopsis-toggle");
        const text = document.getElementById("synopsis-text");
        if (!toggle || !text) return;
        toggle.addEventListener("click", function () {
          const isExpanded = text.classList.toggle("banner__synopsis-text--expanded");
          toggle.textContent = isExpanded ? "Lire moins" : "Lire le synopsis";
          toggle.setAttribute("aria-expanded", isExpanded);
        });
      });
    </script>

    <!-- Configuration favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>

  </body>
</html>
