<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez les recettes inspirées de vos films cultes préférés"
    />
    <title><%= movie.title %> - Recettes Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/recipes-movie.css" />
  </head>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/recipes-movie.css">

    <!-- MAIN -->
    <main>
      <!-- BANNIÈRE DU FILM -->
      <section class="banner__film">
        <div class="banner__film__title">
          <h2><%= movie.title %></h2>
          <p><%= movie.year %> / <%= movie.genre %></p>
        </div>

    <!-- scripts -->
    <script src="/js/filtred-category.js" defer></script>

</head>


<body>

<!-- ========== HEADER ============ -->

  <header class="header" role="banner">

    <div class="title" aria-label="Titre du site">

      🎬 <span class="title-cine">Ciné</span> <span class="title-delices">Délices</span>

    </div>

    <nav class="navigationheader" role="navigation" aria-label="Navigation principale">

      <a class="navigationheader-link" href="/">Accueil</a>
      <a class="navigationheader-link" href="/movies">Films</a>
      <a class="navigationheader-link" href="#ajouter">Ajouter un film</a>

    </nav>

    <div class="buttons__header">

      <button class="login" aria-label="Connexion">Connexion</button>
      <button class="registration" aria-label="Inscription">Inscription</button>

    </div>

  </header>

<!-- ========== MAIN ============ -->

  <main>
  
    <section class="banner__film">

          <div class="banner__film__title" id="movie" data-id="<%= movie.id %>">

              <h2><%= movie.title %></h2>
              <p><%= movie.year %> / <%= movie.genre %></p>

        <div class="presentation__recipes">
          <div class="presentation__text__recipes">
            <h3>Nos recettes cultes</h3>
            <p>Parce que le goût se partage</p>
          </div>

            <div class="banner__search__recipes">

                <label for="search" class="search__label">Rechercher une recette par catégorie:</label>

                <select name="recipes" id="search" class="search__select__dish">
                    <option value="all">Tous</option>
                    <option value="entrée">Entrée</option>
                    <option value="plat">Plat</option>
                    <option value="dessert">Dessert</option>

                </select>
            </div>

    </section>

    
    <section id="recipes">

          <div class="presentation__image">

            <img src="/images/<%= movie.picture %>" class="banner__image__film" alt="Image du film Crocodile Dundee">

          </div>
        </div>

        <div class="articles only__3__recipes">
              <!-- bouclage des différentes recettes pour les afficher un à un-->
            
          <% recipes.forEach(recipe => { %> <!-- recipes (correspond au tableau récupéré par le controller)-->
          <article>

            <img src="/images/<%= recipe.picture %>">

            <div>
              <h4><%= recipe.name %></h4>
              <p><%= recipe.category %></p>
              <p><%= recipe.quote %>/5</p>
              <a class="recipe-button" href="/recipes-movie/details/<%= recipe.id %>">Voir les recettes</a>                                                  
            </div>
          </article>
          <% }) %>
        </div>

        <div class="center-button">
          <button class="cta-button-secondary" aria-label="Voir tous les films">
            Voir toutes les recettes
          </button>
        </div>
      </section>
    </main>
    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>
    <script src="/js/modal.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/recipes-movie.js" defer></script>
  </body>
</html>
