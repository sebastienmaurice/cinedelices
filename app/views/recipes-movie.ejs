<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title>Recettes du film - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/recipes-movie.css" />

    <!-- scripts -->
    <script src="/js/filtred-category.js" defer></script>
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
  <main>
  
    <section class="banner">
        <div class="banner__film" id="movie" data-id="<%= movie.id %>">
              <h2><%= movie.title %></h2>
              <p><%= movie.year %> / <%= movie.genre %></p>
          </div>

            <div class="banner__search__recipes">
                <label for="search" class="search__label">Rechercher une recette par catégorie:</label>

                <select name="recipes" id="search" class="search__select__dish">
                    <option value="" selected>Categories</option> 
                    <option value="all">Toutes les recettes</option>
                    <option value="entrée">Entrée</option>
                    <option value="plat">Plat</option>
                    <option value="dessert">Dessert</option>
                </select>
            </div>
    </section>

    <!-- SECTION RECETTES -->
    <section id="recipes">

          <div class="presentation__image">

            <img src="/images/<%= movie.picture %>" class="banner__image__film" alt="Image du film Crocodile Dundee">

          </div>

          <div class="presentation__recipes">

                <div class="presentation__text__recipes">

                  <h3>Nos recettes cultes</h3>
                  <p>parce que le goût se partage</p>

                </div>

                <div class="presentation__button__recipes">

                  <button class="btn btn--gold">Ajouter ma recette</button>  
                  
                </div>

          </div>

                

        <div class="articles only__3__recipes">
              <!-- bouclage des différentes recettes pour les afficher une à une-->
            
          <% recipes.forEach(recipe => { %> <!-- recipes (correspond au tableau récupéré par le controller)-->
          <article>
            <div class="recipe-card-image">
              <img src="/images/<%= recipe.picture %>" alt="recette du film <%= recipe.title %>"/>
            </div>
            
            <div class="recipe-card-info">
              <h4 class="recipe-title"><%= recipe.name %></h4>
              <div class="recipe-meta">
                <span class="recipe-category"><%= recipe.category %> </span>
                <span class="recipe-separator">•</span>
                <span class="recipe-duration"><%= recipe.duration %> min</span>
                <span class="recipe-separator">•</span>
                <span class="recipe-difficulty"><%= recipe.difficulty %></span>
                <span class="recipe-separator">•</span>
                <span class="recipe-quote"><%= recipe.quote %>/5</span>
              </div>
              
              
              
              <a class="btn btn--red" href="/recipes-movie/details/<%= recipe.id %>">Voir la recette</a>                                                  
            </div>

          </article>
          <% }) %>

        </div>

        <div class="center-button">
          <button class="btn btn--gold-special" aria-label="Voir tous les films" aria-label="Voir tous les films">Voir toutes les recettes</button>
        </div>

    </section>

</main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>
    <script src="/js/modal.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/films.js" defer></script>
  </body>
</html>


            
