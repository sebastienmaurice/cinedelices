<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Ciné Délices — Site en maintenance">
<title>Maintenance · Ciné Délices</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --bleu-nuit:       #142234;
  --bleu-inter:      #1b263b;
  --surface-card:    #0f1e30;
  --bleu-clair:      #415a77;
  --or-titre:        #C4A052;
  --or-100:          #D4A843;
  --or-200:          #B8882A;
  --dore-clair:      #F2C84B;
  --jaune-blond:     #FFE085;
  --rouge-cta:       #C23018;
  --argent:          #e8e8e8;
  --gold-gradient:   linear-gradient(135deg, #B8882A 0%, #D4A843 30%, #F2C84B 55%, #FFE085 80%, #D4A843 100%);
  --f-display:  'Bebas Neue', cursive;
  --f-title:    'Cinzel', serif;
  --f-editorial:'Playfair Display', serif;
  --f-body:     'Lato', sans-serif;
  --nav-h: 68px;
  --page-px: 64px;
  --max-w: 1440px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; min-height: 100vh; }
body {
  background: var(--bleu-nuit);
  font-family: var(--f-body);
  color: var(--argent);
  overflow-x: hidden;
  overflow-y: auto;
}

#particleCanvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; }

.bg-glow {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse 65% 55% at 50% 50%, rgba(196,160,82,.08) 0%, transparent 60%),
    radial-gradient(ellipse 90% 70% at 20% 20%, rgba(196,160,82,.06) 0%, transparent 55%),
    radial-gradient(ellipse 80% 80% at 80% 80%, rgba(65,90,119,.12) 0%, transparent 55%);
}

.scanlines {
  position: fixed; inset: 0; pointer-events: none; z-index: 2;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,.028) 2px, rgba(0,0,0,.028) 4px);
}

.reel {
  position: fixed; border-radius: 50%;
  border: 2px solid rgba(196,160,82,.07);
  pointer-events: none; z-index: 0;
}
.reel::before { content: ""; position: absolute; inset: 18px; border-radius: 50%; border: 1px solid rgba(196,160,82,.05); }
.reel::after  { content: ""; position: absolute; inset: 36px; border-radius: 50%; border: 1px solid rgba(196,160,82,.03); }
.reel--a { width: 420px; height: 420px; right: -160px; top: -100px; animation: rotReel 50s linear infinite; }
.reel--b { width: 300px; height: 300px; left: -120px; bottom: -100px; animation: rotReel 38s linear infinite reverse; }
@keyframes rotReel { to { transform: rotate(360deg); } }

.vignette {
  position: fixed; inset: 0; pointer-events: none; z-index: 1;
  background: radial-gradient(ellipse 100% 100% at 50% 50%, transparent 40%, rgba(10,16,26,.65) 100%);
}

.page-maintenance {
  position: relative; width: 100%; min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: var(--page-px);
  overflow: hidden; z-index: 1;
}

.maintenance-content {
  position: relative; z-index: 5;
  width: 100%; max-width: 600px;
  display: flex; flex-direction: column; align-items: center;
  text-align: center;
}

/* Logo animé centré */
.maintenance-logo-scene {
  position: relative;
  width: 276px; height: 158px;
  margin-bottom: 2.5rem;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .1s both;
}
.nav-logo__fx {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}
.nav-logo__fx--under { z-index: 0; }
.nav-logo__img { position: relative; z-index: 1; width: 100%; height: auto; display: block; }
.nav-logo__fx--over { z-index: 2; }

.gold-rule {
  width: 200px; height: 1px; margin: 0 auto 2rem;
  background: linear-gradient(90deg, transparent, rgba(196,160,82,.5), transparent);
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .2s both;
}

.maintenance-eyebrow {
  font-family: var(--f-title); font-size: .62rem; font-weight: 600;
  letter-spacing: .22em; text-transform: uppercase; color: rgba(196,160,82,.6);
  margin-bottom: 1rem;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .28s both;
  display: flex; align-items: center; gap: 10px;
}
.eyebrow-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--rouge-cta); flex-shrink: 0; }

.maintenance-title {
  font-family: var(--f-display); font-size: clamp(2rem, 5vw, 3.2rem);
  letter-spacing: .1em; color: #fff; margin-bottom: .8rem;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .38s both;
}
.maintenance-title em { color: var(--or-titre); font-style: normal; }

.maintenance-sub {
  font-family: var(--f-editorial); font-style: italic; font-weight: 400;
  font-size: clamp(.9rem, 1.8vw + .5rem, 1.1rem); color: rgba(232,232,232,.45);
  max-width: 460px; line-height: 1.7; margin-bottom: 0;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .48s both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  :root { --page-px: 24px; }
  .maintenance-logo-scene { width: 200px; height: 115px; }
}
@media (max-width: 480px) {
  :root { --page-px: 16px; }
  .maintenance-logo-scene { width: 160px; height: 92px; }
  .reel--a { width: 260px; height: 260px; right: -100px; }
  .reel--b { width: 200px; height: 200px; left: -80px; }
}
</style>
</head>
<body>

<canvas id="particleCanvas"></canvas>
<div class="bg-glow"></div>
<div class="scanlines"></div>
<div class="vignette"></div>
<div class="reel reel--a"></div>
<div class="reel reel--b"></div>

<main class="page-maintenance">
  <div class="maintenance-content">

    <div class="maintenance-logo-scene nav-logo__scene" id="navLogoScene" data-w="276" data-h="158">
      <canvas class="nav-logo__fx nav-logo__fx--under" id="navLogoFxUnder" width="276" height="158"></canvas>
      <img class="nav-logo__img" id="navLogoImg"
        src="/images/Logo/logo-cine-delices-2026-1.png"
        alt="Ciné Délices"
        crossorigin="anonymous" />
      <canvas class="nav-logo__fx nav-logo__fx--over" id="navLogoFxOver" width="276" height="158"></canvas>
    </div>

    <div class="gold-rule"></div>

    <p class="maintenance-eyebrow">
      <span class="eyebrow-dot"></span>
      Maintenance en cours
      <span class="eyebrow-dot"></span>
    </p>

    <h1 class="maintenance-title">Nous revenons <em>très bientôt</em></h1>

    <p class="maintenance-sub">
      Le site est temporairement en maintenance.<br>
      Notre équipe travaille dans les coulisses pour vous offrir une meilleure expérience.
    </p>

  </div>


</main>

<script>
const canvas = document.getElementById('particleCanvas');
const ctx = canvas.getContext('2d');
let W, H, particles = [];

function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
resize();
window.addEventListener('resize', resize);

const GOLD = ['rgba(196,160,82,','rgba(212,168,67,','rgba(242,200,75,','rgba(255,224,133,','rgba(184,136,42,'];

function mkP() {
  return { x: Math.random()*W, y: H+Math.random()*60, vx:(Math.random()-.5)*.6, vy:-(0.4+Math.random()*1.1),
    r:.8+Math.random()*2.2, alpha:0, life:0, maxLife:120+Math.random()*200,
    color:GOLD[Math.floor(Math.random()*GOLD.length)], twinkle:Math.random()*Math.PI*2, twinkleSpeed:.03+Math.random()*.05 };
}

for (let i=0;i<55;i++) { const p=mkP(); p.y=Math.random()*H; p.life=Math.random()*p.maxLife; particles.push(p); }

function tick() {
  ctx.clearRect(0,0,W,H);
  if (particles.length<70 && Math.random()<.4) particles.push(mkP());
  particles = particles.filter(p => {
    p.life++; p.x+=p.vx; p.y+=p.vy; p.twinkle+=p.twinkleSpeed;
    const t=p.life/p.maxLife;
    p.alpha = t<.15 ? t/.15 : t>.75 ? 1-(t-.75)/.25 : 1;
    const twinkleFactor = .7+.3*Math.sin(p.twinkle);
    ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
    ctx.fillStyle = p.color+(p.alpha*twinkleFactor).toFixed(3)+')';
    ctx.fill();
    return p.life < p.maxLife;
  });
  requestAnimationFrame(tick);
}
tick();
</script>
<script src="/js/nav-logo-fx.js"></script>
</body>
</html>
