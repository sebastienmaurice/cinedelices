<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Choisissez un nouveau mot de passe." />
    <title>Nouveau mot de passe · Ciné Délices</title>

    <%- include("partials/head-resources") %>

    <style>
      .auth-recovery {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px 60px;
      }
      .auth-card {
        width: 100%;
        max-width: 460px;
        background: rgba(15, 30, 48, 0.85);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(196, 160, 82, 0.18);
        border-radius: 16px;
        padding: 40px 36px;
        color: var(--argent, #e8e8e8);
        box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
      }
      .auth-card__eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--or-titre, #c4a052);
        margin: 0 0 10px;
      }
      .auth-card__title {
        font-family: var(--ft-f-title, Georgia, serif);
        font-size: 1.65rem;
        margin: 0 0 10px;
        color: #f2e5c2;
      }
      .auth-card__title em {
        color: var(--or-titre, #c4a052);
        font-style: italic;
      }
      .auth-card__desc {
        font-size: 0.92rem;
        line-height: 1.55;
        color: rgba(232, 232, 232, 0.75);
        margin: 0 0 24px;
      }
      .auth-card__form { display: flex; flex-direction: column; gap: 14px; }
      .auth-card__input {
        width: 100%;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(196, 160, 82, 0.25);
        border-radius: 8px;
        color: #fff;
        font-size: 0.95rem;
      }
      .auth-card__input:focus {
        outline: none;
        border-color: var(--or-titre, #c4a052);
        background: rgba(255, 255, 255, 0.08);
      }
      .auth-card__help {
        font-size: 0.78rem;
        color: rgba(232, 232, 232, 0.6);
        margin: -8px 0 2px;
      }
      .auth-card__btn {
        width: 100%;
        padding: 12px 16px;
        background: var(--rouge-cta, #c23018);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .auth-card__btn:hover { background: #a02614; }
      .auth-card__alert {
        padding: 12px 14px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .auth-card__alert--error {
        background: rgba(194, 48, 24, 0.14);
        border: 1px solid rgba(194, 48, 24, 0.4);
        color: #ffb8a8;
      }
      .auth-card__alert--success {
        background: rgba(76, 175, 80, 0.12);
        border: 1px solid rgba(76, 175, 80, 0.35);
        color: #b8e6ba;
      }
      .auth-card__links {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 22px;
        font-size: 0.82rem;
      }
      .auth-card__links a {
        color: var(--or-titre, #c4a052);
        text-decoration: none;
      }
      .auth-card__links a:hover { text-decoration: underline; }
    </style>
  </head>

  <body class="reset-password-page">
    <%- include("partials/header") %>

    <main class="auth-recovery">
      <section class="auth-card" role="region" aria-labelledby="rp-title">
        <p class="auth-card__eyebrow">Sécurité du compte</p>
        <h1 class="auth-card__title" id="rp-title">Nouveau <em>mot de passe</em></h1>

        <% if (success) { %>
          <div class="auth-card__alert auth-card__alert--success" role="status">
            Votre mot de passe a bien été mis à jour. Vous pouvez maintenant vous reconnecter.
          </div>
          <div class="auth-card__links" style="justify-content:center;">
            <a href="#" class="js-open-login" style="font-weight:600;">→ Retour à la connexion</a>
          </div>
        <% } else if (!tokenValid) { %>
          <div class="auth-card__alert auth-card__alert--error" role="alert">
            <%= error || "Ce lien est invalide ou a expiré." %>
          </div>
          <p class="auth-card__desc">
            Vous pouvez demander un nouveau lien de réinitialisation.
          </p>
          <a href="/auth/forgot-password" class="auth-card__btn" style="display:block;text-align:center;text-decoration:none;">
            Demander un nouveau lien
          </a>
        <% } else { %>
          <p class="auth-card__desc">Choisissez un nouveau mot de passe pour votre compte.</p>

          <% if (error) { %>
            <div class="auth-card__alert auth-card__alert--error" role="alert"><%= error %></div>
          <% } %>

          <form class="auth-card__form" method="POST" action="/auth/reset-password" novalidate>
            <input type="hidden" name="token" value="<%= token %>" />

            <label for="rp-password" class="sr-only">Nouveau mot de passe</label>
            <input
              id="rp-password"
              class="auth-card__input"
              type="password"
              name="password"
              placeholder="Nouveau mot de passe"
              autocomplete="new-password"
              minlength="8"
              required
            />
            <p class="auth-card__help">Min. 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial.</p>

            <label for="rp-confirm" class="sr-only">Confirmer le mot de passe</label>
            <input
              id="rp-confirm"
              class="auth-card__input"
              type="password"
              name="confirm_password"
              placeholder="Confirmer le mot de passe"
              autocomplete="new-password"
              minlength="8"
              required
            />

            <button type="submit" class="auth-card__btn">Enregistrer le nouveau mot de passe</button>
          </form>
        <% } %>

        <% if (!success) { %>
        <div class="auth-card__links">
          <a href="/auth/forgot-password">Recommencer</a>
          <a href="/">Accueil</a>
        </div>
        <% } %>
      </section>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
