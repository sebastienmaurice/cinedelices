<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !"
    />
    <title>Ciné Délices - Le goût du cinéma</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/home.css" />
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- HERO SLIDER -->
      <section class="hero-slider" aria-label="Carrousel principal">
        <div class="hero-slider__container">
          <!-- Slide 1 : Remy de ratatouillle -->
          <div
            class="hero-slider__slide hero-slider__slide--active"
            data-slide="1"
          >
            <div
              class="hero-slider__bg"
              style="
                background-image: url('/images/event/hero-slide-remy-paris-bg.jpg');
              "
            ></div>
            <div class="hero-slider__overlay"></div>
            <img
              src="/images/event/hero-slide-remy-foreground.png"
              alt="Rémy sur la vue de Paris"
              class="hero-slider__foreground"
            />
            <div class="hero-slider__content">
              <h1 class="hero-slider__h1">Remy : Ratatouille</h1>
              <p class="hero-slider__subtitle">
                À Paris, même un rat peut devenir un grand chef
              </p>
              <a href="/movies" class="btn btn--gold-special"
                >Passer en cuisine</a
              >
            </div>
          </div>

          <!-- Slide 2 : Walter de Breaking Bad -->
          <div class="hero-slider__slide" data-slide="2">
            <div
              class="hero-slider__bg"
              style="
                background-image: url('/images/event/hero-slide-breaking-bad-bg.jpg');
              "
            ></div>
            <div class="hero-slider__overlay"></div>
            <img
              src="/images/event/hero-slide-walter-breaking-bad-foreground.png"
              alt="Walter desert de Breaking Bad"
              class="hero-slider__foreground"
            />
            <div class="hero-slider__content">
              <h1 class="hero-slider__h1">Walter : Breaking Bad</h1>
              <p class="hero-slider__subtitle">
                Quand la cuisine devient une question de survie
              </p>
              <a href="/recipes-movie" class="btn btn--gold-special"
                >Passer aux fourneaux</a
              >
            </div>
          </div>

          <!-- Slide 3 : Recettes cultes -->
          <div class="hero-slider__slide" data-slide="3">
            <div
              class="hero-slider__bg"
              style="
                background-image: url('/images/image-default-recipe-1.jpg');
              "
            ></div>
            <div class="hero-slider__overlay"></div>
            <img
              src="/images/event/santa-1.png"
              alt=""
              class="hero-slider__foreground"
            />
            <div class="hero-slider__content">
              <h1 class="hero-slider__h1">Recettes cultes</h1>
              <p class="hero-slider__subtitle">
                Explorez les saveurs iconiques du grand écran
              </p>
              <a href="/recipes-movie" class="btn btn--gold-special"
                >Voir les recettes</a
              >
            </div>
          </div>

          <!-- Slide 4 : Communauté / Partage -->
          <div class="hero-slider__slide" data-slide="4">
            <div
              class="hero-slider__bg"
              style="
                background-image: url('/images/image-home-marty-doc.png');
                background-color: var(--bleu-nuit);
              "
            ></div>
            <div class="hero-slider__overlay"></div>
            <img
              src="/images/event/santa-1.png"
              alt=""
              class="hero-slider__foreground"
            />
            <div class="hero-slider__content">
              <h1 class="hero-slider__h1">Communauté</h1>
              <p class="hero-slider__subtitle">
                Partagez vos recettes et commentez celles des autres
              </p>
              <a href="/auth/register" class="btn btn--gold-special"
                >Rejoindre la communauté</a
              >
            </div>
          </div>
        </div>

        <!-- Pagination verticale à droite -->
        <div class="hero-slider__pagination-vertical" role="tablist">
          <button
            class="hero-slider__pagination-number hero-slider__pagination-number--active"
            data-slide="0"
            aria-label="Aller au slide 1"
            role="tab"
            aria-selected="true"
          >
            01
          </button>
          <button
            class="hero-slider__pagination-number"
            data-slide="1"
            aria-label="Aller au slide 2"
            role="tab"
            aria-selected="false"
          >
            02
          </button>
          <button
            class="hero-slider__pagination-number"
            data-slide="2"
            aria-label="Aller au slide 3"
            role="tab"
            aria-selected="false"
          >
            03
          </button>
          <button
            class="hero-slider__pagination-number"
            data-slide="3"
            aria-label="Aller au slide 4"
            role="tab"
            aria-selected="false"
          >
            04
          </button>
        </div>
      </section>

      <!-- RECETTE DU JOUR -->
      <section
        class="recipeofthe__day"
        id="recettes"
        role="region"
        aria-labelledby="recette-du-jour-titre"
      >
        <div class="recipeofthe__day-container">
          <!-- Colonne gauche : Recette du jour -->
          <div class="recipe-column-left">
            <div class="section-header">
              <h2 id="recette-du-jour-titre">Recette du jour</h2>
              <p class="section-subtitle">
                Le goût du cinéma et le cinéma du goût
              </p>
            </div>
            <article class="recipe-card recipe-card--left">
              <div class="recipe-image-placeholder">
                <img
                  src="<%= topRecipe.picture %>"
                  alt="Recette inspiré du film <%= topRecipe.Movie.title %>"
                  loading="lazy"
                  width="600"
                  height="260"
                />
              </div>
              <div class="recipe-info">
                <h3><%= topRecipe.name %></h3>
                <p class="recipe-film"><%= topRecipe.Movie.title %></p>
                <p class="recipe-description"><%= topRecipe.description %></p>
                <a
                  class="btn btn--red"
                  href="/recipes-movie/details/<%= topRecipe.id %>"
                  aria-label="Voir la recette <%= topRecipe.name %> (accéder à la fiche recette)"
                >
                  Voir la recette
                </a>
              </div>
            </article>
          </div>

          <!-- Colonnes droite : Les 4 films du jour -->
          <div class="films-columns-right">
            <div class="section-header">
              <h2>Quelques films Ciné Délices</h2>
              <p class="section-subtitle">
                Une sélection de films et séries cultes avec leurs recettes
                inspirées. Plongez dans l'univers du cinéma et découvrez le goût
                du grand écran.
              </p>
            </div>
            <div class="films-container">
              <% if (topMovies && topMovies.length > 0) { %>
              <!-- Première carte film -->
              <% if (topMovies[0]) { %>
              <a
                href="/recipes-movie/<%= topMovies[0].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[0].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[0].cardPath || topMovies[0].picture %>"
                    alt="<%= topMovies[0].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[0].title %></h3>
                  <p class="film-description">
                    Explorez les recettes cultes inspirées de <%=
                    topMovies[0].title %> et revivez les saveurs du grand écran.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %>

              <!-- Deuxième carte film -->
              <% if (topMovies[1]) { %>
              <a
                href="/recipes-movie/<%= topMovies[1].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[1].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[1].cardPath || topMovies[1].picture %>"
                    alt="<%= topMovies[1].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[1].title %></h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film ou de
                    cette série culte et plongez vous dans l'univers de <%=
                    topMovies[1].title %>.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %>

              <!-- Troisième carte film -->
              <% if (topMovies[2]) { %>
              <a
                href="/recipes-movie/<%= topMovies[2].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[2].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[2].cardPath || topMovies[2].picture %>"
                    alt="<%= topMovies[2].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[2].title %></h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film ou de
                    cette série culte et plongez vous dans l'univers de <%=
                    topMovies[2].title %>.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %>

              <!-- Quatrième carte film -->
              <% if (topMovies[3]) { %>
              <a
                href="/recipes-movie/<%= topMovies[3].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[3].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[3].cardPath || topMovies[3].picture %>"
                    alt="<%= topMovies[3].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[3].title %></h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film ou de
                    cette série culte et plongez vous dans l'univers de <%=
                    topMovies[3].title %>.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %> <% } else { %>
              <p class="no-movies">Aucun film disponible pour le moment.</p>
              <% } %>
            </div>
          </div>
        </div>
      </section>

      <!-- TOP 3 RECETTES -->
      <section
        class="top-recettes"
        id="films"
        role="region"
        aria-labelledby="top3-titre"
      >
        <div class="section-header">
          <h2 id="top3-titre">Top 3 des recettes</h2>
          <p class="section-subtitle">
            Les recettes les plus appréciées par la communauté Ciné Délices,
            inspirées de scènes cultes du cinéma.
          </p>
        </div>

        <div class="top-recettes__grid">
          <!-- boucle sur les 3 recettes -->
          <% recipes.forEach(recipe => { %>
          <article class="recette-card">
            <div class="recette-image">
              <img
                src="<%= recipe.picture %>"
                alt="<%= recipe.name %> inspiré de <%= recipe.Movie.title %>"
                loading="lazy"
                width="420"
                height="220"
              />
            </div>
            <div class="recette-content">
              <h3><%= recipe.name %></h3>
              <p class="recette-film"><%= recipe.Movie.title %></p>
              <p class="recette-description"><%= recipe.description %></p>
              <a
                class="btn btn--red"
                href="/recipes-movie/details/<%= recipe.id %>"
                aria-label="Voir la recette <%= recipe.name %> (accéder à la fiche recette)"
              >
                Voir la recette
              </a>
            </div>
          </article>
          <% }) %>
        </div>

        <div class="center-button">
          <a
            class="btn btn--gold-special"
            href="/movies"
            aria-label="Voir tous les films"
          >
            Voir tous les films
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->

    <!-- Ionicons (icônes) -->
    <script
      type="module"
      src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"
    ></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"
    ></script>
    <!-- Script du hero slider -->
    <script src="/js/hero-slider.js" defer></script>
  </body>
</html>
