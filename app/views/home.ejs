<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !" />
    <title>Ciné Délices - Le goût du cinéma</title>
    <%- include("partials/head-resources") %>
    <link rel="stylesheet" href="/css/home.css" />
  </head>

  <body>
    <%- include("partials/header") %>

    <main>

      <!-- ══════════════════════════════════════════════
           HERO — 2 slides, version maquette V2 (hero__* classes)
           Images : /images/event/  (locales)
           ══════════════════════════════════════════════ -->
      <div class="hero-wrapper">
      <div class="hero__cut-flash" aria-hidden="true"></div>
      <section class="hero" id="hero">

        <!-- SLIDE 0 : Ratatouille -->
        <div class="hero__slide active" id="slide-0">
          <div class="hero__bg" id="bg-0" style="background-image:url('/images/event/hero-slide-remy-paris-bg.jpg')"></div>
          <div class="hero__overlay"></div>
          <div class="hero__vignette"></div>
          <div class="hero__fade-left"></div>
          <div class="hero__fade-right"></div>
          <img class="hero__fg" id="fg-0" src="/images/event/hero-slide-remy-foreground.png" alt="Rémy — Ratatouille" draggable="false">
          <span class="hero__slide-badge">🎬 Film du moment</span>
          <div class="hero__content">
            <div class="hero__eyebrow-bar">
              <div class="hero__eyebrow-line"></div>
              <div class="hero__eyebrow-text">
                <span class="hero__eyebrow-label">Sélection Ciné Délices</span>
                <span class="hero__eyebrow-genre">Animation · Comédie</span>
              </div>
            </div>
            <h1 class="hero__title">REMY<em>RATATOUILLE</em></h1>
            <p class="hero__sub">Quand la cuisine rencontre l'art</p>
            <p class="hero__desc">Un rat passionné de gastronomie défie les conventions dans les cuisines parisiennes. Découvrez les recettes inspirées du chef Gusteau.</p>
            <div class="hero__actions">
              <a href="/movies" class="hero__btn-primary">🍴 Voir les recettes</a>
              <a href="/movies" class="hero__btn-secondary">Fiche Film →</a>
            </div>
          </div>
          <div class="hero__stats">
            <div class="hero__stat"><span class="hero__stat-val">4.9</span><span class="hero__stat-label">Note</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">18</span><span class="hero__stat-label">Recettes</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">2007</span><span class="hero__stat-label">Année</span></div>
          </div>
          <div class="hero__watermark">RATATOUILLE</div>
          <div class="hero__grain"></div>
        </div>

        <!-- SLIDE 1 : Breaking Bad -->
        <div class="hero__slide" id="slide-1">
          <div class="hero__bg" id="bg-1" style="background-image:url('/images/event/hero-slide-breaking-bad-bg.jpg')"></div>
          <div class="hero__overlay"></div>
          <div class="hero__vignette"></div>
          <div class="hero__fade-left"></div>
          <div class="hero__fade-right"></div>
          <img class="hero__fg" id="fg-1" src="/images/event/hero-slide-walter-breaking-bad-foreground.png" alt="Walter White — Breaking Bad" draggable="false">
          <span class="hero__slide-badge">📺 Série du moment</span>
          <div class="hero__content">
            <div class="hero__eyebrow-bar">
              <div class="hero__eyebrow-line"></div>
              <div class="hero__eyebrow-text">
                <span class="hero__eyebrow-label">Sélection Ciné Délices</span>
                <span class="hero__eyebrow-genre">Drame · Thriller</span>
              </div>
            </div>
            <h1 class="hero__title">BREAKING<em>BAD</em></h1>
            <p class="hero__sub">La chimie au service des sens</p>
            <p class="hero__desc">Walter White transformait le danger en art. Nous, on transforme ses recettes en chef-d'œuvres culinaires. Say my name.</p>
            <div class="hero__actions">
              <a href="/movies" class="hero__btn-primary">🍴 Voir les recettes</a>
              <a href="/movies" class="hero__btn-secondary">Fiche Série →</a>
            </div>
          </div>
          <div class="hero__stats">
            <div class="hero__stat"><span class="hero__stat-val">5.0</span><span class="hero__stat-label">Note</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">11</span><span class="hero__stat-label">Recettes</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">2008</span><span class="hero__stat-label">Année</span></div>
          </div>
          <div class="hero__watermark">BREAKING BAD</div>
          <div class="hero__grain"></div>
        </div>

        <button class="hero__arrow hero__arrow--prev" id="heroPrev">‹</button>
        <button class="hero__arrow hero__arrow--next" id="heroNext">›</button>
        <div class="hero__nav">
          <button class="hero__dot active" data-slide="0"></button>
          <button class="hero__dot" data-slide="1"></button>
          <div class="hero__counter">
            <span class="hero__counter-cur" id="heroCounterCur">01</span>
            <span class="hero__counter-sep">/</span>
            <span class="hero__counter-tot" id="heroCounterTot">02</span>
          </div>
        </div>

      </section>
      </div>

      <!-- ══════════════════════════════════════════════
           GENRES — maquette HTML lines 1677-1706
           Badges carousel dynamiques via genreStats
           ══════════════════════════════════════════════ -->
      <%
        const GENRE_THEMES = {
          'Action':          { glow: '#FF6622', accent: '#FF8844', rgb: '255,102,34',  anim: 'bullet'      },
          'Horreur':         { glow: '#C23018', accent: '#E84020', rgb: '194,48,24',   anim: 'blood'       },
          'Aventure':        { glow: '#D4A843', accent: '#F2C84B', rgb: '212,168,67',  anim: 'fuse'        },
          'Comédie':         { glow: '#FFE085', accent: '#F2C84B', rgb: '255,224,133', anim: 'confetti'    },
          'Animation':       { glow: '#F2C84B', accent: '#FFE085', rgb: '242,200,75',  anim: 'brush'       },
          'Romance':         { glow: '#FF6B8A', accent: '#FF8FA3', rgb: '255,107,138', anim: 'heart'       },
          'Science-Fiction': { glow: '#00FF88', accent: '#00FFCC', rgb: '0,255,136',   anim: 'scan'        },
          'Drame':           { glow: '#C4A052', accent: '#D4A843', rgb: '196,160,82',  anim: 'tear'        },
          'Thriller':        { glow: '#8899BB', accent: '#AABBDD', rgb: '136,153,187', anim: 'strobe'      },
          'Fantastique':     { glow: '#C084FC', accent: '#A855F7', rgb: '192,132,252', anim: 'magic'       },
          'Policier':        { glow: '#A8B8C8', accent: '#C8D8E8', rgb: '168,184,200', anim: 'siren'       },
          'Documentaire':    { glow: '#7BA7BC', accent: '#A8C8D8', rgb: '123,167,188', anim: 'viewfinder'  },
          'Biopic':          { glow: '#B8882A', accent: '#C4A052', rgb: '184,136,42',  anim: 'torch'       },
          'Guerre':          { glow: '#778899', accent: '#99AABB', rgb: '119,136,153', anim: 'radar'       },
          'Western':         { glow: '#A07840', accent: '#C09858', rgb: '160,120,64',  anim: 'torch'       },
          'Musical':         { glow: '#C4A052', accent: '#FFE085', rgb: '196,160,82',  anim: 'notes'       },
          'Sci-Fi':          { glow: '#00FF88', accent: '#00FFCC', rgb: '0,255,136',   anim: 'scan'        },
          'Historique':      { glow: '#B8882A', accent: '#C4A052', rgb: '184,136,42',  anim: 'torch'       },
        };
        const DEFAULT_GENRE_THEME = { glow: '#C4A052', accent: '#F2C84B', rgb: '196,160,82', anim: 'fuse' };
        function genreSlug(name) {
          return name.toLowerCase()
            .replace(/[éèêë]/g, 'e').replace(/[àâ]/g, 'a')
            .replace(/[ôö]/g, 'o').replace(/[îï]/g, 'i')
            .replace(/[ùûü]/g, 'u').replace(/ç/g, 'c')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        }
      %>
      <canvas id="burst-canvas"></canvas>
      <section class="genres-section" aria-label="Explorer par genre">
        <div class="wrap">
          <div class="genres-header">
            <div class="genres-header__left">
              <div class="section-label" data-reveal="left">Explorer par Genre</div>
              <h2 class="section-title" data-reveal="left" style="margin-bottom:0;margin-top:0;transition-delay:.10s">Le goût du cinéma</h2>
            </div>
            <a href="/movies" class="genres-see-all" data-reveal="right">Tous les films</a>
          </div>
        </div>
        <div class="carousel-outer" id="carouselOuter">
          <div class="carousel-track" id="track">
            <% if (genreStats && genreStats.length > 0) { %>
              <% genreStats.forEach(function(stat) { %>
                <% const theme = GENRE_THEMES[stat.genre] || DEFAULT_GENRE_THEME; %>
                <% const slug = genreSlug(stat.genre); %>
                <article class="badge"
                  style="--glow:<%- theme.glow %>;--accent:<%- theme.accent %>;--glow-rgb:<%- theme.rgb %>;"
                  data-count="<%- stat.count %>"
                  data-genre="<%- stat.genre %>"
                  data-anim="<%- theme.anim %>"
                  data-films='[]'>
                  <canvas class="badge__border-canvas"></canvas>
                  <div class="badge__img-wrap">
                    <img class="badge__img"
                         src="/images/categories/<%- slug %>.webp"
                         alt="<%- stat.genre %>"
                         onerror="this.src.endsWith('.webp')?(this.src=this.src.slice(0,-5)+'.png'):(this.onerror=null,this.style.display='none')" />
                    <div class="badge__fade"></div>
                    <div class="badge__img-tint"></div>
                  </div>
                  <div class="badge__text">
                    <span class="badge__category"><%- stat.genre %></span>
                    <div class="badge__divider"></div>
                    <p class="badge__count">
                      <strong data-target="<%- stat.count %>">0</strong>
                      <span>Film<%= stat.count > 1 ? 's' : '' %></span>
                    </p>
                  </div>
                </article>
              <% }) %>
            <% } %>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════
           TRANSITION NARRATIVE — maquette HTML lines 1708-1721
           ══════════════════════════════════════════════ -->
      <div class="section-bridge">
        <div class="wrap">
          <div class="section-bridge__inner" data-reveal="up">
            <div class="section-bridge__line"></div>
            <div class="section-bridge__text">
              <span class="section-bridge__eyebrow">Vous avez trouvé votre genre ?</span>
              <span class="section-bridge__arrow">↓</span>
              <span class="section-bridge__tagline">Voici les recettes que nos membres adorent</span>
            </div>
            <div class="section-bridge__line"></div>
          </div>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════
           DUO DU JOUR — maquette HTML lines 1546-1672
           3 colonnes : Film (27fr) | CTA doré (30fr) | Recette (43fr)
           Film  → topMovies[0]
           Recette → topRecipe
           CTA → liens statiques (/auth/register, /add-recipes-movies/)
           ══════════════════════════════════════════════ -->
      <div class="wrap">
        <section class="duo-jour-section">
          <div class="duo-jour-header" data-reveal="up">
            <div>
              <div class="section-label">Sélection du Jour</div>
              <h2 class="section-title">Le Duo du Jour</h2>
              <p class="section-sub">Un film, une recette — l'association parfaite</p>
            </div>
            <div class="duo-jour-header__live">
              <span class="duo-jour-header__live-dot"></span>
              Mis à jour chaque jour
            </div>
          </div>

          <div class="duo-jour-grid">

            <!-- ① FILM — affiche 2:3 cadrée — topMovies[0] -->
            <% if (topMovies && topMovies[0]) { %>
            <a href="/recipes-movie/<%= topMovies[0].slug || topMovies[0].id %>" class="djc-film" data-reveal="left" aria-label="Voir les recettes de <%= topMovies[0].title %>">
              <img class="djc-film__img" src="<%= topMovies[0].cardPath || topMovies[0].picture %>" alt="Affiche <%= topMovies[0].title %>" loading="lazy">
              <div class="djc-film__overlay"></div>
              <div class="djc-film__top">
                <span class="djc-film__badge">🎬 Film</span>
                <button class="djc-film__fav btn-fav" data-id="<%= topMovies[0].id %>" data-type="movie" aria-label="Ajouter aux favoris">♡</button>
              </div>
              <div class="djc-film__bottom">
                <div class="djc-film__tags">
                  <% if (topMovies[0].genre) { %>
                  <span class="film-badge film-badge--genre"><%= topMovies[0].genre.split(',')[0].trim() %></span>
                  <% } %>
                </div>
                <span class="djc-film__title"><%= topMovies[0].title %></span>
                <% if (topMovies[0].year) { %><span class="djc-film__sub"><%= topMovies[0].year %></span><% } %>
                <div class="djc-film__meta">
                  <div class="djc-film__stars">
                    <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                  </div>
                  <% if (topMovies[0].recipeCount) { %>
                  <span class="djc-film__count">🍴 <%= topMovies[0].recipeCount %> recette<%= topMovies[0].recipeCount > 1 ? 's' : '' %></span>
                  <% } %>
                </div>
              </div>
            </a>
            <% } %>

            <!-- ② CTA DORÉ — wrapper colonne : eyebrow + Golden Ticket -->
            <div class="djc-cta-col">

              <!-- Eyebrow dynamique au-dessus de la CTA -->
              <div class="djc-eyebrow">🎬&nbsp;<%= totalMovies %> FILMS VOUS ATTENDENT</div>

              <!-- Golden Ticket -->
              <div class="djc-cta" data-reveal="up">
              <div class="djc-cta__shimmer"></div>
              <div>
                <div class="djc-cta__eyebrow">Rejoignez la communauté</div>
              </div>
              <div>
                <h2 class="djc-cta__title">CUISINEZ<em>CE QUE<br>VOUS AIMEZ.</em></h2>
              </div>
              <p class="djc-cta__desc">Partagez vos recettes inspirées du grand écran et rejoignez des milliers de cinéphiles gourmands.</p>
              <div class="djc-cta__stats">
                <div class="djc-cta__stat">
                  <span class="djc-cta__stat-val"><%= totalUsers %></span>
                  <span class="djc-cta__stat-lbl">Membres</span>
                </div>
                <div class="djc-cta__stat-sep"></div>
                <div class="djc-cta__stat">
                  <span class="djc-cta__stat-val"><%= totalRecipes %></span>
                  <span class="djc-cta__stat-lbl">Recettes</span>
                </div>
                <div class="djc-cta__stat-sep"></div>
                <div class="djc-cta__stat">
                  <span class="djc-cta__stat-val"><%= totalMovies %></span>
                  <span class="djc-cta__stat-lbl">Films liés</span>
                </div>
              </div>
              <div class="djc-cta__btns">
                <a href="/auth/register" class="djc-cta__btn-primary">✦ Créer un compte</a>
                <a href="/add-recipes-movies/" class="djc-cta__btn-secondary">🍴 Ajouter ma recette</a>
                <div class="djc-cta__membres">
                  <img src="https://i.pravatar.cc/32?img=12" alt="" class="djc-cta__av">
                  <img src="https://i.pravatar.cc/32?img=25" alt="" class="djc-cta__av">
                  <img src="https://i.pravatar.cc/32?img=33" alt="" class="djc-cta__av">
                  <span class="djc-cta__av-txt">+<%= totalUsers %> membres actifs</span>
                </div>
              </div>
            </div><!-- /.djc-cta -->
            </div><!-- /.djc-cta-col -->

            <!-- ③ RECETTE — format 3:2 — topRecipe — maquette lines 1626-1668 -->
            <% if (topRecipe) { %>
            <div class="djc-recette" data-reveal="right">
              <div class="djc-recette__img-wrap">
                <img class="djc-recette__img" src="<%= topRecipe.picture %>" alt="<%= topRecipe.name %>" loading="lazy">
                <div class="djc-recette__img-overlay"></div>
                <div class="djc-recette__img-top">
                  <span class="djc-recette__type"><%= topRecipe.difficulty || 'Recette' %></span>
                  <button class="djc-recette__fav btn-fav" data-id="<%= topRecipe.id %>" data-type="recipe" aria-label="Ajouter aux favoris">♡</button>
                </div>
                <div class="djc-recette__img-bottom">
                  <span class="djc-recette__film-badge">🎞 <%= topRecipe.Movie.title %></span>
                </div>
              </div>
              <div class="djc-recette__body">
                <h3 class="djc-recette__title"><%= topRecipe.name %></h3>
                <div class="djc-recette__tags">
                  <span class="djc-recette__tag djc-recette__tag--or"><%= topRecipe.difficulty || 'Moyen' %></span>
                  <% if (topRecipe.category) { %>
                  <span class="djc-recette__tag djc-recette__tag--bleu"><%= topRecipe.category %></span>
                  <% } %>
                </div>
                <div class="djc-recette__meta">
                  <div class="djc-recette__stars">
                    <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                  </div>
                  <div class="djc-recette__infos">
                    <% if (topRecipe.time) { %><span>⏱ <%= topRecipe.time %> min</span><% } %>
                    <% if (topRecipe.servings) { %><span>👥 <%= topRecipe.servings %> pers.</span><% } %>
                  </div>
                </div>
                <div class="djc-recette__foot">
                  <div class="djc-recette__author">
                    <img class="djc-recette__avatar" src="<%= topRecipe.User && topRecipe.User.avatar ? topRecipe.User.avatar : 'https://i.pravatar.cc/68?img=47' %>" alt="<%= topRecipe.User ? topRecipe.User.username : 'Chef' %>" loading="lazy">
                    <div>
                      <div class="djc-recette__author-name"><%= topRecipe.User ? topRecipe.User.username : 'Chef Ciné Délices' %></div>
                      <div class="djc-recette__author-rank">★★ Studio Bronze</div>
                    </div>
                  </div>
                  <a href="/recipes-movie/details/<%= topRecipe.slug || topRecipe.id %>" class="djc-recette__btn">Voir la recette →</a>
                </div>
              </div>
            </div>
            <% } %>

          </div>
        </section>
      </div>

      <!-- ══════════════════════════════════════════════
           TOP 3 RECETTES — maquette HTML lines 1976-2084
           recipes[0] → featured #1
           recipes[1] → card #2
           recipes[2] → card #3
           ══════════════════════════════════════════════ -->
      <section class="top-recettes-section" id="films" role="region" aria-labelledby="top3-titre">
        <div class="wrap">
          <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:36px">
            <div data-reveal="left">
              <div class="section-label">Les incontournables</div>
              <h2 id="top3-titre" class="section-title">Top 3 Recettes</h2>
              <p class="section-sub" style="margin-bottom:0">Les meilleures recettes inspirées du grand écran</p>
            </div>
            <a href="/movies" class="genres-see-all" data-reveal="right">Voir toutes les recettes</a>
          </div>

          <% if (recipes && recipes.length > 0) { %>
          <div class="top3-layout" data-reveal-stagger>

            <!-- COLONNE GAUCHE : featured #1 — recipes[0] -->
            <div class="top3-col-left">
              <% if (recipes[0]) { %>
              <div class="top3-featured">
                <div class="top3-featured__img-wrap">
                  <img class="top3-featured__img" src="<%= recipes[0].picture %>" alt="<%= recipes[0].name %>" loading="lazy">
                  <div class="top3-featured__overlay"></div>
                  <div class="top3-featured__medal">1</div>
                  <button class="top3-featured__fav btn-fav" data-id="<%= recipes[0].id %>" data-type="recipe" aria-label="Favoris">♡</button>
                  <span class="top3-featured__film-badge">🎬 <%= recipes[0].Movie.title %></span>
                </div>
                <div class="top3-featured__body">
                  <span class="top3-featured__eyebrow">🏆 Recette n°1 de la communauté</span>
                  <h3 class="top3-featured__title"><%= recipes[0].name %></h3>
                  <div class="top3-featured__tags">
                    <% if (recipes[0].difficulty) { %>
                    <span class="djc-recette__tag djc-recette__tag--or top3-tag--sm"><%= recipes[0].difficulty %></span>
                    <% } %>
                    <% if (recipes[0].category) { %>
                    <span class="djc-recette__tag djc-recette__tag--bleu top3-tag--sm"><%= recipes[0].category %></span>
                    <% } %>
                  </div>
                  <div class="top3-featured__meta">
                    <div class="top3-featured__stars">
                      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                    </div>
                    <div class="top3-featured__infos">
                      <% if (recipes[0].time) { %><span>⏱ <%= recipes[0].time %> min</span><% } %>
                      <% if (recipes[0].servings) { %><span>👥 <%= recipes[0].servings %> pers.</span><% } %>
                    </div>
                  </div>
                  <% if (recipes[0].description) { %>
                  <p class="top3-featured__desc"><%= recipes[0].description.slice(0, 120) %>...</p>
                  <% } %>
                  <div class="top3-featured__foot">
                    <% const c0 = recipes[0].contributor;
                       const c0cls = c0 && c0.role === 'admin' ? 'lvl--legend' : 'lvl--1';
                       const c0ttl = c0 && c0.role === 'admin' ? '★★★★★ Légende' : '★ Popcorn Rookie'; %>
                    <div class="lvl-badge <%= c0cls %>">
                      <div class="lvl-av">
                        <img src="<%= c0 && c0.picture ? c0.picture : 'https://i.pravatar.cc/68?img=15' %>" alt="" loading="lazy">
                      </div>
                      <div class="lvl-info">
                        <span class="lvl-name"><%= c0 ? c0.pseudo : 'Chef Ciné Délices' %></span>
                        <span class="lvl-title"><%= c0ttl %></span>
                      </div>
                    </div>
                    <a href="/recipes-movie/details/<%= recipes[0].slug || recipes[0].id %>" class="top3-featured__btn">Voir la recette →</a>
                  </div>
                </div>
              </div>
              <% } %>
            </div>

            <!-- COLONNE DROITE : cards #2 & #3 empilées -->
            <div class="top3-col-right">

              <!-- #2 — recipes[1] -->
              <% if (recipes[1]) { %>
              <div class="top3-card">
                <div class="top3-card__img-wrap">
                  <img class="top3-card__img" src="<%= recipes[1].picture %>" alt="<%= recipes[1].name %>" loading="lazy">
                  <div class="top3-card__medal top3-card__medal--2">2</div>
                </div>
                <div class="top3-card__body">
                  <span class="top3-card__film-badge">🎬 <%= recipes[1].Movie.title %></span>
                  <h3 class="top3-card__title"><%= recipes[1].name %></h3>
                  <div class="top3-card__tags">
                    <% if (recipes[1].difficulty) { %>
                    <span class="djc-recette__tag djc-recette__tag--or top3-tag--xs"><%= recipes[1].difficulty %></span>
                    <% } %>
                    <% if (recipes[1].category) { %>
                    <span class="djc-recette__tag djc-recette__tag--bleu top3-tag--xs"><%= recipes[1].category %></span>
                    <% } %>
                  </div>
                  <div class="top3-card__meta">
                    <div class="top3-card__stars">
                      <span>★</span><span>★</span><span>★</span><span>★</span><span class="star-e">★</span>
                    </div>
                  </div>
                  <% if (recipes[1].description) { %><p class="top3-card__desc"><%= recipes[1].description.slice(0, 80) %>...</p><% } %>
                  <div class="top3-card__foot">
                    <% const c1 = recipes[1].contributor;
                       const c1cls = c1 && c1.role === 'admin' ? 'lvl--legend' : 'lvl--1';
                       const c1ttl = c1 && c1.role === 'admin' ? '★★★★★ Légende' : '★ Popcorn Rookie'; %>
                    <div class="lvl-badge lvl-badge--sm <%= c1cls %>">
                      <div class="lvl-av">
                        <img src="<%= c1 && c1.picture ? c1.picture : 'https://i.pravatar.cc/68?img=15' %>" alt="" loading="lazy">
                      </div>
                      <div class="lvl-info">
                        <span class="lvl-name"><%= c1 ? c1.pseudo : 'Chef Ciné Délices' %></span>
                        <span class="lvl-title"><%= c1ttl %></span>
                      </div>
                    </div>
                    <a href="/recipes-movie/details/<%= recipes[1].slug || recipes[1].id %>" class="top3-card__btn">Voir</a>
                  </div>
                </div>
              </div>
              <% } %>

              <!-- #3 — recipes[2] -->
              <% if (recipes[2]) { %>
              <div class="top3-card">
                <div class="top3-card__img-wrap">
                  <img class="top3-card__img" src="<%= recipes[2].picture %>" alt="<%= recipes[2].name %>" loading="lazy">
                  <div class="top3-card__medal top3-card__medal--3">3</div>
                </div>
                <div class="top3-card__body">
                  <span class="top3-card__film-badge">🎬 <%= recipes[2].Movie.title %></span>
                  <h3 class="top3-card__title"><%= recipes[2].name %></h3>
                  <div class="top3-card__tags">
                    <% if (recipes[2].difficulty) { %>
                    <span class="djc-recette__tag djc-recette__tag--or top3-tag--xs"><%= recipes[2].difficulty %></span>
                    <% } %>
                    <% if (recipes[2].category) { %>
                    <span class="djc-recette__tag djc-recette__tag--bleu top3-tag--xs"><%= recipes[2].category %></span>
                    <% } %>
                  </div>
                  <div class="top3-card__meta">
                    <div class="top3-card__stars">
                      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                    </div>
                  </div>
                  <% if (recipes[2].description) { %><p class="top3-card__desc"><%= recipes[2].description.slice(0, 80) %>...</p><% } %>
                  <div class="top3-card__foot">
                    <% const c2 = recipes[2].contributor;
                       const c2cls = c2 && c2.role === 'admin' ? 'lvl--legend' : 'lvl--1';
                       const c2ttl = c2 && c2.role === 'admin' ? '★★★★★ Légende' : '★ Popcorn Rookie'; %>
                    <div class="lvl-badge lvl-badge--sm <%= c2cls %>">
                      <div class="lvl-av">
                        <img src="<%= c2 && c2.picture ? c2.picture : 'https://i.pravatar.cc/68?img=15' %>" alt="" loading="lazy">
                      </div>
                      <div class="lvl-info">
                        <span class="lvl-name"><%= c2 ? c2.pseudo : 'Chef Ciné Délices' %></span>
                        <span class="lvl-title"><%= c2ttl %></span>
                      </div>
                    </div>
                    <a href="/recipes-movie/details/<%= recipes[2].slug || recipes[2].id %>" class="top3-card__btn">Voir</a>
                  </div>
                </div>
              </div>
              <% } %>

              <!-- CTA participe-banner — intégrée comme card du grid -->
              <div class="top3-card top3-cta">
                <div class="top3-cta__shimmer"></div>
                <div class="top3-cta__icon-col">
                  <div class="top3-cta__icon">🎬</div>
                </div>
                <div class="top3-cta__body">
                  <span class="top3-cta__eyebrow">Contribuez</span>
                  <h3 class="top3-cta__title">Partagez<br><span>votre recette</span></h3>
                  <div class="top3-cta__stats">
                    <div class="top3-cta__stat">
                      <span class="top3-cta__stat-val"><%= totalUsers %></span>
                      <span class="top3-cta__stat-lbl">Membres</span>
                    </div>
                    <div class="top3-cta__stat-sep"></div>
                    <div class="top3-cta__stat">
                      <span class="top3-cta__stat-val"><%= totalRecipes %></span>
                      <span class="top3-cta__stat-lbl">Recettes</span>
                    </div>
                    <div class="top3-cta__stat-sep"></div>
                    <div class="top3-cta__stat">
                      <span class="top3-cta__stat-val"><%= totalMovies %></span>
                      <span class="top3-cta__stat-lbl">Films</span>
                    </div>
                  </div>
                  <div class="top3-cta__foot">
                    <a href="/add-recipes-movies/" class="top3-cta__btn">✦ Ajouter ma recette</a>
                  </div>
                </div>
              </div>

            </div>
          </div>
          <% } %>

        </div>
      </section>

      <!-- ══════════════════════════════════════════════
           COMMUNAUTÉ BAND — maquette HTML lines 2086-2260
           Left : texte statique + stats + actions
           Right : contrib-block (top contributeurs) + mini-gamif
           ══════════════════════════════════════════════ -->
      <section class="communaute-band">
        <div class="communaute-band__bg" aria-hidden="true"></div>
        <div class="wrap">
          <div class="communaute-inner">

            <!-- Gauche : texte + stats + boutons -->
            <div class="communaute-text" data-reveal="left">
              <div class="communaute-kicker">Rejoignez-nous</div>
              <h2 class="communaute-title">Cuisinez ce que<br>vous <span>regardez.</span></h2>
              <p class="communaute-desc">Ciné Délices, c'est un univers où chaque film devient une table dressée. Partagez vos créations culinaires, découvrez celles des autres, et entrez dans une communauté qui vit le cinéma avec tous ses sens.</p>
              <div class="communaute-stats">
                <div>
                  <div class="c-stat-val"><%= totalUsers %></div>
                  <div class="c-stat-label">Membres</div>
                </div>
                <div class="c-stat-sep"></div>
                <div>
                  <div class="c-stat-val"><%= totalRecipes %></div>
                  <div class="c-stat-label">Recettes</div>
                </div>
                <div class="c-stat-sep"></div>
                <div>
                  <div class="c-stat-val"><%= totalMovies %></div>
                  <div class="c-stat-label">Films liés</div>
                </div>
              </div>
              <div class="communaute-actions" data-reveal="up" style="transition-delay:.35s">
                <% if (user) { %>
                <a href="/add-recipes-movies/" class="btn btn--primary">✦ Ajouter ma recette</a>
                <% } else { %>
                <a href="#" class="js-open-login btn btn--primary">✦ Créer un compte</a>
                <% } %>
                <a href="/movies" class="btn-ghost-lg">En savoir plus →</a>
              </div>
            </div>

            <!-- Droite : top contributeurs + mini gamification -->
            <div class="communaute-right" data-reveal="right">
              <div class="contrib-block">

                <!-- Header -->
                <div>
                  <div class="contrib-header">
                    <span class="contrib-header__icon">🏆</span>
                    <div>
                      <div class="contrib-header__title">Top Contributeurs</div>
                      <div class="contrib-header__sub">Ce mois-ci · classement par recettes publiées</div>
                    </div>
                  </div>
                </div>

                <!-- Liste dynamique — top 3 contributeurs par recettes approuvées -->
                <div class="contrib-list">
                  <% const contribEmojis = ['🥇', '🎞️', '🎬']; %>
                  <% const contribAvatarImgs = [15, 47, 32]; %>
                  <% if (topContributors && topContributors.length > 0) { %>
                    <% topContributors.forEach(function(contrib, idx) { %>
                    <div class="contrib-item <%= idx === 0 ? 'contrib-item--first' : '' %>">
                      <span class="contrib-item__rank"><%= idx + 1 %></span>
                      <% if (idx === 0) { %>
                      <div class="contrib-item__avatar-wrap">
                        <svg class="contrib-item__crown" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/></svg>
                        <img class="contrib-item__avatar" src="<%= contrib.picture || 'https://i.pravatar.cc/68?img=' + contribAvatarImgs[idx] %>" alt="Top contributeur 1">
                      </div>
                      <% } else { %>
                      <img class="contrib-item__avatar" src="<%= contrib.picture || 'https://i.pravatar.cc/68?img=' + contribAvatarImgs[idx] %>" alt="Top contributeur <%= idx + 1 %>">
                      <% } %>
                      <div class="contrib-item__info">
                        <div class="contrib-item__name"><%= contrib.pseudo %></div>
                        <div class="contrib-item__meta"><%= contrib.recipe_count %> recette<%= contrib.recipe_count > 1 ? 's' : '' %></div>
                      </div>
                      <span class="contrib-item__badge-emoji"><%= contribEmojis[idx] %></span>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="contrib-item" style="justify-content:center;opacity:.6;font-size:.85rem;">
                    Aucun contributeur pour le moment.
                  </div>
                  <% } %>
                </div>

                <div class="contrib-sep"></div>

                <!-- Mini gamification — maquette lines 2225-2253 -->
                <div class="mini-gamif">
                  <div class="mini-gamif__title">Votre progression</div>
                  <div class="mini-gamif__levels">
                    <div class="mini-gamif__lvl">
                      <span class="mini-gamif__emoji">🎟️</span>
                      <span class="mini-gamif__name">Spec&shy;ta&shy;teur</span>
                    </div>
                    <span class="mini-gamif__arrow">›</span>
                    <div class="mini-gamif__lvl">
                      <span class="mini-gamif__emoji">🍿</span>
                      <span class="mini-gamif__name">Ciné&shy;phile</span>
                    </div>
                    <span class="mini-gamif__arrow">›</span>
                    <div class="mini-gamif__lvl">
                      <span class="mini-gamif__emoji">🎬</span>
                      <span class="mini-gamif__name">Cri&shy;tique</span>
                    </div>
                    <span class="mini-gamif__arrow">›</span>
                    <div class="mini-gamif__lvl">
                      <span class="mini-gamif__emoji">🎞️</span>
                      <span class="mini-gamif__name">Collec&shy;teur</span>
                    </div>
                    <span class="mini-gamif__arrow">›</span>
                    <div class="mini-gamif__lvl mini-gamif__lvl--5">
                      <span class="mini-gamif__emoji">👑</span>
                      <span class="mini-gamif__name">Maître</span>
                    </div>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <%- include("partials/footer") %>

    <!-- Scripts JS spécifiques à la page home -->
    <script src="/js/category-badges.js" defer></script>
    <script src="/js/favorites.js" defer></script>
    <script src="/js/hero-slider.js" defer></script>
  </body>
</html>
