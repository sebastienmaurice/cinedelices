<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !"
    />
    <title>Ciné Délices - Le goût du cinéma</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/home.css" />
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- BANNER -->
      <section class="banner">
        <!-- BANNER CARDS 1 -->

        <div class="banner-card">
          <img
            src="/images/harry-potter-1.png"
            alt="Harry potter"
            class="banner-img"
          />

          <div class="card-content">
            <div class="card-info">
              <div class="genre">
                <ion-icon name="film"></ion-icon>
                <span>Aventure/Fantastique</span>
              </div>

              <div class="year">
                <ion-icon name="calendar"></ion-icon>
                <span>2003</span>
              </div>

              <div class="duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 23min</span>
              </div>

              <div class="recipe-banner">Le Gâteau Étoilé</div>
            </div>
            <h2 class="card-title">Harry Potter</h2>
          </div>
        </div>
        <!-- BANNER CARDS 2 -->

        <div class="banner-card">
          <img
            src="/images/sparrow-2.jpg"
            alt="Jack Sparrow"
            class="banner-img"
          />

          <div class="card-content">
            <div class="card-info">
              <div class="genre">
                <ion-icon name="film"></ion-icon>
                <span>Action/Aventure</span>
              </div>

              <div class="year">
                <ion-icon name="calendar"></ion-icon>
                <span>2003</span>
              </div>

              <div class="duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 20min</span>
              </div>

              <div class="recipe-banner">La recette du Pélican Maudit</div>
            </div>
            <h2 class="card-title">Pirates des Caraïbes</h2>
          </div>
        </div>

        <!-- BANNER CARDS 3 -->
        <div class="banner-card">
          <img
            src="/images/commando-shwarzy-1.png"
            alt="Shwarzy-1"
            class="banner-img"
          />

          <div class="card-content">
            <div class="card-info">
              <div class="genre">
                <ion-icon name="film"></ion-icon>
                <span>Action</span>
              </div>

              <div class="year">
                <ion-icon name="calendar"></ion-icon>
                <span>2006</span>
              </div>

              <div class="duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 11min</span>
              </div>

              <div class="recipe-banner">La recette du Commando</div>
            </div>
            <h2 class="card-title">Commando</h2>
          </div>
        </div>
        <!-- FIN BANNER CARDS -->
      </section>

      <!-- RECETTE DU JOUR -->
      <section
        class="recipeofthe__day"
        id="recettes"
        role="region"
        aria-labelledby="recette-du-jour-titre"
      >
        <div class="recipeofthe__day-container">
          <!-- Colonne gauche : Recette du jour -->
          <div class="recipe-column-left">
            <div class="section-header">
              <h2 id="recette-du-jour-titre">Recette du jour</h2>
              <p class="section-subtitle">
                Le goût du cinéma et le cinéma du goût
              </p>
            </div>
            <article class="recipe-card recipe-card--left">
              <div class="recipe-image-placeholder">
                <img
                  src="/images/dessert-backtothefuture-2.jpg"
                  alt="Peach Pie de Hill Valley, dessert inspiré du film Retour vers le Futur"
                  loading="lazy"
                  width="600"
                  height="260"
                />
                <blockquote class="film-quote">
                  <p>
                    « Marty, c'est incroyable ! Ce Peach Pie est plus délicieux
                    que tout ce que j'ai jamais goûté ! On va révolutionner les
                    desserts du futur ! »
                  </p>
                  <footer><cite>— Retour vers le Futur</cite></footer>
                </blockquote>
              </div>
              <div class="recipe-info">
                <h3>Peach Pie de Hill Valley</h3>
                <p class="recipe-film">Retour vers le Futur</p>
                <p class="recipe-description">
                  Le dessert emblématique que Marty McFly savoure dans le café
                  de Hill Valley. Une tarte aux pêches caramélisées et une
                  pointe de nostalgie rétro.
                </p>
                <a
                  class="btn btn--red"
                  href="/movies"
                  aria-label="Voir la recette du Peach Pie (accéder aux films et recettes)"
                >
                  Voir la recette
                </a>
              </div>
            </article>
          </div>

          <!-- Colonnes droite : Les 2 films du jour -->
          <div class="films-columns-right">
            <div class="section-header">
              <h2>Quelques films Ciné Délices</h2>
              <p class="section-subtitle">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
                eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
                enim ad minim veniam, quis nostrud exercitation ullamco laboris.
              </p>
            </div>
            <div class="films-container">
              <!-- Première carte film -->
              <a
                href="/movies#film-1"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film Retour vers le Futur"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="/images/doc-and-marty-peach-pie-1.jpg"
                    alt="Doc et Marty savourant un Peach Pie"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3>Retour vers le Futur</h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film culte et
                    plongez dans l'univers de Marty McFly et du Doc Brown.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>

              <!-- Deuxième carte film -->
              <a
                href="/movies#film-2"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film Pirates des Caraïbes"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="/images/sparrow-2.jpg"
                    alt="Jack Sparrow dans Pirates des Caraïbes"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3>Pirates des Caraïbes</h3>
                  <p class="film-description">
                    Explorez les recettes inspirées des aventures du capitaine
                    Jack Sparrow et de son équipage de pirates légendaires.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>

              <!-- Troisième carte film -->
              <a
                href="/movies#film-3"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film Harry Potter"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="/images/harry-potter-1.png"
                    alt="Harry Potter"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3>Harry Potter</h3>
                  <p class="film-description">
                    Plongez dans l'univers magique de Poudlard avec des recettes
                    inspirées des aventures du sorcier à la cicatrice.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>

              <!-- Quatrième carte film -->
              <a
                href="/movies#film-4"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film Commando"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="/images/commando-shwarzy-1.png"
                    alt="Commando"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3>Commando</h3>
                  <p class="film-description">
                    Des recettes puissantes et énergétiques inspirées de ce film
                    d'action légendaire avec Arnold Schwarzenegger.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- TOP 3 RECETTES -->
      <section
        class="top-recettes"
        id="films"
        role="region"
        aria-labelledby="top3-titre"
      >
        <div class="section-header">
          <h2 id="top3-titre">Top 3 des recettes</h2>
          <p class="section-subtitle">
            Les incontournables du moment, tout droit venus du grand écran.
          </p>
        </div>

        <div class="top-recettes__grid">
          <!-- Carte 1 -->
          <article class="recette-card">
            <div class="recette-image">
              <img
                src="/images/croco-dundee-2.jpg"
                alt="Steak d'Outback inspiré de Crocodile Dundee"
                loading="lazy"
                width="420"
                height="220"
              />
            </div>
            <div class="recette-content">
              <h3>Steak d'Outback</h3>
              <p class="recette-film">Crocodile Dundee</p>
              <p class="recette-description">
                Un steak épais grillé à la manière australienne, servi avec une
                sauce à la bière locale et des légumes rôtis en forme de
                boomerang.
              </p>
              <a
                class="btn btn--red"
                href="/movies"
                aria-label="Voir la recette du Steak d'Outback (accéder aux films et recettes)"
              >
                Voir la recette
              </a>
            </div>
          </article>

          <!-- Carte 2 -->
          <article class="recette-card">
            <div class="recette-image">
              <img
                src="/images/kaamelott-2.png"
                alt="Soupe du roi Arthur inspirée de Kaamelott"
                loading="lazy"
                width="420"
                height="220"
              />
            </div>
            <div class="recette-content">
              <h3>Soupe du roi Arthur</h3>
              <p class="recette-film">Kaamelott</p>
              <p class="recette-description">
                Une soupe médiévale servie dans un bol en bois, garnie de
                croûtons en forme d'épée et d'herbes aromatiques de Brocéliande.
              </p>
              <a
                class="btn btn--red"
                href="/movies"
                aria-label="Voir la recette de la Soupe du roi Arthur (accéder aux films et recettes)"
              >
                Voir la recette
              </a>
            </div>
          </article>

          <!-- Carte 3 -->
          <article class="recette-card">
            <div class="recette-image">
              <img
                src="/images/sparrow-2.jpg"
                alt="Ragoût de pirate inspiré de Pirates des Caraïbes"
                loading="lazy"
                width="420"
                height="220"
              />
            </div>
            <div class="recette-content">
              <h3>Ragoût de pirate</h3>
              <p class="recette-film">Pirates des Caraïbes</p>
              <p class="recette-description">
                Ragoût de fruits de mer servi dans un mini coffre, rehaussé d'un
                soupçon de rhum caramélisé et d'épices exotiques.
              </p>
              <a
                class="btn btn--red"
                href="/movies"
                aria-label="Voir la recette du Ragoût de pirate (accéder aux films et recettes)"
              >
                Voir la recette
              </a>
            </div>
          </article>
        </div>

        <div class="center-button">
          <a
            class="btn btn--gold-special"
            href="/movies"
            aria-label="Voir tous les films"
          >
            Voir tous les films
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/popup-connexion.js" defer></script>

    <!-- Ionicons (icônes) -->
    <script
      type="module"
      src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"
    ></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"
    ></script>
  </body>
</html>
