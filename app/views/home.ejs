<!DOCTYPE html>
<html lang="fr">
<head>
  <!-- CONFIG DE BASE -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !" />
  <title>Ciné Délices - Le goût du cinéma</title>

  <!-- POLICES ET STYLES -->
  <link rel="stylesheet" href="../css/home.css" />
  <link href="https://fonts.googleapis.com/css2?family=Fascinate+Inline&family=Limelight&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
</head>

<body>
  <!-- =============================== -->
  <!-- ========== HEADER ============ -->
  <!-- =============================== -->
  <header class="header" role="banner">
    <div class="title" aria-label="Titre du site">
      🎬 <span class="title-cine">Ciné</span> <span class="title-delices">Délices</span>
    </div>

    <nav class="navigationheader" role="navigation" aria-label="Navigation principale">
      <a class="navigationheader-link" href="#accueil">Accueil</a>
      <a class="navigationheader-link" href="#films">Films</a>
      <a class="navigationheader-link" href="#ajouter">Ajouter un film</a>
    </nav>

    <div class="buttons__header">
      <button class="login" aria-label="Connexion">Connexion</button>
      <button class="registration" aria-label="Inscription">Inscription</button>
    </div>
  </header>

  <!-- =============================== -->
  <!-- ========== MAIN ============== -->
  <!-- =============================== -->
  <main>
    <!-- =============================== -->
    <!-- ========= BIENVENUE =========== -->
    <!-- =============================== -->
    <section class="welcome" id="accueil" role="region" aria-label="Section d'accueil">
      <div class="welcome-content">
        <h1>Bienvenue sur Ciné Délices</h1>
        <p>"Ciné Délices" : le goût du cinéma... et le cinéma de goût.</p>
        <button class="cta-button" aria-label="Découvrir les films">Découvrir les films</button>
      </div>
    </section>

    <!-- =============================== -->
    <!-- ========== RECETTE DU JOUR ==== -->
    <!-- =============================== -->
    <section class="recipeofthe__day" id="recettes" role="region" aria-labelledby="recette-du-jour-titre">
      <div class="section-header">
        <h2 id="recette-du-jour-titre">Recette du jour</h2>
        <p class="section-subtitle">Le goût du cinéma et le cinéma de goût</p>
      </div>

      <div class="recipeofthe__day-container">
        <!-- Carte recette à gauche -->
        <article class="recipe-card recipe-card--left">
          <div class="recipe-image-placeholder">
            <img src="../images/dessert-backtothefuture-2.jpg" alt="Peach Pie de Hill Valley, dessert inspiré du film Retour vers le Futur" />
          </div>
          <div class="recipe-info">
            <h3>Peach Pie de Hill Valley</h3>
            <p class="recipe-film">Retour vers le Futur</p>
            <p class="recipe-description">
              Le dessert emblématique que Marty McFly savoure dans le café de Hill Valley. Une tarte aux pêches caramélisées et une pointe de nostalgie rétro.
            </p>
            <button class="recipe-button" aria-label="Voir la recette du Peach Pie">Voir la recette</button>
          </div>
        </article>

        <!-- Carte film à droite avec quote -->
        <article class="recipe-card recipe-card--right">
          <div class="film-image-placeholder">
            <img class="img-default" src="../images/marty-and-doc-eating.png" alt="Doc et Marty" />
            <img class="img-hover" src="../images/doc-et-marty-2.jpg" alt="Doc et Marty alternatif" />
          </div>
          <div class="film-quote">
            <p class="cinema-quote">
              « Marty, c’est incroyable ! Ce Peach Pie est plus délicieux que tout ce que j’ai jamais goûté ! On va révolutionner les desserts du futur ! »
            </p>
            <span>— Retour vers le Futur</span>
          </div>
        </article>
      </div>
    </section>

    <!-- =============================== -->
    <!-- ========== TOP 3 RECETTES ===== -->
    <!-- =============================== -->
    <section class="top-recettes" id="films" role="region" aria-labelledby="top3-titre">
      <div class="section-header">
        <h2 id="top3-titre">Top 3 des recettes</h2>
        <p class="section-subtitle">Les incontournables du moment, tout droit venus du grand écran.</p>
      </div>

      <div class="top-recettes__grid">
        <!-- Carte 1 -->
        <article class="recette-card">
          <div class="recette-image">
            <img src="../images/croco-dundee-2.jpg" alt="Steak d'Outback inspiré de Crocodile Dundee" />
          </div>
          <div class="recette-content">
            <h3>Steak d'Outback</h3>
            <p class="recette-film">Crocodile Dundee</p>
            <p class="recette-description">
              Un steak épais grillé à la manière australienne, servi avec une sauce à la bière locale et des légumes rôtis en forme de boomerang.
            </p>
            <button class="recipe-button" aria-label="Voir la recette du Steak d'Outback">Voir la recette</button>
          </div>
        </article>

        <!-- Carte 2 -->
        <article class="recette-card">
          <div class="recette-image">
            <img src="../images/kaamelott-2.png" alt="Soupe du roi Arthur inspirée de Kaamelott" />
          </div>
          <div class="recette-content">
            <h3>Soupe du roi Arthur</h3>
            <p class="recette-film">Kaamelott</p>
            <p class="recette-description">
              Une soupe médiévale servie dans un bol en bois, garnie de croûtons en forme d’épée et d’herbes aromatiques de Brocéliande.
            </p>
            <button class="recipe-button" aria-label="Voir la recette de la Soupe du roi Arthur">Voir la recette</button>
          </div>
        </article>

        <!-- Carte 3 -->
        <article class="recette-card">
          <div class="recette-image">
            <img src="../images/sparrow-2.jpg" alt="Ragoût de pirate inspiré de Pirates des Caraïbes" />
          </div>
          <div class="recette-content">
            <h3>Ragoût de pirate</h3>
            <p class="recette-film">Pirates des Caraïbes</p>
            <p class="recette-description">
              Ragoût de fruits de mer servi dans un mini coffre, rehaussé d’un soupçon de rhum caramélisé et d’épices exotiques.
            </p>
            <button class="recipe-button" aria-label="Voir la recette du Ragoût de pirate">Voir la recette</button>
          </div>
        </article>
      </div>

      <div class="center-button">
        <button class="cta-button-secondary" aria-label="Voir tous les films">Voir tous les films</button>
      </div>
    </section>
  </main>

  <!-- =============================== -->
  <!-- ========== FOOTER ============ -->
  <!-- =============================== -->
  <footer class="footer" role="contentinfo">
    <p>🎬 Ciné Délices — Où le 7e art rencontre la gastronomie.</p>
    <nav aria-label="Liens de bas de page">
      <a href="#mentions">Mentions légales</a> |
      <a href="#contact">Contact</a> |
      <a href="#apropos">À propos</a>
    </nav>
  </footer>
</body>
</html>
