<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !"
    />
    <title>Ciné Délices - Le goût du cinéma</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/home.css" />
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- HERO SLIDER -->
      <section class="hero-slider">
        <!-- HERO SLIDER CARDS 1 -->

        <div class="hero-slider__card">
          <img
            src="<%= recipeImages[0] %>"
            alt="Harry potter"
            class="hero-slider__img"
          />

          <div class="hero-slider__content">
            <div class="hero-slider__info">
              <div class="hero-slider__genre">
                <ion-icon name="film"></ion-icon>
                <span>Aventure/Fantastique</span>
              </div>

              <div class="hero-slider__year">
                <ion-icon name="calendar"></ion-icon>
                <span>2003</span>
              </div>

              <div class="hero-slider__duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 23min</span>
              </div>

              <div class="hero-slider__recipe-badge">Le Gâteau Étoilé</div>
            </div>
            <h2 class="hero-slider__title">Harry Potter</h2>
          </div>
        </div>
        <!-- HERO SLIDER CARDS 2 -->

        <div class="hero-slider__card">
          <img
            src="<%= recipeImages[1] %>"
            alt="Jack Sparrow"
            class="hero-slider__img"
          />

          <div class="hero-slider__content">
            <div class="hero-slider__info">
              <div class="hero-slider__genre">
                <ion-icon name="film"></ion-icon>
                <span>Action/Aventure</span>
              </div>

              <div class="hero-slider__year">
                <ion-icon name="calendar"></ion-icon>
                <span>2003</span>
              </div>

              <div class="hero-slider__duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 20min</span>
              </div>

              <div class="hero-slider__recipe-badge">
                La recette du Pélican Maudit
              </div>
            </div>
            <h2 class="hero-slider__title">Pirates des Caraïbes</h2>
          </div>
        </div>

        <!-- HERO SLIDER CARDS 3 -->
        <div class="hero-slider__card">
          <img
            src="<%= recipeImages[2] %>"
            alt="Shwarzy-1"
            class="hero-slider__img"
          />

          <div class="hero-slider__content">
            <div class="hero-slider__info">
              <div class="hero-slider__genre">
                <ion-icon name="film"></ion-icon>
                <span>Action</span>
              </div>

              <div class="hero-slider__year">
                <ion-icon name="calendar"></ion-icon>
                <span>2006</span>
              </div>

              <div class="hero-slider__duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 11min</span>
              </div>

              <div class="hero-slider__recipe-badge">
                La recette du Commando
              </div>
            </div>
            <h2 class="hero-slider__title">Commando</h2>
          </div>
        </div>

        <!-- HERO SLIDER CARDS 4 -->
        <div class="hero-slider__card">
          <img
            src="<%= recipeImages[3] %>"
            alt="Maman j'ai raté l'avion"
            class="hero-slider__img"
          />

          <div class="hero-slider__content">
            <div class="hero-slider__info">
              <div class="hero-slider__genre">
                <ion-icon name="film"></ion-icon>
                <span>Comédie</span>
              </div>

              <div class="hero-slider__year">
                <ion-icon name="calendar"></ion-icon>
                <span>1990</span>
              </div>

              <div class="hero-slider__duration">
                <ion-icon name="time"></ion-icon>
                <span>2h 23min</span>
              </div>

              <div class="hero-slider__recipe-badge">la Pizza au fromage</div>
            </div>
            <h2 class="hero-slider__title">Maman j'ai raté l'avion</h2>
          </div>
        </div>
        <!-- FIN HERO SLIDER CARDS -->
      </section>

      <!-- RECETTE DU JOUR -->
      <section
        class="recipeofthe__day"
        id="recettes"
        role="region"
        aria-labelledby="recette-du-jour-titre"
      >
        <div class="recipeofthe__day-container">
          <!-- Colonne gauche : Recette du jour -->
          <div class="recipe-column-left">
            <div class="section-header">
              <h2 id="recette-du-jour-titre">Recette du jour</h2>
              <p class="section-subtitle">
                Le goût du cinéma et le cinéma du goût
              </p>
            </div>
            <article class="recipe-card recipe-card--left">
              <div class="recipe-image-placeholder">
                <img
                  src="<%= topRecipe.picture %>"
                  alt="Recette inspiré du film <%= topRecipe.Movie.title %>"
                  loading="lazy"
                  width="600"
                  height="260"
                />
                <blockquote class="film-quote">
                  <p>
                    « Marty, c'est incroyable ! Ce Peach Pie est plus délicieux
                    que tout ce que j'ai jamais goûté ! On va révolutionner les
                    desserts du futur ! »
                  </p>
                  <footer><cite>— <%= topRecipe.Movie.title %></cite></footer>
                </blockquote>
              </div>
              <div class="recipe-info">
                <h3><%= topRecipe.name %></h3>
                <p class="recipe-film"><%= topRecipe.Movie.title %></p>
                <p class="recipe-description"><%= topRecipe.description %></p>
                <a
                  class="btn btn--red"
                  href="/recipes-movie/details/<%= topRecipe.id %>"
                  aria-label="Voir la recette <%= topRecipe.name %> (accéder à la fiche recette)"
                >
                  Voir la recette
                </a>
              </div>
            </article>
          </div>

          <!-- Colonnes droite : Les 4 films du jour -->
          <div class="films-columns-right">
            <div class="section-header">
              <h2>Quelques films Ciné Délices</h2>
              <p class="section-subtitle">
                Une sélection de films et séries cultes avec leurs recettes
                inspirées. Plongez dans l'univers du cinéma et découvrez le goût
                du grand écran.
              </p>
            </div>
            <div class="films-container">
              <% if (topMovies && topMovies.length > 0) { %>
              <!-- Première carte film -->
              <% if (topMovies[0]) { %>
              <a
                href="/recipes-movie/<%= topMovies[0].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[0].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[0].picture %>"
                    alt="<%= topMovies[0].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[0].title %></h3>
                  <p class="film-description">
                    Explorez les recettes cultes inspirées de <%=
                    topMovies[0].title %> et revivez les saveurs du grand écran.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %>

              <!-- Deuxième carte film -->
              <% if (topMovies[1]) { %>
              <a
                href="/recipes-movie/<%= topMovies[1].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[1].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[1].picture %>"
                    alt="<%= topMovies[1].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[1].title %></h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film ou de
                    cette série culte et plongez vous dans l'univers de <%=
                    topMovies[1].title %>.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %>

              <!-- Troisième carte film -->
              <% if (topMovies[2]) { %>
              <a
                href="/recipes-movie/<%= topMovies[2].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[2].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[2].picture %>"
                    alt="<%= topMovies[2].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[2].title %></h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film ou de
                    cette série culte et plongez vous dans l'univers de <%=
                    topMovies[2].title %>.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %>

              <!-- Quatrième carte film -->
              <% if (topMovies[3]) { %>
              <a
                href="/recipes-movie/<%= topMovies[3].id %>"
                class="recipe-card recipe-card--right"
                aria-label="Voir le film <%= topMovies[3].title %>"
              >
                <div class="film-image-placeholder">
                  <img
                    class="img-default"
                    src="<%= topMovies[3].picture %>"
                    alt="<%= topMovies[3].title %>"
                    loading="lazy"
                    width="800"
                    height="400"
                  />
                </div>
                <div class="film-info">
                  <h3><%= topMovies[3].title %></h3>
                  <p class="film-description">
                    Découvrez toutes les recettes inspirées de ce film ou de
                    cette série culte et plongez vous dans l'univers de <%=
                    topMovies[3].title %>.
                  </p>
                  <span class="btn btn--red" aria-hidden="true">
                    Voir le film
                  </span>
                </div>
              </a>
              <% } %> <% } else { %>
              <p class="no-movies">Aucun film disponible pour le moment.</p>
              <% } %>
            </div>
          </div>
        </div>
      </section>

      <!-- TOP 3 RECETTES -->
      <section
        class="top-recettes"
        id="films"
        role="region"
        aria-labelledby="top3-titre"
      >
        <div class="section-header">
          <h2 id="top3-titre">Top 3 des recettes</h2>
          <p class="section-subtitle">
            Les recettes les plus appréciées par la communauté Ciné Délices,
            inspirées de scènes cultes du cinéma.
          </p>
        </div>

        <div class="top-recettes__grid">
          <!-- boucle sur les 3 recettes -->
          <% recipes.forEach(recipe => { %>
          <article class="recette-card">
            <div class="recette-image">
              <img
                src="<%= recipe.picture %>"
                alt="<%= recipe.name %> inspiré de <%= recipe.Movie.title %>"
                loading="lazy"
                width="420"
                height="220"
              />
            </div>
            <div class="recette-content">
              <h3><%= recipe.name %></h3>
              <p class="recette-film"><%= recipe.Movie.title %></p>
              <p class="recette-description"><%= recipe.description %></p>
              <a
                class="btn btn--red"
                href="/recipes-movie/details/<%= recipe.id %>"
                aria-label="Voir la recette <%= recipe.name %> (accéder à la fiche recette)"
              >
                Voir la recette
              </a>
            </div>
          </article>
          <% }) %>
        </div>

        <div class="center-button">
          <a
            class="btn btn--gold-special"
            href="/movies"
            aria-label="Voir tous les films"
          >
            Voir tous les films
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->

    <!-- Ionicons (icônes) -->
    <script
      type="module"
      src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"
    ></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"
    ></script>
  </body>
</html>
