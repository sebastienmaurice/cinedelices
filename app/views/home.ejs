<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !" />
    <title>Ciné Délices - Le goût du cinéma</title>
    <%- include("partials/head-resources") %>
    <!-- SEO — Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Ciné Délices" />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:title"       content="Ciné Délices — Le goût du cinéma" />
    <meta property="og:description" content="Découvrez des recettes inspirées de vos films cultes. Cuisinez comme au cinéma !" />
    <meta property="og:image"       content="<%= siteUrl %>/images/background-page.jpg" />
    <meta property="og:url"         content="<%= siteUrl %>/" />
    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="Ciné Délices — Le goût du cinéma" />
    <meta name="twitter:description" content="Découvrez des recettes inspirées de vos films cultes. Cuisinez comme au cinéma !" />
    <meta name="twitter:image"       content="<%= siteUrl %>/images/background-page.jpg" />
    <!-- Canonical -->
    <link rel="canonical" href="<%= siteUrl %>/" />
    <link rel="stylesheet" href="/css/home.css" />
  </head>

  <body>
    <%- include("partials/header") %>

    <main>

      <!-- ══════════════════════════════════════════════
           HERO — 2 slides, version maquette V2 (hero__* classes)
           Images : /images/event/  (locales)
           ══════════════════════════════════════════════ -->
      <div class="hero-wrapper">
      <div class="hero__cut-flash" aria-hidden="true"></div>
      <section class="hero" id="hero">

        <!-- SLIDE 0 : Bienvenue Ciné Délices -->
        <div class="hero__slide hero__slide--welcome" id="slide-0">
          <div class="hero__bg" id="bg-0" style="background-image:url('/images/event/hero-slide-bienvenue-bg.jpg')"></div>
          <div class="hero__overlay"></div>
          <div class="hero__vignette"></div>
          <div class="hero__fade-left"></div>
          <div class="hero__fade-right"></div>
          <img class="hero__fg hero__fg--welcome" id="fg-0" src="/images/event/hero-slide-bienvenue-foreground.png" alt="Le Passeport Ciné Délices" draggable="false">
          <span class="hero__slide-badge hero__slide-badge--welcome"><i data-lucide="sparkles" width="12" height="12" aria-hidden="true"></i> Nouveaux membres</span>
          <div class="hero__content">
            <div class="hero__eyebrow-bar">
              <div class="hero__eyebrow-line"></div>
              <div class="hero__eyebrow-text">
                <span class="hero__eyebrow-label">Ciné Délices Community</span>
                <span class="hero__eyebrow-genre">Cinéma · Gastronomie</span>
              </div>
            </div>
            <h1 class="hero__title">BIENVENUE CHEZ<em>CINÉ DÉLICES</em></h1>
            <p class="hero__sub">Votre passeport pour l'aventure cinématographique</p>
            <p class="hero__desc">Rejoignez une communauté de cinéphiles gourmands. Explorez, cuisinez et partagez les recettes inspirées du grand écran.</p>
            <div class="hero__actions">
              <a href="#" class="hero__btn-primary js-open-login"><i data-lucide="user-plus" width="13" height="13" aria-hidden="true"></i> Rejoindre la communauté</a>
              <a href="/recipes-movie" class="hero__btn-secondary">Découvrir les recettes →</a>
            </div>
          </div>
          <div class="hero__stats">
            <div class="hero__stat"><span class="hero__stat-val"><%= typeof footerStats !== 'undefined' ? footerStats.members : '—' %></span><span class="hero__stat-label">Membres</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val"><%= typeof footerStats !== 'undefined' ? footerStats.recipes : '—' %></span><span class="hero__stat-label">Recettes</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val"><%= typeof footerStats !== 'undefined' ? footerStats.films : '—' %></span><span class="hero__stat-label">Films liés</span></div>
          </div>
          <div class="hero__watermark">BIENVENUE</div>
          <div class="hero__grain"></div>
        </div>

        <!-- SLIDE 1 : Breaking Bad -->
        <div class="hero__slide" id="slide-1">
          <div class="hero__bg" id="bg-1" style="background-image:url('/images/event/hero-slide-breaking-bad-bg.jpg')"></div>
          <div class="hero__overlay"></div>
          <div class="hero__vignette"></div>
          <div class="hero__fade-left"></div>
          <div class="hero__fade-right"></div>
          <img class="hero__fg" id="fg-1" src="/images/event/hero-slide-walter-breaking-bad-foreground.png" alt="Walter White — Breaking Bad" draggable="false">
          <span class="hero__slide-badge"><i data-lucide="tv-2" width="12" height="12" aria-hidden="true"></i> Série du moment</span>
          <div class="hero__content">
            <div class="hero__eyebrow-bar">
              <div class="hero__eyebrow-line"></div>
              <div class="hero__eyebrow-text">
                <span class="hero__eyebrow-label">Sélection Ciné Délices</span>
                <span class="hero__eyebrow-genre">Drame · Thriller</span>
              </div>
            </div>
            <h1 class="hero__title">BREAKING<em>BAD</em></h1>
            <p class="hero__sub">La chimie au service des sens</p>
            <p class="hero__desc">Walter White transformait le danger en art. Nous, on transforme ses recettes en chef-d'œuvres culinaires. Say my name.</p>
            <div class="hero__actions">
              <a href="/recipes-movie/breaking-bad" class="hero__btn-primary"><i data-lucide="utensils" width="13" height="13" aria-hidden="true"></i> Voir les recettes</a>
              <a href="/movies" class="hero__btn-secondary">Fiche Série →</a>
            </div>
          </div>
          <div class="hero__stats">
            <div class="hero__stat"><span class="hero__stat-val">5.0</span><span class="hero__stat-label">Note</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">11</span><span class="hero__stat-label">Recettes</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">2008</span><span class="hero__stat-label">Année</span></div>
          </div>
          <div class="hero__watermark">BREAKING BAD</div>
          <div class="hero__grain"></div>
        </div>

        <!-- SLIDE 2 : Bienvenue Ciné Délices -->
        <!-- SLIDE 2 : Ratatouille -->
        <div class="hero__slide" id="slide-2">
          <div class="hero__bg" id="bg-2" style="background-image:url('/images/event/hero-slide-remy-paris-bg.jpg')"></div>
          <div class="hero__overlay"></div>
          <div class="hero__vignette"></div>
          <div class="hero__fade-left"></div>
          <div class="hero__fade-right"></div>
          <img class="hero__fg" id="fg-2" src="/images/event/hero-slide-remy-foreground.png" alt="Rémy — Ratatouille" draggable="false">
          <span class="hero__slide-badge"><i data-lucide="film" width="12" height="12" aria-hidden="true"></i> Film du moment</span>
          <div class="hero__content">
            <div class="hero__eyebrow-bar">
              <div class="hero__eyebrow-line"></div>
              <div class="hero__eyebrow-text">
                <span class="hero__eyebrow-label">Sélection Ciné Délices</span>
                <span class="hero__eyebrow-genre">Animation · Comédie</span>
              </div>
            </div>
            <h1 class="hero__title">REMY<em>RATATOUILLE</em></h1>
            <p class="hero__sub">Quand la cuisine rencontre l'art</p>
            <p class="hero__desc">Un rat passionné de gastronomie défie les conventions dans les cuisines parisiennes. Découvrez les recettes inspirées du chef Gusteau.</p>
            <div class="hero__actions">
              <a href="/recipes-movie/ratatouille" class="hero__btn-primary"><i data-lucide="utensils" width="13" height="13" aria-hidden="true"></i> Voir les recettes</a>
              <a href="/movies" class="hero__btn-secondary">Fiche Film →</a>
            </div>
          </div>
          <div class="hero__stats">
            <div class="hero__stat"><span class="hero__stat-val">4.9</span><span class="hero__stat-label">Note</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">18</span><span class="hero__stat-label">Recettes</span></div>
            <div class="hero__stat-sep"></div>
            <div class="hero__stat"><span class="hero__stat-val">2007</span><span class="hero__stat-label">Année</span></div>
          </div>
          <div class="hero__watermark">RATATOUILLE</div>
          <div class="hero__grain"></div>
        </div>

        <button class="hero__arrow hero__arrow--prev" id="heroPrev">‹</button>
        <button class="hero__arrow hero__arrow--next" id="heroNext">›</button>
        <div class="hero__nav">
          <button class="hero__dot" data-slide="2"></button>
          <button class="hero__dot" data-slide="1"></button>
          <button class="hero__dot" data-slide="0"></button>
          <div class="hero__counter">
            <span class="hero__counter-cur" id="heroCounterCur">01</span>
            <span class="hero__counter-sep">/</span>
            <span class="hero__counter-tot" id="heroCounterTot">03</span>
          </div>
        </div>

      </section>
      </div>
<%- include("genres-section-v3") %>


      <!-- ══════════════════════════════════════════════
           DUO DU JOUR — maquette HTML lines 1546-1672
           3 colonnes : Film (27fr) | CTA doré (30fr) | Recette (43fr)
           Film  → topMovies[0]
           Recette → topRecipe
           CTA → liens statiques (/auth/register, /add-recipes-movies/)
           ══════════════════════════════════════════════ -->
      <div class="wrap">
        <section class="duo-jour-section">
          <div class="duo-jour-header" data-reveal="up">
            <div>
              <div class="section-label">Sélection du Jour</div>
              <h2 class="section-title">Le Duo du Jour</h2>
              <p class="section-sub">Un film, une recette — l'association parfaite</p>
            </div>
            <div class="duo-jour-header__live">
              <span class="duo-jour-header__live-dot"></span>
              Mis à jour chaque jour
            </div>
          </div>

          <div class="duo-jour-grid">

            <!-- ① FILM — affiche 2:3 cadrée — film du duo (lié à topRecipe) -->
            <% if (duoFilm) { %>
            <a href="/recipes-movie/<%= duoFilm.slug || duoFilm.id %>" class="djc-film" data-reveal="left" aria-label="Voir les recettes de <%= duoFilm.title %>">
              <img class="djc-film__img" src="<%= duoFilm.cardPath || duoFilm.picture %>" alt="Affiche <%= duoFilm.title %>" loading="lazy">
              <div class="djc-film__overlay"></div>
              <!-- Hover CTA — icon doré centré -->
              <div class="djc-film__hover-cta" aria-hidden="true">
                <div class="cd-icon-btn">
                  <div class="cd-icon-btn__wrap">
                    <span class="cd-icon-btn__ring"></span>
                    <span class="cd-icon-btn__bg">
                      <i data-lucide="film" width="18" height="18" aria-hidden="true"></i>
                    </span>
                  </div>
                  <span class="cd-icon-btn__label">Voir les recettes</span>
                </div>
              </div>
              <div class="djc-film__top">
                <span class="djc-film__badge"><i data-lucide="film" width="11" height="11" aria-hidden="true"></i> Film</span>
                <button class="djc-film__fav btn-fav" data-entity-id="<%= duoFilm.id %>" data-entity-type="movie" aria-label="Ajouter aux favoris">♡</button>
              </div>
              <div class="djc-film__bottom">
                <div class="djc-film__tags">
                  <% if (duoFilm.genre) { %>
                  <span class="tag tag--genre-cinema"><%= duoFilm.genre.split(',')[0].trim() %></span>
                  <% } %>
                </div>
                <span class="djc-film__title"><%= duoFilm.title %></span>
                <% if (duoFilm.year) { %><span class="djc-film__sub"><%= duoFilm.year %></span><% } %>
                <div class="djc-film__meta">
                  <div class="djc-film__stars">
                    <% const dfStars = Math.min(Math.max(Math.round(duoFilm.quote || 0), 0), 5); %>
                    <% for (let s=1; s<=5; s++) { %><span class="<%= s > dfStars ? 'star-e' : '' %>">★</span><% } %>
                  </div>
                  <% if (duoFilm.recipeCount) { %>
                  <span class="djc-film__count"><i data-lucide="utensils" width="11" height="11" aria-hidden="true"></i> <%= duoFilm.recipeCount %> recette<%= duoFilm.recipeCount > 1 ? 's' : '' %></span>
                  <% } %>
                </div>
              </div>
            </a>
            <% } %>

            <!-- ② CTA DORÉ — wrapper colonne : Golden Ticket + texte explicatif -->
            <div class="djc-cta-col">

              <!-- Golden Ticket -->
              <div class="djc-cta" data-reveal="up">
              <div class="djc-cta__shimmer"></div>
              <div>
                <div class="djc-cta__eyebrow">Rejoignez la communauté</div>
              </div>
              <div>
                <h3 class="djc-cta__title">CUISINEZ<em>CE QUE<br>VOUS AIMEZ.</em></h3>
              </div>
              <p class="djc-cta__desc">Partagez vos recettes inspirées du grand écran et rejoignez des milliers de cinéphiles gourmands.</p>
              <div class="djc-cta__stats">
                <div class="djc-cta__stat">
                  <span class="djc-cta__stat-val"><%= totalUsers %></span>
                  <span class="djc-cta__stat-lbl">Membres</span>
                </div>
                <div class="djc-cta__stat-sep"></div>
                <div class="djc-cta__stat">
                  <span class="djc-cta__stat-val"><%= totalRecipes %></span>
                  <span class="djc-cta__stat-lbl">Recettes</span>
                </div>
                <div class="djc-cta__stat-sep"></div>
                <div class="djc-cta__stat">
                  <span class="djc-cta__stat-val"><%= totalMovies %></span>
                  <span class="djc-cta__stat-lbl">Films liés</span>
                </div>
              </div>
              <div class="djc-cta__btns">
                <% if (typeof role === 'undefined') { %>
                <button type="button" class="djc-cta__btn-primary js-open-register">✦ Créer un compte</button>
                <button type="button" class="djc-cta__btn-secondary js-open-login" data-login-hint="Connectez-vous pour ajouter votre recette"><i data-lucide="utensils" width="13" height="13" aria-hidden="true"></i> Ajouter ma recette</button>
                <% } else { %>
                <a href="/add-recipes-movies/" class="djc-cta__btn-primary"><i data-lucide="utensils" width="13" height="13" aria-hidden="true"></i> Ajouter ma recette</a>
                <% } %>
                <div class="djc-cta__membres">
                  <% [0,1,2].forEach(function(i) { %>
                    <% const tc = topContributors && topContributors[i]; %>
                    <img src="<%= tc && tc.picture ? tc.picture : '/images/image-default-profile.jpg' %>" alt="" class="djc-cta__av" loading="lazy">
                  <% }); %>
                  <span class="djc-cta__av-txt">+<%= totalUsers %> membres actifs</span>
                </div>
              </div>
            </div><!-- /.djc-cta -->

              <!-- Texte explicatif sous la card dorée -->
              <div class="djc-explain">
                <div class="djc-explain__label">Comment ça marche ?</div>
                <p class="djc-explain__text">
                  Chaque jour, Ciné Délices sélectionne un film et une recette qui s'accordent parfaitement.
                  Le duo est renouvelé quotidiennement pour vous proposer de nouvelles associations culinaires inspirées du grand écran.
                </p>
                <a href="/movies" class="djc-explain__link">Explorer tous les films →</a>
              </div>

            </div><!-- /.djc-cta-col -->

            <!-- ③ RECETTE — format 3:2 — topRecipe — maquette lines 1626-1668 -->
            <% if (topRecipe) { %>
            <div class="djc-recette" data-reveal="right">
              <!-- Stretched link -->
              <a href="/recipes-movie/details/<%= topRecipe.slug || topRecipe.id %>" class="djc-recette__link" aria-label="Voir la recette <%= topRecipe.name %>"></a>
              <div class="djc-recette__img-wrap">
                <img class="djc-recette__img" src="<%= topRecipe.picture %>" alt="<%= topRecipe.name %>" loading="lazy">
                <div class="djc-recette__img-overlay"></div>
                <!-- Overlay hover doré — centré sur l'image -->
                <div class="cd-hover-overlay">
                  <div class="cd-icon-btn">
                    <div class="cd-icon-btn__wrap">
                      <span class="cd-icon-btn__ring"></span>
                      <span class="cd-icon-btn__bg">
                        <i data-lucide="utensils" width="18" height="18" aria-hidden="true"></i>
                      </span>
                    </div>
                    <span class="cd-icon-btn__label">Voir la recette</span>
                  </div>
                </div>
                <div class="djc-recette__img-bottom">
                  <span class="djc-recette__film-badge"><i data-lucide="film" width="11" height="11" aria-hidden="true"></i> <%= topRecipe.Movie ? topRecipe.Movie.title : 'Film inconnu' %></span>
                </div>
              </div>
              <div class="djc-recette__body">
                <h3 class="djc-recette__title"><%= topRecipe.name %></h3>
                <div class="djc-recette__tags">
                  <span class="tag tag--or"><%= topRecipe.difficulty || 'Moyen' %></span>
                  <% if (topRecipe.category) { %>
                  <span class="tag tag--recette-cat"><%= topRecipe.category %></span>
                  <% } %>
                </div>
                <div class="djc-recette__meta">
                  <div class="djc-recette__stars">
                    <% const trStars = Math.min(Math.max(Math.round(topRecipe.quote || 0), 0), 5); %>
                    <% for (let s=1; s<=5; s++) { %><span class="<%= s > trStars ? 'star-e' : '' %>">★</span><% } %>
                  </div>
                  <div class="djc-recette__infos">
                    <% if (topRecipe.time) { %><span><i data-lucide="clock" width="11" height="11" aria-hidden="true"></i> <%= topRecipe.time %> min</span><% } %>
                    <% if (topRecipe.servings) { %><span><i data-lucide="users" width="11" height="11" aria-hidden="true"></i> <%= topRecipe.servings %> pers.</span><% } %>
                  </div>
                </div>
              </div>
              <!-- Footer hors du body -->
              <div class="djc-recette__foot">
                <% const trContrib = topRecipe.contributor;
                   const trIsStaff = trContrib && (trContrib.role === 'admin' || trContrib.role === 'superadmin'); %>
                <div class="contrib <%= trIsStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                  <div class="contrib__av"><img src="<%= trContrib && trContrib.picture ? trContrib.picture : '/images/image-default-profile.jpg' %>" alt="<%= trContrib ? trContrib.pseudo : 'Chef' %>" loading="lazy"></div>
                  <div class="contrib__info">
                    <span class="contrib__pseudo"><%= trContrib ? trContrib.pseudo : 'Chef Ciné Délices' %></span>
                    <span class="contrib__pill <%= trIsStaff ? 'contrib__pill--admin' : 'contrib__pill--membre' %>"><span class="contrib__pill-dot"></span><%= trIsStaff ? 'Ciné Délices' : 'Membre' %></span>
                  </div>
                </div>
                <button
                  class="btn-fav"
                  data-entity-id="<%= topRecipe.id %>"
                  data-entity-type="recipe"
                  data-is-favorite="<%= topRecipe.isFavorite || false %>"
                  aria-label="<%= topRecipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                  title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (topRecipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
                >
                  <i data-lucide="heart" class="icon" fill="<%= topRecipe.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <% } %>

          </div>
        </section>
      </div>

      <!-- ══════════════════════════════════════════════
           TOP 3 RECETTES — maquette HTML lines 1976-2084
           recipes[0] → featured #1
           recipes[1] → card #2
           recipes[2] → card #3
           ══════════════════════════════════════════════ -->
      <section class="top-recettes-section" id="films" role="region" aria-labelledby="top3-titre">
        <div class="wrap">
          <div class="top3-section-header">
            <div data-reveal="left">
              <div class="section-label">Les incontournables</div>
              <h2 id="top3-titre" class="section-title">Top 3 Recettes</h2>
              <p class="section-sub" style="margin-bottom:0">Les meilleures recettes inspirées du grand écran</p>
            </div>
            <a href="/recipes-movie/" class="genres-see-all" data-reveal="right">Voir toutes les recettes</a>
          </div>

          <% if (recipes && recipes.length > 0) { %>
          <div class="top3-layout bento" data-reveal-stagger>

            <!-- ① HERO : featured #1 — col 1, row 1+2 -->
              <% if (recipes[0]) { %>
              <div class="top3-featured bento__cell cell--hero">
                <!-- Stretched link -->
                <a href="/recipes-movie/details/<%= recipes[0].slug || recipes[0].id %>" class="top3-featured__link" aria-label="Voir la recette <%= recipes[0].name %>"></a>
                <div class="top3-featured__img-wrap">
                  <img class="top3-featured__img" src="<%= recipes[0].picture %>" alt="<%= recipes[0].name %>" loading="lazy">
                  <div class="top3-featured__overlay"></div>
                  <!-- Overlay hover doré — centré sur l'image -->
                  <div class="cd-hover-overlay">
                    <div class="cd-icon-btn">
                      <div class="cd-icon-btn__wrap">
                        <span class="cd-icon-btn__ring"></span>
                        <span class="cd-icon-btn__bg">
                          <i data-lucide="utensils" width="18" height="18" aria-hidden="true"></i>
                        </span>
                      </div>
                      <span class="cd-icon-btn__label">Voir la recette</span>
                    </div>
                  </div>
                  <div class="top3-featured__medal">1</div>
                  <span class="top3-featured__film-badge"><i data-lucide="film" width="11" height="11" aria-hidden="true"></i> <%= recipes[0].Movie ? recipes[0].Movie.title : 'Film inconnu' %></span>
                </div>
                <div class="top3-featured__body">
                  <span class="top3-featured__eyebrow"><i data-lucide="trophy" width="12" height="12" aria-hidden="true"></i> Recette n°1 de la communauté</span>
                  <h3 class="top3-featured__title"><%= recipes[0].name %></h3>
                  <div class="top3-featured__tags">
                    <% if (recipes[0].difficulty) { %>
                    <span class="tag tag--or top3-tag--sm"><%= recipes[0].difficulty %></span>
                    <% } %>
                    <% if (recipes[0].category) { %>
                    <span class="tag tag--recette-cat top3-tag--sm"><%= recipes[0].category %></span>
                    <% } %>
                  </div>
                  <div class="top3-featured__meta">
                    <div class="top3-featured__stars">
                      <% const r0Stars = Math.min(Math.max(Math.round(recipes[0].quote || 0), 0), 5); %>
                      <% for (let s=1; s<=5; s++) { %><span class="<%= s > r0Stars ? 'star-e' : '' %>">★</span><% } %>
                    </div>
                    <div class="top3-featured__infos">
                      <% if (recipes[0].time) { %><span><i data-lucide="clock" width="11" height="11" aria-hidden="true"></i> <%= recipes[0].time %> min</span><% } %>
                      <% if (recipes[0].servings) { %><span><i data-lucide="users" width="11" height="11" aria-hidden="true"></i> <%= recipes[0].servings %> pers.</span><% } %>
                    </div>
                  </div>
                  <% if (recipes[0].description) { %>
                  <p class="top3-featured__desc"><%= recipes[0].description %></p>
                  <% } %>
                </div>
              <!-- Footer hors du body -->
              <div class="top3-featured__foot">
                <% const c0 = recipes[0].contributor;
                   const c0isStaff = c0 && (c0.role === 'admin' || c0.role === 'superadmin'); %>
                <div class="contrib <%= c0isStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                  <div class="contrib__av"><img src="<%= c0 && c0.picture ? c0.picture : '/images/image-default-profile.jpg' %>" alt="" loading="lazy"></div>
                  <div class="contrib__info">
                    <span class="contrib__pseudo"><%= c0 ? c0.pseudo : 'Chef Ciné Délices' %></span>
                    <span class="contrib__pill <%= c0isStaff ? 'contrib__pill--admin' : 'contrib__pill--membre' %>"><span class="contrib__pill-dot"></span><%= c0isStaff ? 'Ciné Délices' : 'Membre' %></span>
                  </div>
                </div>
                <button
                  class="btn-fav"
                  data-entity-id="<%= recipes[0].id %>"
                  data-entity-type="recipe"
                  data-is-favorite="<%= recipes[0].isFavorite || false %>"
                  aria-label="<%= recipes[0].isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                  title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipes[0].isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
                >
                  <i data-lucide="heart" class="icon" fill="<%= recipes[0].isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></i>
                </button>
              </div>
            </div>
              <% } %>

            <!-- ② VERTICAL : card #2 — col 2, row 1 -->
              <% if (recipes[1]) { %>
              <div class="top3-card bento__cell cell--vertical">
                <!-- Stretched link -->
                <a href="/recipes-movie/details/<%= recipes[1].slug || recipes[1].id %>" class="top3-card__link" aria-label="Voir la recette <%= recipes[1].name %>"></a>
                <div class="top3-card__img-wrap">
                  <img class="top3-card__img" src="<%= recipes[1].picture %>" alt="<%= recipes[1].name %>" loading="lazy">
                  <div class="top3-card__overlay"></div>
                  <!-- Overlay hover doré — centré sur l'image -->
                  <div class="cd-hover-overlay">
                    <div class="cd-icon-btn">
                      <div class="cd-icon-btn__wrap">
                        <span class="cd-icon-btn__ring"></span>
                        <span class="cd-icon-btn__bg">
                          <i data-lucide="utensils" width="18" height="18" aria-hidden="true"></i>
                        </span>
                      </div>
                      <span class="cd-icon-btn__label">Voir la recette</span>
                    </div>
                  </div>
                  <div class="top3-card__medal top3-card__medal--2">2</div>
                  <span class="top3-card__film-badge"><i data-lucide="film" width="10" height="10" aria-hidden="true"></i> <%= recipes[1].Movie ? recipes[1].Movie.title : 'Film inconnu' %></span>
                </div>
                <div class="top3-card__body">
                  <h3 class="top3-card__title"><%= recipes[1].name %></h3>
                  <div class="top3-card__tags">
                    <% if (recipes[1].difficulty) { %>
                    <span class="tag tag--or top3-tag--xs"><%= recipes[1].difficulty %></span>
                    <% } %>
                    <% if (recipes[1].category) { %>
                    <span class="tag tag--recette-cat top3-tag--xs"><%= recipes[1].category %></span>
                    <% } %>
                  </div>
                  <div class="top3-card__meta">
                    <div class="top3-card__stars">
                      <% const r1Stars = Math.min(Math.max(Math.round(recipes[1].quote || 0), 0), 5); %>
                      <% for (let s=1; s<=5; s++) { %><span class="<%= s > r1Stars ? 'star-e' : '' %>">★</span><% } %>
                    </div>
                  </div>
                  <% if (recipes[1].description) { %><p class="top3-card__desc"><%= recipes[1].description %></p><% } %>
                </div>
              <!-- Footer hors du body -->
              <div class="top3-card__foot">
                <% const c1 = recipes[1].contributor;
                   const c1isStaff = c1 && (c1.role === 'admin' || c1.role === 'superadmin'); %>
                <div class="contrib <%= c1isStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                  <div class="contrib__av"><img src="<%= c1 && c1.picture ? c1.picture : '/images/image-default-profile.jpg' %>" alt="" loading="lazy"></div>
                  <div class="contrib__info">
                    <span class="contrib__pseudo"><%= c1 ? c1.pseudo : 'Chef Ciné Délices' %></span>
                    <span class="contrib__pill <%= c1isStaff ? 'contrib__pill--admin' : 'contrib__pill--membre' %>"><span class="contrib__pill-dot"></span><%= c1isStaff ? 'Ciné Délices' : 'Membre' %></span>
                  </div>
                </div>
                <button class="btn-fav" data-entity-id="<%= recipes[1].id %>" data-entity-type="recipe" data-is-favorite="<%= recipes[1].isFavorite || false %>" aria-label="<%= recipes[1].isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>" title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipes[1].isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>">
                  <i data-lucide="heart" class="icon" fill="<%= recipes[1].isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></i>
                </button>
              </div>
            </div>
              <% } %>

              <!-- ③ VERTICAL : card #3 — col 3, row 1 -->
              <% if (recipes[2]) { %>
              <div class="top3-card bento__cell cell--vertical">
                <!-- Stretched link -->
                <a href="/recipes-movie/details/<%= recipes[2].slug || recipes[2].id %>" class="top3-card__link" aria-label="Voir la recette <%= recipes[2].name %>"></a>
                <div class="top3-card__img-wrap">
                  <img class="top3-card__img" src="<%= recipes[2].picture %>" alt="<%= recipes[2].name %>" loading="lazy">
                  <div class="top3-card__overlay"></div>
                  <!-- Overlay hover doré — centré sur l'image -->
                  <div class="cd-hover-overlay">
                    <div class="cd-icon-btn">
                      <div class="cd-icon-btn__wrap">
                        <span class="cd-icon-btn__ring"></span>
                        <span class="cd-icon-btn__bg">
                          <i data-lucide="utensils" width="18" height="18" aria-hidden="true"></i>
                        </span>
                      </div>
                      <span class="cd-icon-btn__label">Voir la recette</span>
                    </div>
                  </div>
                  <div class="top3-card__medal top3-card__medal--3">3</div>
                  <span class="top3-card__film-badge"><i data-lucide="film" width="10" height="10" aria-hidden="true"></i> <%= recipes[2].Movie ? recipes[2].Movie.title : 'Film inconnu' %></span>
                </div>
                <div class="top3-card__body">
                  <h3 class="top3-card__title"><%= recipes[2].name %></h3>
                  <div class="top3-card__tags">
                    <% if (recipes[2].difficulty) { %>
                    <span class="tag tag--or top3-tag--xs"><%= recipes[2].difficulty %></span>
                    <% } %>
                    <% if (recipes[2].category) { %>
                    <span class="tag tag--recette-cat top3-tag--xs"><%= recipes[2].category %></span>
                    <% } %>
                  </div>
                  <div class="top3-card__meta">
                    <div class="top3-card__stars">
                      <% const r2Stars = Math.min(Math.max(Math.round(recipes[2].quote || 0), 0), 5); %>
                      <% for (let s=1; s<=5; s++) { %><span class="<%= s > r2Stars ? 'star-e' : '' %>">★</span><% } %>
                    </div>
                  </div>
                  <% if (recipes[2].description) { %><p class="top3-card__desc"><%= recipes[2].description %></p><% } %>
                </div>
              <!-- Footer hors du body -->
              <div class="top3-card__foot">
                <% const c2 = recipes[2].contributor;
                   const c2isStaff = c2 && (c2.role === 'admin' || c2.role === 'superadmin'); %>
                <div class="contrib <%= c2isStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                  <div class="contrib__av"><img src="<%= c2 && c2.picture ? c2.picture : '/images/image-default-profile.jpg' %>" alt="" loading="lazy"></div>
                  <div class="contrib__info">
                    <span class="contrib__pseudo"><%= c2 ? c2.pseudo : 'Chef Ciné Délices' %></span>
                    <span class="contrib__pill <%= c2isStaff ? 'contrib__pill--admin' : 'contrib__pill--membre' %>"><span class="contrib__pill-dot"></span><%= c2isStaff ? 'Ciné Délices' : 'Membre' %></span>
                  </div>
                </div>
                <button class="btn-fav" data-entity-id="<%= recipes[2].id %>" data-entity-type="recipe" data-is-favorite="<%= recipes[2].isFavorite || false %>" aria-label="<%= recipes[2].isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>" title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipes[2].isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>">
                  <i data-lucide="heart" class="icon" fill="<%= recipes[2].isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></i>
                </button>
              </div>
            </div>
              <% } %>

              <!-- ④ CTA DORÉ — col 2-3, row 2 -->
              <div class="top3-card top3-cta bento__cell cell--cta">
                <div class="top3-cta__shimmer"></div>
                <div class="top3-cta__icon-col">
                  <img class="top3-cta__img" src="/images/top3-cta-img-card-gold.jpg" alt="" loading="lazy">
                  <div class="top3-cta__img-overlay"></div>
                </div>
                <div class="top3-cta__body">
                  <span class="top3-cta__eyebrow">Contribuez</span>
                  <h3 class="top3-cta__title">Partagez<br><span>votre recette</span></h3>
                  <p class="top3-cta__tagline">Votre recette pourrait figurer dans ce top. Partagez votre création inspirée du grand écran et faites voter la communauté.</p>
                  <div class="top3-cta__foot">
                    <% if (typeof userId !== 'undefined' && userId) { %>
                    <a href="/add-recipes-movies/" class="top3-cta__btn">✦ Ajouter ma recette</a>
                    <% } else { %>
                    <a href="#" class="top3-cta__btn js-open-login">✦ Ajouter ma recette</a>
                    <% } %>
                  </div>
                </div>
              </div>

          </div>
          <% } %>

        </div>
      </section>

    </main>

    <%- include("partials/footer") %>

    <!-- Scripts JS spécifiques à la page home -->
    <script src="/js/category-badges.js" defer></script>
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>
    <script src="/js/hero-slider.js" defer></script>
  </body>
</html>
