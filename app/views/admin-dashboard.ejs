          <!-- Sous-panel : Photos de profil -->
          <div class="sub-panel is-active" id="profils-photos">
            <% if (!pendingProfilePhotos || pendingProfilePhotos.length === 0) { %>
            <div class="empty-state">
              <i data-lucide="check" width="48" height="48" stroke-width="1.5" aria-hidden="true"></i>
              <p>Aucune photo de profil en attente de validation.</p>
            </div>
            <% } else { %>
            <div class="media-approval-grid">
              <% pendingProfilePhotos.forEach(function(photo) { %>
              <div class="media-card">
                <div class="media-card__img-wrap">
                  <img src="<%= photo.pending_picture %>" alt="Photo de profil" class="media-card__img" />
                </div>
                <div class="media-card__body">
                  <p class="media-card__user"><%= photo.pseudo || photo.username || 'Utilisateur inconnu' %></p>
                  <span class="badge-status badge-status--pending">En attente</span>
                </div>
                <div class="media-card__actions">
                  <form action="/admin/users/<%= photo.id %>/photo/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve">
                      <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                      <span>Valider</span>
                    </button>
                  </form>
                  <form action="/admin/users/<%= photo.id %>/photo/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject">
                      <i data-lucide="x" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                      <span>Refuser</span>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Sous-panel : Bannières -->
          <div class="sub-panel" id="profils-bannieres">
            <% if (!pendingBanners || pendingBanners.length === 0) { %>
            <div class="empty-state">
              <i data-lucide="check" width="48" height="48" stroke-width="1.5" aria-hidden="true"></i>
              <p>Aucune bannière en attente de validation.</p>
            </div>
            <% } else { %>
            <div class="media-approval-grid media-approval-grid--wide">
              <% pendingBanners.forEach(function(banner) { %>
              <div class="media-card media-card--banner">
                <div class="media-card__img-wrap media-card__img-wrap--banner">
                  <img src="<%= banner.pending_banner_image %>" alt="Bannière" class="media-card__img" />
                </div>
                <div class="media-card__body">
                  <p class="media-card__user"><%= banner.pseudo || 'Utilisateur inconnu' %></p>
                  <span class="badge-status badge-status--pending">En attente</span>
                </div>
                <div class="media-card__actions">
                  <form action="/admin/users/<%= banner.id %>/banner/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve">
                      <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                      <span>Valider</span>
                    </button>
                  </form>
                  <form action="/admin/users/<%= banner.id %>/banner/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject">
                      <i data-lucide="x" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                      <span>Refuser</span>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Sous-panel : Pseudos -->
          <div class="sub-panel" id="profils-pseudos">
            <% const pendingPseudosList = users ? users.filter(u => u.pending_pseudo && u.pseudo_status === 'pending') : []; %>
            <% if (pendingPseudosList.length === 0) { %>
            <div class="empty-state">
              <i data-lucide="check" width="48" height="48" stroke-width="1.5" aria-hidden="true"></i>
              <p>Aucun pseudo en attente de validation.</p>
            </div>
            <% } else { %>
            <div class="media-approval-grid">
              <% pendingPseudosList.forEach(function(u) { %>
              <div class="media-card pseudo-card">
                <div class="pseudo-card__header">
                  <span class="pseudo-card__username"><%= u.username || u.pseudo %></span>
                  <span class="badge-status badge-status--pending">En attente</span>
                </div>
                <div class="pseudo-card__change">
                  <div class="pseudo-card__value">
                    <span class="pseudo-card__label">Actuel</span>
                    <strong class="pseudo-card__name"><%= u.pseudo %></strong>
                  </div>
                  <i data-lucide="arrow-right" class="pseudo-card__arrow" width="16" height="16" aria-hidden="true"></i>
                  <div class="pseudo-card__value">
                    <span class="pseudo-card__label">Demandé</span>
                    <strong class="pseudo-card__name pseudo-card__name--new"><%= u.pending_pseudo %></strong>
                  </div>
                </div>
                <div class="media-card__actions">
                  <form action="/admin/users/<%= u.id %>/pseudo/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve">
                      <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                      <span>Valider</span>
                    </button>
                  </form>
                  <form action="/admin/users/<%= u.id %>/pseudo/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject">
                      <i data-lucide="x" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                      <span>Refuser</span>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — PHOTOS RECETTES
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="photos-recettes">
          <div class="page-header">
            <h1 class="page-header__title">Photos de recettes</h1>
            <p class="page-header__sub">Modération des photos complémentaires soumises avec les recettes.</p>
          </div>

          <% if (!pendingRecipePictures || pendingRecipePictures.length === 0) { %>
          <div class="empty-state">
            <i data-lucide="check" width="48" height="48" stroke-width="1.5" aria-hidden="true"></i>
            <p>Aucune photo de recette en attente de modération.</p>
          </div>
          <% } else { %>
          <div class="media-approval-grid">
            <% pendingRecipePictures.forEach(function(pic) { %>
            <div class="media-card">
              <div class="media-card__img-wrap">
                <img src="<%= pic.file_path %>" alt="Photo recette" class="media-card__img" data-lightbox-trigger data-lightbox-src="<%= pic.file_path %>" data-lightbox-alt="Photo recette" />
              </div>
              <div class="media-card__body">
                <% if (pic.Recipe) { %>
                <p class="media-card__user"><%= pic.Recipe.name %></p>
                <% if (pic.Recipe.contributor) { %><span class="mod-row__user">par <%= pic.Recipe.contributor.pseudo %></span><% } %>
                <% } %>
                <span class="badge-status badge-status--pending">En attente</span>
                <span class="tag" style="margin-left:4px;">Photo <%= pic.position %></span>
              </div>
              <div class="media-card__actions">
                <form action="/admin/recipe-pictures/<%= pic.id %>/approve" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--approve">
                    <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    <span>Valider</span>
                  </button>
                </form>
                <form action="/admin/recipe-pictures/<%= pic.id %>/delete" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--reject">
                    <i data-lucide="x" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    <span>Refuser</span>
                  </button>
                </form>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — UTILISATEURS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="utilisateurs">
          <div class="page-header">
            <h1 class="page-header__title">Utilisateurs</h1>
            <p class="page-header__sub">Gestion et modération des membres de la communauté.</p>
            <button type="button" class="act-btn act-btn--approve" data-create-user style="margin-left:auto;">
              <i data-lucide="plus" width="14" height="14" stroke-width="2.5" aria-hidden="true"></i>
              <span>Créer un utilisateur</span>
            </button>
          </div>

          <div class="filter-bar">
            <input type="text" class="filter-bar__search" placeholder="Rechercher un utilisateur…" data-filter-input="utilisateurs" />
          </div>

          <%
            const roleBadgeMap = {
              super_admin: { label: 'Super Admin', cls: 'tag--superadmin', color: 'rgba(200,100,255,.9)' },
              superadmin:  { label: 'Super Admin', cls: 'tag--superadmin', color: 'rgba(200,100,255,.9)' },
              admin:       { label: 'Admin',       cls: 'tag--admin',       color: 'rgba(196,160,82,.9)' },
              editor:      { label: 'Éditeur',     cls: 'tag--editor',      color: 'rgba(80,150,255,.9)' },
              user:        { label: 'Membre',      cls: 'tag--user',        color: 'rgba(160,200,130,.8)' },
            };
            const staffUsers   = users ? users.filter(u => ['super_admin','superadmin','admin','editor'].includes(u.role))
                                               .sort((a,b) => (['super_admin','superadmin','admin','editor'].indexOf(a.role)) - (['super_admin','superadmin','admin','editor'].indexOf(b.role))) : [];
            const memberUsers  = users ? users.filter(u => u.role === 'user' || !u.role) : [];
          %>

          <%
            /* ── Macro : rendu d'une ligne utilisateur ── */
            function userRow(user) {
              const badge = roleBadgeMap[user.role] || roleBadgeMap.user;
              return '';
            }
          %>

          <% if (!users || users.length === 0) { %>
          <div class="empty-state"><p>Aucun utilisateur inscrit.</p></div>
          <% } else { %>

          <!-- ── Section Équipe / Staff ── -->
          <% if (staffUsers.length > 0) { %>
          <h2 class="ctable-section-title">
            <i data-lucide="layers" width="13" height="13" aria-hidden="true"></i>
            Équipe &amp; Administration
          </h2>
          <div class="ctable-wrap" style="margin-bottom:28px;">
          <table class="ctable">
            <thead><tr>
              <th>Pseudo</th><th>Email</th><th>Rôle</th><th>Statut</th><th>Inscrit le</th><th>Actions</th>
            </tr></thead>
            <tbody>
              <% staffUsers.forEach(function(user) { %>
              <% const badge = roleBadgeMap[user.role] || roleBadgeMap.user; %>
              <tr class="admin-list-item" data-search="<%= (user.pseudo || '').toLowerCase() + ' ' + (user.email || '').toLowerCase() %>">
                <td class="user-cell">
                  <div class="user-cell__inner">
                    <% if (user.picture) { %><img src="<%= user.picture %>" alt="" class="user-cell__avatar" /><% } %>
                    <span><%= user.pseudo || '—' %></span>
                  </div>
                </td>
                <td style="font-size:.68rem; color:rgba(255,255,255,.55);"><%= user.email || '—' %></td>
                <td>
                  <select class="tag" style="background:transparent; border:1px solid rgba(255,255,255,.1); color:<%= badge.color %>; font-size:.6rem; padding:2px 6px; border-radius:4px; cursor:pointer;"
                    data-user-role-select="<%= user.id %>">
                    <option value="user"       <%= user.role === 'user'       ? 'selected' : '' %>>Membre</option>
                    <option value="editor"     <%= user.role === 'editor'     ? 'selected' : '' %>>Éditeur</option>
                    <option value="admin"      <%= user.role === 'admin'      ? 'selected' : '' %>>Admin</option>
                    <option value="superadmin" <%= user.role === 'superadmin' ? 'selected' : '' %>>Super Admin</option>
                  </select>
                </td>
                <td>
                  <% if (user.suspended) { %>
                  <span class="badge-status badge-status--rejected" style="font-size:.58rem;">Suspendu</span>
                  <% } else { %>
                  <span style="font-size:.6rem; color:rgba(100,200,130,.7);">Actif</span>
                  <% } %>
                </td>
                <td class="date-cell"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('fr-FR') : '—' %></td>
                <td class="actions-cell">
                  <button type="button" class="act-btn act-btn--edit act-btn--sm" title="Modifier"
                    data-edit-user-id="<%= user.id %>"
                    data-edit-user-pseudo="<%= user.pseudo || '' %>"
                    data-edit-user-email="<%= user.email || '' %>"
                    data-edit-user-role="<%= user.role || 'user' %>">
                    <i data-lucide="square-pen" width="13" height="13" aria-hidden="true"></i>
                  </button>
                  <% if (user.suspended) { %>
                  <form action="/admin/users/<%= user.id %>/unsuspend" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Réactiver">
                      <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    </button>
                  </form>
                  <% } else if (user.role !== 'superadmin') { %>
                  <button type="button" class="act-btn act-btn--ban act-btn--sm" title="Suspendre"
                    data-suspend-user-id="<%= user.id %>"
                    data-suspend-user-pseudo="<%= user.pseudo || '' %>">
                    <i data-lucide="ban" width="13" height="13" aria-hidden="true"></i>
                  </button>
                  <% } %>
                  <% if (user.role !== 'superadmin') { %>
                  <form action="/admin/deleteUser/<%= user.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                      <i data-lucide="trash-2" width="13" height="13" aria-hidden="true"></i>
                    </button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          <% } %>

          <!-- ── Section Membres ── -->
          <h2 class="ctable-section-title">
            <i data-lucide="users" width="13" height="13" aria-hidden="true"></i>
            Membres
            <span class="ctable-section-count"><%= memberUsers.length %></span>
          </h2>
          <% if (memberUsers.length === 0) { %>
          <div class="empty-state" style="margin-top:0;"><p>Aucun membre inscrit.</p></div>
          <% } else { %>
          <div class="ctable-wrap">
          <table class="ctable">
            <thead><tr>
              <th>Pseudo</th><th>Email</th><th>Rôle</th><th>Statut</th><th>Inscrit le</th><th>Actions</th>
            </tr></thead>
            <tbody>
              <% memberUsers.forEach(function(user) { %>
              <% const badge = roleBadgeMap[user.role] || roleBadgeMap.user; %>
              <tr class="admin-list-item" data-search="<%= (user.pseudo || '').toLowerCase() + ' ' + (user.email || '').toLowerCase() %>">
                <td class="user-cell">
                  <div class="user-cell__inner">
                    <% if (user.picture) { %><img src="<%= user.picture %>" alt="" class="user-cell__avatar" /><% } %>
                    <span><%= user.pseudo || '—' %></span>
                  </div>
                </td>
                <td style="font-size:.68rem; color:rgba(255,255,255,.55);"><%= user.email || '—' %></td>
                <td>
                  <select class="tag" style="background:transparent; border:1px solid rgba(255,255,255,.1); color:<%= badge.color %>; font-size:.6rem; padding:2px 6px; border-radius:4px; cursor:pointer;"
                    data-user-role-select="<%= user.id %>">
                    <option value="user"       <%= user.role === 'user'       ? 'selected' : '' %>>Membre</option>
                    <option value="editor"     <%= user.role === 'editor'     ? 'selected' : '' %>>Éditeur</option>
                    <option value="admin"      <%= user.role === 'admin'      ? 'selected' : '' %>>Admin</option>
                    <option value="superadmin" <%= user.role === 'superadmin' ? 'selected' : '' %>>Super Admin</option>
                  </select>
                </td>
                <td>
                  <% if (user.suspended) { %>
                  <span class="badge-status badge-status--rejected" style="font-size:.58rem;">Suspendu</span>
                  <% } else { %>
                  <span style="font-size:.6rem; color:rgba(100,200,130,.7);">Actif</span>
                  <% } %>
                </td>
                <td class="date-cell"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('fr-FR') : '—' %></td>
                <td class="actions-cell">
                  <button type="button" class="act-btn act-btn--edit act-btn--sm" title="Modifier"
                    data-edit-user-id="<%= user.id %>"
                    data-edit-user-pseudo="<%= user.pseudo || '' %>"
                    data-edit-user-email="<%= user.email || '' %>"
                    data-edit-user-role="<%= user.role || 'user' %>">
                    <i data-lucide="square-pen" width="13" height="13" aria-hidden="true"></i>
                  </button>
                  <% if (user.suspended) { %>
                  <form action="/admin/users/<%= user.id %>/unsuspend" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Réactiver">
                      <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    </button>
                  </form>
                  <% } else { %>
                  <button type="button" class="act-btn act-btn--ban act-btn--sm" title="Suspendre"
                    data-suspend-user-id="<%= user.id %>"
                    data-suspend-user-pseudo="<%= user.pseudo || '' %>">
                    <i data-lucide="ban" width="13" height="13" aria-hidden="true"></i>
                  </button>
                  <% } %>
                  <form action="/admin/deleteUser/<%= user.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                      <i data-lucide="trash-2" width="13" height="13" aria-hidden="true"></i>
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          <% } %>

          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — FILMS PUBLIÉS (+ demandes modification/suppression)
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="pub-films">
          <div class="page-header">
            <h1 class="page-header__title">Films</h1>
            <p class="page-header__sub">Films publiés et demandes de modification ou suppression.</p>
          </div>

          <div class="queue-tabs" role="tablist">
            <button class="queue-tab is-active" data-sub-tab="pub-films-list" role="tab">
              Films publiés
              <% if (validatedMovies && validatedMovies.length > 0) { %><span class="queue-tab__count queue-tab__count--vert"><%= validatedMovies.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="pub-films-edits" role="tab">
              Modifications
              <% if (pendingMovieEdits && pendingMovieEdits.length > 0) { %><span class="queue-tab__count"><%= pendingMovieEdits.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="pub-films-deletes" role="tab">
              Suppressions
              <% if (pendingMovieDeleteRequests && pendingMovieDeleteRequests.length > 0) { %><span class="queue-tab__count queue-tab__count--rouge"><%= pendingMovieDeleteRequests.length %></span><% } %>
            </button>
          </div>

          <!-- Films publiés -->
          <div class="sub-panel is-active" id="pub-films-list">
            <% if (!validatedMovies || validatedMovies.length === 0) { %>
            <div class="empty-state"><p>Aucun film publié.</p></div>
            <% } else { %>
            <div class="admin-published-section" data-page-size="10">
              <div class="filter-bar">
                <input type="text" class="filter-bar__search" placeholder="Rechercher un film publié…" data-search-input />
                <button type="button" class="filter-bar__clear" data-search-clear title="Effacer">×</button>
              </div>
              <div data-no-results style="display:none;" class="empty-state"><p>Aucun résultat pour cette recherche.</p></div>
              <table class="ctable">
                <thead>
                  <tr>
                    <th>Film</th>
                    <th>Année</th>
                    <th>Genre</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% validatedMovies.forEach(function(movie) { %>
                  <tr class="admin-list-item" data-search="<%= (movie.title || '').toLowerCase() + ' ' + (movie.genre || '').toLowerCase() %>">
                    <td>
                      <div class="cell-media">
                        <% if (movie.poster) { %><img src="<%= movie.poster %>" alt="" class="cell-media__thumb" /><% } %>
                        <span class="cell-media__title"><%= movie.title %></span>
                      </div>
                    </td>
                    <td><%= movie.year || '—' %></td>
                    <td><span class="tag"><%= movie.genre || '—' %></span></td>
                    <td class="actions-cell">
                      <button type="button" class="act-btn act-btn--edit act-btn--sm"
                        data-edit-btn
                        data-edit-type="movie"
                        data-edit-id="<%= movie.id %>"
                        data-edit-title="<%= movie.title %>"
                        data-edit-year="<%= movie.year || '' %>"
                        data-edit-genre="<%= movie.genre || '' %>"
                        data-edit-synopsis="<%= String(movie.synopsis || '').replace(/"/g, '&quot;') %>">
                        <i data-lucide="square-pen" width="13" height="13" aria-hidden="true"></i>
                      </button>
                      <form action="/admin/movies/<%= movie.id %>/delete/direct" method="POST" style="display:inline;">
                        <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                          <i data-lucide="trash" width="13" height="13" aria-hidden="true"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="admin-pagination" style="display:none;">
                <button class="btn btn--ghost admin-pagination__prev">← Précédent</button>
                <span class="admin-pagination__info"></span>
                <button class="btn btn--ghost admin-pagination__next">Suivant →</button>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Modifications films -->
          <div class="sub-panel" id="pub-films-edits">
            <% if (!pendingMovieEdits || pendingMovieEdits.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de modification de film.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingMovieEdits.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="badge-status badge-status--proposed">Modification</span>
                  <strong class="mod-row__title"><%= req.title || 'Film inconnu' %></strong>
                  <% if (req.User) { %><span class="mod-row__user">par <%= req.User.pseudo %></span><% } %>
                  <ul class="mod-row__changes">
                    <% if (req.pending_title && req.pending_title !== req.title) { %><li><em>Titre :</em> <s class="mod-old"><%= req.title %></s> → <strong class="mod-new"><%= req.pending_title %></strong></li><% } %>
                    <% if (req.pending_year && req.pending_year !== req.year) { %><li><em>Année :</em> <s class="mod-old"><%= req.year %></s> → <strong class="mod-new"><%= req.pending_year %></strong></li><% } %>
                    <% if (req.pending_genre && req.pending_genre !== req.genre) { %><li><em>Genre :</em> <s class="mod-old"><%= req.genre %></s> → <strong class="mod-new"><%= req.pending_genre %></strong></li><% } %>
                  </ul>
                </div>
                <div class="actions-cell">
                  <form action="/admin/movies/<%= req.id %>/edit/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Approuver la modification">
                      <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    </button>
                  </form>
                  <form action="/admin/movies/<%= req.id %>/edit/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la modification">
                      <i data-lucide="x" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Suppressions films -->
          <div class="sub-panel" id="pub-films-deletes">
            <% if (!pendingMovieDeleteRequests || pendingMovieDeleteRequests.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de suppression de film.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingMovieDeleteRequests.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="badge-status badge-status--delete">Suppression</span>
                  <strong class="mod-row__title"><%= req.title || 'Film inconnu' %></strong>
                  <% if (req.User) { %><span class="mod-row__user">par <%= req.User.pseudo %></span><% } %>
                </div>
                <div class="actions-cell">
                  <form action="/admin/movies/<%= req.id %>/delete/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Confirmer la suppression">
                      <i data-lucide="trash-2" width="13" height="13" aria-hidden="true"></i>
                    </button>
                  </form>
                  <form action="/admin/movies/<%= req.id %>/delete/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la suppression">
                      <i data-lucide="x" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — RECETTES PUBLIÉES
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="pub-recettes">
          <div class="page-header">
            <h1 class="page-header__title">Recettes publiées</h1>
            <p class="page-header__sub">Toutes les recettes validées et visibles sur le site.</p>
          </div>

          <% if (!validatedRecipes || validatedRecipes.length === 0) { %>
          <div class="empty-state"><p>Aucune recette publiée.</p></div>
          <% } else { %>
          <div class="admin-published-section" data-page-size="10">
            <div class="filter-bar">
              <input type="text" class="filter-bar__search" placeholder="Rechercher une recette publiée…" data-search-input />
              <button type="button" class="filter-bar__clear" data-search-clear title="Effacer">×</button>
            </div>
            <div data-no-results style="display:none;" class="empty-state"><p>Aucun résultat pour cette recherche.</p></div>
            <table class="ctable">
              <thead>
                <tr>
                  <th>Recette</th>
                  <th>Catégorie</th>
                  <th>Difficulté</th>
                  <th>Soumis par</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% validatedRecipes.forEach(function(recipe) { %>
                <tr class="admin-list-item" data-search="<%= (recipe.name || '').toLowerCase() + ' ' + (recipe.category || '').toLowerCase() %>">
                  <td>
                    <div class="cell-media">
                      <% const vThumb = (recipe.RecipePictures && recipe.RecipePictures.length > 0) ? recipe.RecipePictures[0].file_path : recipe.picture; %>
                      <% if (vThumb) { %><img src="<%= vThumb %>" alt="" class="cell-media__thumb cell-media__thumb--recipe" /><% } %>
                      <span class="cell-media__title"><%= recipe.name %></span>
                    </div>
                  </td>
                  <td><span class="tag"><%= recipe.category || '—' %></span></td>
                  <td><%= recipe.difficulty || '—' %></td>
                  <td class="user-cell"><%= recipe.contributor?.pseudo || '—' %></td>
                  <td class="actions-cell">
                    <button type="button" class="act-btn act-btn--edit act-btn--sm"
                      data-edit-btn
                      data-edit-type="recipe"
                      data-edit-id="<%= recipe.id %>"
                      data-edit-name="<%= recipe.name %>"
                      data-edit-category="<%= recipe.category || '' %>"
                      data-edit-time="<%= recipe.time || '' %>"
                      data-edit-servings="<%= recipe.servings || '' %>"
                      data-edit-difficulty="<%= recipe.difficulty || '' %>"
                      data-edit-description='<%- (recipe.description || "").replace(/\x27/g, "&#39;") %>'
                      data-edit-ingredients='<%- (recipe.ingredients || "").replace(/\x27/g, "&#39;") %>'
                      data-edit-preparation='<%- (recipe.preparation || "").replace(/\x27/g, "&#39;") %>'>
                      <i data-lucide="square-pen" width="13" height="13" aria-hidden="true"></i>
                    </button>
                    <form action="/admin/recipes/<%= recipe.id %>/delete/direct" method="POST" style="display:inline;">
                      <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                        <i data-lucide="trash" width="13" height="13" aria-hidden="true"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <div class="admin-pagination" style="display:none;">
              <button class="btn btn--ghost admin-pagination__prev">← Précédent</button>
              <span class="admin-pagination__info"></span>
              <button class="btn btn--ghost admin-pagination__next">Suivant →</button>
            </div>
          </div>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — AVIS PUBLIÉS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="pub-avis">
          <div class="page-header">
            <h1 class="page-header__title">Avis publiés</h1>
            <p class="page-header__sub">Tous les avis validés et visibles sur le site.</p>
          </div>

          <% if (!validatedNotices || validatedNotices.length === 0) { %>
          <div class="empty-state"><p>Aucun avis publié.</p></div>
          <% } else { %>
          <div class="admin-published-section" data-page-size="10">
            <div class="filter-bar">
              <input type="text" class="filter-bar__search" placeholder="Rechercher un avis publié…" data-search-input />
              <button type="button" class="filter-bar__clear" data-search-clear title="Effacer">×</button>
            </div>
            <div data-no-results style="display:none;" class="empty-state"><p>Aucun résultat pour cette recherche.</p></div>
            <table class="ctable">
              <thead>
                <tr>
                  <th>Utilisateur</th>
                  <th>Recette</th>
                  <th>Note</th>
                  <th>Commentaire</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% validatedNotices.forEach(function(notice) { %>
                <tr class="admin-list-item" data-search="<%= (notice.user || notice.author || '').toLowerCase() + ' ' + (notice.recipe || '').toLowerCase() %>">
                  <td class="user-cell"><%= notice.user || notice.author || '—' %></td>
                  <td><%= notice.recipe || '—' %></td>
                  <td class="score-cell">
                    <% if (notice.rating || notice.note) { %><span class="score-badge"><%= notice.rating || notice.note %>/5</span><% } else { %>—<% } %>
                  </td>
                  <td><span class="cell-excerpt"><%= ((notice.content || notice.comment || notice.quote || '') + '').substring(0, 60) %>…</span></td>
                  <td class="actions-cell">
                    <button type="button" class="act-btn act-btn--edit act-btn--sm"
                      data-edit-btn
                      data-edit-type="notice"
                      data-edit-id="<%= notice.id %>"
                      data-edit-content="<%= String(notice.content || notice.comment || '').replace(/"/g, '&quot;') %>"
                      data-edit-quote="<%= String(notice.quote || '').replace(/"/g, '&quot;') %>"
                      data-edit-author="<%= notice.user || notice.author || '' %>"
                      data-edit-recipe="<%= notice.recipe || '' %>">
                      <i data-lucide="square-pen" width="13" height="13" aria-hidden="true"></i>
                    </button>
                    <form action="/admin/notices/<%= notice.id %>/delete/direct" method="POST" style="display:inline;">
                      <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                        <i data-lucide="trash" width="13" height="13" aria-hidden="true"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <div class="admin-pagination" style="display:none;">
              <button class="btn btn--ghost admin-pagination__prev">← Précédent</button>
              <span class="admin-pagination__info"></span>
              <button class="btn btn--ghost admin-pagination__next">Suivant →</button>
            </div>
          </div>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — GAMIFICATION (stub)
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="gamification">
          <div class="page-header">
            <h1 class="page-header__title">Gamification</h1>
            <p class="page-header__sub">Statistiques XP, niveaux et progression de la communauté.</p>
          </div>

          <!-- Stats cards -->
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px;margin-bottom:24px;" id="gamif-stats-grid">
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(196,160,82,.5);font-family:var(--f-title);margin-bottom:6px;">XP Total distribué</div>
              <div id="gamif-total-xp" style="font-size:1.8rem;font-weight:700;color:var(--or-titre);font-family:var(--f-display);">—</div>
            </div>
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(196,160,82,.5);font-family:var(--f-title);margin-bottom:6px;">Membres avec XP</div>
              <div id="gamif-total-members" style="font-size:1.8rem;font-weight:700;color:var(--or-titre);font-family:var(--f-display);">—</div>
            </div>
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(196,160,82,.5);font-family:var(--f-title);margin-bottom:6px;">XP moyen / membre</div>
              <div id="gamif-avg-xp" style="font-size:1.8rem;font-weight:700;color:var(--or-titre);font-family:var(--f-display);">—</div>
            </div>
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(196,160,82,.5);font-family:var(--f-title);margin-bottom:6px;">Niveau moyen</div>
              <div id="gamif-avg-level" style="font-size:1.8rem;font-weight:700;color:var(--or-titre);font-family:var(--f-display);">—</div>
            </div>
          </div>

          <!-- Top membres par XP -->
          <div class="card" style="padding:0;">
            <div style="padding:14px 20px;border-bottom:1px solid rgba(255,255,255,.07);font-size:.8rem;font-weight:600;color:rgba(255,255,255,.6);display:flex;align-items:center;gap:8px;">
              <i data-lucide="trophy" width="14" height="14" style="color:var(--or-titre);" aria-hidden="true"></i>
              Top membres par XP
            </div>
            <div id="gamif-top-table" style="padding:16px 20px;color:rgba(255,255,255,.3);font-size:.75rem;">Chargement…</div>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — LOGS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="logs">
          <div class="page-header">
            <h1 class="page-header__title">Logs</h1>
            <p class="page-header__sub">Journal des 200 dernières actions administrateur. Lecture seule.</p>
            <button type="button" class="act-btn act-btn--view" id="logs-export-btn" style="margin-left:auto;" title="Exporter en JSON">
              <i data-lucide="upload" width="13" height="13" aria-hidden="true"></i>
              <span>Exporter JSON</span>
            </button>
          </div>

          <!-- Filtres -->
          <div class="filter-bar" style="display:flex; gap:10px; flex-wrap:wrap;">
            <input type="text" class="filter-bar__search" id="logs-filter-text" placeholder="Filtrer par action ou admin…" style="flex:1; min-width:180px;" />
            <select class="filter-bar__search" id="logs-filter-action" style="flex:0 0 auto; min-width:160px; cursor:pointer;">
              <option value="">Toutes les actions</option>
            </select>
          </div>

          <div class="card" style="padding:0;">
            <div class="ctable-wrap" id="logs-table-wrap" style="max-height:600px; overflow-y:auto;">
              <table class="ctable" id="logs-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Type</th>
                    <th>ID cible</th>
                    <th>Détail</th>
                  </tr>
                </thead>
                <tbody id="logs-tbody">
                  <tr id="logs-loading-row">
                    <td colspan="6" style="text-align:center; padding:32px; color:rgba(255,255,255,.35);">Chargement…</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div id="logs-empty" style="display:none; text-align:center; padding:28px; color:rgba(255,255,255,.3); font-size:.72rem;">Aucun log correspondant.</div>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — PARAMÈTRES (stub)
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="parametres">
          <div class="page-header">
            <h1 class="page-header__title">Paramètres</h1>
            <p class="page-header__sub">Informations système et configuration de la plateforme.</p>
          </div>

          <!-- Infos système en lecture -->
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin-bottom:24px;">
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,160,255,.6);font-family:var(--f-title);margin-bottom:6px;">Environnement</div>
              <div style="font-size:1rem;font-weight:700;color:rgba(232,232,232,.9);"><%= process.env.NODE_ENV || 'development' %></div>
            </div>
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,160,255,.6);font-family:var(--f-title);margin-bottom:6px;">URL de base</div>
              <div style="font-size:.82rem;color:rgba(232,232,232,.7);word-break:break-all;"><%= process.env.BASE_URL || 'http://localhost:3000' %></div>
            </div>
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,160,255,.6);font-family:var(--f-title);margin-bottom:6px;">Mode maintenance</div>
              <div style="font-size:1rem;font-weight:700;color:<%= process.env.MAINTENANCE === 'true' ? 'rgba(232,100,65,.9)' : 'rgba(61,200,100,.8)' %>;">
                <%= process.env.MAINTENANCE === 'true' ? '🔒 Activé' : '✅ Désactivé' %>
              </div>
            </div>
            <div class="card" style="padding:18px 20px;">
              <div style="font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,160,255,.6);font-family:var(--f-title);margin-bottom:6px;">Version Node.js</div>
              <div style="font-size:1rem;font-weight:700;color:rgba(232,232,232,.9);"><%= process.version %></div>
            </div>
          </div>

          <!-- Actions -->
          <div class="card" style="padding:20px 24px;margin-bottom:12px;">
            <div style="font-weight:600;font-size:.85rem;margin-bottom:4px;display:flex;align-items:center;gap:8px;">
              <i data-lucide="settings" width="14" height="14" style="color:rgba(100,160,255,.7);" aria-hidden="true"></i>
              Maintenance
            </div>
            <div style="font-size:.76rem;color:rgba(255,255,255,.4);margin-bottom:14px;">Le mode maintenance se active via la variable d'environnement <code style="background:rgba(255,255,255,.07);padding:1px 6px;border-radius:4px;">MAINTENANCE=true</code> sur le dashboard Render.</div>
            <a href="https://dashboard.render.com" target="_blank" rel="noopener" class="act-btn act-btn--view" style="display:inline-flex;">
              <i data-lucide="external-link" width="13" height="13" aria-hidden="true"></i>
              Ouvrir Render Dashboard
            </a>
          </div>

          <div class="card" style="padding:20px 24px;margin-bottom:12px;">
            <div style="font-weight:600;font-size:.85rem;margin-bottom:4px;display:flex;align-items:center;gap:8px;">
              <i data-lucide="database" width="14" height="14" style="color:rgba(100,160,255,.7);" aria-hidden="true"></i>
              Base de données
            </div>
            <div style="font-size:.76rem;color:rgba(255,255,255,.4);">PostgreSQL hébergé sur Render (Frankfurt). Les migrations SQL se font via le Shell Render.</div>
          </div>

          <div class="card" style="padding:20px 24px;">
            <div style="font-weight:600;font-size:.85rem;margin-bottom:4px;display:flex;align-items:center;gap:8px;">
              <i data-lucide="image" width="14" height="14" style="color:rgba(100,160,255,.7);" aria-hidden="true"></i>
              Stockage images
            </div>
            <div style="font-size:.76rem;color:rgba(255,255,255,.4);">Cloudinary — cloud name : <code style="background:rgba(255,255,255,.07);padding:1px 6px;border-radius:4px;"><%= process.env.CLOUDINARY_CLOUD_NAME || '—' %></code></div>
          </div>
        </section>

      </main>
    </div><!-- /.main-wrapper -->


    <!-- ═══════════════════════════════════════════
         TOAST STACK
    ═══════════════════════════════════════════ -->
    <div class="toast-stack" id="toast-stack" aria-live="polite"></div>
    <!-- Legacy compat -->
    <div class="admin-toast" id="admin-toast" aria-live="polite"></div>


    <!-- ═══════════════════════════════════════════
         MODAL ÉDITION ADMIN (Films, Recettes, Avis)
    ═══════════════════════════════════════════ -->
    <div class="admin-modal" id="admin-edit-modal" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
      <div class="admin-modal__backdrop"></div>
      <div class="admin-modal__dialog">
        <div class="admin-modal__header">
          <div class="admin-modal__title-row">
            <!-- Icônes dynamiques selon le type -->
            <span data-modal-icon="movie" style="display:none;">
              <i data-lucide="film" width="20" height="20" aria-hidden="true"></i>
            </span>
            <span data-modal-icon="recipe" style="display:none;">
              <i data-lucide="utensils" width="20" height="20" aria-hidden="true"></i>
            </span>
            <span data-modal-icon="notice" style="display:none;">
              <i data-lucide="message-square" width="20" height="20" aria-hidden="true"></i>
            </span>
            <h2 class="admin-modal__title" id="admin-modal-title">
              <span data-modal-title-text>Éditer</span>
            </h2>
          </div>
          <button type="button" class="admin-modal__close" data-modal-close aria-label="Fermer">
            <i data-lucide="x" width="18" height="18" stroke-width="2.5" aria-hidden="true"></i>
          </button>
        </div>

        <form class="admin-modal__form" id="admin-edit-form" method="POST">
          <!-- Section Film -->
          <div data-modal-section="movie" style="display:none; flex-direction:column; gap:14px;">
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-movie-title">Titre</label>
              <input type="text" id="edit-movie-title" name="title" class="admin-modal__input" required />
            </div>
            <div class="admin-modal__field-row">
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-movie-year">Année</label>
                <input type="number" id="edit-movie-year" name="year" class="admin-modal__input" min="1888" max="2099" />
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-movie-genre">Genre</label>
                <select id="edit-movie-genre" name="genre" class="admin-modal__select">
                  <option value="">— Choisir —</option>
                  <option value="Action">Action</option>
                  <option value="Aventure">Aventure</option>
                  <option value="Animation">Animation</option>
                  <option value="Comédie">Comédie</option>
                  <option value="Documentaire">Documentaire</option>
                  <option value="Drame">Drame</option>
                  <option value="Fantastique">Fantastique</option>
                  <option value="Horreur">Horreur</option>
                  <option value="Musical">Musical</option>
                  <option value="Romance">Romance</option>
                  <option value="Science-Fiction">Science-Fiction</option>
                  <option value="Thriller">Thriller</option>
                  <option value="Western">Western</option>
                </select>
              </div>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-movie-synopsis">Synopsis</label>
              <textarea id="edit-movie-synopsis" name="synopsis" class="admin-modal__textarea admin-modal__textarea--autosize" rows="4"></textarea>
            </div>
          </div>

          <!-- Section Recette -->
          <div data-modal-section="recipe" style="display:none; flex-direction:column; gap:14px;">
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-recipe-name">Nom de la recette</label>
              <input type="text" id="edit-recipe-name" name="name" class="admin-modal__input" required />
            </div>
            <div class="admin-modal__field-row">
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-category">Catégorie</label>
                <select id="edit-recipe-category" name="category" class="admin-modal__select">
                  <option value="">— Choisir —</option>
                  <option value="Entrée">Entrée</option>
                  <option value="Plat principal">Plat principal</option>
                  <option value="Dessert">Dessert</option>
                  <option value="Boisson">Boisson</option>
                  <option value="Apéritif">Apéritif</option>
                  <option value="Snack">Snack</option>
                </select>
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-time">Temps (min)</label>
                <input type="number" id="edit-recipe-time" name="time" class="admin-modal__input" min="0" />
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-servings">Portions</label>
                <input type="number" id="edit-recipe-servings" name="servings" class="admin-modal__input" min="1" placeholder="ex: 4" />
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-difficulty">Difficulté</label>
                <select id="edit-recipe-difficulty" name="difficulty" class="admin-modal__select">
                  <option value="">— Choisir —</option>
                  <option value="Facile">Facile</option>
                  <option value="Moyen">Moyen</option>
                  <option value="Difficile">Difficile</option>
                </select>
              </div>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-recipe-description">Description</label>
              <textarea id="edit-recipe-description" name="description" class="admin-modal__textarea admin-modal__textarea--autosize" rows="2"></textarea>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label">Ingrédients <span style="font-weight:400;opacity:.5;font-size:.75em">— <kbd>§</kbd> titre de section · <kbd>•</kbd> liste</span></label>
              <div class="rte-mini-wrap">
                <div class="rte-mini-toolbar" id="admin-ing-tb" role="toolbar" aria-label="Mise en forme ingrédients">
                  <button type="button" class="rte-tb-btn" data-cmd="bold" title="Gras (Ctrl+B)"><strong>G</strong></button>
                  <button type="button" class="rte-tb-btn" data-cmd="italic" title="Italique (Ctrl+I)"><em>I</em></button>
                  <div class="rte-tb-divider"></div>
                  <button type="button" class="rte-tb-btn" data-cmd="bulletList" title="Liste à puces">• liste</button>
                  <button type="button" class="rte-tb-btn" data-cmd="heading" title="Titre de section (§)">§ titre</button>
                </div>
                <div class="rte-mini-editor" id="admin-ing-rte" contenteditable="true" spellcheck="false" role="textbox" aria-multiline="true" aria-label="Ingrédients"></div>
              </div>
              <input type="hidden" id="edit-recipe-ingredients" name="ingredients" />
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label">Préparation <span style="font-weight:400;opacity:.5;font-size:.75em">— <kbd>Ctrl+↵</kbd> ou <kbd>+ étape</kbd> pour séparer · le premier <strong>§ titre</strong> de chaque étape devient son en-tête affiché</span></label>
              <div class="rte-mini-wrap">
                <div class="rte-mini-toolbar" id="admin-prep-tb" role="toolbar" aria-label="Mise en forme préparation">
                  <button type="button" class="rte-tb-btn" data-cmd="bold" title="Gras (Ctrl+B)"><strong>G</strong></button>
                  <button type="button" class="rte-tb-btn" data-cmd="italic" title="Italique (Ctrl+I)"><em>I</em></button>
                  <div class="rte-tb-divider"></div>
                  <button type="button" class="rte-tb-btn" data-cmd="bulletList" title="Liste à puces">• liste</button>
                  <button type="button" class="rte-tb-btn" data-cmd="heading" title="Titre d'étape — devient l'en-tête affiché">§ titre</button>
                  <div class="rte-tb-divider"></div>
                  <button type="button" class="rte-tb-btn" data-cmd="separator" title="Nouvelle étape (Ctrl+Entrée)">+ étape</button>
                </div>
                <div class="rte-mini-editor" id="admin-prep-rte" contenteditable="true" spellcheck="false" role="textbox" aria-multiline="true" aria-label="Préparation"></div>
              </div>
              <input type="hidden" id="edit-recipe-preparation" name="preparation" />
            </div>
            <input type="hidden" id="edit-recipe-image" name="recipeImage" />
            <img id="edit-recipe-image-preview" style="display:none;" />

            <!-- ── Photos complémentaires ── -->
            <div class="admin-modal__field" style="border-top:1px solid rgba(255,255,255,.06); padding-top:14px; margin-top:4px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <label class="admin-modal__label" style="margin:0;">Photos de la recette</label>
                <span id="recipe-photos-count-badge" style="font-size:.63rem; color:rgba(196,160,82,.65);"></span>
              </div>
              <div id="recipe-photos-grid" style="display:flex; gap:10px; flex-wrap:wrap; min-height:60px; align-items:flex-start;">
                <span style="font-size:.7rem; opacity:.35; align-self:center;">Chargement…</span>
              </div>
              <!-- Ancienne zone ajout — remplacée par les slots intégrés dans la grille -->
              <div id="recipe-photo-add-zone" style="display:none;"></div>
              <input type="file" id="recipe-photo-add-input" style="display:none;" />
              <button type="button" id="recipe-photo-add-btn" style="display:none;"></button>
              <p id="recipe-photos-limit-msg" style="display:none;"></p>
            </div>
          </div>

          <!-- Section Avis -->
          <div data-modal-section="notice" style="display:none; flex-direction:column; gap:14px;">
            <div class="admin-modal__info-row">
              <div class="admin-modal__info-chip">
                <span class="admin-modal__info-label">Auteur :</span>
                <span id="edit-notice-author-display">—</span>
              </div>
              <div class="admin-modal__info-chip">
                <span class="admin-modal__info-label">Recette :</span>
                <span id="edit-notice-recipe-display">—</span>
              </div>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-notice-quote">Note (1 à 5)</label>
              <input type="number" id="edit-notice-quote" name="quote" class="admin-modal__input" min="1" max="5" />
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-notice-content">Commentaire</label>
              <textarea id="edit-notice-content" name="content" class="admin-modal__textarea admin-modal__textarea--autosize" rows="4"></textarea>
            </div>
          </div>

          <div class="admin-modal__footer">
            <button type="button" class="btn btn--ghost" data-modal-close>Annuler</button>
            <button type="submit" class="btn btn--primary">Enregistrer</button>
          </div>
        </form>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════
         MODAL SUSPENSION UTILISATEUR
    ═══════════════════════════════════════════ -->
    <div class="admin-modal" id="user-suspension-modal" role="dialog" aria-modal="true" aria-labelledby="suspend-modal-title">
      <div class="admin-modal__backdrop"></div>
      <div class="admin-modal__dialog">
        <div class="admin-modal__header">
          <div class="admin-modal__title-row">
            <i data-lucide="ban" width="20" height="20" aria-hidden="true"></i>
            <h2 class="admin-modal__title" id="suspend-modal-title">Suspendre l'utilisateur</h2>
          </div>
          <button type="button" class="admin-modal__close" id="suspend-modal-close" aria-label="Fermer">
            <i data-lucide="x" width="18" height="18" stroke-width="2.5" aria-hidden="true"></i>
          </button>
        </div>

        <form class="admin-modal__form" id="suspend-form">
          <div class="admin-modal__field">
            <label class="admin-modal__label" for="suspend-duration">Durée</label>
            <select name="duration" id="suspend-duration" class="admin-modal__input">
              <option value="1">1 jour</option>
              <option value="3">3 jours</option>
              <option value="7" selected>7 jours</option>
              <option value="14">14 jours</option>
              <option value="30">30 jours</option>
              <option value="0">Permanent</option>
            </select>
          </div>
          <div class="admin-modal__field">
            <label class="admin-modal__label" for="suspend-reason">Raison</label>
            <textarea name="reason" id="suspend-reason" class="admin-modal__textarea" maxlength="500" rows="3" placeholder="Motif de la suspension…"></textarea>
          </div>
          <div class="admin-modal__footer">
            <button type="submit" class="act-btn act-btn--danger">
              <i data-lucide="ban" width="14" height="14" stroke-width="2.5" aria-hidden="true"></i>
              Suspendre
            </button>
            <button type="button" class="act-btn act-btn--ghost" id="suspend-modal-cancel">Annuler</button>
          </div>
        </form>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════
         MODAL CRÉATION / ÉDITION UTILISATEUR
    ═══════════════════════════════════════════ -->
    <div class="admin-modal" id="user-role-modal" role="dialog" aria-modal="true" aria-labelledby="ur-modal-title">
      <div class="admin-modal__backdrop"></div>
      <div class="admin-modal__dialog">
        <div class="admin-modal__header">
          <div class="admin-modal__title-row">
            <i data-lucide="user" width="20" height="20" aria-hidden="true"></i>
            <h2 class="admin-modal__title" id="ur-modal-title">Créer un utilisateur</h2>
          </div>
          <button type="button" class="admin-modal__close" id="ur-modal-close" aria-label="Fermer">
            <i data-lucide="x" width="18" height="18" stroke-width="2.5" aria-hidden="true"></i>
          </button>
        </div>

        <form class="admin-modal__form" id="user-role-form">
          <div class="admin-modal__field">
            <label class="admin-modal__label" for="ur-pseudo">Pseudo</label>
            <input type="text" id="ur-pseudo" name="pseudo" class="admin-modal__input" required />
          </div>
          <div class="admin-modal__field">
            <label class="admin-modal__label" for="ur-email">Email</label>
            <input type="email" id="ur-email" name="email" class="admin-modal__input" required />
          </div>
          <div class="admin-modal__field">
            <label class="admin-modal__label" for="ur-password">
              Mot de passe
              <span id="ur-password-hint" style="font-weight:400; opacity:.55; margin-left:6px; font-size:.62rem;">(min. 8 caractères)</span>
            </label>
            <input type="password" id="ur-password" name="password" class="admin-modal__input" minlength="8" autocomplete="new-password" />
          </div>
          <% if (role === 'superadmin') { %>
          <div class="admin-modal__field" id="ur-role-field">
            <label class="admin-modal__label" for="ur-role">Rôle</label>
            <select id="ur-role" name="role" class="admin-modal__select">
              <option value="user">Membre</option>
              <option value="editor">Éditeur</option>
              <option value="admin">Admin</option>
              <option value="superadmin">Super Admin</option>
            </select>
          </div>
          <% } %>
          <div class="admin-modal__footer">
            <button type="submit" id="ur-submit-btn" class="act-btn act-btn--approve">
              <i data-lucide="check" width="14" height="14" stroke-width="2.5" aria-hidden="true"></i>
              <span id="ur-submit-label">Créer</span>
            </button>
            <button type="button" id="ur-modal-cancel" class="act-btn act-btn--ghost">Annuler</button>
          </div>
        </form>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════
         LIGHTBOX
    ═══════════════════════════════════════════ -->
    <div class="recipe-lightbox" id="recipe-lightbox" role="dialog" aria-modal="true" aria-label="Visionneuse d'image">
      <div class="recipe-lightbox__backdrop" id="lightbox-backdrop"></div>
      <div class="recipe-lightbox__panel">
        <button class="recipe-lightbox__close" id="lightbox-close" aria-label="Fermer">
          <i data-lucide="x" width="20" height="20" stroke-width="2.5" aria-hidden="true"></i>
        </button>
        <img src="" alt="" class="recipe-lightbox__img" id="lightbox-img" />
      </div>
    </div>


    <!-- Scripts -->
    <script src="/js/confirm-action.js"></script>
    <script src="/js/rte-mini.js"></script>
    <script src="/js/admin-dashboard.js"></script>
    <script src="/js/recipe-detail.js"></script>
    <script>if (window.lucide) lucide.createIcons();</script>
  </body>
</html>
