<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Espace Administrateur - Ciné Délices</title>
    <meta
      name="description"
      content="Ciné Délices — Espace Administrateur, gestion des recettes et films"
    />

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css, preload éventuel -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à l'admin -->
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>
  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- Bannière Administrateur -->
    <div class="admin-header-banner">Espace Administrateur</div>

    <!-- CONTAINER PRINCIPAL -->
    <div class="admin-container">
      <!-- SIDEBAR -->
      <aside class="admin-sidebar">
        <button class="dropdown-btn" data-target="recettes">
          <i class="fa-solid fa-utensils"></i> Validation des recettes
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
        <div class="dropdown-container" id="recettes">
          <% recipes.forEach(recipe => { %>
          <button class="list-item"><a href="/admin/recipe/<%= recipe.id %>"><%= recipe.id %> - <%= recipe.name %></a></button>
          <% }) %>
        </div>

        <button class="dropdown-btn" data-target="films">
          <i class="fa-solid fa-film"></i> Validation des films
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
        <div class="dropdown-container" id="films">
          <% movies.forEach(movie => { %>
          <button class="list-item"><a href="/admin/movie/<%= movie.id %>"><%= movie.id %> - <%= movie.title %></a></button>
          <% }) %>
        </div>

        <button class="dropdown-btn" data-target="avis">
          <i class="fa-solid fa-comment"></i> Avis à valider
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
         <div class="dropdown-container" id="avis">
          <% avis.forEach(note => { %>
          <button class="list-item"><%= note.id %> - <%= note.content %></button>
          <% }) %>
        </div>

        <button class="dropdown-btn" data-target="users">
          <i class="fa-solid fa-user"></i> Utilisateurs
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
        <div class="dropdown-container" id="users">
          <% users.forEach(user => { %>
            <form method="POST" action="/admin/deleteUser/<%= user.id %>" >
              <button type="submit" class="list-item dropdown-btn" title="Supprimer <%= user.first_name %>">
                <%= user.id %> - <%= user.first_name %>
              </button>
            </form>
          <!-- <button class="list-item"><%= user.id %> - <%= user.first_name %></button> -->
          <% }) %>
        </div>

      </aside>

      <!-- CONTENU PRINCIPAL -->
      <main class="admin-main">
        <!-- FILM -->
        <h2 class="admin-section-title">Film</h2>
        <section class="admin-section film-section">
          <div class="film-section-container">
            <div class="film-section-content">
              <h3 class="film-title">
                <% if (typeof upMovie === "undefined") { %>
                  le film
                <% } else { %>
                  <%= upMovie.title %>
                <% } %>
              </h3>
              <div class="film-meta-badges">
                <span class="film-badge film-badge-year">
                  <i class="fa-solid fa-calendar"></i>
                  <span class="film-badge-value">
                    <% if (typeof upMovie === "undefined") { %>
                      l'année
                    <% } else { %>
                      <%= upMovie.year %>
                    <% } %>
                  </span>
                </span>
                <span class="film-badge film-badge-genre">
                  <i class="fa-solid fa-film"></i>
                  <span class="film-badge-value">
                    <% if (typeof upMovie === "undefined") { %>
                      le genre
                    <% } else { %>
                      <%= upMovie.genre %>
                    <% } %>
                  </span>
                </span>
              </div>
            </div>
            <div class="film-section-upload">
              <div class="film-upload-zone">
                <div class="film-upload-controls">
                  <input 
                    type="file" 
                    name="filmImage" 
                    id="filmImageInput" 
                    accept="image/jpeg,image/jpg,image/png,image/webp"
                    style="display: none;"
                  />
                  <button type="button" class="btn btn--red btn-upload-film" id="uploadFilmButton">
                    <i class="fa-solid fa-upload"></i>
                  </button>
                </div>
                <div class="overview-image">
                  <button
                    type="button"
                    class="overview-image-button"
                    data-lightbox-trigger
                    <% if (typeof upMovie !== "undefined" && upMovie && upMovie.picture) { %>
                    data-lightbox-image="<%= upMovie.picture %>"
                    data-lightbox-alt="Affiche du film <%= upMovie.title %>"
                    <% } else { %>
                    data-lightbox-image="/images/bg-img-default-boys.jpg"
                    data-lightbox-alt="Image du film"
                    <% } %>
                    aria-label="Voir l'image du film en plein écran"
                  >
                    <img
                      id="filmImagePreview"
                      <% if (typeof upMovie !== "undefined" && upMovie && upMovie.picture) { %>
                      src="<%= upMovie.picture %>"
                      alt="Affiche du film <%= upMovie.title %>"
                      <% } else { %>
                      src="/images/bg-img-default-boys.jpg"
                      alt="Image du film"
                      <% } %>
                    />
                    <span class="overview-image-hint">
                      <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- BOUTONS DE VALIDATION -->
        <div class="admin-validation">
          <% if (typeof upMovie !== "undefined") { %>
            <form method="POST" action="/admin/validateMovie/<%= upMovie.id %>" enctype="multipart/form-data" id="validateMovieForm">
              <button type="submit" class="btn btn-valid">Valider le film</button>
            </form>
            <form method="POST" action="/admin/rejectMovie/<%= upMovie.id %>">
              <button type="submit" class="btn btn-refus">Refuser le film</button>
            </form>
          <% } else { %>
            <button class="btn btn-valid" disabled>Valider le film</button>
            <button class="btn btn-refus" disabled>Refuser le film</button>
          <% } %>
        </div>

        <!-- RECETTE -->
        <h2 class="admin-section-title">Recette</h2>
        <section class="admin-section recette-section">
          <div class="recette-details">
            <div class="recette-photo">
              <button
                type="button"
                class="recette-photo-button"
                data-lightbox-trigger
                <% if (typeof upRecipe !== "undefined" && upRecipe && upRecipe.picture) { %>
                data-lightbox-image="<%= upRecipe.picture %>"
                data-lightbox-alt="Photo de la recette <%= upRecipe.name %>"
                <% } else { %>
                data-lightbox-image="/images/default-recipe.jpg"
                data-lightbox-alt="Photo de la recette"
                <% } %>
                aria-label="Voir l'image de la recette en plein écran"
              >
                <img
                  <% if (typeof upRecipe !== "undefined" && upRecipe && upRecipe.picture) { %>
                  src="<%= upRecipe.picture %>"
                  alt="Photo de la recette <%= upRecipe.name %>"
                  <% } else { %>
                  src="/images/default-recipe.jpg"
                  alt="Photo de la recette"
                  <% } %>
                />
                <span class="overview-image-hint">
                  <i class="fa-solid fa-magnifying-glass"></i>
                </span>
              </button>
            </div>

            <div class="recette-texte">
              <h3>Contexte de la recette dans le film</h3>
              <% if (typeof upRecipe === "undefined") { %>
                <textarea readonly>Contexte de la recette dans le film
                </textarea>
              <% } else { %>
                <textarea readonly><%= upRecipe.description %></textarea>
              <% } %>

            </div>
          </div>

          <div class="recette-ingredients">
            <h3>Ingrédients</h3>
            <% if (typeof upRecipe === "undefined") { %>
              <textarea readonly>ingredients de la recette </textarea>
            <% } else { %>
              <textarea readonly><%= upRecipe.ingredients %></textarea>
            <% } %>
          </div>

          <div class="recette-preparation">
            <h3>Préparation</h3>
            <% if (typeof upRecipe === "undefined") { %>
              <textarea readonly>preparation de la recette </textarea>
            <% } else { %>
              <textarea readonly><%= upRecipe.preparation %></textarea>
            <% } %>
          </div>
        </section>

        <!-- BOUTONS DE VALIDATION RECETTE-->
        <div class="admin-validation">
          <% if (typeof upRecipe !== "undefined") { %>
            <form method="POST" action="/admin/validateRecipe/<%= upRecipe.id %>">
              <button type="submit" class="btn btn-valid">Valider la recette</button>
            </form>
            <form method="POST" action="/admin/rejectRecipe/<%= upRecipe.id %>">
              <button type="submit" class="btn btn-refus">Refuser la recette</button>
            </form>
          <% } else { %>
            <button class="btn btn-valid" disabled>Valider la recette</button>
            <button class="btn btn-refus" disabled>Refuser la recette</button>
          <% } %>
        </div>

    <!-- Lightbox pour zoom image -->
    <div id="recipe-lightbox" class="recipe-lightbox">
      <div
        class="recipe-lightbox__backdrop"
        data-lightbox-close
        aria-hidden="true"
      ></div>
      <div class="recipe-lightbox__dialog" role="dialog" aria-modal="true">
        <button
          type="button"
          class="recipe-lightbox__close"
          aria-label="Fermer l'aperçu"
          data-lightbox-close
        >
          &times;
        </button>
        <img
          src=""
          alt="Image du film Ciné Délices"
          class="recipe-lightbox__image"
          loading="lazy"
        />
      </div>
    </div>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- JS Admin -->
    <script src="/js/admin-dashboard.js" defer></script>
    <script src="/js/recipe-detail.js" defer></script>
  </body>
</html>
