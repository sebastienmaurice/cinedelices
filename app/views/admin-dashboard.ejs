<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Espace Administrateur - Ciné Délices</title>
    <meta name="description" content="Ciné Délices — Espace Administrateur" />

    <!-- Ressources globales du css et partials communs -->
    <%- include("partials/head-resources") %>

    <!-- CSS admin -->
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>
  <body>
    <!-- partial HEADER -->
    <%- include("partials/header") %>

    <!-- Bandeau Admin -->
    <div class="admin-header-banner">Espace Administrateur</div>

    <div class="admin-container">
      <!-- Sidebar gauche -->
      <aside class="admin-sidebar">
        <button class="sidebar-btn" data-target="recettes">
          <i class="fa-solid fa-utensils"></i> Validation des recettes
        </button>
        <div class="sidebar-list" id="recettes">
          <button class="list-item">Tiramisu du Parrain</button>
          <button class="list-item">Popcorn caramel - Grease</button>
          <button class="list-item">Ramen du Voyage de Chihiro</button>
        </div>

        <button class="sidebar-btn" data-target="films">
          <i class="fa-solid fa-film"></i> Films à valider
        </button>
        <div class="sidebar-list" id="films">
          <button class="list-item">Le Parrain</button>
          <button class="list-item">Ratatouille</button>
          <button class="list-item">James Bond - Skyfall</button>
        </div>
      </aside>

      <!-- Contenu principal -->
      <main class="admin-main">
        <!-- Film -->
        <h2 class="admin-section-title">Film</h2>
        <section class="admin-section film-section">
          <div class="section-content">
            <p><strong>Nom du film :</strong> <span>Le Parrain</span></p>
            <p><strong>Année du film :</strong> <span>1972</span></p>
            <p><strong>Genre :</strong> <span>Drame, Mafia</span></p>
          </div>
        </section>

        <!-- Recette -->
        <h2 class="admin-section-title">Recette</h2>
        <section class="admin-section recette-section">
          <div class="recette-details">
            <!-- Photo à gauche -->
            <div class="recette-photo">
              <img
                src="/images/dessert-backtothefuture-2.jpg"
                alt="Photo de la recette"
              />
            </div>

            <!-- Contexte à droite -->
            <div class="recette-contexte">
              <h3>Contexte de la recette dans le film</h3>
              <textarea readonly>
Le dessert apparaît dans le laboratoire du Doc, lors de la scène emblématique du voyage dans le temps.
              </textarea>
            </div>
          </div>

          <!-- Ingrédients et Préparation en dessous -->
          <div class="recette-ingredients">
            <h3>Ingrédients</h3>
            <textarea readonly>
Sucre, farine, beurre, œufs, vanille, chocolat.
            </textarea>
          </div>

          <div class="recette-preparation">
            <h3>Préparation</h3>
            <textarea readonly>
1. Préchauffer le four. 2. Mélanger les ingrédients. 3. Cuire 25 min. 4. Laisser refroidir.
            </textarea>
          </div>
        </section>

        <!-- Validation Admin -->
        <div class="admin-validation">
          <button class="btn-valid">Valider la fiche</button>
          <button class="btn-refus">Refuser la fiche</button>
        </div>
      </main>
    </div>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- JS Admin -->
    <!-- ⚠️ chemin corrigé pour correspondre à ton dossier /JS/ -->
    <script src="/JS/admin-dashboard.js" defer></script>
  </body>
</html>
