<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Administration — Ciné Délices</title>
    <meta name="robots" content="noindex, nofollow" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@400;600;700&family=Lato:ital,wght@0,300;0,400;0,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>
  <body>

    <!-- ═══════════════════════════════════════════
         SIDEBAR
    ═══════════════════════════════════════════ -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-logo">
        <span class="sidebar-logo__icon">🎬</span>
        <span class="sidebar-logo__text">Ciné Délices</span>
        <span class="sidebar-logo__badge">Admin</span>
      </div>

      <nav class="sidebar-nav">
        <p class="sidebar-nav__label">Tableau de bord</p>
        <button class="nav-item is-active" data-nav-view="dashboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Vue d'ensemble</span>
        </button>

        <p class="sidebar-nav__label">Modération</p>
        <button class="nav-item" data-nav-view="films">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
          <span>Films</span>
          <% const pendingMoviesCount = movies ? movies.filter(m => m.status === 'pending').length : 0; %>
          <% if (pendingMoviesCount > 0) { %><span class="nav-badge"><%= pendingMoviesCount %></span><% } %>
        </button>
        <button class="nav-item" data-nav-view="recettes">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2"/><path d="M18 15h.01"/><path d="M18 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
          <span>Recettes</span>
          <% const pendingRecipesCount = recipes ? recipes.filter(r => r.status === 'pending').length : 0; %>
          <% if (pendingRecipesCount > 0) { %><span class="nav-badge"><%= pendingRecipesCount %></span><% } %>
        </button>
        <button class="nav-item" data-nav-view="avis">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Avis</span>
          <% const pendingAvisCount = avis ? avis.filter(a => a.status === 'pending').length : 0; %>
          <% if (pendingAvisCount > 0) { %><span class="nav-badge"><%= pendingAvisCount %></span><% } %>
        </button>
        <button class="nav-item" data-nav-view="demandes">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>Demandes</span>
          <% const totalDemandes = (pendingMovieEdits ? pendingMovieEdits.length : 0) + (pendingRecipeEdits ? pendingRecipeEdits.length : 0) + (pendingNoticeEdits ? pendingNoticeEdits.length : 0) + (pendingMovieDeleteRequests ? pendingMovieDeleteRequests.length : 0) + (pendingNoticeDeleteRequests ? pendingNoticeDeleteRequests.length : 0) + (pendingRecipeDeleteRequests ? pendingRecipeDeleteRequests.length : 0); %>
          <% if (totalDemandes > 0) { %><span class="nav-badge"><%= totalDemandes %></span><% } %>
        </button>

        <p class="sidebar-nav__label">Médias</p>
        <button class="nav-item" data-nav-view="photos">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Photos profil</span>
          <% if (pendingProfilePhotos && pendingProfilePhotos.length > 0) { %><span class="nav-badge"><%= pendingProfilePhotos.length %></span><% } %>
        </button>
        <button class="nav-item" data-nav-view="bannieres">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span>Bannières</span>
          <% if (pendingBanners && pendingBanners.length > 0) { %><span class="nav-badge"><%= pendingBanners.length %></span><% } %>
        </button>

        <p class="sidebar-nav__label">Communauté</p>
        <button class="nav-item" data-nav-view="utilisateurs">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Utilisateurs</span>
        </button>
        <button class="nav-item" data-nav-view="publies">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>
          <span>Contenus publiés</span>
        </button>
      </nav>

      <div class="sidebar-footer">
        <a href="/" class="sidebar-footer__link" target="_blank">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Voir le site
        </a>
        <a href="/logout" class="sidebar-footer__link sidebar-footer__link--logout">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Déconnexion
        </a>
      </div>
    </aside>

    <!-- ═══════════════════════════════════════════
         MAIN WRAPPER
    ═══════════════════════════════════════════ -->
    <div class="main-wrapper">

      <!-- TOPBAR -->
      <header class="topbar">
        <div class="topbar-left">
          <button class="topbar-burger" id="sidebar-toggle" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <nav class="topbar-breadcrumb" id="topbar-breadcrumb" aria-label="Fil d'ariane">
            <span class="topbar-breadcrumb__item">Admin</span>
            <span class="topbar-breadcrumb__sep">›</span>
            <span class="topbar-breadcrumb__item topbar-breadcrumb__item--current" id="breadcrumb-current">Vue d'ensemble</span>
          </nav>
        </div>
        <div class="topbar-right">
          <div class="topbar-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="Recherche globale…" id="topbar-search-input" autocomplete="off" />
          </div>
          <a href="/" class="topbar-site-link" target="_blank" title="Voir le site">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </header>

      <!-- CONTENT AREA -->
      <main class="content">

        <!-- ═══════════════════════════════════════════
             VUE — DASHBOARD
        ═══════════════════════════════════════════ -->
        <section class="view is-active" data-view-id="dashboard">
          <div class="page-header">
            <h1 class="page-header__title">Vue d'ensemble</h1>
            <p class="page-header__sub">Bienvenue dans l'espace d'administration Ciné Délices.</p>
          </div>

          <!-- Stats rapides -->
          <div class="stats-grid">
            <div class="stat-card stat-card--orange">
              <div class="stat-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </div>
              <div class="stat-card__body">
                <span class="stat-card__value"><%= (movies ? movies.filter(m => m.status === 'pending').length : 0) + (recipes ? recipes.filter(r => r.status === 'pending').length : 0) + (avis ? avis.filter(a => a.status === 'pending').length : 0) %></span>
                <span class="stat-card__label">En attente de validation</span>
              </div>
            </div>
            <div class="stat-card stat-card--violet">
              <div class="stat-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="stat-card__body">
                <span class="stat-card__value"><%= totalDemandes %></span>
                <span class="stat-card__label">Demandes en cours</span>
              </div>
            </div>
            <div class="stat-card stat-card--vert">
              <div class="stat-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="stat-card__body">
                <span class="stat-card__value"><%= (validatedMovies ? validatedMovies.length : 0) + (validatedRecipes ? validatedRecipes.length : 0) + (validatedNotices ? validatedNotices.length : 0) %></span>
                <span class="stat-card__label">Contenus validés</span>
              </div>
            </div>
            <div class="stat-card stat-card--or">
              <div class="stat-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div class="stat-card__body">
                <span class="stat-card__value"><%= users ? users.length : 0 %></span>
                <span class="stat-card__label">Utilisateurs inscrits</span>
              </div>
            </div>
          </div>

          <!-- Grille rapide -->
          <div class="dash-grid">
            <div class="dash-card">
              <h3 class="dash-card__title">Activité récente</h3>
              <ul class="activity-feed">
                <% if (movies && movies.filter(m => m.status === 'pending').length > 0) { %>
                <li class="activity-item activity-item--orange">
                  <span class="activity-dot"></span>
                  <span><strong><%= movies.filter(m => m.status === 'pending').length %></strong> film(s) en attente de validation</span>
                </li>
                <% } %>
                <% if (recipes && recipes.filter(r => r.status === 'pending').length > 0) { %>
                <li class="activity-item activity-item--or">
                  <span class="activity-dot"></span>
                  <span><strong><%= recipes.filter(r => r.status === 'pending').length %></strong> recette(s) en attente de validation</span>
                </li>
                <% } %>
                <% if (avis && avis.filter(a => a.status === 'pending').length > 0) { %>
                <li class="activity-item activity-item--violet">
                  <span class="activity-dot"></span>
                  <span><strong><%= avis.filter(a => a.status === 'pending').length %></strong> avis en attente de validation</span>
                </li>
                <% } %>
                <% if (pendingProfilePhotos && pendingProfilePhotos.length > 0) { %>
                <li class="activity-item activity-item--vert">
                  <span class="activity-dot"></span>
                  <span><strong><%= pendingProfilePhotos.length %></strong> photo(s) de profil à modérer</span>
                </li>
                <% } %>
                <% if (pendingBanners && pendingBanners.length > 0) { %>
                <li class="activity-item activity-item--vert">
                  <span class="activity-dot"></span>
                  <span><strong><%= pendingBanners.length %></strong> bannière(s) à modérer</span>
                </li>
                <% } %>
                <% if ((movies ? movies.filter(m => m.status === 'pending').length : 0) === 0 && (recipes ? recipes.filter(r => r.status === 'pending').length : 0) === 0 && (avis ? avis.filter(a => a.status === 'pending').length : 0) === 0 && (!pendingProfilePhotos || pendingProfilePhotos.length === 0) && (!pendingBanners || pendingBanners.length === 0)) { %>
                <li class="activity-item">
                  <span class="activity-dot activity-dot--vert"></span>
                  <span>Tout est à jour — aucune modération en attente.</span>
                </li>
                <% } %>
              </ul>
            </div>
            <div class="dash-card">
              <h3 class="dash-card__title">Résumé rapide</h3>
              <ul class="quick-stats">
                <li class="qs-item">
                  <span class="qs-label">Films publiés</span>
                  <span class="qs-value"><%= validatedMovies ? validatedMovies.length : 0 %></span>
                </li>
                <li class="qs-item">
                  <span class="qs-label">Recettes publiées</span>
                  <span class="qs-value"><%= validatedRecipes ? validatedRecipes.length : 0 %></span>
                </li>
                <li class="qs-item">
                  <span class="qs-label">Avis publiés</span>
                  <span class="qs-value"><%= validatedNotices ? validatedNotices.length : 0 %></span>
                </li>
                <li class="qs-item">
                  <span class="qs-label">Modifications en attente</span>
                  <span class="qs-value qs-value--orange"><%= (pendingMovieEdits ? pendingMovieEdits.length : 0) + (pendingRecipeEdits ? pendingRecipeEdits.length : 0) + (pendingNoticeEdits ? pendingNoticeEdits.length : 0) %></span>
                </li>
                <li class="qs-item">
                  <span class="qs-label">Suppressions en attente</span>
                  <span class="qs-value qs-value--rouge"><%= (pendingMovieDeleteRequests ? pendingMovieDeleteRequests.length : 0) + (pendingNoticeDeleteRequests ? pendingNoticeDeleteRequests.length : 0) + (pendingRecipeDeleteRequests ? pendingRecipeDeleteRequests.length : 0) %></span>
                </li>
              </ul>
            </div>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — FILMS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="films">
          <div class="page-header">
            <h1 class="page-header__title">Films</h1>
            <p class="page-header__sub">Validation et gestion des films soumis par la communauté.</p>
          </div>

          <div class="queue-tabs" role="tablist">
            <button class="queue-tab is-active" data-sub-tab="films-pending" role="tab">
              En attente
              <% const filmsPending = movies ? movies.filter(m => m.status === 'pending') : []; %>
              <% if (filmsPending.length > 0) { %><span class="queue-tab__count"><%= filmsPending.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="films-validated" role="tab">
              Validés
              <% if (validatedMovies && validatedMovies.length > 0) { %><span class="queue-tab__count queue-tab__count--vert"><%= validatedMovies.length %></span><% } %>
            </button>
          </div>

          <!-- Sous-panel : Films en attente -->
          <div class="sub-panel" id="films-pending">
            <% if (filmsPending.length === 0) { %>
            <div class="empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <p>Aucun film en attente de validation.</p>
            </div>
            <% } else { %>
            <div class="filter-bar">
              <input type="text" class="filter-bar__search" placeholder="Filtrer les films…" data-filter-input="films-pending" />
            </div>
            <% filmsPending.forEach(function(movie) { %>
            <div class="movie-val-panel" data-search-item="<%= (movie.title || '').toLowerCase() %>">
              <div class="movie-val-panel__poster">
                <% if (movie.poster) { %>
                <img src="<%= movie.poster %>" alt="Affiche <%= movie.title %>" loading="lazy" />
                <% } else { %>
                <div class="movie-val-panel__poster--placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
                </div>
                <% } %>
              </div>
              <div class="movie-val-panel__body">
                <div class="movie-val-panel__meta">
                  <h3 class="movie-val-panel__title"><%= movie.title %></h3>
                  <span class="s-badge s-badge--pending">En attente</span>
                </div>
                <div class="movie-val-panel__info">
                  <% if (movie.year) { %><span class="tag"><%= movie.year %></span><% } %>
                  <% if (movie.genre) { %><span class="tag"><%= movie.genre %></span><% } %>
                  <% if (movie.director) { %><span class="tag">Réal. <%= movie.director %></span><% } %>
                  <% if (movie.User?.pseudo) { %><span class="tag tag--user">Par : <%= movie.User.pseudo %></span><% } %>
                </div>
                <% if (movie.synopsis) { %>
                <p class="movie-val-panel__synopsis"><%= movie.synopsis.substring(0, 240) %><%= movie.synopsis.length > 240 ? '…' : '' %></p>
                <% } %>
                <div class="movie-val-panel__actions">
                  <form action="/admin/validateMovie/<%= movie.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      Valider
                    </button>
                  </form>
                  <form action="/admin/rejectMovie/<%= movie.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      Refuser
                    </button>
                  </form>
                  <button type="button" class="act-btn act-btn--edit"
                    data-edit-btn
                    data-edit-type="movie"
                    data-edit-id="<%= movie.id %>"
                    data-edit-title="<%= movie.title %>"
                    data-edit-year="<%= movie.year || '' %>"
                    data-edit-genre="<%= movie.genre || '' %>"
                    data-edit-synopsis="<%= String(movie.synopsis || '').replace(/"/g, '&quot;') %>">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Éditer
                  </button>
                </div>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>

          <!-- Sous-panel : Films validés -->
          <div class="sub-panel" id="films-validated" style="display:none;">
            <% if (!validatedMovies || validatedMovies.length === 0) { %>
            <div class="empty-state">
              <p>Aucun film validé.</p>
            </div>
            <% } else { %>
            <div class="filter-bar">
              <input type="text" class="filter-bar__search" placeholder="Filtrer les films validés…" data-filter-input="films-validated" />
            </div>
            <table class="ctable">
              <thead>
                <tr>
                  <th>Film</th>
                  <th>Année</th>
                  <th>Genre</th>
                  <th>Soumis par</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% validatedMovies.forEach(function(movie) { %>
                <tr class="admin-list-item" data-search="<%= (movie.title || '').toLowerCase() + ' ' + (movie.genre || '').toLowerCase() %>">
                  <td class="cell-media">
                    <% if (movie.poster) { %><img src="<%= movie.poster %>" alt="" class="cell-media__thumb" /><% } %>
                    <span class="cell-media__title"><%= movie.title %></span>
                  </td>
                  <td><%= movie.year || '—' %></td>
                  <td><span class="tag"><%= movie.genre || '—' %></span></td>
                  <td class="user-cell"><%= movie.User?.pseudo || '—' %></td>
                  <td class="actions-cell">
                    <button type="button" class="act-btn act-btn--edit act-btn--sm"
                      data-edit-btn
                      data-edit-type="movie"
                      data-edit-id="<%= movie.id %>"
                      data-edit-title="<%= movie.title %>"
                      data-edit-year="<%= movie.year || '' %>"
                      data-edit-genre="<%= movie.genre || '' %>"
                      data-edit-synopsis="<%= String(movie.synopsis || '').replace(/"/g, '&quot;') %>">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                    <form action="/admin/movies/<%= movie.id %>/delete/direct" method="POST" style="display:inline;">
                      <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <% } %>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — RECETTES
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="recettes">
          <div class="page-header">
            <h1 class="page-header__title">Recettes</h1>
            <p class="page-header__sub">Validation et gestion des recettes soumises.</p>
          </div>

          <div class="queue-tabs" role="tablist">
            <button class="queue-tab is-active" data-sub-tab="recettes-pending" role="tab">
              En attente
              <% const recipesPending = recipes ? recipes.filter(r => r.status === 'pending') : []; %>
              <% if (recipesPending.length > 0) { %><span class="queue-tab__count"><%= recipesPending.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="recettes-validated" role="tab">
              Validées
              <% if (validatedRecipes && validatedRecipes.length > 0) { %><span class="queue-tab__count queue-tab__count--vert"><%= validatedRecipes.length %></span><% } %>
            </button>
          </div>

          <!-- Sous-panel : Recettes en attente -->
          <div class="sub-panel" id="recettes-pending">
            <% if (recipesPending.length === 0) { %>
            <div class="empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <p>Aucune recette en attente de validation.</p>
            </div>
            <% } else { %>
            <div class="filter-bar">
              <input type="text" class="filter-bar__search" placeholder="Filtrer les recettes…" data-filter-input="recettes-pending" />
            </div>
            <% recipesPending.forEach(function(recipe) { %>
            <div class="recipe-val-panel" data-search-item="<%= (recipe.name || '').toLowerCase() %>">
              <div class="recipe-val-panel__header">
                <div>
                  <h3 class="recipe-val-panel__title"><%= recipe.name %></h3>
                  <div class="recipe-val-panel__meta">
                    <% if (recipe.category) { %><span class="tag"><%= recipe.category %></span><% } %>
                    <% if (recipe.time) { %><span class="tag"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> <%= recipe.time %> min</span><% } %>
                    <% if (recipe.difficulty) { %><span class="tag"><%= recipe.difficulty %></span><% } %>
                    <% if (recipe.contributor?.pseudo) { %><span class="tag tag--user">Par : <%= recipe.contributor.pseudo %></span><% } %>
                  </div>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
                  <span class="s-badge s-badge--pending">En attente</span>
                  <% if (recipe.edit_requested_at && recipe.edit_status !== 'pending') { %>
                  <span class="s-badge" style="background:rgba(80,80,180,.18);border:1px solid rgba(120,120,220,.35);color:rgba(160,160,255,.9);font-size:.55rem;">
                    🔄 Resoumission — <%= new Date(recipe.edit_requested_at).toLocaleDateString('fr-FR') %>
                  </span>
                  <% } %>
                </div>
              </div>

              <% const rPics = (recipe.RecipePictures || []).slice().sort((a,b)=>a.position-b.position); %>
              <% if (rPics.length > 0) { %>
              <div class="recipe-val-panel__img-wrap" style="display:flex;gap:6px;flex-wrap:wrap;align-items:flex-start;">
                <% rPics.forEach(function(pic) { %>
                <div style="position:relative;flex:1;min-width:0;max-width:calc(33% - 4px);">
                  <img src="<%= pic.file_path %>" alt="<%= recipe.name %>" class="recipe-val-panel__img" style="width:100%;display:block;" data-lightbox-trigger data-lightbox-src="<%= pic.file_path %>" data-lightbox-alt="<%= recipe.name %>" />
                  <span class="rpic-label" style="position:absolute;top:4px;left:4px;background:rgba(5,10,18,.75);color:rgba(232,232,232,.6);font-size:.42rem;font-weight:700;letter-spacing:.08em;padding:2px 6px;border-radius:4px;text-transform:uppercase;">Photo <%= pic.position %></span>
                  <% if (pic.position >= 2 && pic.id) { %>
                  <form action="/admin/recipe-pictures/<%= pic.id %>/delete" method="POST" style="position:absolute;top:4px;right:4px;" onsubmit="return confirm('Supprimer cette photo complémentaire ?')">
                    <button type="submit" title="Refuser cette photo" style="background:rgba(180,30,20,.82);border:none;border-radius:4px;padding:3px 7px;color:#fff;font-size:.55rem;font-weight:700;cursor:pointer;line-height:1.2;">✕ Refuser</button>
                  </form>
                  <% } %>
                </div>
                <% }) %>
              </div>
              <% } else if (recipe.picture) { %>
              <div class="recipe-val-panel__img-wrap">
                <img src="<%= recipe.picture %>" alt="<%= recipe.name %>" class="recipe-val-panel__img" data-lightbox-trigger data-lightbox-src="<%= recipe.picture %>" data-lightbox-alt="<%= recipe.name %>" />
              </div>
              <% } %>

              <% if (recipe.description) { %>
              <p class="recipe-val-panel__desc"><%= recipe.description %></p>
              <% } %>

              <% if (recipe.ingredients) { %>
              <div class="recipe-val-panel__section">
                <h4 class="recipe-val-panel__section-title">Ingrédients</h4>
                <pre class="recipe-val-panel__pre"><%= recipe.ingredients %></pre>
              </div>
              <% } %>

              <% if (recipe.preparation) { %>
              <div class="recipe-val-panel__section">
                <h4 class="recipe-val-panel__section-title">Préparation</h4>
                <pre class="recipe-val-panel__pre"><%= recipe.preparation %></pre>
              </div>
              <% } %>

              <div class="recipe-val-panel__actions">
                <form action="/admin/validateRecipe/<%= recipe.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--approve">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    Valider
                  </button>
                </form>
                <form action="/admin/rejectRecipe/<%= recipe.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--reject">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Refuser
                  </button>
                </form>
                <button type="button" class="act-btn act-btn--edit"
                  data-edit-btn
                  data-edit-type="recipe"
                  data-edit-id="<%= recipe.id %>"
                  data-edit-name="<%= recipe.name %>"
                  data-edit-category="<%= recipe.category || '' %>"
                  data-edit-time="<%= recipe.time || '' %>"
                  data-edit-difficulty="<%= recipe.difficulty || '' %>"
                  data-edit-description="<%= String(recipe.description || '').replace(/"/g, '&quot;') %>"
                  data-edit-ingredients="<%= String(recipe.ingredients || '').replace(/"/g, '&quot;') %>"
                  data-edit-preparation="<%= String(recipe.preparation || '').replace(/"/g, '&quot;') %>">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  Éditer
                </button>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>

          <!-- Sous-panel : Recettes validées -->
          <div class="sub-panel" id="recettes-validated" style="display:none;">
            <% if (!validatedRecipes || validatedRecipes.length === 0) { %>
            <div class="empty-state"><p>Aucune recette validée.</p></div>
            <% } else { %>
            <div class="filter-bar">
              <input type="text" class="filter-bar__search" placeholder="Filtrer les recettes validées…" data-filter-input="recettes-validated" />
            </div>
            <table class="ctable">
              <thead>
                <tr>
                  <th>Recette</th>
                  <th>Catégorie</th>
                  <th>Difficulté</th>
                  <th>Soumis par</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% validatedRecipes.forEach(function(recipe) { %>
                <tr class="admin-list-item" data-search="<%= (recipe.name || '').toLowerCase() + ' ' + (recipe.category || '').toLowerCase() %>">
                  <td class="cell-media">
                    <% const thumb = (recipe.RecipePictures && recipe.RecipePictures.length > 0) ? recipe.RecipePictures[0].file_path : recipe.picture; %>
                    <% if (thumb) { %><img src="<%= thumb %>" alt="" class="cell-media__thumb" /><% } %>
                    <span class="cell-media__title"><%= recipe.name %></span>
                  </td>
                  <td><span class="tag"><%= recipe.category || '—' %></span></td>
                  <td><%= recipe.difficulty || '—' %></td>
                  <td class="user-cell"><%= recipe.contributor?.pseudo || '—' %></td>
                  <td class="actions-cell">
                    <button type="button" class="act-btn act-btn--edit act-btn--sm"
                      data-edit-btn
                      data-edit-type="recipe"
                      data-edit-id="<%= recipe.id %>"
                      data-edit-name="<%= recipe.name %>"
                      data-edit-category="<%= recipe.category || '' %>"
                      data-edit-time="<%= recipe.time || '' %>"
                      data-edit-difficulty="<%= recipe.difficulty || '' %>"
                      data-edit-description="<%= String(recipe.description || '').replace(/"/g, '&quot;') %>"
                      data-edit-ingredients="<%= String(recipe.ingredients || '').replace(/"/g, '&quot;') %>"
                      data-edit-preparation="<%= String(recipe.preparation || '').replace(/"/g, '&quot;') %>">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                    <form action="/admin/recipes/<%= recipe.id %>/delete/direct" method="POST" style="display:inline;">
                      <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <% } %>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — AVIS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="avis">
          <div class="page-header">
            <h1 class="page-header__title">Avis</h1>
            <p class="page-header__sub">Modération des avis et commentaires communautaires.</p>
          </div>

          <% const avisPending = avis ? avis.filter(a => a.status === 'pending') : []; %>

          <% if (avisPending.length === 0) { %>
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p>Aucun avis en attente de validation.</p>
          </div>
          <% } else { %>
          <div class="filter-bar">
            <input type="text" class="filter-bar__search" placeholder="Filtrer les avis…" data-filter-input="avis" />
          </div>
          <table class="ctable">
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Recette</th>
                <th>Note</th>
                <th>Commentaire</th>
                <th>Statut</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% avisPending.forEach(function(notice) { %>
              <tr class="admin-list-item" data-search="<%= notice.id %>">
                <td class="user-cell"><%= notice.id_user || '—' %></td>
                <td><%= notice.id_recipe || '—' %></td>
                <td class="score-cell">
                  <% if (notice.quote) { %>
                  <span class="score-badge"><%= notice.quote %>/5</span>
                  <% } else { %>—<% } %>
                </td>
                <td><span class="cell-excerpt"><%= (notice.content || '').substring(0, 80) %>…</span></td>
                <td><span class="s-badge s-badge--pending">En attente</span></td>
                <td class="actions-cell">
                  <form action="/admin/validateNotice/<%= notice.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Valider">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </button>
                  </form>
                  <form action="/admin/rejectNotice/<%= notice.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                  <button type="button" class="act-btn act-btn--edit act-btn--sm" title="Éditer"
                    data-edit-btn
                    data-edit-type="notice"
                    data-edit-id="<%= notice.id %>"
                    data-edit-content="<%= String(notice.content || '').replace(/"/g, '&quot;') %>"
                    data-edit-quote="<%= notice.quote || '' %>"
                    data-edit-author="<%= notice.id_user || '' %>"
                    data-edit-recipe="<%= notice.id_recipe || '' %>">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <form action="/admin/notices/<%= notice.id %>/delete/direct" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — DEMANDES
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="demandes">
          <div class="page-header">
            <h1 class="page-header__title">Demandes</h1>
            <p class="page-header__sub">Modifications et suppressions demandées par les utilisateurs.</p>
          </div>

          <div class="queue-tabs" role="tablist">
            <button class="queue-tab is-active" data-sub-tab="demandes-movie-edits" role="tab">
              Modif. Films
              <% if (pendingMovieEdits && pendingMovieEdits.length > 0) { %><span class="queue-tab__count"><%= pendingMovieEdits.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="demandes-recipe-edits" role="tab">
              Modif. Recettes
              <% if (pendingRecipeEdits && pendingRecipeEdits.length > 0) { %><span class="queue-tab__count"><%= pendingRecipeEdits.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="demandes-notice-edits" role="tab">
              Modif. Avis
              <% if (pendingNoticeEdits && pendingNoticeEdits.length > 0) { %><span class="queue-tab__count"><%= pendingNoticeEdits.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="demandes-movie-deletes" role="tab">
              Suppr. Films
              <% if (pendingMovieDeleteRequests && pendingMovieDeleteRequests.length > 0) { %><span class="queue-tab__count queue-tab__count--rouge"><%= pendingMovieDeleteRequests.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="demandes-recipe-deletes" role="tab">
              Suppr. Recettes
              <% if (pendingRecipeDeleteRequests && pendingRecipeDeleteRequests.length > 0) { %><span class="queue-tab__count queue-tab__count--rouge"><%= pendingRecipeDeleteRequests.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="demandes-notice-deletes" role="tab">
              Suppr. Avis
              <% if (pendingNoticeDeleteRequests && pendingNoticeDeleteRequests.length > 0) { %><span class="queue-tab__count queue-tab__count--rouge"><%= pendingNoticeDeleteRequests.length %></span><% } %>
            </button>
          </div>

          <!-- Modifications Films -->
          <div class="sub-panel" id="demandes-movie-edits">
            <% if (!pendingMovieEdits || pendingMovieEdits.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de modification de film.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingMovieEdits.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="s-badge s-badge--modif">Modification</span>
                  <strong class="mod-row__title"><%= req.title || 'Film inconnu' %></strong>
                  <% if (req.User) { %><span class="mod-row__user">par <%= req.User.pseudo %></span><% } %>
                  <ul class="mod-row__changes">
                    <% if (req.pending_title && req.pending_title !== req.title) { %><li><em>Titre :</em> <s class="mod-old"><%= req.title %></s> → <strong class="mod-new"><%= req.pending_title %></strong></li><% } %>
                    <% if (req.pending_year && req.pending_year !== req.year) { %><li><em>Année :</em> <s class="mod-old"><%= req.year %></s> → <strong class="mod-new"><%= req.pending_year %></strong></li><% } %>
                    <% if (req.pending_genre && req.pending_genre !== req.genre) { %><li><em>Genre :</em> <s class="mod-old"><%= req.genre %></s> → <strong class="mod-new"><%= req.pending_genre %></strong></li><% } %>
                  </ul>
                </div>
                <div class="actions-cell">
                  <form action="/admin/movies/<%= req.id %>/edit/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Approuver la modification">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </button>
                  </form>
                  <form action="/admin/movies/<%= req.id %>/edit/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la modification">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Modifications Recettes -->
          <div class="sub-panel" id="demandes-recipe-edits" style="display:none;">
            <% if (!pendingRecipeEdits || pendingRecipeEdits.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de modification de recette.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingRecipeEdits.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="s-badge s-badge--modif">Modification</span>
                  <strong class="mod-row__title"><%= req.name || 'Recette inconnue' %></strong>
                  <% if (req.contributor) { %><span class="mod-row__user">par <%= req.contributor.pseudo %></span><% } %>
                  <ul class="mod-row__changes">
                    <% if (req.pending_name && req.pending_name !== req.name) { %><li><em>Nom :</em> <s class="mod-old"><%= req.name %></s> → <strong class="mod-new"><%= req.pending_name %></strong></li><% } %>
                    <% if (req.pending_category && req.pending_category !== req.category) { %><li><em>Catégorie :</em> <s class="mod-old"><%= req.category %></s> → <strong class="mod-new"><%= req.pending_category %></strong></li><% } %>
                    <% if (req.pending_difficulty && req.pending_difficulty !== req.difficulty) { %><li><em>Difficulté :</em> <s class="mod-old"><%= req.difficulty %></s> → <strong class="mod-new"><%= req.pending_difficulty %></strong></li><% } %>
                    <% if (req.pending_time && req.pending_time !== req.time) { %><li><em>Temps :</em> <s class="mod-old"><%= req.time %> min</s> → <strong class="mod-new"><%= req.pending_time %> min</strong></li><% } %>
                    <% if (req.pending_description) { %><li><em>Description :</em> <s class="mod-old">"<%= req.description.substring(0, 60) %>…"</s> → <strong class="mod-new">"<%= req.pending_description.substring(0, 60) %>…"</strong></li><% } %>
                    <% if (req.pending_ingredients) { %><li><em>Ingrédients :</em><br><s class="mod-old mod-block">"<%= req.ingredients.substring(0, 120) %>…"</s><br>→ <strong class="mod-new mod-block">"<%= req.pending_ingredients.substring(0, 120) %>…"</strong></li><% } %>
                    <% if (req.pending_preparation) { %><li><em>Préparation :</em><br><s class="mod-old mod-block">"<%= req.preparation.substring(0, 120) %>…"</s><br>→ <strong class="mod-new mod-block">"<%= req.pending_preparation.substring(0, 120) %>…"</strong></li><% } %>
                    <% if (req.pending_picture) { %><li><em>Photo :</em> <img src="<%= req.picture %>" alt="Actuelle" style="width:48px;height:34px;object-fit:cover;border-radius:3px;vertical-align:middle;opacity:.5;" /> → <img src="<%= req.pending_picture %>" alt="Nouvelle" style="width:56px;height:38px;object-fit:cover;border-radius:4px;vertical-align:middle;border:1px solid rgba(100,210,120,.4);" /></li><% } %>
                  </ul>
                </div>
                <div class="actions-cell">
                  <form action="/admin/recipes/<%= req.id %>/edit/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Approuver la modification">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </button>
                  </form>
                  <form action="/admin/recipes/<%= req.id %>/edit/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la modification">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Modifications Avis -->
          <div class="sub-panel" id="demandes-notice-edits" style="display:none;">
            <% if (!pendingNoticeEdits || pendingNoticeEdits.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de modification d'avis.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingNoticeEdits.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="s-badge s-badge--modif">Modification</span>
                  <strong class="mod-row__title">Avis sur "<%= req.Recipe ? req.Recipe.name : 'recette inconnue' %>"</strong>
                  <% if (req.User) { %><span class="mod-row__user">par <%= req.User.pseudo %></span><% } %>
                  <% if (req.pending_content) { %><p class="mod-row__excerpt">"<%= req.pending_content.substring(0, 120) %>…"</p><% } %>
                </div>
                <div class="actions-cell">
                  <form action="/admin/notices/<%= req.id %>/edit/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--approve act-btn--sm" title="Approuver la modification">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </button>
                  </form>
                  <form action="/admin/notices/<%= req.id %>/edit/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la modification">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Suppressions Films -->
          <div class="sub-panel" id="demandes-movie-deletes" style="display:none;">
            <% if (!pendingMovieDeleteRequests || pendingMovieDeleteRequests.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de suppression de film.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingMovieDeleteRequests.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="s-badge s-badge--delete">Suppression</span>
                  <strong class="mod-row__title"><%= req.title || 'Film inconnu' %></strong>
                  <% if (req.User) { %><span class="mod-row__user">par <%= req.User.pseudo %></span><% } %>
                </div>
                <div class="actions-cell">
                  <form action="/admin/movies/<%= req.id %>/delete/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Confirmer la suppression">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  </form>
                  <form action="/admin/movies/<%= req.id %>/delete/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la suppression">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Suppressions Recettes -->
          <div class="sub-panel" id="demandes-recipe-deletes" style="display:none;">
            <% if (!pendingRecipeDeleteRequests || pendingRecipeDeleteRequests.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de suppression de recette.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingRecipeDeleteRequests.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="s-badge s-badge--delete">Suppression</span>
                  <strong class="mod-row__title"><%= req.name || 'Recette inconnue' %></strong>
                  <% if (req.contributor) { %><span class="mod-row__user">par <%= req.contributor.pseudo %></span><% } %>
                  <% if (req.Movie) { %><p class="mod-row__excerpt">Film : <%= req.Movie.title %></p><% } %>
                </div>
                <div class="actions-cell">
                  <form action="/admin/recipes/<%= req.id %>/delete/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Confirmer la suppression">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  </form>
                  <form action="/admin/recipes/<%= req.id %>/delete/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la suppression">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>

          <!-- Suppressions Avis -->
          <div class="sub-panel" id="demandes-notice-deletes" style="display:none;">
            <% if (!pendingNoticeDeleteRequests || pendingNoticeDeleteRequests.length === 0) { %>
            <div class="empty-state"><p>Aucune demande de suppression d'avis.</p></div>
            <% } else { %>
            <div class="mod-table">
              <% pendingNoticeDeleteRequests.forEach(function(req) { %>
              <div class="mod-row">
                <div class="mod-row__info">
                  <span class="s-badge s-badge--delete">Suppression</span>
                  <strong class="mod-row__title">Avis sur "<%= req.Recipe ? req.Recipe.name : 'recette inconnue' %>"</strong>
                  <% if (req.User) { %><span class="mod-row__user">par <%= req.User.pseudo %></span><% } %>
                  <% if (req.content) { %><p class="mod-row__excerpt">"<%= req.content.substring(0, 120) %>…"</p><% } %>
                </div>
                <div class="actions-cell">
                  <form action="/admin/notices/<%= req.id %>/delete/approve" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Confirmer la suppression">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  </form>
                  <form action="/admin/notices/<%= req.id %>/delete/reject" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--reject act-btn--sm" title="Refuser la suppression">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — PHOTOS PROFIL
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="photos">
          <div class="page-header">
            <h1 class="page-header__title">Photos de profil</h1>
            <p class="page-header__sub">Validation des photos de profil soumises par les utilisateurs.</p>
          </div>

          <% if (!pendingProfilePhotos || pendingProfilePhotos.length === 0) { %>
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p>Aucune photo de profil en attente de validation.</p>
          </div>
          <% } else { %>
          <div class="media-approval-grid">
            <% pendingProfilePhotos.forEach(function(photo) { %>
            <div class="media-card">
              <div class="media-card__img-wrap">
                <img src="<%= photo.pending_picture %>" alt="Photo de profil" class="media-card__img" />
              </div>
              <div class="media-card__body">
                <p class="media-card__user"><%= photo.username || 'Utilisateur inconnu' %></p>
                <span class="s-badge s-badge--pending">En attente</span>
              </div>
              <div class="media-card__actions">
                <form action="/admin/users/<%= photo.id %>/photo/approve" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--approve">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Valider</span>
                  </button>
                </form>
                <form action="/admin/users/<%= photo.id %>/photo/reject" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--reject">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    <span>Refuser</span>
                  </button>
                </form>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — BANNIÈRES
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="bannieres">
          <div class="page-header">
            <h1 class="page-header__title">Bannières</h1>
            <p class="page-header__sub">Validation des bannières de profil soumises par les utilisateurs.</p>
          </div>

          <% if (!pendingBanners || pendingBanners.length === 0) { %>
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p>Aucune bannière en attente de validation.</p>
          </div>
          <% } else { %>
          <div class="media-approval-grid media-approval-grid--wide">
            <% pendingBanners.forEach(function(banner) { %>
            <div class="media-card media-card--banner">
              <div class="media-card__img-wrap media-card__img-wrap--banner">
                <img src="<%= banner.banner_image %>" alt="Bannière" class="media-card__img" />
              </div>
              <div class="media-card__body">
                <p class="media-card__user"><%= banner.pseudo || 'Utilisateur inconnu' %></p>
                <span class="s-badge s-badge--pending">En attente</span>
              </div>
              <div class="media-card__actions">
                <form action="/admin/users/<%= banner.id %>/banner/approve" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--approve">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Valider</span>
                  </button>
                </form>
                <form action="/admin/users/<%= banner.id %>/banner/reject" method="POST" style="display:inline;">
                  <button type="submit" class="act-btn act-btn--reject">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    <span>Refuser</span>
                  </button>
                </form>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — UTILISATEURS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="utilisateurs">
          <div class="page-header">
            <h1 class="page-header__title">Utilisateurs</h1>
            <p class="page-header__sub">Gestion et modération des membres de la communauté.</p>
          </div>

          <div class="filter-bar">
            <input type="text" class="filter-bar__search" placeholder="Rechercher un utilisateur…" data-filter-input="utilisateurs" />
          </div>

          <% const regularUsers = users ? users.filter(u => !u.isAdmin && u.role !== 'admin') : []; %>
          <% const adminUsers = users ? users.filter(u => u.isAdmin || u.role === 'admin') : []; %>

          <% if (adminUsers.length > 0) { %>
          <h3 class="section-title section-title--admin">Administrateurs</h3>
          <table class="ctable">
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Inscrit le</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% adminUsers.forEach(function(user) { %>
              <tr class="admin-list-item" data-search="<%= (user.username || '').toLowerCase() + ' ' + (user.email || '').toLowerCase() %>">
                <td class="user-cell">
                  <% if (user.profilePhoto) { %><img src="<%= user.profilePhoto %>" alt="" class="user-cell__avatar" /><% } %>
                  <span><%= user.username || user.name || '—' %></span>
                </td>
                <td><%= user.email || '—' %></td>
                <td><span class="tag tag--admin">Admin</span></td>
                <td class="date-cell"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('fr-FR') : '—' %></td>
                <td class="actions-cell">—</td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>

          <h3 class="section-title">Membres <span class="section-title__count"><%= regularUsers.length %></span></h3>
          <% if (regularUsers.length === 0) { %>
          <div class="empty-state"><p>Aucun membre inscrit.</p></div>
          <% } else { %>
          <table class="ctable">
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Niveau</th>
                <th>Inscrit le</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% regularUsers.forEach(function(user) { %>
              <tr class="admin-list-item" data-search="<%= (user.username || '').toLowerCase() + ' ' + (user.email || '').toLowerCase() %>">
                <td class="user-cell">
                  <% if (user.profilePhoto) { %><img src="<%= user.profilePhoto %>" alt="" class="user-cell__avatar" /><% } %>
                  <span><%= user.username || user.name || '—' %></span>
                </td>
                <td><%= user.email || '—' %></td>
                <td><span class="lvl-inline">Niv. <%= user.level || 1 %></span></td>
                <td class="date-cell"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('fr-FR') : '—' %></td>
                <td class="actions-cell">
                  <form action="/admin/deleteUser/<%= user._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer l'utilisateur">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </section>


        <!-- ═══════════════════════════════════════════
             VUE — CONTENUS PUBLIÉS
        ═══════════════════════════════════════════ -->
        <section class="view" data-view-id="publies">
          <div class="page-header">
            <h1 class="page-header__title">Contenus publiés</h1>
            <p class="page-header__sub">Tous les contenus validés et visibles sur le site.</p>
          </div>

          <div class="queue-tabs" role="tablist">
            <button class="queue-tab is-active" data-sub-tab="publies-films" role="tab">
              Films
              <% if (validatedMovies && validatedMovies.length > 0) { %><span class="queue-tab__count queue-tab__count--vert"><%= validatedMovies.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="publies-recettes" role="tab">
              Recettes
              <% if (validatedRecipes && validatedRecipes.length > 0) { %><span class="queue-tab__count queue-tab__count--vert"><%= validatedRecipes.length %></span><% } %>
            </button>
            <button class="queue-tab" data-sub-tab="publies-avis" role="tab">
              Avis
              <% if (validatedNotices && validatedNotices.length > 0) { %><span class="queue-tab__count queue-tab__count--vert"><%= validatedNotices.length %></span><% } %>
            </button>
          </div>

          <!-- Films publiés -->
          <div class="sub-panel" id="publies-films">
            <% if (!validatedMovies || validatedMovies.length === 0) { %>
            <div class="empty-state"><p>Aucun film publié.</p></div>
            <% } else { %>
            <div class="admin-published-section" data-page-size="10">
              <div class="filter-bar">
                <input type="text" class="filter-bar__search" placeholder="Rechercher un film publié…" data-search-input />
                <button type="button" class="filter-bar__clear" data-search-clear title="Effacer">×</button>
              </div>
              <div data-no-results style="display:none;" class="empty-state"><p>Aucun résultat pour cette recherche.</p></div>
              <table class="ctable">
                <thead>
                  <tr>
                    <th>Film</th>
                    <th>Année</th>
                    <th>Genre</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% validatedMovies.forEach(function(movie) { %>
                  <tr class="admin-list-item" data-search="<%= (movie.title || '').toLowerCase() + ' ' + (movie.genre || '').toLowerCase() %>">
                    <td class="cell-media">
                      <% if (movie.poster) { %><img src="<%= movie.poster %>" alt="" class="cell-media__thumb" /><% } %>
                      <span class="cell-media__title"><%= movie.title %></span>
                    </td>
                    <td><%= movie.year || '—' %></td>
                    <td><span class="tag"><%= movie.genre || '—' %></span></td>
                    <td class="actions-cell">
                      <button type="button" class="act-btn act-btn--edit act-btn--sm"
                        data-edit-btn
                        data-edit-type="movie"
                        data-edit-id="<%= movie.id %>"
                        data-edit-title="<%= movie.title %>"
                        data-edit-year="<%= movie.year || '' %>"
                        data-edit-genre="<%= movie.genre || '' %>"
                        data-edit-synopsis="<%= String(movie.synopsis || '').replace(/"/g, '&quot;') %>">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <form action="/admin/movies/<%= movie.id %>/delete/direct" method="POST" style="display:inline;">
                        <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="admin-pagination" style="display:none;">
                <button class="btn btn--ghost admin-pagination__prev">← Précédent</button>
                <span class="admin-pagination__info"></span>
                <button class="btn btn--ghost admin-pagination__next">Suivant →</button>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Recettes publiées -->
          <div class="sub-panel" id="publies-recettes" style="display:none;">
            <% if (!validatedRecipes || validatedRecipes.length === 0) { %>
            <div class="empty-state"><p>Aucune recette publiée.</p></div>
            <% } else { %>
            <div class="admin-published-section" data-page-size="10">
              <div class="filter-bar">
                <input type="text" class="filter-bar__search" placeholder="Rechercher une recette publiée…" data-search-input />
                <button type="button" class="filter-bar__clear" data-search-clear title="Effacer">×</button>
              </div>
              <div data-no-results style="display:none;" class="empty-state"><p>Aucun résultat pour cette recherche.</p></div>
              <table class="ctable">
                <thead>
                  <tr>
                    <th>Recette</th>
                    <th>Catégorie</th>
                    <th>Difficulté</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% validatedRecipes.forEach(function(recipe) { %>
                  <tr class="admin-list-item" data-search="<%= (recipe.name || '').toLowerCase() + ' ' + (recipe.category || '').toLowerCase() %>">
                    <td class="cell-media">
                      <% const vThumb = (recipe.RecipePictures && recipe.RecipePictures.length > 0) ? recipe.RecipePictures[0].file_path : recipe.picture; %>
                      <% if (vThumb) { %><img src="<%= vThumb %>" alt="" class="cell-media__thumb" /><% } %>
                      <span class="cell-media__title"><%= recipe.name %></span>
                    </td>
                    <td><span class="tag"><%= recipe.category || '—' %></span></td>
                    <td><%= recipe.difficulty || '—' %></td>
                    <td class="actions-cell">
                      <button type="button" class="act-btn act-btn--edit act-btn--sm"
                        data-edit-btn
                        data-edit-type="recipe"
                        data-edit-id="<%= recipe.id %>"
                        data-edit-name="<%= recipe.name %>"
                        data-edit-category="<%= recipe.category || '' %>"
                        data-edit-time="<%= recipe.preparationTime || '' %>"
                        data-edit-difficulty="<%= recipe.difficulty || '' %>"
                        data-edit-description="<%= String(recipe.description || '').replace(/"/g, '&quot;') %>"
                        data-edit-ingredients="<%= String(recipe.ingredients || '').replace(/"/g, '&quot;') %>"
                        data-edit-preparation="<%= String(recipe.preparation || '').replace(/"/g, '&quot;') %>">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <form action="/admin/recipes/<%= recipe.id %>/delete/direct" method="POST" style="display:inline;">
                        <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="admin-pagination" style="display:none;">
                <button class="btn btn--ghost admin-pagination__prev">← Précédent</button>
                <span class="admin-pagination__info"></span>
                <button class="btn btn--ghost admin-pagination__next">Suivant →</button>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Avis publiés -->
          <div class="sub-panel" id="publies-avis" style="display:none;">
            <% if (!validatedNotices || validatedNotices.length === 0) { %>
            <div class="empty-state"><p>Aucun avis publié.</p></div>
            <% } else { %>
            <div class="admin-published-section" data-page-size="10">
              <div class="filter-bar">
                <input type="text" class="filter-bar__search" placeholder="Rechercher un avis publié…" data-search-input />
                <button type="button" class="filter-bar__clear" data-search-clear title="Effacer">×</button>
              </div>
              <div data-no-results style="display:none;" class="empty-state"><p>Aucun résultat pour cette recherche.</p></div>
              <table class="ctable">
                <thead>
                  <tr>
                    <th>Utilisateur</th>
                    <th>Recette</th>
                    <th>Note</th>
                    <th>Commentaire</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% validatedNotices.forEach(function(notice) { %>
                  <tr class="admin-list-item" data-search="<%= (notice.user || notice.author || '').toLowerCase() + ' ' + (notice.recipe || '').toLowerCase() %>">
                    <td class="user-cell"><%= notice.user || notice.author || '—' %></td>
                    <td><%= notice.recipe || '—' %></td>
                    <td class="score-cell">
                      <% if (notice.rating || notice.note) { %><span class="score-badge"><%= notice.rating || notice.note %>/5</span><% } else { %>—<% } %>
                    </td>
                    <td><span class="cell-excerpt"><%= ((notice.content || notice.comment || notice.quote || '') + '').substring(0, 60) %>…</span></td>
                    <td class="actions-cell">
                      <button type="button" class="act-btn act-btn--edit act-btn--sm"
                        data-edit-btn
                        data-edit-type="notice"
                        data-edit-id="<%= notice.id %>"
                        data-edit-content="<%= String(notice.content || notice.comment || '').replace(/"/g, '&quot;') %>"
                        data-edit-quote="<%= String(notice.quote || '').replace(/"/g, '&quot;') %>"
                        data-edit-author="<%= notice.user || notice.author || '' %>"
                        data-edit-recipe="<%= notice.recipe || '' %>">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <form action="/admin/notices/<%= notice.id %>/delete/direct" method="POST" style="display:inline;">
                        <button type="submit" class="act-btn act-btn--delete act-btn--sm" title="Supprimer">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="admin-pagination" style="display:none;">
                <button class="btn btn--ghost admin-pagination__prev">← Précédent</button>
                <span class="admin-pagination__info"></span>
                <button class="btn btn--ghost admin-pagination__next">Suivant →</button>
              </div>
            </div>
            <% } %>
          </div>
        </section>

      </main>
    </div><!-- /.main-wrapper -->


    <!-- ═══════════════════════════════════════════
         TOAST STACK
    ═══════════════════════════════════════════ -->
    <div class="toast-stack" id="toast-stack" aria-live="polite"></div>
    <!-- Legacy compat -->
    <div class="admin-toast" id="admin-toast" aria-live="polite"></div>


    <!-- ═══════════════════════════════════════════
         MODAL ÉDITION ADMIN (Films, Recettes, Avis)
    ═══════════════════════════════════════════ -->
    <div class="admin-modal" id="admin-edit-modal" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
      <div class="admin-modal__backdrop"></div>
      <div class="admin-modal__dialog">
        <div class="admin-modal__header">
          <div class="admin-modal__title-row">
            <!-- Icônes dynamiques selon le type -->
            <span data-modal-icon="movie" style="display:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
            </span>
            <span data-modal-icon="recipe" style="display:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/></svg>
            </span>
            <span data-modal-icon="notice" style="display:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <h2 class="admin-modal__title" id="admin-modal-title">
              <span data-modal-title-text>Éditer</span>
            </h2>
          </div>
          <button type="button" class="admin-modal__close" data-modal-close aria-label="Fermer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <form class="admin-modal__form" id="admin-edit-form" method="POST">
          <!-- Section Film -->
          <div data-modal-section="movie" style="display:none; flex-direction:column; gap:14px;">
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-movie-title">Titre</label>
              <input type="text" id="edit-movie-title" name="title" class="admin-modal__input" required />
            </div>
            <div class="admin-modal__field-row">
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-movie-year">Année</label>
                <input type="number" id="edit-movie-year" name="year" class="admin-modal__input" min="1888" max="2099" />
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-movie-genre">Genre</label>
                <select id="edit-movie-genre" name="genre" class="admin-modal__select">
                  <option value="">— Choisir —</option>
                  <option value="Action">Action</option>
                  <option value="Aventure">Aventure</option>
                  <option value="Animation">Animation</option>
                  <option value="Comédie">Comédie</option>
                  <option value="Documentaire">Documentaire</option>
                  <option value="Drame">Drame</option>
                  <option value="Fantastique">Fantastique</option>
                  <option value="Horreur">Horreur</option>
                  <option value="Musical">Musical</option>
                  <option value="Romance">Romance</option>
                  <option value="Science-Fiction">Science-Fiction</option>
                  <option value="Thriller">Thriller</option>
                  <option value="Western">Western</option>
                </select>
              </div>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-movie-synopsis">Synopsis</label>
              <textarea id="edit-movie-synopsis" name="synopsis" class="admin-modal__textarea admin-modal__textarea--autosize" rows="4"></textarea>
            </div>
          </div>

          <!-- Section Recette -->
          <div data-modal-section="recipe" style="display:none; flex-direction:column; gap:14px;">
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-recipe-name">Nom de la recette</label>
              <input type="text" id="edit-recipe-name" name="name" class="admin-modal__input" required />
            </div>
            <div class="admin-modal__field-row">
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-category">Catégorie</label>
                <select id="edit-recipe-category" name="category" class="admin-modal__select">
                  <option value="">— Choisir —</option>
                  <option value="Entrée">Entrée</option>
                  <option value="Plat principal">Plat principal</option>
                  <option value="Dessert">Dessert</option>
                  <option value="Boisson">Boisson</option>
                  <option value="Apéritif">Apéritif</option>
                  <option value="Snack">Snack</option>
                </select>
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-time">Temps (min)</label>
                <input type="number" id="edit-recipe-time" name="time" class="admin-modal__input" min="1" />
              </div>
              <div class="admin-modal__field">
                <label class="admin-modal__label" for="edit-recipe-difficulty">Difficulté</label>
                <select id="edit-recipe-difficulty" name="difficulty" class="admin-modal__select">
                  <option value="">— Choisir —</option>
                  <option value="Facile">Facile</option>
                  <option value="Moyen">Moyen</option>
                  <option value="Difficile">Difficile</option>
                </select>
              </div>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-recipe-description">Description</label>
              <textarea id="edit-recipe-description" name="description" class="admin-modal__textarea admin-modal__textarea--autosize" rows="2"></textarea>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-recipe-ingredients">Ingrédients</label>
              <textarea id="edit-recipe-ingredients" name="ingredients" class="admin-modal__textarea admin-modal__textarea--autosize" rows="4"></textarea>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-recipe-preparation">Préparation</label>
              <textarea id="edit-recipe-preparation" name="preparation" class="admin-modal__textarea admin-modal__textarea--autosize" rows="5"></textarea>
            </div>
          </div>

          <!-- Section Avis -->
          <div data-modal-section="notice" style="display:none; flex-direction:column; gap:14px;">
            <div class="admin-modal__info-row">
              <div class="admin-modal__info-chip">
                <span class="admin-modal__info-label">Auteur :</span>
                <span id="edit-notice-author-display">—</span>
              </div>
              <div class="admin-modal__info-chip">
                <span class="admin-modal__info-label">Recette :</span>
                <span id="edit-notice-recipe-display">—</span>
              </div>
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-notice-quote">Note (1 à 5)</label>
              <input type="number" id="edit-notice-quote" name="quote" class="admin-modal__input" min="1" max="5" />
            </div>
            <div class="admin-modal__field">
              <label class="admin-modal__label" for="edit-notice-content">Commentaire</label>
              <textarea id="edit-notice-content" name="content" class="admin-modal__textarea admin-modal__textarea--autosize" rows="4"></textarea>
            </div>
          </div>

          <div class="admin-modal__footer">
            <button type="button" class="btn btn--ghost" data-modal-close>Annuler</button>
            <button type="submit" class="btn btn--primary">Enregistrer</button>
          </div>
        </form>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════
         LIGHTBOX
    ═══════════════════════════════════════════ -->
    <div class="recipe-lightbox" id="recipe-lightbox" role="dialog" aria-modal="true" aria-label="Visionneuse d'image">
      <div class="recipe-lightbox__backdrop" id="lightbox-backdrop"></div>
      <div class="recipe-lightbox__panel">
        <button class="recipe-lightbox__close" id="lightbox-close" aria-label="Fermer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <img src="" alt="" class="recipe-lightbox__img" id="lightbox-img" />
      </div>
    </div>


    <!-- Scripts -->
    <script src="/js/confirm-action.js"></script>
    <script src="/js/admin-dashboard.js"></script>
    <script src="/js/recipe-detail.js"></script>
  </body>
</html>
