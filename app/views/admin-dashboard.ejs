<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Espace Administrateur - Ciné Délices</title>
    <meta
      name="description"
      content="Ciné Délices — Espace Administrateur, gestion des recettes et films"
    />

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css, preload éventuel -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à l'admin -->
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>
  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- Bannière Administrateur -->
    <div class="admin-header-banner">Espace Administrateur</div>

    <!-- CONTAINER PRINCIPAL -->
    <div class="admin-container">
      <!-- SIDEBAR -->
      <aside class="admin-sidebar">
        <button class="dropdown-btn" data-target="recettes">
          <i class="fa-solid fa-utensils"></i> Validation des recettes
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
        <div class="dropdown-container" id="recettes">
          <% recipes.forEach(recipe => { %>
          <button class="list-item"><a href="/admin/recipe/<%= recipe.id %>"><%= recipe.id %> - <%= recipe.name %></a></button>
          <% }) %>
        </div>

        <button class="dropdown-btn" data-target="films">
          <i class="fa-solid fa-film"></i> Validation des films
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
        <div class="dropdown-container" id="films">
          <% movies.forEach(movie => { %>
          <button class="list-item"><a href="/admin/movie/<%= movie.id %>"><%= movie.id %> - <%= movie.title %></a></button>
          <% }) %>
        </div>

        <button class="dropdown-btn" data-target="avis">
          <i class="fa-solid fa-comment"></i> Avis à valider
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
         <div class="dropdown-container" id="avis">
          <% avis.forEach(note => { %>
          <button class="list-item"><%= note.id %> - <%= note.content %></button>
          <% }) %>
        </div>

        <button class="dropdown-btn" data-target="users">
          <i class="fa-solid fa-user"></i> Utilisateurs
          <i class="fa-solid fa-chevron-down toggle-icon"></i>
        </button>
        <div class="dropdown-container" id="users">
          <% users.forEach(user => { %>
            <form method="POST" action="/admin/deleteUser/<%= user.id %>" >
              <button type="submit" class="list-item dropdown-btn" title="Supprimer <%= user.first_name %>">
                <%= user.id %> - <%= user.first_name %>
              </button>
            </form>
          <!-- <button class="list-item"><%= user.id %> - <%= user.first_name %></button> -->
          <% }) %>
        </div>

      </aside>

      <!-- CONTENU PRINCIPAL -->
      <main class="admin-main">
        <!-- FILM -->
        <h2 class="admin-section-title">Film</h2>
        <section class="admin-section film-section">
          <div class="section-content">
            <p><strong>Nom du film :<% if (typeof upMovie === "undefined") { %> </strong> <span> le film</span></p>  <% } else { %>
              <%= upMovie.title %> 
              <% } %>
            <p><strong>Année du film :<% if (typeof upMovie === "undefined") { %> </strong> <span>l'année</span></p> <% } else { %>
              <%= upMovie.year %> 
              <% } %>
            <p><strong>Genre :<% if (typeof upMovie === "undefined") { %> </strong> <span>le genre</span></p> <% } else { %>
              <%= upMovie.genre %> 
              <% } %>
          </div>
        </section>

        <!-- BOUTONS DE VALIDATION -->
<div class="admin-validation">
  <% if (typeof upMovie !== "undefined") { %>
    <form method="POST" action="/admin/validateMovie/<%= upMovie.id %>">
      <button type="submit" class="btn btn-valid">Valider le film</button>
    </form>
    <form method="POST" action="/admin/rejectMovie/<%= upMovie.id %>">
      <button type="submit" class="btn btn-refus">Refuser le film</button>
    </form>
  <% } else { %>
    <button class="btn btn-valid" disabled>Valider le film</button>
    <button class="btn btn-refus" disabled>Refuser le film</button>
  <% } %>
</div>

        <!-- RECETTE -->
        <h2 class="admin-section-title">Recette</h2>
        <section class="admin-section recette-section">
          <div class="recette-details">
            <div class="recette-photo">
              <img
                src="/images/dessert-backtothefuture-2.jpg"
                alt="Photo de la recette"
              />
            </div>

            <div class="recette-texte">
              <h3>Contexte de la recette dans le film</h3>
              <% if (typeof upRecipe === "undefined") { %>
                                <textarea readonly>
Le dessert apparaît dans le laboratoire du Doc, lors de la scène emblématique du voyage dans le temps.
                                </textarea>
              <% } else { %>
                                <textarea readonly><%= upRecipe.description %></textarea>
              <% } %>

            </div>
          </div>

          <div class="recette-ingredients">
            <h3>Ingrédients</h3>
            <% if (typeof upRecipe === "undefined") { %>
              <textarea readonly>
Le dessert apparaît dans le laboratoire du Doc, lors de la scène emblématique du voyage dans le temps.
              </textarea>
<% } else { %>
              <textarea readonly><%= upRecipe.ingredients %></textarea>
<% } %>
          </div>

          <div class="recette-preparation">
            <h3>Préparation</h3>
            <% if (typeof upRecipe === "undefined") { %>
              <textarea readonly>
Le dessert apparaît dans le laboratoire du Doc, lors de la scène emblématique du voyage dans le temps.
              </textarea>
<% } else { %>
              <textarea readonly><%= upRecipe.preparation %></textarea>
<% } %>
          </div>
        </section>

        <!-- BOUTONS DE VALIDATION -->
        <div class="admin-validation">
          <button class="btn btn-valid">Valider la fiche</button>
          <button class="btn btn-refus">Refuser la fiche</button>
        </div>
      </main>
    </div>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- JS Admin -->
    <script src="/js/admin-dashboard.js" defer></script>
  </body>
</html>
