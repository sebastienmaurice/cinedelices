<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Contactez-nous et découvrez l'équipe derrière le goût du cinéma"
    />
    <title>Contact & À propos - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/contact-about.css" />
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- HERO IMAGE -->
      <section
        class="banner__image__film banner__image__film--contact"
        aria-hidden="true"
      >
        <div class="banner__image__film__overlay"></div>
        <img src="/images/image-contact-cinema.jpg" alt="Contactez Ciné Délices" />
      </section>

      <!-- BANNIÈRE -->
      <section
        class="banner banner--contact-about"
        aria-labelledby="contact-title"
      >
        <div class="banner__title">
          <p class="banner__meta">Contact & À propos</p>
          <h2 id="contact-title">Restons connectés</h2>
          <p class="banner__subtitle">
            Le goût du cinéma vous inspire ? Parlons-en ensemble
          </p>
        </div>

        <div class="banner__navigation">
          <a
            href="#about"
            class="banner__nav-btn banner__nav-btn--active"
            data-section="about"
          >
            <i class="fas fa-users"></i>
            <span>La Team Ciné Délices</span>
          </a>
          <a
            href="#cine-delices-about"
            class="banner__nav-btn"
            data-section="cine-delices-about"
          >
            <i class="fas fa-info-circle"></i>
            <span>À propos</span>
          </a>
          <a href="#contact" class="banner__nav-btn" data-section="contact">
            <i class="fas fa-envelope"></i>
            <span>Contact</span>
          </a>
        </div>
      </section>

      <!-- SECTION À PROPOS / TEAM -->
      <section class="about-section" id="about">
        <div class="about-section__container">
          <div class="team-section">
            <div class="team-pirate-container">
              <!-- Cartes latérales gauche -->
              <div class="team-pirate-sidebar">
                <!-- Sébastien -->
                <article class="team-pirate-card-side" data-member="sebastien">
                  <div class="team-pirate-card-side__image">
                    <img
                      src="/images/profil-contact/profil-sebastien.jpg"
                      alt="Portrait Sébastien"
                    />
                  </div>
                  <div class="team-pirate-card-side__content">
                    <h4 class="team-pirate-card-side__name">Sébastien</h4>
                    <p class="team-pirate-card-side__role">
                      Développeur Full Stack
                    </p>
                    <span
                      class="team-pirate-card-side__tag team-pirate-card-side__tag--frontend"
                      >Front-end</span
                    >
                  </div>
                  <div class="team-pirate-card-side__icon">
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </article>

                <!-- Ludovic -->
                <article class="team-pirate-card-side" data-member="ludovic">
                  <div class="team-pirate-card-side__image">
                    <img
                      src="/images/profil-contact/profil-ludovic.jpg"
                      alt="Portrait Ludovic"
                    />
                  </div>
                  <div class="team-pirate-card-side__content">
                    <h4 class="team-pirate-card-side__name">Ludovic</h4>
                    <p class="team-pirate-card-side__role">
                      Développeur Full Stack
                    </p>
                    <span
                      class="team-pirate-card-side__tag team-pirate-card-side__tag--backend"
                      >Back-end</span
                    >
                  </div>
                  <div class="team-pirate-card-side__icon">
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </article>

                <!-- Denis -->
                <article class="team-pirate-card-side" data-member="denis">
                  <div class="team-pirate-card-side__image">
                    <img
                      src="/images/profil-contact/profil-denis.jpg"
                      alt="Portrait Denis"
                    />
                  </div>
                  <div class="team-pirate-card-side__content">
                    <h4 class="team-pirate-card-side__name">Denis</h4>
                    <p class="team-pirate-card-side__role">
                      Développeur Full Stack
                    </p>
                    <span
                      class="team-pirate-card-side__tag team-pirate-card-side__tag--backend"
                      >Back-end</span
                    >
                  </div>
                  <div class="team-pirate-card-side__icon">
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </article>

                <!-- Richard -->
                <article class="team-pirate-card-side" data-member="richard">
                  <div class="team-pirate-card-side__image">
                    <img
                      src="/images/profil-contact/profil-richard.jpg"
                      alt="Portrait Richard"
                    />
                  </div>
                  <div class="team-pirate-card-side__content">
                    <h4 class="team-pirate-card-side__name">Richard</h4>
                    <p class="team-pirate-card-side__role">
                      Développeur Full Stack
                    </p>
                    <span
                      class="team-pirate-card-side__tag team-pirate-card-side__tag--backend"
                      >Back-end</span
                    >
                  </div>
                  <div class="team-pirate-card-side__icon">
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </article>
              </div>

              <!-- Carte centrale -->
              <div class="team-pirate-center">
                <!-- Carte profil membre -->
                <article
                  class="team-pirate-card-center"
                  id="team-pirate-card-center"
                >
                  <div class="team-pirate-card-center__columns">
                    <!-- Colonne principale (3/4) -->
                    <div class="team-pirate-card-center__column-main">
                      <div class="team-pirate-card-center__image">
                        <img
                          id="team-pirate-center-img"
                          src="/images/profil-contact/profil-sebastien.jpg"
                          alt="Portrait membre équipe"
                        />
                        <!-- Tags en overlay en bas à droite -->
                        <div class="team-pirate-card-center__tags">
                          <span
                            class="team-pirate-card-center__tag"
                            id="team-pirate-center-tag-1"
                            >Développeur full stack</span
                          >
                          <span
                            class="team-pirate-card-center__tag"
                            id="team-pirate-center-tag-2"
                            >Front-end</span
                          >
                        </div>
                        <!-- Réseaux sociaux en overlay sur le bord droit -->
                        <div class="team-pirate-card-center__socials-overlay">
                          <a
                            href="https://www.linkedin.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="team-pirate-card-center__social-link"
                            aria-label="LinkedIn"
                          >
                            <i class="fab fa-linkedin-in"></i>
                          </a>
                          <a
                            href="https://www.github.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="team-pirate-card-center__social-link"
                            aria-label="GitHub"
                          >
                            <i class="fab fa-github"></i>
                          </a>
                        </div>
                      </div>
                      <div class="team-pirate-card-center__content">
                        <h3
                          class="team-pirate-card-center__name"
                          id="team-pirate-center-name"
                        >
                          Seb le Fourbe
                        </h3>
                        <p
                          class="team-pirate-card-center__bio"
                          id="team-pirate-center-bio"
                        >
                          Graphiste imaginatif, webdesigner affûté et
                          développeur full-stack orienté front, Seb le Fourbe
                          façonne l'identité visuelle de Ciné Délices. Il mêle
                          univers pirate et esthétique cinématographique pour
                          donner vie aux recettes et aux interfaces. Polyvalent,
                          il conçoit autant l'apparence que l'expérience, du
                          design jusqu'au code. Sa précision et son œil créatif
                          transforment chaque idée en moment fort digne du grand
                          écran.
                        </p>
                        <div class="team-pirate-card-center__favorites">
                          <h4 class="team-pirate-card-center__favorites-title">
                            <i class="fas fa-star"></i>
                            Mon Top films
                          </h4>
                          <div
                            class="team-pirate-card-center__favorites-list"
                            id="team-pirate-center-favorites"
                          >
                            <span class="team-pirate-card-center__favorite-item"
                              >Retour vers le futur</span
                            >
                            <span class="team-pirate-card-center__favorite-item"
                              >Le seigneur des anneaux</span
                            >
                            <span class="team-pirate-card-center__favorite-item"
                              >kaamelott</span
                            >
                          </div>
                        </div>
                        <!-- Titre "Mes technos" visible uniquement en mobile -->
                        <div class="team-pirate-card-center__tech-section-mobile">
                          <h4 class="team-pirate-card-center__tech-title-mobile">
                            <i class="fas fa-code"></i>
                            Mes technos
                          </h4>
                          <div class="team-pirate-card-center__tech-mobile">
                            <div
                              class="team-pirate-card-center__tech-list-mobile"
                              id="team-pirate-center-tech-mobile"
                            >
                              <!-- Les boutons seront générés dynamiquement par JavaScript -->
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!-- Colonne technique (1/4) -->
                    <div class="team-pirate-card-center__column-tech">
                      <div class="team-pirate-card-center__tech">
                        <div
                          class="team-pirate-card-center__tech-list"
                          id="team-pirate-center-tech"
                        >
                          <!-- Les boutons seront générés dynamiquement par JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                </article>

                <!-- Formulaire de contact -->
                <article
                  class="team-pirate-card-center team-pirate-card-center--contact"
                  id="team-pirate-card-contact"
                >
                  <div class="team-pirate-card-center__contact-header">
                    <h3 class="team-pirate-card-center__contact-title">
                      <i class="fas fa-envelope-open-text"></i>
                      Contactez Ciné Délices
                    </h3>
                    <p class="team-pirate-card-center__contact-subtitle">
                      Une question, une suggestion ou une envie de partager une
                      recette ? Nous serions ravis de vous entendre !
                    </p>
                  </div>
                  <form
                    class="team-pirate-contact-form"
                    method="POST"
                    action="/contact"
                  >
                    <div class="team-pirate-contact-form__row">
                      <div class="input-container">
                        <input
                          type="text"
                          id="contact-name"
                          name="name"
                          placeholder=" "
                          required
                        />
                        <label for="contact-name">Nom complet</label>
                      </div>
                      <div class="input-container">
                        <input
                          type="text"
                          id="contact-prenom"
                          name="prenom"
                          placeholder=" "
                          required
                        />
                        <label for="contact-prenom">Prénom</label>
                      </div>
                    </div>
                    <div class="input-container">
                      <input
                        type="email"
                        id="contact-email"
                        name="email"
                        placeholder=" "
                        required
                      />
                      <label for="contact-email">Adresse e-mail</label>
                    </div>
                    <div class="input-container">
                      <textarea
                        id="contact-message"
                        name="message"
                        placeholder=" "
                        rows="6"
                        required
                        spellcheck="true" 
                        lang="fr en"
                      ></textarea>
                      <label for="contact-message"
                        >Votre message pour Ciné Délices</label
                      >
                    </div>
                    <button
                      type="submit"
                      class="btn btn--gold-special team-pirate-contact-form__submit"
                    >
                      <i class="fas fa-paper-plane"></i>
                      Envoyer le message
                    </button>
                  </form>
                </article>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION À PROPOS DE CINÉ DÉLICES -->
      <section class="cine-delices-about" id="cine-delices-about">
        <div class="cine-delices-about__container">
          <h2 class="cine-delices-about__title">À propos de Ciné Délices</h2>

          <div class="cine-delices-about__content">
            <div class="cine-delices-about__image-wrapper">
              <div class="cine-delices-about__image-overlay"></div>
              <img
                src="/images/salle-cinoche-1.jpg"
                alt="Ciné Délices - L'univers du cinéma et de la cuisine"
                class="cine-delices-about__image"
              />
            </div>

            <div class="cine-delices-about__text">
              <div class="cine-delices-about__description">
                <p class="cine-delices-about__paragraph">
                  Né au cœur d'un projet de formation chez O'clock, Ciné Délices
                  a d'abord été un simple exercice d'équipe… avant de devenir
                  une véritable aventure. À quatre, chacun avec son talent, sa
                  sensibilité et sa passion, nous avons façonné un univers où le
                  cinéma rencontre la cuisine, où chaque recette raconte une
                  scène et chaque plat devient un clin d'œil aux films qui nous
                  inspirent.
                </p>
                <p class="cine-delices-about__paragraph">
                  Très vite, le projet a dépassé le cadre de la formation.
                  L'envie d'aller plus loin s'est imposée d'elle-même : affiner
                  le concept, enrichir les recettes, pousser le design,
                  renforcer l'expérience… bref, faire grandir Ciné Délices comme
                  un vrai produit, pas seulement un projet d'école.
                </p>
                <p class="cine-delices-about__paragraph">
                  Aujourd'hui, notre ambition est simple : offrir une plateforme
                  unique où cinéphiles et gourmets se retrouvent, explorent,
                  découvrent, cuisinent et partagent des créations inspirées des
                  plus grands moments du cinéma. Une passion commune devenue une
                  collaboration durable, et on l'espère, une référence pour tous
                  ceux qui aiment autant le grand écran que le bon goût.
                </p>
              </div>

              <div class="cine-delices-about__subtitle-wrapper">
                <h3 class="cine-delices-about__subtitle">
                  Où le cinéma rencontre la cuisine
                </h3>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>
    <script src="/js/contact-about.js" defer></script>
  </body>
</html>
