<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Contactez-nous et découvrez l'équipe derrière le goût du cinéma" />
    <title>Contact & À propos - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/contact-about.css" />
  </head>

  <body class="contact-about-page">
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- ── Particles décoratives ── -->
    <div class="ca-particles" aria-hidden="true">
      <div class="ca-particle" style="left:7%;width:1px;height:1px;background:rgba(65,90,119,0.3);animation-duration:15s;animation-delay:0s;"></div>
      <div class="ca-particle" style="left:21%;width:2px;height:2px;background:rgba(90,115,145,0.2);animation-duration:22s;animation-delay:4s;"></div>
      <div class="ca-particle" style="left:48%;width:1px;height:1px;background:rgba(65,90,119,0.25);animation-duration:17s;animation-delay:1.5s;"></div>
      <div class="ca-particle" style="left:70%;width:2px;height:2px;background:rgba(90,115,145,0.18);animation-duration:24s;animation-delay:6s;"></div>
      <div class="ca-particle" style="left:88%;width:1px;height:1px;background:rgba(65,90,119,0.22);animation-duration:19s;animation-delay:3s;"></div>
      <div class="ca-particle" style="left:35%;width:2px;height:2px;background:rgba(90,115,145,0.15);animation-duration:20s;animation-delay:9s;"></div>
    </div>

    <!-- ══ HERO ══ -->
    <section class="ca-hero" aria-labelledby="caHeroH1">
      <div class="ca-hero__deco" aria-hidden="true">
        <div class="ca-hero__bg"></div>
        <div class="ca-hero__reel ca-hero__reel--1"></div>
        <div class="ca-hero__reel ca-hero__reel--2"></div>
        <div class="ca-hero__scan"></div>
        <div class="ca-hero__vignette"></div>
      </div>

      <div class="ca-hero__content">
        <!-- Gauche : titre + stats -->
        <div class="ca-hero__left">
          <p class="ca-hero__eyebrow">
            <span class="ca-hero__eyebrow-line" aria-hidden="true"></span>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Contact &amp; équipe
          </p>
          <h1 class="ca-hero__title" id="caHeroH1">
            RESTONS <em>CONNECTÉS</em>
          </h1>
          <p class="ca-hero__sub">
            Une question, une suggestion, une envie de partager&nbsp;?
          </p>
          <div class="ca-hero__stats">
            <div class="ca-hstat">
              <span class="ca-hstat__n">4</span>
              <span class="ca-hstat__l">Membres</span>
            </div>
            <div class="ca-hdivider" aria-hidden="true"></div>
            <div class="ca-hstat">
              <span class="ca-hstat__n"><%= typeof movieCount !== 'undefined' ? movieCount : '247' %></span>
              <span class="ca-hstat__l">Films</span>
            </div>
            <div class="ca-hdivider" aria-hidden="true"></div>
            <div class="ca-hstat">
              <span class="ca-hstat__n"><%= typeof recipeCount !== 'undefined' ? recipeCount : '583' %></span>
              <span class="ca-hstat__l">Recettes</span>
            </div>
          </div>
        </div>

        <!-- Droite : tabs navigation -->
        <nav class="ca-hero__tabs" aria-label="Navigation sections">
          <button class="ca-hero__tab is-active" data-target="team" id="htab-team" type="button">
            <div class="ca-hero__tab-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="ca-hero__tab-label">La Team</div>
          </button>
          <button class="ca-hero__tab" data-target="about" id="htab-about" type="button">
            <div class="ca-hero__tab-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1-.3 2.1.3 2.4 1.3Z"/><path d="m6.2 5.3 3.1 3.9"/><path d="m12.4 3.4 3.1 3.8"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>
            </div>
            <div class="ca-hero__tab-label">À propos</div>
          </button>
          <button class="ca-hero__tab ca-hero__tab--contact" data-target="contact" id="htab-contact" type="button">
            <div class="ca-hero__tab-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div class="ca-hero__tab-label">Contact</div>
          </button>
        </nav>
      </div>
    </section>

    <!-- ══ MAIN ══ -->
    <main class="ca-main">

      <!-- ═══ 01 — LA TEAM ═══ -->
      <section class="ca-team-section" id="section-team">
        <div class="ca-sh">
          <span class="ca-sh__num" aria-hidden="true">01</span>
          <div class="ca-sh__body">
            <span class="ca-sh__eye">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              L'équipe
            </span>
            <span class="ca-sh__title">LA TEAM PIRATE</span>
          </div>
          <div class="ca-sh__rule" aria-hidden="true"></div>
          <span class="ca-sh__hint">4 devs · 1 projet · 1 passion</span>
        </div>

        <!-- Galerie portraits -->
        <div class="ca-portraits-row" id="caTeamList" role="group" aria-label="Choisir un membre">

          <!-- Sébastien -->
          <button class="ca-portrait is-on" data-member="sebastien" type="button" aria-pressed="true">
            <img class="ca-portrait__img" src="/images/profil-contact/profil-sebastien.jpg" alt="Sébastien" />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Sébastien</div>
              <span class="ca-portrait__spec">Front-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Ludovic -->
          <button class="ca-portrait" data-member="ludovic" type="button" aria-pressed="false">
            <img class="ca-portrait__img" src="/images/profil-contact/profil-ludovic.jpg" alt="Ludovic" />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Ludovic</div>
              <span class="ca-portrait__spec">Back-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Denis -->
          <button class="ca-portrait" data-member="denis" type="button" aria-pressed="false">
            <img class="ca-portrait__img" src="/images/profil-contact/profil-denis.jpg" alt="Denis" />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Denis</div>
              <span class="ca-portrait__spec">Back-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Richard -->
          <button class="ca-portrait" data-member="richard" type="button" aria-pressed="false">
            <img class="ca-portrait__img" src="/images/profil-contact/profil-richard.jpg" alt="Richard" />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Richard</div>
              <span class="ca-portrait__spec">Back-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Nous écrire -->
          <button class="ca-portrait ca-portrait--contact" id="caTcardContact" type="button" aria-pressed="false">
            <div class="ca-portrait__icon-bg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 3 9-3 9 19-9Z"/><path d="M6 12h16"/></svg>
            </div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Nous écrire</div>
              <span class="ca-portrait__spec">Message</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

        </div>
        <!-- /ca-portraits-row -->

          <!-- Panneau détail -->
          <div class="ca-profile-panel" id="caTeamCenter">

            <!-- Member card (visible par défaut) -->
            <article class="ca-mcard" id="caMemberCard">
              <div class="ca-mcard__photo">
                <img id="caMImg" src="/images/profil-contact/profil-sebastien.jpg" alt="Portrait membre" />
                <div class="ca-mcard__photo-fade" aria-hidden="true"></div>
                <div class="ca-mcard__tags">
                  <span class="ca-mtag ca-mtag--g" id="caMTag1">Développeur Full Stack</span>
                  <span class="ca-mtag ca-mtag--r" id="caMTag2">Front-end</span>
                </div>
                <div class="ca-mcard__socials">
                  <a href="#" target="_blank" rel="noopener noreferrer" class="ca-msocial" aria-label="LinkedIn" id="caMLI">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                  </a>
                  <a href="#" target="_blank" rel="noopener noreferrer" class="ca-msocial" aria-label="GitHub" id="caMGH">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  </a>
                </div>
              </div>

              <div class="ca-mcard__body">
                <div>
                  <div class="ca-mcard__name" id="caMName">Seb le Fourbe</div>
                  <div class="ca-mcard__role" id="caMRole">Maître du front-end &amp; architecte visuel</div>
                </div>
                <div class="ca-mcard__sep" aria-hidden="true"></div>
                <p class="ca-mcard__bio" id="caMMBio">
                  Graphiste imaginatif, webdesigner affûté et développeur full-stack orienté front, Seb le Fourbe façonne l'identité visuelle de Ciné Délices. Il mêle univers pirate et esthétique cinématographique pour donner vie aux interfaces.
                </p>
                <div class="ca-mcard__pills" id="caMPills">
                  <span class="ca-pill"><span class="ca-pill__dot ca-dot-fe"></span>HTML5</span>
                  <span class="ca-pill"><span class="ca-pill__dot ca-dot-fe"></span>CSS3</span>
                  <span class="ca-pill"><span class="ca-pill__dot ca-dot-fe"></span>JavaScript</span>
                </div>
                <div class="ca-mcard__films">
                  <div class="ca-mcard__films-lbl">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a2 2 0 0 0 0-4 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0 0 4"/><path d="m5 8 1 12h12L19 8"/><path d="M12 8v13"/><path d="m19 8-1.5 3M5 8l1.5 3"/></svg>
                    Top films
                  </div>
                  <div class="ca-films-list" id="caMFilms">
                    <span class="ca-film-tag">Retour vers le futur</span>
                    <span class="ca-film-tag">Interstellar</span>
                  </div>
                </div>
              </div>
            </article>

            <!-- Formulaire de contact (masqué par défaut) -->
            <article class="ca-cform" id="caContactCard" aria-label="Formulaire de contact">
              <div class="ca-cform__head">
                <p class="ca-cform__eye">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  Formulaire de contact
                </p>
                <h2 class="ca-cform__title">CONTACTEZ <em>CINÉ DÉLICES</em></h2>
                <p class="ca-cform__desc">
                  Une question, une suggestion ou une envie de partager une recette&nbsp;?
                </p>
              </div>
              <div class="ca-cform__body">
                <div id="caFormSuccess" class="ca-form-success" role="alert" aria-live="polite">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                  Message envoyé ! Nous vous répondrons très rapidement.
                </div>
                <form id="caContactForm" method="POST" action="/contact" novalidate autocomplete="off">
                  <div class="ca-frow" style="margin-bottom:12px">
                    <div class="ca-fg">
                      <label for="caFn">Nom</label>
                      <input class="ca-fi" type="text" id="caFn" name="name" placeholder="Votre nom" autocomplete="family-name" />
                      <span class="ca-fi-err">Veuillez renseigner votre nom</span>
                    </div>
                    <div class="ca-fg">
                      <label for="caFp">Prénom</label>
                      <input class="ca-fi" type="text" id="caFp" name="prenom" placeholder="Votre prénom" autocomplete="given-name" />
                      <span class="ca-fi-err">Veuillez renseigner votre prénom</span>
                    </div>
                  </div>
                  <div class="ca-fg" style="margin-bottom:12px">
                    <label for="caFe">Adresse e-mail</label>
                    <input class="ca-fi" type="email" id="caFe" name="email" placeholder="votre@email.com" autocomplete="email" />
                    <span class="ca-fi-err">Adresse e-mail invalide</span>
                  </div>
                  <div class="ca-fg" style="margin-bottom:14px">
                    <label for="caFm">Message</label>
                    <textarea class="ca-fi" id="caFm" name="message" rows="4" placeholder="Écrivez votre message…"></textarea>
                    <span class="ca-fi-err">Veuillez écrire un message</span>
                  </div>
                  <button type="submit" class="ca-btn-send" id="caBtnSend">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 3 9-3 9 19-9Z"/><path d="M6 12h16"/></svg>
                    Envoyer le message
                  </button>
                </form>
              </div>
            </article>

          </div>
          <!-- /ca-profile-panel -->
      </section>

      <!-- ═══ 02 — À PROPOS ═══ -->
      <section class="ca-about-section" id="section-about">
        <div class="ca-sh">
          <span class="ca-sh__num" aria-hidden="true">02</span>
          <div class="ca-sh__body">
            <span class="ca-sh__eye">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1-.3 2.1.3 2.4 1.3Z"/><path d="m6.2 5.3 3.1 3.9"/><path d="m12.4 3.4 3.1 3.8"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>
              Notre histoire
            </span>
            <span class="ca-sh__title">À PROPOS</span>
          </div>
          <div class="ca-sh__rule" aria-hidden="true"></div>
          <span class="ca-sh__hint">Né d'une formation · devenu une passion</span>
        </div>

        <div class="ca-about-card">
          <div class="ca-about-layout">
            <!-- Image -->
            <div class="ca-about-img">
              <img src="/images/salle-cinoche-1.jpg" alt="Ciné Délices — univers cinéma et cuisine" />
              <div class="ca-about-img__fade" aria-hidden="true"></div>
              <div class="ca-about-img__badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                <span>Ciné Délices</span>
              </div>
              <p class="ca-about-img__quote">
                "Où le cinéma<br />rencontre la <em>cuisine</em>"
              </p>
            </div>

            <!-- Texte -->
            <div class="ca-about-text">
              <div>
                <p class="ca-about-eye">Ciné Délices</p>
                <h2 class="ca-about-title">L'AVENTURE<br />CONTINUE</h2>
                <p class="ca-about-tagline">Né d'un projet d'école, devenu bien plus</p>
              </div>
              <div class="ca-about-body">
                <p class="ca-about-p">
                  Né au cœur d'une formation chez <strong>O'clock</strong>, Ciné Délices a d'abord été un simple exercice d'équipe… avant de devenir une véritable aventure. À quatre, chacun avec son talent, nous avons façonné un univers où chaque recette raconte une scène.
                </p>
                <p class="ca-about-p">
                  Très vite, le projet a <strong>dépassé le cadre de la formation</strong>. L'envie d'aller plus loin s'est imposée : affiner le concept, enrichir les recettes, pousser le design, renforcer l'expérience.
                </p>
                <p class="ca-about-p">
                  Aujourd'hui, notre ambition est simple : offrir une <strong>plateforme unique</strong> où cinéphiles et gourmets se retrouvent, explorent et cuisinent des créations inspirées des plus grands films.
                </p>
              </div>
              <div class="ca-about-stats">
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n">2025</span>
                  <span class="ca-about-stat__l">Fondation</span>
                </div>
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n">4</span>
                  <span class="ca-about-stat__l">Créateurs</span>
                </div>
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n"><%= typeof recipeCount !== 'undefined' ? recipeCount : '583' %></span>
                  <span class="ca-about-stat__l">Recettes</span>
                </div>
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n"><%= typeof movieCount !== 'undefined' ? movieCount : '247' %></span>
                  <span class="ca-about-stat__l">Films</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 03 — MISSION ═══ -->
      <section class="ca-mission-section" id="section-mission">
        <div class="ca-sh">
          <span class="ca-sh__num" aria-hidden="true">03</span>
          <div class="ca-sh__body">
            <span class="ca-sh__eye">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              Notre raison d'être
            </span>
            <span class="ca-sh__title">NOTRE MISSION</span>
          </div>
          <div class="ca-sh__rule" aria-hidden="true"></div>
        </div>

        <div class="ca-mission-list">
          <div class="ca-mission-item ca-mission-item--a">
            <div class="ca-mission-item__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
            </div>
            <div>
              <div class="ca-mission-item__title">Célébrer le Cinéma</div>
              <p class="ca-mission-item__text">Chaque film est une porte vers un univers culinaire unique. Nous explorons les décors, les cultures et les saveurs qui peuplent les plus grandes œuvres du septième art pour en extraire la quintessence gustative.</p>
            </div>
          </div>

          <div class="ca-mission-item ca-mission-item--b">
            <div class="ca-mission-item__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
            </div>
            <div>
              <div class="ca-mission-item__title">Inspirer en Cuisine</div>
              <p class="ca-mission-item__text">Des recettes pensées comme des scènes de film. Chaque plat raconte une histoire, chaque ingrédient est choisi pour sa résonance narrative. Cuisiner devient un acte créatif, un hommage aux films qui nous ont marqués.</p>
            </div>
          </div>

          <div class="ca-mission-item ca-mission-item--c">
            <div class="ca-mission-item__icon">
