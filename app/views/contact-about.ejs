<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Contactez-nous et découvrez l'équipe derrière le goût du cinéma"
    />
    <title>Contact & À propos - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/contact-about.css" />
  </head>

  <body class="contact-about-page">
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- ── Particles décoratives ── -->
    <div class="ca-particles" aria-hidden="true">
      <div
        class="ca-particle"
        style="
          left: 7%;
          width: 1px;
          height: 1px;
          background: rgba(65, 90, 119, 0.3);
          animation-duration: 15s;
          animation-delay: 0s;
        "
      ></div>
      <div
        class="ca-particle"
        style="
          left: 21%;
          width: 2px;
          height: 2px;
          background: rgba(90, 115, 145, 0.2);
          animation-duration: 22s;
          animation-delay: 4s;
        "
      ></div>
      <div
        class="ca-particle"
        style="
          left: 48%;
          width: 1px;
          height: 1px;
          background: rgba(65, 90, 119, 0.25);
          animation-duration: 17s;
          animation-delay: 1.5s;
        "
      ></div>
      <div
        class="ca-particle"
        style="
          left: 70%;
          width: 2px;
          height: 2px;
          background: rgba(90, 115, 145, 0.18);
          animation-duration: 24s;
          animation-delay: 6s;
        "
      ></div>
      <div
        class="ca-particle"
        style="
          left: 88%;
          width: 1px;
          height: 1px;
          background: rgba(65, 90, 119, 0.22);
          animation-duration: 19s;
          animation-delay: 3s;
        "
      ></div>
      <div
        class="ca-particle"
        style="
          left: 35%;
          width: 2px;
          height: 2px;
          background: rgba(90, 115, 145, 0.15);
          animation-duration: 20s;
          animation-delay: 9s;
        "
      ></div>
    </div>

    <!-- ══ HERO ══ -->
    <section class="ca-hero" aria-labelledby="caHeroH1">
      <div class="ca-hero__deco" aria-hidden="true">
        <div class="ca-hero__bg"></div>
        <div class="ca-hero__reel ca-hero__reel--1"></div>
        <div class="ca-hero__reel ca-hero__reel--2"></div>
        <div class="ca-hero__scan"></div>
        <div class="ca-hero__vignette"></div>
      </div>

      <div class="ca-hero__content">
        <!-- Gauche : titre + stats -->
        <div class="ca-hero__left">
          <p class="ca-hero__eyebrow">
            <span class="ca-hero__eyebrow-line" aria-hidden="true"></span>
            <i data-lucide="mail" width="13" height="13" aria-hidden="true"></i>
            Contact &amp; équipe
          </p>
          <h1 class="ca-hero__title" id="caHeroH1">
            RESTONS <em>CONNECTÉS</em>
          </h1>
          <p class="ca-hero__sub">
            Une question, une suggestion, une envie de partager&nbsp;?
          </p>
          <div class="ca-hero__stats">
            <div class="ca-hstat">
              <span class="ca-hstat__n"
                ><%= typeof userCount !== 'undefined' ? userCount : '0' %></span
              >
              <span class="ca-hstat__l">Membres</span>
            </div>
            <div class="ca-hdivider" aria-hidden="true"></div>
            <div class="ca-hstat">
              <span class="ca-hstat__n"
                ><%= typeof movieCount !== 'undefined' ? movieCount : '0'
                %></span
              >
              <span class="ca-hstat__l">Films</span>
            </div>
            <div class="ca-hdivider" aria-hidden="true"></div>
            <div class="ca-hstat">
              <span class="ca-hstat__n"
                ><%= typeof recipeCount !== 'undefined' ? recipeCount : '0'
                %></span
              >
              <span class="ca-hstat__l">Recettes</span>
            </div>
          </div>
        </div>

        <!-- Droite : tabs navigation -->
        <nav class="ca-hero__tabs" aria-label="Navigation sections">
          <button
            class="ca-hero__tab is-active"
            data-target="team"
            id="htab-team"
            type="button"
          >
            <div class="ca-hero__tab-icon">
              <i data-lucide="users" aria-hidden="true"></i>
            </div>
            <div class="ca-hero__tab-label">La Team</div>
          </button>
          <button
            class="ca-hero__tab"
            data-target="about"
            id="htab-about"
            type="button"
          >
            <div class="ca-hero__tab-icon">
              <i data-lucide="clapperboard" aria-hidden="true"></i>
            </div>
            <div class="ca-hero__tab-label">À propos</div>
          </button>
          <button
            class="ca-hero__tab ca-hero__tab--contact"
            data-target="contact"
            id="htab-contact"
            type="button"
          >
            <div class="ca-hero__tab-icon">
              <i data-lucide="mail" aria-hidden="true"></i>
            </div>
            <div class="ca-hero__tab-label">Contact</div>
          </button>
        </nav>
      </div>
    </section>

    <!-- ══ MAIN ══ -->
    <main class="ca-main">
      <!-- ═══ 01 — LA TEAM ═══ -->
      <section class="ca-team-section" id="section-team">
        <div class="ca-sh">
          <span class="ca-sh__num" aria-hidden="true">01</span>
          <div class="ca-sh__body">
            <span class="ca-sh__eye">
              <i data-lucide="users" aria-hidden="true"></i>
              L'équipe
            </span>
            <span class="ca-sh__title">LA TEAM PIRATE</span>
          </div>
          <div class="ca-sh__rule" aria-hidden="true"></div>
          <span class="ca-sh__hint">4 devs · 1 projet · 1 passion</span>
        </div>

        <!-- Galerie portraits -->
        <div
          class="ca-portraits-row"
          id="caTeamList"
          role="group"
          aria-label="Choisir un membre"
        >
          <!-- Sébastien -->
          <button
            class="ca-portrait is-on"
            data-member="sebastien"
            type="button"
            aria-pressed="true"
          >
            <img
              class="ca-portrait__img"
              src="/images/profil-contact/profil-sebastien.jpg"
              alt="Sébastien"
            />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Sébastien</div>
              <span class="ca-portrait__spec">Front-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Ludovic -->
          <button
            class="ca-portrait"
            data-member="ludovic"
            type="button"
            aria-pressed="false"
          >
            <img
              class="ca-portrait__img"
              src="/images/profil-contact/profil-ludovic.jpg"
              alt="Ludovic"
            />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Ludovic</div>
              <span class="ca-portrait__spec">Back-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Denis -->
          <button
            class="ca-portrait"
            data-member="denis"
            type="button"
            aria-pressed="false"
          >
            <img
              class="ca-portrait__img"
              src="/images/profil-contact/profil-denis.jpg"
              alt="Denis"
            />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Denis</div>
              <span class="ca-portrait__spec">Back-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Richard -->
          <button
            class="ca-portrait"
            data-member="richard"
            type="button"
            aria-pressed="false"
          >
            <img
              class="ca-portrait__img"
              src="/images/profil-contact/profil-richard.jpg"
              alt="Richard"
            />
            <div class="ca-portrait__fade" aria-hidden="true"></div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Richard</div>
              <span class="ca-portrait__spec">Back-end</span>
            </div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>

          <!-- Nous écrire -->
          <button
            class="ca-portrait ca-portrait--contact"
            id="caTcardContact"
            type="button"
            aria-pressed="false"
          >
            <%# Perforations film côté gauche %>
            <div class="ca-portrait__perfs" aria-hidden="true"></div>
            <%# Icône dans son anneau décoratif %>
            <div class="ca-portrait__icon-wrap">
              <div class="ca-portrait__icon-ring" aria-hidden="true"></div>
              <div class="ca-portrait__icon-bg">
                <i data-lucide="mail" stroke-width="1.8" aria-hidden="true"></i>
              </div>
            </div>
            <%# Séparateur décoratif or %>
            <div class="ca-portrait__divider" aria-hidden="true">
              <span></span><i>✦</i><span></span>
            </div>
            <div class="ca-portrait__overlay">
              <div class="ca-portrait__name">Nous écrire</div>
              <span class="ca-portrait__spec">Message</span>
            </div>
            <%# Shimmer au hover %>
            <div class="ca-portrait__shimmer" aria-hidden="true"></div>
            <div class="ca-portrait__sel" aria-hidden="true"></div>
          </button>
        </div>
        <!-- /ca-portraits-row -->

        <!-- Panneau détail -->
        <div class="ca-profile-panel" id="caTeamCenter">
          <!-- Member card (visible par défaut) -->
          <article class="ca-mcard" id="caMemberCard">
            <div class="ca-mcard__photo">
              <img
                id="caMImg"
                src="/images/profil-contact/profil-sebastien.jpg"
                alt="Portrait membre"
              />
              <div class="ca-mcard__photo-fade" aria-hidden="true"></div>
              <div class="ca-mcard__tags">
                <span class="ca-mtag ca-mtag--g" id="caMTag1"
                  >Développeur Full Stack</span
                >
                <span class="ca-mtag ca-mtag--r" id="caMTag2">Front-end</span>
              </div>
              <div class="ca-mcard__socials">
                <a
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ca-msocial"
                  aria-label="LinkedIn"
                  id="caMLI"
                >
                  <i data-lucide="linkedin" aria-hidden="true"></i>
                </a>
                <a
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ca-msocial"
                  aria-label="GitHub"
                  id="caMGH"
                >
                  <i data-lucide="github" aria-hidden="true"></i>
                </a>
              </div>
            </div>

            <div class="ca-mcard__body">
              <div>
                <div class="ca-mcard__name" id="caMName">Seb le Fourbe</div>
                <div class="ca-mcard__role" id="caMRole">
                  Maître du front-end &amp; architecte visuel
                </div>
              </div>
              <div class="ca-mcard__sep" aria-hidden="true"></div>
              <p class="ca-mcard__bio" id="caMMBio">
                Graphiste imaginatif, webdesigner affûté et développeur
                full-stack orienté front, Seb le Fourbe façonne l'identité
                visuelle de Ciné Délices. Il mêle univers pirate et esthétique
                cinématographique pour donner vie aux interfaces.
              </p>
              <div class="ca-mcard__pills" id="caMPills">
                <span class="ca-pill"
                  ><span class="ca-pill__dot ca-dot-fe"></span>HTML5</span
                >
                <span class="ca-pill"
                  ><span class="ca-pill__dot ca-dot-fe"></span>CSS3</span
                >
                <span class="ca-pill"
                  ><span class="ca-pill__dot ca-dot-fe"></span>JavaScript</span
                >
              </div>
              <div class="ca-mcard__films">
                <div class="ca-mcard__films-lbl">
                  <i data-lucide="popcorn" aria-hidden="true"></i>
                  Top films
                </div>
                <div class="ca-films-list" id="caMFilms">
                  <span class="ca-film-tag">Retour vers le futur</span>
                  <span class="ca-film-tag">Interstellar</span>
                </div>
              </div>
            </div>
          </article>

          <!-- Formulaire de contact (masqué par défaut) -->
          <article
            class="ca-cform"
            id="caContactCard"
            aria-label="Formulaire de contact"
          >
            <div class="ca-cform__head">
              <p class="ca-cform__eye">
                <i data-lucide="mail" aria-hidden="true"></i>
                Formulaire de contact
              </p>
              <h2 class="ca-cform__title">CONTACTEZ <em>CINÉ DÉLICES</em></h2>
              <p class="ca-cform__desc">
                Question, suggestion, bug, idée de recette ou de cadre&nbsp;— on est là pour vous&nbsp;!
              </p>
            </div>
            <div class="ca-cform__body">
              <div
                id="caFormSuccess"
                class="ca-form-success"
                role="alert"
                aria-live="polite"
              >
                <i data-lucide="circle-check" aria-hidden="true"></i>
                Message envoyé ! Nous vous répondrons très rapidement.
              </div>
              <form
                id="caContactForm"
                method="POST"
                action="/contact-about/contact"
                novalidate
                autocomplete="off"
              >
                <div class="ca-frow" style="margin-bottom: 12px">
                  <div class="ca-fg">
                    <label for="caFn">Nom</label>
                    <input
                      class="ca-fi"
                      type="text"
                      id="caFn"
                      name="name"
                      placeholder="Votre nom"
                      autocomplete="family-name"
                      required
                      aria-describedby="caFnErr"
                    />
                    <span class="ca-fi-err" id="caFnErr"
                      >Veuillez renseigner votre nom</span
                    >
                  </div>
                  <div class="ca-fg">
                    <label for="caFp">Prénom</label>
                    <input
                      class="ca-fi"
                      type="text"
                      id="caFp"
                      name="prenom"
                      placeholder="Votre prénom"
                      autocomplete="given-name"
                      required
                      aria-describedby="caFpErr"
                    />
                    <span class="ca-fi-err" id="caFpErr"
                      >Veuillez renseigner votre prénom</span
                    >
                  </div>
                </div>
                <div class="ca-fg" style="margin-bottom: 12px">
                  <label for="caFe">Adresse e-mail</label>
                  <input
                    class="ca-fi"
                    type="email"
                    id="caFe"
                    name="email"
                    placeholder="votre@email.com"
                    autocomplete="email"
                    required
                    aria-describedby="caFeErr"
                  />
                  <span class="ca-fi-err" id="caFeErr"
                    >Adresse e-mail invalide</span
                  >
                </div>

                <!-- ── Sélecteur de sujet ── -->
                <div class="ca-fg ca-fg--subject" style="margin-bottom: 14px">
                  <label class="ca-subj-label">De quoi s'agit-il&nbsp;?</label>
                  <div class="ca-subj-grid" role="group" aria-label="Choisir un sujet">

                    <div class="ca-subj-item">
                      <input type="radio" name="subject" id="subj-question" value="Question générale">
                      <label for="subj-question" class="ca-subj-card">
                        <i data-lucide="circle-help" aria-hidden="true"></i>
                        <span>Question</span>
                      </label>
                    </div>

                    <div class="ca-subj-item">
                      <input type="radio" name="subject" id="subj-suggestion" value="Suggestion / idée">
                      <label for="subj-suggestion" class="ca-subj-card">
                        <i data-lucide="lightbulb" aria-hidden="true"></i>
                        <span>Suggestion</span>
                      </label>
                    </div>

                    <div class="ca-subj-item">
                      <input type="radio" name="subject" id="subj-bug" value="Problème technique">
                      <label for="subj-bug" class="ca-subj-card">
                        <i data-lucide="bug" aria-hidden="true"></i>
                        <span>Bug technique</span>
                      </label>
                    </div>

                    <div class="ca-subj-item">
                      <input type="radio" name="subject" id="subj-recipe" value="Idée de recette ou de film">
                      <label for="subj-recipe" class="ca-subj-card">
                        <i data-lucide="film" aria-hidden="true"></i>
                        <span>Film / Recette</span>
                      </label>
                    </div>

                    <div class="ca-subj-item">
                      <input type="radio" name="subject" id="subj-contrib" value="Idée de cadre de contribution">
                      <label for="subj-contrib" class="ca-subj-card">
                        <i data-lucide="award" aria-hidden="true"></i>
                        <span>Contribution</span>
                      </label>
                    </div>

                    <div class="ca-subj-item">
                      <input type="radio" name="subject" id="subj-autre" value="Autre">
                      <label for="subj-autre" class="ca-subj-card">
                        <i data-lucide="message-square" aria-hidden="true"></i>
                        <span>Autre</span>
                      </label>
                    </div>

                  </div>
                </div>

                <div class="ca-fg" style="margin-bottom: 14px">
                  <label for="caFm">Message</label>
                  <textarea
                    class="ca-fi"
                    id="caFm"
                    name="message"
                    rows="4"
                    placeholder="Écrivez votre message…"
                    required
                    aria-describedby="caFmErr"
                  ></textarea>
                  <span class="ca-fi-err" id="caFmErr"
                    >Veuillez écrire un message</span
                  >
                </div>
                <!-- Honeypot anti-spam : invisible pour les humains, rempli par les bots -->
                <input type="text" name="website" tabindex="-1" autocomplete="off"
                  style="opacity:0;position:absolute;top:0;left:0;height:0;width:0;border:0;padding:0;pointer-events:none;" />

                <button type="submit" class="ca-btn-send" id="caBtnSend">
                  <i data-lucide="send" aria-hidden="true"></i>
                  Envoyer le message
                </button>
              </form>
            </div>
          </article>
        </div>
        <!-- /ca-profile-panel -->
      </section>

      <!-- ═══ 02 — À PROPOS ═══ -->
      <section class="ca-about-section" id="section-about">
        <div class="ca-sh">
          <span class="ca-sh__num" aria-hidden="true">02</span>
          <div class="ca-sh__body">
            <span class="ca-sh__eye">
              <i data-lucide="clapperboard" aria-hidden="true"></i>
              Notre histoire
            </span>
            <span class="ca-sh__title">À PROPOS</span>
          </div>
          <div class="ca-sh__rule" aria-hidden="true"></div>
          <span class="ca-sh__hint"
            >Né d'une formation · devenu une passion</span
          >
        </div>

        <div class="ca-about-card">
          <div class="ca-about-layout">
            <!-- Image -->
            <div class="ca-about-img">
              <img
                src="/images/ca-about-img.jpg"
                alt="Ciné Délices — univers cinéma et cuisine"
              />
              <div class="ca-about-img__fade" aria-hidden="true"></div>
              <div class="ca-about-img__badge">
                <i data-lucide="film" aria-hidden="true"></i>
                <span>Ciné Délices</span>
              </div>
              <p class="ca-about-img__quote">
                "Où le cinéma<br />rencontre la <em>cuisine</em>"
              </p>
            </div>

            <!-- Texte -->
            <div class="ca-about-text">
              <div>
                <p class="ca-about-eye">Ciné Délices</p>
                <h2 class="ca-about-title">L'AVENTURE<br />CONTINUE</h2>
                <p class="ca-about-tagline">
                  Né d'un projet d'école, devenu bien plus
                </p>
              </div>
              <div class="ca-about-body">
                <p class="ca-about-p">
                  Né au cœur d'une formation chez <strong>O'clock</strong>, Ciné
                  Délices a d'abord été un simple exercice d'équipe… avant de
                  devenir une véritable aventure. À quatre, chacun avec son
                  talent, nous avons façonné un univers où chaque recette
                  raconte une scène.
                </p>
                <p class="ca-about-p">
                  Très vite, le projet a
                  <strong>dépassé le cadre de la formation</strong>. L'envie
                  d'aller plus loin s'est imposée : affiner le concept, enrichir
                  les recettes, pousser le design, renforcer l'expérience.
                </p>
                <p class="ca-about-p">
                  Aujourd'hui, notre ambition est simple : offrir une
                  <strong>plateforme unique</strong> où cinéphiles et gourmets
                  se retrouvent, explorent et cuisinent des créations inspirées
                  des plus grands films.
                </p>
              </div>
              <div class="ca-about-stats">
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n">2025</span>
                  <span class="ca-about-stat__l">Fondation</span>
                </div>
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n">4</span>
                  <span class="ca-about-stat__l">Créateurs</span>
                </div>
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n"
                    ><%= typeof recipeCount !== 'undefined' ? recipeCount : '0'
                    %></span
                  >
                  <span class="ca-about-stat__l">Recettes</span>
                </div>
                <div class="ca-about-stat">
                  <span class="ca-about-stat__n"
                    ><%= typeof movieCount !== 'undefined' ? movieCount : '0'
                    %></span
                  >
                  <span class="ca-about-stat__l">Films</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 03 — MISSION ═══ -->
      <section class="ca-mission-section" id="section-mission">
        <div class="ca-sh">
          <span class="ca-sh__num" aria-hidden="true">03</span>
          <div class="ca-sh__body">
            <span class="ca-sh__eye">
              <i data-lucide="target" aria-hidden="true"></i>
              Notre raison d'être
            </span>
            <span class="ca-sh__title">NOTRE MISSION</span>
          </div>
          <div class="ca-sh__rule" aria-hidden="true"></div>
        </div>

        <div class="ca-mission-list">
          <div class="ca-mission-item ca-mission-item--a">
            <div class="ca-mission-item__icon">
              <i data-lucide="film" aria-hidden="true"></i>
            </div>
            <div>
              <div class="ca-mission-item__title">Célébrer le Cinéma</div>
              <p class="ca-mission-item__text">
                Chaque film est une porte vers un univers culinaire unique. Nous
                explorons les décors, les cultures et les saveurs qui peuplent
                les plus grandes œuvres du septième art pour en extraire la
                quintessence gustative.
              </p>
            </div>
          </div>

          <div class="ca-mission-item ca-mission-item--b">
            <div class="ca-mission-item__icon">
              <i data-lucide="utensils" aria-hidden="true"></i>
            </div>
            <div>
              <div class="ca-mission-item__title">Inspirer en Cuisine</div>
              <p class="ca-mission-item__text">
                Des recettes pensées comme des scènes de film. Chaque plat
                raconte une histoire, chaque ingrédient est choisi pour sa
                résonance narrative. Cuisiner devient un acte créatif, un
                hommage aux films qui nous ont marqués.
              </p>
            </div>
