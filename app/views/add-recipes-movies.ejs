<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajouter un film et une recette - Ciné Délices</title>
    <meta
      name="description"
      content="Ciné Délices — Ajoutez votre film et votre recette inspirée"
    />

    <!-- Ressources globales -->
    <%- include("partials/head-resources") %>

    <!-- Polices dédiées à la refonte "Velours & Projecteur" de cette page -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@200;300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Styles -->
    <link rel="stylesheet" href="/css/add-recipes-movies.css?v=202608310" />
  </head>
  <body class="arm-full-bleed">
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- ═══════════ HERO CINÉMA FULL-WIDTH ═══════════ -->
    <section class="arm-hero">
      <!-- Couche décorative clippée séparément pour que les dropdowns ne soient pas masqués -->
      <div class="arm-hero__deco" aria-hidden="true">
        <div class="arm-hero__bg"></div>
        <div class="arm-hero__reel arm-hero__reel--1"></div>
        <div class="arm-hero__reel arm-hero__reel--2"></div>
        <div class="arm-hero__scanlines"></div>
        <div class="arm-hero__vignette"></div>
      </div>
      <div class="arm-hero__content">
        <div class="arm-hero__top">
          <p class="arm-hero__breadcrumb">
            <i data-lucide="film" width="14" height="14" stroke-width="2" aria-hidden="true"></i>
            Contribution · Communauté
          </p>
          <h1 class="arm-hero__title">AJOUTER UN FILM &amp; <em>UNE RECETTE</em></h1>
          <p class="arm-hero__sub">Partagez votre passion du cinéma et de la cuisine avec la communauté Ciné Délices.</p>
        </div>

        <div class="arm-hero__bottom">
          <!-- Tags — classes officielles moodboard v3 -->
          <div class="arm-hero__tags" aria-hidden="true">
            <span class="tag tag--or">
              <i data-lucide="film" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Film &amp; Série
            </span>
            <span class="tag tag--rouge">
              <i data-lucide="lightbulb" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Recette inspirée
            </span>
            <span class="tag tag--bleu">
              <i data-lucide="users" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Communauté
            </span>
            <span class="tag tag--vert">
              <i data-lucide="sparkles" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Contribution libre
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ BANDEAU ÉTAPE + COMPTEURS ═══════════ -->
    <div class="dc-band">
      <div class="dc-band__eyebrow">
        <span class="dc-band__rule" aria-hidden="true"></span>
        <span id="dcStepEyebrow"><% if (typeof newMovie !== 'undefined' && newMovie) { %>ÉTAPE 2 SUR 3<% } else { %>ÉTAPE 1 SUR 3<% } %></span>
      </div>
      <div class="dc-band__counters" id="dcCounters" hidden>
        <span class="dc-pill dc-pill--sage">
          <i data-lucide="shopping-basket" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
          <span id="dcCountIng">0</span> ingrédients
        </span>
        <span class="dc-pill dc-pill--wine">
          <i data-lucide="images" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
          <span id="dcCountPhotos">0/8</span> photos
        </span>
        <span class="dc-pill dc-pill--gold">
          <i data-lucide="list-ordered" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
          <span id="dcCountSteps">0</span> étapes · <span id="dcCountMin">0</span> min
        </span>
      </div>
    </div>

    <!-- ═══════════ BARRE D'ONGLETS ═══════════ -->
    <div class="dc-tabbar-wrap">
      <nav class="dc-tabbar arm-stepper" role="tablist" aria-label="Progression du formulaire">
        <button type="button" class="dc-tab arm-step <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-step--done<% } else { %>arm-step--active<% } %>" id="tab1" role="tab" aria-controls="arm-s1" aria-selected="<% if (typeof newMovie !== 'undefined' && newMovie) { %>false<% } else { %>true<% } %>">
          <span class="dc-tab__bubble arm-step__bubble">
            <% if (typeof newMovie !== 'undefined' && newMovie) { %>
            <i data-lucide="check" width="14" height="14" stroke-width="2.5" aria-hidden="true"></i>
            <% } else { %>01<% } %>
          </span>
          <span class="dc-tab__info arm-step__info">
            <span class="dc-tab__eyebrow arm-step__label">Étape 01 / 03</span>
            <span class="dc-tab__name arm-step__name">Mon film ou ma série</span>
          </span>
          <span class="dc-tab__state" aria-hidden="true"></span>
        </button>
        <button type="button" class="dc-tab arm-step <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-step--active<% } else { %>dc-tab--locked<% } %>" id="tab2" role="tab" aria-controls="arm-s2" aria-selected="<% if (typeof newMovie !== 'undefined' && newMovie) { %>true<% } else { %>false<% } %>">
          <span class="dc-tab__bubble arm-step__bubble">02</span>
          <span class="dc-tab__info arm-step__info">
            <span class="dc-tab__eyebrow arm-step__label">Étape 02 / 03</span>
            <span class="dc-tab__name arm-step__name">Ma recette</span>
          </span>
          <span class="dc-tab__state" aria-hidden="true"><% if (typeof newMovie === 'undefined' || !newMovie) { %><i data-lucide="lock" width="13" height="13" stroke-width="2" aria-hidden="true"></i><% } %></span>
        </button>
        <button type="button" class="dc-tab arm-step dc-tab--locked" id="tab3" role="tab" aria-controls="arm-s3" aria-selected="false">
          <span class="dc-tab__bubble arm-step__bubble">03</span>
          <span class="dc-tab__info arm-step__info">
            <span class="dc-tab__eyebrow arm-step__label">Étape 03 / 03</span>
            <span class="dc-tab__name arm-step__name">Ingrédients &amp; préparation</span>
          </span>
          <span class="dc-tab__state" aria-hidden="true"><i data-lucide="lock" width="13" height="13" stroke-width="2" aria-hidden="true"></i></span>
        </button>
      </nav>
    </div>

    <!-- ═══════════ MAIN ═══════════ -->
    <main id="main-content" class="arm-page">

      <!-- ALERTES -->
      <% if (typeof success !== "undefined" && success && typeof successMessage !== "undefined" && successMessage) { %>
      <div class="alert alert-success alert-success--with-actions">
        <i data-lucide="circle-check" width="24" height="24" class="lucide-icon" aria-hidden="true"></i>
        <div class="alert__content">
          <p><%= successMessage %></p>
          <div class="alert__actions">
            <a href="/movies" class="btn btn--primary btn--sm">Voir les films</a>
            <a href="/auth/profil/<%= typeof userId !== 'undefined' && userId ? userId : '' %>" class="btn btn--secondary btn--sm">Mon compte</a>
          </div>
        </div>
      </div>
      <% } %>
      <% if (typeof error !== "undefined" && error && typeof errorMessage !== "undefined" && errorMessage) { %>
      <div class="alert alert-error">
        <i data-lucide="circle-x" width="24" height="24" class="lucide-icon" aria-hidden="true"></i>
        <p><%= errorMessage %></p>
      </div>
      <% } %>
      <% if (typeof duplicateWarning !== "undefined" && duplicateWarning) { %>
      <div class="alert alert-info">
        <i data-lucide="circle-alert" width="24" height="24" class="lucide-icon" aria-hidden="true"></i>
        <p>
          Ce film existe déjà dans notre base de données. Vous pouvez continuer
          à ajouter votre recette.
        </p>
      </div>
      <% } %>

      <!-- ═══ TOAST badge débloqué ═══ -->
      <% if (typeof newBadges !== 'undefined' && newBadges && newBadges.length > 0) {
        const _badgeIcon  = { STRANGE: 'wand-2', HARRY: 'zap', INDIANA: 'compass', MATRIX: 'code-2' };
        const _badgeLabel = { STRANGE: 'Doctor Strange', HARRY: 'Harry Potter', INDIANA: 'Indiana Jones', MATRIX: 'Matrix' };
        newBadges.forEach(function(b) {
          const _code  = (b.code || '').toUpperCase();
          const _icon  = _badgeIcon[_code] || 'trophy';
          const _label = _badgeLabel[_code] || b.label || b.code;
      %>
      <div class="badge-unlock-toast" role="status" aria-live="polite">
        <span class="badge-unlock-toast__icon" aria-hidden="true">
          <i data-lucide="<%= _icon %>" width="20" height="20" aria-hidden="true"></i>
        </span>
        <div class="badge-unlock-toast__body">
          <strong>Badge débloqué !</strong>
          <span>Tu as obtenu "<%= _label %>"</span>
        </div>
      </div>
      <% }); } %>

      <!-- ══════════════════════════════════════════
         SECTION 1 — MON FILM
         Layout 2 colonnes : champs | poster preview
      ══════════════════════════════════════════ -->
      <article class="arm-card <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-card--confirmed arm-card--done<% } else { %>arm-card--active<% } %>" id="arm-s1" aria-labelledby="arm-s1-title">
        <span class="arm-card__num" aria-hidden="true">01</span>
        <div class="arm-body">

        <% if (typeof newMovie !== 'undefined' && newMovie) { %>
          <!-- ── Film existant : résumé compact ── -->
          <div class="arm-film-confirmed">
            <div class="arm-film-confirmed__poster film-selected-image">
              <img
                src="<%= newMovie.cardPath || newMovie.picture || '/images/movie-default-img.png' %>"
                alt="Affiche <%= newMovie.title %>"
                onerror="this.onerror=null;this.src='/images/movie-default-img.png'"
              />
            </div>
            <div class="arm-film-confirmed__info">
              <span class="arm-film-confirmed__check">
                <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                Film sélectionné
              </span>
              <h2 class="arm-film-confirmed__title" id="arm-s1-title"><%= newMovie.title %></h2>
              <div class="arm-film-confirmed__meta">
                <% if (newMovie.year) { %><span class="arm-film-confirmed__year"><%= newMovie.year %></span><% } %>
                <% if (newMovie.genre) { %><span class="arm-film-confirmed__genre"><%= newMovie.genre %></span><% } %>
              </div>
              <% if (newMovie.synopsis) { %>
              <p class="arm-film-confirmed__synopsis"><%= newMovie.synopsis.length > 140 ? newMovie.synopsis.slice(0, 140) + '…' : newMovie.synopsis %></p>
              <% } %>
            </div>
            <a href="/add-recipes-movies/" class="arm-film-confirmed__change">
              <i data-lucide="square-pen" width="13" height="13" stroke-width="2" aria-hidden="true"></i>
              Changer de film
            </a>
          </div>
          <!-- Champ caché pour les JS qui lisent #film-preview-form -->
          <form id="film-preview-form" method="post" onsubmit="return false;" style="display:none">
            <input type="text" id="film-name" value="<%= newMovie.title %>" />
            <input type="number" id="film-year" value="<%= newMovie.year %>" />
            <select id="film-genre"><option value="<%= newMovie.genre %>" selected><%= newMovie.genre %></option></select>
            <textarea id="film-synopsis"><%= newMovie.synopsis || '' %></textarea>
          </form>
        <% } else { %>
          <form id="film-preview-form" method="post" onsubmit="return false;">
            <div class="dc-panel" data-accent="sage">

              <div class="dc-panel__head">
                <div class="dc-panel__icon">
                  <i data-lucide="clapperboard" stroke-width="1.6" aria-hidden="true"></i>
                </div>
                <div class="dc-panel__head-text">
                  <h2 class="dc-panel__title" id="arm-s1-title">Mon film ou ma série</h2>
                  <p class="dc-panel__sub">Importez la fiche depuis TMDB : synopsis, année, genre, réalisateur et affiche sont récupérés automatiquement.</p>
                </div>
              </div>

              <!-- Bascule Film / Série / Animé -->
              <div class="dc-pilltoggle" id="dcFilmTypeToggle" role="radiogroup" aria-label="Type d'œuvre">
                <button type="button" class="dc-pilltoggle__opt is-active" data-type="movie" role="radio" aria-checked="true">Film</button>
                <button type="button" class="dc-pilltoggle__opt" data-type="tv" role="radio" aria-checked="false">Série</button>
                <button type="button" class="dc-pilltoggle__opt" data-type="anime" role="radio" aria-checked="false">Animé</button>
              </div>

              <!-- Recherche TMDB -->
              <div class="dc-field">
                <label class="dc-label" for="dcFilmSearchInput">
                  <i data-lucide="search" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
                  Rechercher sur TMDB
                  <span class="dc-req">*</span>
                </label>
                <div class="dc-search-row">
                  <div class="dc-search-input-wrap">
                    <i data-lucide="film" width="15" height="15" stroke-width="1.8" class="dc-search-input-ico" aria-hidden="true"></i>
                    <input
                      type="text"
                      id="dcFilmSearchInput"
                      class="dc-input dc-input--search"
                      placeholder="Titre du film ou de la série — ex. Retour vers le futur"
                      autocomplete="off"
                      role="combobox"
                      aria-expanded="false"
                      aria-controls="dcFilmResultsList"
                      aria-autocomplete="list"
                    />
                  </div>
                  <button type="button" class="dc-btn dc-btn--sage" id="dcFilmSearchBtn">
                    <i data-lucide="search" width="14" height="14" stroke-width="2" aria-hidden="true"></i>
                    Rechercher
                  </button>
                </div>
                <p class="dc-hint">
                  Données et affiches fournies par TMDB —
                  <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">themoviedb.org</a>
                </p>
                <p class="dc-field-error" id="dcFilmSearchError" role="alert" hidden></p>
              </div>

              <!-- Zone à 3 états : vide / résultats / fiche importée -->
              <div id="dcFilmResultsZone">
                <div class="dc-empty-panel" id="dcFilmEmptyState">
                  <i data-lucide="clapperboard" width="30" height="30" stroke-width="1.3" aria-hidden="true"></i>
                  <p class="dc-empty-panel__title">Aucune fiche importée</p>
                  <p class="dc-empty-panel__sub">Lancez une recherche pour récupérer l'affiche et les informations du film qui inspire votre recette.</p>
                </div>
              </div>
              <span class="sr-only" id="dcFilmResultsAnnounce" role="status" aria-live="polite"></span>

              <button type="button" class="dc-link-btn" id="dcFilmManualLink">
                Mon film n'est pas sur TMDB
              </button>

              <!-- Bloc de saisie / correction manuelle -->
              <div class="dc-edit-block" id="dcFilmEditBlock" hidden>
                <div class="dc-row dc-row--film-edit">
                  <div class="dc-field">
                    <label class="dc-label" for="dcEditTitle">Titre<span class="dc-req">*</span></label>
                    <input type="text" id="dcEditTitle" class="dc-input" placeholder="Titre du film ou de la série" />
                  </div>
                  <div class="dc-field">
                    <label class="dc-label" for="dcEditYear">Année<span class="dc-req">*</span></label>
                    <input type="number" id="dcEditYear" class="dc-input" min="1888" max="<%= new Date().getFullYear() + 5 %>" />
                  </div>
                  <div class="dc-field">
                    <label class="dc-label" for="dcEditGenre">Genre<span class="dc-req">*</span></label>
                    <select id="dcEditGenre" class="dc-select">
                      <option value="" disabled selected>Choisir…</option>
                      <option value="action">Action</option>
                      <option value="animation">Animation</option>
                      <option value="aventure">Aventure</option>
                      <option value="comédie">Comédie</option>
                      <option value="crime">Crime</option>
                      <option value="documentaire">Documentaire</option>
                      <option value="drame">Drame</option>
                      <option value="familial">Familial</option>
                      <option value="fantastique">Fantastique</option>
                      <option value="guerre">Guerre</option>
                      <option value="histoire">Histoire</option>
                      <option value="horreur">Horreur</option>
                      <option value="musique">Musique</option>
                      <option value="mystère">Mystère</option>
                      <option value="romance">Romance</option>
                      <option value="science-fiction">Science-Fiction</option>
                      <option value="thriller">Thriller</option>
                      <option value="téléfilm">Téléfilm</option>
                      <option value="western">Western</option>
                    </select>
                  </div>
                  <div class="dc-field">
                    <label class="dc-label" for="dcEditDirector">Réalisateur</label>
                    <input type="text" id="dcEditDirector" class="dc-input" placeholder="Ex : Robert Zemeckis" />
                  </div>
                </div>
                <div class="dc-field">
                  <label class="dc-label" for="dcEditSynopsis">Synopsis</label>
                  <textarea id="dcEditSynopsis" class="dc-textarea" rows="3" maxlength="800" placeholder="Résumé court du film ou de la série…"></textarea>
                </div>
                <p class="dc-hint">Les corrections sont enregistrées sur votre fiche uniquement, la fiche TMDB reste inchangée.</p>
              </div>

              <div class="arm-cta-row">
                <span class="arm-cta-row__hint" id="dcFilmCtaHint">Importez ou renseignez votre film pour continuer</span>
                <button class="btn btn--hero arm-cta-btn" type="button" id="dcFilmContinueBtn">
                  <i data-lucide="utensils" aria-hidden="true"></i>
                  Je passe à la recette
                </button>
              </div>

            </div>

            <!-- Contrat de soumission inchangé — lus par unified-form-handler.js -->
            <input type="hidden" id="film-name" />
            <input type="hidden" id="film-year" />
            <input type="hidden" id="film-genre" />
            <input type="hidden" id="film-synopsis" />
          </form>
        <% } %>

        </div>
      </article>

      <!-- ══════════════════════════════════════════
         SECTIONS 2, 3 & TICKET — dans unified-form
      ══════════════════════════════════════════ -->
      <form
        id="unified-form"
        action="/add-recipes-movies/movie-and-recipe"
        method="post"
        enctype="multipart/form-data"
      >
        <!-- CHAMPS CACHÉS -->
        <input type="hidden" name="filmId" id="filmId-hidden" value="<% if (typeof newMovie !== 'undefined' && newMovie && newMovie.id) { %><%= newMovie.id %><% } %>" />
        <input type="hidden" name="title" id="film-title-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.title || '' %><% } %>" />
        <input type="hidden" name="year" id="film-year-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.year || '' %><% } %>" />
        <input type="hidden" name="genre" id="film-genre-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.genre || '' %><% } %>" />
        <input type="hidden" name="synopsis" id="film-synopsis-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.synopsis || '' %><% } %>" />
        <input type="hidden" name="tmdbId" id="tmdbId-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.tmdbId || '' %><% } %>" />
        <input type="hidden" name="titleFR" id="titleFR-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.title || '' %><% } %>" />
        <input type="hidden" name="tmdbYear" id="tmdbYear-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.year || '' %><% } %>" />
        <input type="hidden" name="tmdbGenre" id="tmdbGenre-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.genre || '' %><% } %>" />
        <input type="hidden" name="type" id="film-type-hidden" value="movie" />

        <!-- ══════════════════════════════════════════
           SECTION 2 — MA RECETTE
        ══════════════════════════════════════════ -->
        <article class="arm-card <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-card--active<% } %>" id="arm-s2" aria-labelledby="arm-s2-title">
          <span class="arm-card__num" aria-hidden="true">02</span>
          <div class="arm-body">

            <div class="dc-panel__head">
              <div class="dc-panel__icon">
                <i data-lucide="chef-hat" stroke-width="1.6" aria-hidden="true"></i>
              </div>
              <div class="dc-panel__head-text">
                <h2 class="dc-panel__title" id="arm-s2-title">Ma recette</h2>
                <p class="dc-panel__sub">Décrivez votre recette, choisissez la catégorie et ajoutez vos photos.</p>
              </div>
            </div>

            <!-- Nom de la recette -->
            <div class="dc-field">
              <label for="recipe-name" class="dc-label">
                <i data-lucide="sparkles" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
                Nom de la recette
                <span class="dc-req">*</span>
              </label>
              <input
                type="text"
                name="name"
                id="recipe-name"
                class="dc-input"
                placeholder="Ex : Le Ragoût de l'Explorateur, Tarte des Sorcières…"
                value="<% if (typeof newRecipe !== 'undefined' && newRecipe && newRecipe.name) { %><%= newRecipe.name %><% } %>"
                spellcheck="true"
                lang="fr"
                required
              />
              <p class="dc-hint">
                <i data-lucide="lightbulb" width="12" height="12" stroke-width="1.8" aria-hidden="true"></i>
                Un nom évocateur qui rappelle le film ou la scène.
              </p>
              <!-- Recette(s) déjà publiée(s) pour ce film — voir add-recipes-movies-step2.js -->
              <div class="dc-existing-recipes" id="dcExistingRecipes" hidden></div>
            </div>

            <!-- Méta : Portions | Temps | Catégorie | Difficulté -->
            <div class="dc-row dc-row--recipe-meta">

              <div class="dc-field">
                <label class="dc-label" for="recipe-servings">
                  <i data-lucide="users" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
                  Portions
                </label>
                <div class="dc-portions-ctrl" id="arm-portionsCtrl">
                  <button type="button" class="dc-portions-btn" id="arm-portionsMinus" aria-label="Moins">
                    <i data-lucide="minus" width="13" height="13" stroke-width="2.2" aria-hidden="true"></i>
                  </button>
                  <span class="dc-portions-val" id="arm-portionsVal">4</span>
                  <input type="hidden" name="servings" id="recipe-servings" value="4" />
                  <button type="button" class="dc-portions-btn" id="arm-portionsPlus" aria-label="Plus">
                    <i data-lucide="plus" width="13" height="13" stroke-width="2.2" aria-hidden="true"></i>
                  </button>
                </div>
              </div>

              <div class="dc-field">
                <label for="recipe-time" class="dc-label">
                  <i data-lucide="clock" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
                  Temps (min)
                  <span class="dc-req">*</span>
                </label>
                <input
                  type="number"
                  name="time"
                  id="recipe-time"
                  class="dc-input"
                  min="1"
                  step="1"
                  placeholder="45"
                  value=""
                />
              </div>

              <div class="dc-field">
                <label for="category" class="dc-label">
                  <i data-lucide="layout-grid" width="12" height="12" stroke-width="2" aria-hidden="true"></i>
                  Catégorie
                  <span class="dc-req">*</span>
