    <!-- 3-slot upload avec preview -->
    <script>
      (function () {
        /* ── Toast upload : remplace les alert() ── */
        var toastEl   = document.getElementById('arm-upload-toast');
        var toastMsg  = document.getElementById('arm-toast-msg');
        var toastClose = document.getElementById('arm-toast-close');
        var toastTimer = null;

        function showUploadToast(message, slot) {
          clearTimeout(toastTimer);
          if (toastMsg) toastMsg.textContent = message;
          toastEl.classList.remove('is-hidden', 'is-hiding');
          /* Feedback visuel sur le slot */
          if (slot) {
            slot.classList.remove('has-error');
            void slot.offsetWidth; /* reset animation */
            slot.classList.add('has-error');
            setTimeout(function() { slot.classList.remove('has-error'); }, 800);
          }
          toastTimer = setTimeout(function () { hideUploadToast(); }, 5000);
        }

        function hideUploadToast() {
          toastEl.classList.add('is-hiding');
          setTimeout(function () {
            toastEl.classList.remove('is-hiding');
            toastEl.classList.add('is-hidden');
          }, 260);
        }

        if (toastClose) toastClose.addEventListener('click', hideUploadToast);

        var photoCount = 0;
        var slotNums = [1, 2, 3];

        slotNums.forEach(function (n) {
          var slot  = document.getElementById('arm-slot' + n);
          var input = document.getElementById(n === 1 ? 'recipeImageInput' : 'recipeImageInput' + n);
          var prev  = document.getElementById('arm-prev' + n);
          var chgBtn = document.getElementById('arm-chg' + n);
          var delBtn = document.getElementById('arm-del' + n);
          if (!slot || !input || !prev) return;

          // Click sur le slot (si pas déjà une photo) → ouvrir fichier
          slot.addEventListener('click', function (e) {
            if (chgBtn && (e.target === chgBtn || chgBtn.contains(e.target))) return;
            if (delBtn && (e.target === delBtn || delBtn.contains(e.target))) return;
            if (!slot.classList.contains('has-photo')) input.click();
          });

          // Bouton "Changer"
          if (chgBtn) {
            chgBtn.addEventListener('click', function (e) { e.stopPropagation(); input.click(); });
          }

          // Bouton "Supprimer"
          if (delBtn) {
            delBtn.addEventListener('click', function (e) {
              e.stopPropagation();
              if (!slot.classList.contains('has-photo')) return;
              input.value = '';
              prev.style.backgroundImage = '';
              prev.classList.remove('on');
              slot.classList.remove('has-photo');
              photoCount = Math.max(0, photoCount - 1);
              updateCount();
              if (photoCount === 0) {
                var rw = document.getElementById('arm-ratio-warn');
                if (rw) rw.style.display = 'none';
              }
              if (n === 1) {
                var lp = document.getElementById('recipeImagePreview');
                if (lp) lp.src = '';
              }
            });
          }

          // Sélection de fichier
          input.addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (!file) return;
            var ok = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
            if (!ok.includes(file.type)) {
              showUploadToast('Format non supporté. Utilisez JPG, PNG ou WEBP.', slot);
              input.value = '';
              return;
            }
            if (file.size > 2 * 1024 * 1024) {
              showUploadToast('Fichier trop volumineux (max 2 Mo par photo).', slot);
              input.value = '';
              return;
            }
            var ratioWarn = document.getElementById('arm-ratio-warn');
            var reader = new FileReader();
            reader.onload = function (ev) {
              var dataUrl = ev.target.result;
              var imgCheck = new Image();
              imgCheck.onload = function () {
                var r = imgCheck.width / imgCheck.height;
                // Portrait strict → blocage
                if (r < 1.0) {
                  showUploadToast('Format portrait refusé. Tenez votre téléphone à l\'horizontale ou utilisez une image en paysage.', slot);
                  input.value = '';
                  input.dispatchEvent(new Event('change'));
                  return;
                }
                // Trop large (ratio > 3.0) → blocage
                if (r > 3.0) {
                  showUploadToast('Image trop panoramique. Choisissez un format moins large.', slot);
                  input.value = '';
                  input.dispatchEvent(new Event('change'));
                  return;
                }
                // Valide : afficher la preview
                prev.style.backgroundImage = 'url("' + dataUrl + '")';
                prev.classList.add('on');
                if (!slot.classList.contains('has-photo')) {
                  slot.classList.add('has-photo');
                  photoCount++;
                  updateCount();
                }
                if (n === 1) {
                  var lp = document.getElementById('recipeImagePreview');
                  if (lp) lp.src = dataUrl;
                }
                // Warning non bloquant si ratio hors 3:2 ±15 %
                if (ratioWarn) {
                  if (Math.abs(r - 1.5) > 0.15) {
                    ratioWarn.textContent = '⚠ Votre image sera automatiquement recadrée en 3:2 pour un affichage optimal sur le site.';
                    ratioWarn.style.display = '';
                  } else {
                    ratioWarn.style.display = 'none';
                  }
                }
              };
              imgCheck.src = dataUrl;
            };
            reader.readAsDataURL(file);
          });
        });

        function updateCount() {
          var numEl = document.getElementById('arm-photoNum');
          var lblEl = document.getElementById('arm-photoLbl');
          if (numEl) numEl.textContent = photoCount;
          if (lblEl) {
            if (photoCount === 0) lblEl.textContent = 'Au moins 1 photo requise · Format 3:2 conseillé';
            else if (photoCount === 1) lblEl.textContent = '1 photo ajoutée — Vous pouvez en ajouter 2 de plus';
            else if (photoCount === 2) lblEl.textContent = '2 photos ajoutées — Vous pouvez en ajouter 1 de plus';
            else lblEl.textContent = '3 photos ajoutées ✓';
          }
        }
      })();
    </script>


    <!-- Stepper actif au scroll + Portions stepper + Compteurs lignes -->
    <script>
      // ── Stepper : highlight section active au scroll ──
      (function () {
        const steps = document.querySelectorAll('.arm-step');
        const sections = ['arm-s1', 'arm-s2', 'arm-s3'].map(function(id) { return document.getElementById(id); });
        function updateStepper() {
          var active = 0;
          sections.forEach(function(s, i) {
            if (s && s.getBoundingClientRect().top <= 120) active = i;
          });
          steps.forEach(function(st, i) {
            st.classList.toggle('arm-step--active', i === active);
            st.classList.toggle('arm-step--done', i < active);
          });
        }
        window.addEventListener('scroll', updateStepper, { passive: true });
        updateStepper();
      })();

      // ── Portions stepper ──
      (function () {
        var minus = document.getElementById('arm-portionsMinus');
        var plus = document.getElementById('arm-portionsPlus');
        var val = document.getElementById('arm-portionsVal');
        var input = document.getElementById('recipe-servings');
        var count = 4;
        function update() { val.textContent = count; input.value = count; }
        if (minus && plus) {
          minus.addEventListener('click', function() { count = Math.max(1, count - 1); update(); });
          plus.addEventListener('click', function() { count = Math.min(99, count + 1); update(); });
        }
      })();

    </script>


    <!-- ═══════════ TICKET DISABLE / ENABLE LOGIC ═══════════ -->
    <script>
    (function () {
      'use strict';

      /* ── État global ── */
      var steps = { s1: false, s2: false, s3: false };

      /* ── Navigation par onglets — bascule les panneaux, pas de scroll ── */
      function goToTab(n, skipScroll) {
        var tab = document.getElementById('tab' + n);
        if (n !== 1 && tab && tab.classList.contains('dc-tab--locked')) return;

        for (var i = 1; i <= 3; i++) {
          var panel = document.getElementById('arm-s' + i);
          var t = document.getElementById('tab' + i);
          if (panel) panel.hidden = i !== n;
          if (t) t.setAttribute('aria-selected', i === n ? 'true' : 'false');
        }

        var eyebrow = document.getElementById('dcStepEyebrow');
        if (eyebrow) eyebrow.textContent = 'ÉTAPE ' + n + ' SUR 3';
        var counters = document.getElementById('dcCounters');
        if (counters) counters.hidden = n !== 3;

        if (!skipScroll) {
          var main = document.getElementById('main-content');
          if (main) main.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      window.goToTab = goToTab;
      goToTab(<% if (typeof newMovie !== 'undefined' && newMovie) { %>2<% } else { %>1<% } %>, true);

      /* Clic sur un onglet ou un lien "data-goto-tab" (CTA Retour / Continuer) */
      document.addEventListener('click', function (e) {
        var tabBtn = e.target.closest('.dc-tab');
        if (tabBtn && tabBtn.id && /^tab[123]$/.test(tabBtn.id)) {
          goToTab(parseInt(tabBtn.id.replace('tab', ''), 10));
          return;
        }
        var gotoLink = e.target.closest('[data-goto-tab]');
        if (gotoLink) {
          e.preventDefault();
          goToTab(parseInt(gotoLink.getAttribute('data-goto-tab'), 10));
        }
      });

      /* Navigation clavier ← → entre onglets déverrouillés */
      var dcTabbarEl = document.querySelector('.dc-tabbar');
      if (dcTabbarEl) {
        dcTabbarEl.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          var current = document.activeElement.closest ? document.activeElement.closest('.dc-tab') : null;
          if (!current) return;
          var idx = parseInt(current.id.replace('tab', ''), 10);
          var next = e.key === 'ArrowRight' ? idx + 1 : idx - 1;
          if (next < 1 || next > 3) return;
          var nextTabEl = document.getElementById('tab' + next);
          if (nextTabEl && !nextTabEl.classList.contains('dc-tab--locked')) {
            e.preventDefault();
            nextTabEl.focus();
            goToTab(next);
          }
        });
      }

      /* ── SVG check ── */
      var CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18"><polyline points="20 6 9 17 4 12"/></svg>';
      var PILL_CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="9" height="9"><polyline points="20 6 9 17 4 12"/></svg>';
      var PILL_WAIT  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="9" height="9"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>';
      var PILL_LABELS = ['Film', 'Recette', 'Ingrédients'];

      /* ── Mise à jour du Golden Ticket ── */
      function updateTicket() {
        var allDone = steps.s1 && steps.s2 && steps.s3;
        var ticket  = document.getElementById('arm-ticket');
        var btn     = document.getElementById('submit-unified-form');
        var hint    = document.getElementById('unlockHint');
        if (!ticket) return;

        if (allDone) {
          ticket.classList.remove('arm-ticket--disabled');
          ticket.classList.add('arm-ticket--enabled');
          if (btn) btn.disabled = false;
          if (hint) hint.textContent = 'Tout est prêt — bonne publication !';
        } else {
          ticket.classList.add('arm-ticket--disabled');
          ticket.classList.remove('arm-ticket--enabled');
          if (btn) btn.disabled = true;
          if (hint) {
            var missing = [!steps.s1 && 'film', !steps.s2 && 'recette', !steps.s3 && 'ingrédients'].filter(Boolean);
            hint.textContent = missing.length ? 'Manquant : ' + missing.join(', ') : 'Complétez les 3 étapes pour publier';
          }
        }
      }

      /* ── Marquer une étape comme terminée ── */
      function setStepDone(n) {
        if (steps['s' + n]) return; // déjà fait
        steps['s' + n] = true;

        var tab   = document.getElementById('tab' + n);
        var card  = document.getElementById('arm-s' + n);
        var badge = document.getElementById('s' + n + 'badge');
        var prog  = document.getElementById('prog' + n);
        var pill  = document.getElementById('tpill' + n);

        /* Stepper */
        if (tab) {
          tab.classList.remove('arm-step--active');
          tab.classList.add('arm-step--done');
          var bubble = tab.querySelector('.dc-tab__bubble');
          if (bubble) bubble.innerHTML = CHECK_SVG;
        }
        if (prog) { prog.style.width = '100%'; prog.style.background = 'linear-gradient(90deg,#2a7a50,#3daa72)'; }

        /* Card */
        if (card) {
          card.classList.remove('arm-card--active');
          card.classList.add('arm-card--done');
        }

        /* Badge en-tête */
        if (badge) {
          badge.classList.add('arm-hd__step-badge--done');
          var numEl = badge.querySelector('.badge-num');
          if (numEl) numEl.innerHTML = CHECK_SVG;
        }

        /* Pill ticket */
        if (pill) {
          pill.className = 'ticket-step-pill ticket-step-pill--ok';
          pill.innerHTML = PILL_CHECK + ' ' + PILL_LABELS[n - 1];
        }

        /* Activer + déverrouiller la section suivante */
        var nextCard = document.getElementById('arm-s' + (n + 1));
        var nextTab  = document.getElementById('tab' + (n + 1));
        if (nextCard) nextCard.classList.add('arm-card--active');
        if (nextTab && !steps['s' + (n + 1)]) {
          nextTab.classList.add('arm-step--active');
          nextTab.classList.remove('dc-tab--locked');
          var nextState = nextTab.querySelector('.dc-tab__state');
          if (nextState) nextState.innerHTML = '';
        }

        updateTicket();
      }

      /* ── Pill wait reset (si contenu effacé) ── */
      function setStepWait(n) {
        if (!steps['s' + n]) return;
        steps['s' + n] = false;

        var tab   = document.getElementById('tab' + n);
        var card  = document.getElementById('arm-s' + n);
        var badge = document.getElementById('s' + n + 'badge');
        var prog  = document.getElementById('prog' + n);
        var pill  = document.getElementById('tpill' + n);

        if (tab) {
          tab.classList.remove('arm-step--done'); tab.classList.add('arm-step--active');
          var bubble = tab.querySelector('.dc-tab__bubble');
          if (bubble) bubble.textContent = String(n).padStart(2, '0');
        }
        if (prog) { prog.style.width = '35%'; prog.style.background = ''; }
        if (card) { card.classList.remove('arm-card--done'); card.classList.add('arm-card--active'); }
        if (badge) {
          badge.classList.remove('arm-hd__step-badge--done');
          var numEl = badge.querySelector('.badge-num');
          if (numEl) numEl.innerHTML = String(n);
        }
        if (pill) {
          pill.className = 'ticket-step-pill ticket-step-pill--wait';
          pill.innerHTML = PILL_WAIT + ' ' + PILL_LABELS[n - 1];
        }

        /* Re-verrouiller les étapes suivantes si celle-ci redevient invalide */
        for (var k = n + 1; k <= 3; k++) {
          var laterTab = document.getElementById('tab' + k);
          if (laterTab && !steps['s' + k]) {
            laterTab.classList.add('dc-tab--locked');
            var laterState = laterTab.querySelector('.dc-tab__state');
            if (laterState) laterState.innerHTML = '<i data-lucide="lock" width="13" height="13" stroke-width="2" aria-hidden="true"></i>';
          }
        }
        if (window.lucide) lucide.createIcons();

        updateTicket();
      }

      /* ══ S1 — Film (titre + année + genre non vides) ══ */
      var filmName = document.getElementById('film-name');
      var filmYearEl = document.getElementById('film-year');
      var filmGenreEl = document.getElementById('film-genre');
      function checkS1() {
        if (!filmName) return;
        var valid = filmName.value.trim() && filmYearEl && filmYearEl.value.trim() && filmGenreEl && filmGenreEl.value.trim();
        if (valid) setStepDone(1);
        else setStepWait(1);
      }
      window.checkS1 = checkS1;
      if (filmName) {
        filmName.addEventListener('input', checkS1);
        filmName.addEventListener('change', checkS1);
      }
      // Déclenché par le nouveau JS de l'étape 01 (import TMDB / édition manuelle)
      document.addEventListener('tmdbFormPrefilled', checkS1);
      document.addEventListener('filmSelected', checkS1);

      /* ══ S2 — Recette (nom + au moins 1 photo) ══ */
      var recipeName = document.getElementById('recipe-name');
      var photoInputs = [
        document.getElementById('recipeImageInput'),
        document.getElementById('recipeImageInput2'),
        document.getElementById('recipeImageInput3'),
      ];
      function checkS2() {
        var hasName = recipeName && recipeName.value.trim().length > 0;
        var hasPhoto = photoInputs.some(function(inp) { return inp && inp.files && inp.files.length > 0; });
        if (hasName && hasPhoto) setStepDone(2);
        else setStepWait(2);
      }
      if (recipeName) {
        recipeName.addEventListener('input', checkS2);
        recipeName.addEventListener('paste', function() { setTimeout(checkS2, 0); });
      }
      photoInputs.forEach(function(inp) {
        if (inp) inp.addEventListener('change', checkS2);
      });

      /* ══ S3 — Ingrédients & Préparation (état géré par le script des éditeurs
         structurés — voir window.armIngredientsCount / window.armPreparationCount) ══ */
      function checkS3() {
        var hasIng  = (window.armIngredientsCount  || 0) > 0;
        var hasPrep = (window.armPreparationCount || 0) > 0;
        if (hasIng && hasPrep) setStepDone(3);
        else setStepWait(3);
      }
      window.checkS3 = checkS3;

      /* ══ Init : si film déjà confirmé côté serveur ══ */
      <% if (typeof newMovie !== 'undefined' && newMovie) { %>
      setStepDone(1);
      <% } else { %>
      checkS1();
      <% } %>

      updateTicket();

    })();
    </script>
  </body>
</html>
