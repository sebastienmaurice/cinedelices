<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajouter un film et une recette - Ciné Délices</title>
    <meta
      name="description"
      content="Ciné Délices — Ajoutez votre film et votre recette inspirée"
    />

    <!-- Ressources globales -->
    <%- include("partials/head-resources") %>

    <!-- Styles -->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/add-recipes-movies.css" />
  </head>
  <body class="arm-full-bleed">
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- ═══════════ HERO CINÉMA FULL-WIDTH ═══════════ -->
    <section class="arm-hero">
      <!-- Couche décorative clippée séparément pour que les dropdowns ne soient pas masqués -->
      <div class="arm-hero__deco" aria-hidden="true">
        <div class="arm-hero__bg"></div>
        <div class="arm-hero__reel arm-hero__reel--1"></div>
        <div class="arm-hero__reel arm-hero__reel--2"></div>
        <div class="arm-hero__scanlines"></div>
        <div class="arm-hero__vignette"></div>
      </div>
      <div class="arm-hero__content">
        <div class="arm-hero__top">
          <p class="arm-hero__breadcrumb">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
            Contribution · Communauté
          </p>
          <h1 class="arm-hero__title">AJOUTER UN FILM &amp; <em>UNE RECETTE</em></h1>
          <p class="arm-hero__sub">Partagez votre passion du cinéma et de la cuisine avec la communauté Ciné Délices.</p>
        </div>

        <div class="arm-hero__bottom">
          <!-- Tags — classes officielles moodboard v3 -->
          <div class="arm-hero__tags" aria-hidden="true">
            <span class="tag tag--or">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 12h18"/><path d="M17 3v18"/></svg>
              Film &amp; Série
            </span>
            <span class="tag tag--rouge">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" x2="18" y1="17" y2="17"/></svg>
              Recette inspirée
            </span>
            <span class="tag tag--bleu">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Communauté
            </span>
            <span class="tag tag--vert">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
              Contribution libre
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ STEPPER STICKY ═══════════ -->
    <div class="arm-stepper-wrap">
      <nav class="arm-stepper" aria-label="Progression du formulaire">
        <a class="arm-step arm-step--active" href="#arm-s1">
          <div class="arm-step__bubble">1</div>
          <div class="arm-step__info">
            <span class="arm-step__label">Étape 1 / 3</span>
            <span class="arm-step__name">Mon film ou ma série</span>
          </div>
        </a>
        <a class="arm-step" href="#arm-s2">
          <div class="arm-step__bubble">2</div>
          <div class="arm-step__info">
            <span class="arm-step__label">Étape 2 / 3</span>
            <span class="arm-step__name">Ma recette</span>
          </div>
        </a>
        <a class="arm-step" href="#arm-s3">
          <div class="arm-step__bubble">3</div>
          <div class="arm-step__info">
            <span class="arm-step__label">Étape 3 / 3</span>
            <span class="arm-step__name">Ingrédients &amp; préparation</span>
          </div>
        </a>
      </nav>
    </div>

    <!-- ═══════════ MAIN ═══════════ -->
    <main class="arm-page">

      <!-- ALERTES -->
      <% if (typeof success !== "undefined" && success && typeof successMessage !== "undefined" && successMessage) { %>
      <div class="alert alert-success alert-success--with-actions">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        <div class="alert__content">
          <p><%= successMessage %></p>
          <div class="alert__actions">
            <a href="/movies" class="btn btn--primary btn--sm">Voir les films</a>
            <a href="/auth/profil/<%= typeof userId !== 'undefined' && userId ? userId : '' %>" class="btn btn--secondary btn--sm">Mon compte</a>
          </div>
        </div>
      </div>
      <% } %>
      <% if (typeof error !== "undefined" && error && typeof errorMessage !== "undefined" && errorMessage) { %>
      <div class="alert alert-error">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
        <p><%= errorMessage %></p>
      </div>
      <% } %>
      <% if (typeof duplicateWarning !== "undefined" && duplicateWarning) { %>
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        <p>
          Ce film existe déjà dans notre base de données. Vous pouvez continuer
          à ajouter votre recette.
        </p>
      </div>
      <% } %>

      <!-- ═══ TOAST badge débloqué ═══ -->
      <% if (typeof newBadges !== 'undefined' && newBadges && newBadges.length > 0) {
        const _badgeEmoji = { STRANGE: '🧙', HARRY: '⚡', INDIANA: '🎩', MATRIX: '💊', FREDDY: '🔪', READY: '🕹️' };
        const _badgeLabel = { STRANGE: 'Doctor Strange', HARRY: 'Harry Potter', INDIANA: 'Indiana Jones', MATRIX: 'Matrix', FREDDY: 'Freddy', READY: 'Ready Player One' };
        newBadges.forEach(function(b) {
          const _code  = (b.code || '').toUpperCase();
          const _emoji = _badgeEmoji[_code] || '🏆';
          const _label = _badgeLabel[_code] || b.label || b.code;
      %>
      <div class="badge-unlock-toast" role="status" aria-live="polite">
        <span class="badge-unlock-toast__icon" aria-hidden="true"><%= _emoji %></span>
        <div class="badge-unlock-toast__body">
          <strong>Badge débloqué !</strong>
          <span>Tu as obtenu "<%= _label %>" <%= _emoji %></span>
        </div>
      </div>
      <% }); } %>

      <!-- ══════════════════════════════════════════
         SECTION 1 — MON FILM
         Layout 2 colonnes : champs | poster preview
      ══════════════════════════════════════════ -->
      <article class="arm-card" id="arm-s1" aria-labelledby="arm-s1-title">
        <span class="arm-card__num" aria-hidden="true">01</span>
        <div class="arm-body">

          <form id="film-preview-form" method="post" onsubmit="return false;">
            <div class="arm-s1-layout">

              <!-- ── Champs formulaire ── -->
              <div class="arm-s1-fields">

                <div class="arm-hd">
                  <div class="arm-hd__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                  </div>
                  <div class="arm-hd__text">
                    <span class="arm-hd__step">Étape 1</span>
                    <h2 class="arm-hd__title" id="arm-s1-title">MON FILM OU MA SÉRIE</h2>
                    <p class="arm-hd__desc">
                      Renseignez l'œuvre qui inspire votre recette. Titre, année,
                      genre — ces informations apparaîtront sur votre fiche.
                    </p>
                  </div>
                  <div class="arm-hd__rule"></div>
                </div>

                <!-- Titre · Année · Genre -->
                <div class="arm-row arm-row--film">
                  <div class="arm-field">
                    <label for="film-name" class="arm-label">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                      Titre
                      <span class="arm-req">*</span>
                    </label>
                    <div class="film-name-input-wrapper">
                      <input
                        type="text"
                        name="title"
                        id="film-name"
                        class="arm-input"
                        spellcheck="true"
                        lang="fr en"
                        autocomplete="off"
                        <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                        placeholder="Ex: Retour vers le futur, Breaking Bad..."
                        <% } else { %>
                        placeholder="<%= newMovie.title %>"
                        <% } %>
                        value=""
                      />
                      <div
                        id="film-search-results"
                        class="film-search-results"
                        aria-live="polite"
                      ></div>
                    </div>
                    <span class="arm-hint">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                      Film, série, anime, documentaire…
                    </span>
                  </div>

                  <div class="arm-field arm-field--year" id="arm-field-year">
                    <label for="film-year" class="arm-label">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                      Année
                      <span class="arm-req">*</span>
                      <span class="arm-label__source">TMDB</span>
                    </label>
                    <input
                      type="number"
                      name="year"
                      id="film-year"
                      class="arm-input"
                      min="1888"
                      max="<%= new Date().getFullYear() + 5 %>"
                      <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                      placeholder="Ex: 1985"
                      <% } else { %>
                      placeholder="<%= newMovie.year %>"
                      <% } %>
                      value=""
                    />
                  </div>

                  <div class="arm-field arm-field--genre" id="arm-field-genre">
                    <label for="film-genre" class="arm-label">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H2v7l6.29 6.29c.94.94 2.48.94 3.42 0l3.58-3.58c.94-.94.94-2.48 0-3.42L9 5Z"/><path d="M6 9.01V9"/><path d="m15 5 6.3 6.3a2.4 2.4 0 0 1 0 3.4L17 19"/></svg>
                      Genre
                      <span class="arm-req">*</span>
                      <span class="arm-label__source">TMDB</span>
                    </label>
                    <select name="genre" id="film-genre" class="arm-select">
                      <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                      <option value="" disabled selected>Choisir…</option>
                      <% } else { %>
                      <option value=""><%= newMovie.genre %></option>
                      <% } %>
                      <option value="action">Action</option>
                      <option value="animation">Animation</option>
                      <option value="aventure">Aventure</option>
                      <option value="comédie">Comédie</option>
                      <option value="crime">Crime</option>
                      <option value="documentaire">Documentaire</option>
                      <option value="drame">Drame</option>
                      <option value="familial">Familial</option>
                      <option value="fantastique">Fantastique</option>
                      <option value="guerre">Guerre</option>
                      <option value="histoire">Histoire</option>
                      <option value="horreur">Horreur</option>
                      <option value="musique">Musique</option>
                      <option value="mystère">Mystère</option>
                      <option value="romance">Romance</option>
                      <option value="science-fiction">Science-Fiction</option>
                      <option value="thriller">Thriller</option>
                      <option value="téléfilm">Téléfilm</option>
                      <option value="western">Western</option>
                    </select>
                  </div>
                </div>

                <!-- Synopsis -->
                <div class="arm-field" id="arm-field-synopsis">
                  <label for="film-synopsis" class="arm-label">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
                    Synopsis
                    <span class="arm-label__source">TMDB</span>
                  </label>
                  <textarea
                    name="synopsis"
                    id="film-synopsis"
                    class="arm-textarea"
                    rows="3"
                    spellcheck="true"
                    lang="fr"
                    maxlength="800"
                    placeholder="Résumé court du film ou de la série — rempli automatiquement depuis TMDB…"
                  ><% if (typeof newMovie !== "undefined" && newMovie && newMovie.synopsis) { %><%= newMovie.synopsis %><% } %></textarea>
                </div>

                <!-- CTA -->
                <div class="arm-cta-row">
                  <span class="arm-cta-row__hint">Renseignez votre film pour continuer</span>
                  <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                  <button class="btn btn--hero arm-cta-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                    Je passe à la recette
                  </button>
                  <% } %>
                </div>
              </div>

              <!-- ── Poster preview droite ── -->
              <div class="arm-poster-wrap">
                <p class="arm-poster__label">Aperçu de votre fiche film</p>
                <div class="arm-poster-card" id="arm-posterCard">
                  <%
                    let hasMovieWithImage = false;
                    if (
                      typeof newMovie !== "undefined" &&
                      newMovie &&
                      (newMovie.cardPath || newMovie.picture) &&
                      typeof (newMovie.cardPath || newMovie.picture) === "string" &&
                      (newMovie.cardPath || newMovie.picture).trim() !== ""
                    ) {
                      hasMovieWithImage = true;
                    }
                  %>
                  <div class="arm-poster-img film-selected-image">
                    <% if (hasMovieWithImage) { %>
                    <img
                      src="<%= newMovie.cardPath || newMovie.picture %>"
                      alt="Affiche du film ajouté"
                    />
                    <% } else { %>
                    <img
                      src="/images/image-default-movie.jpg"
                      alt="Image de film par défaut"
                    />
                    <% } %>
                    <div class="arm-poster-ph" id="arm-posterPh">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 12h18"/><path d="M17 3v18"/></svg>
                      <span>Affiche du film</span>
                    </div>
                    <div class="arm-poster-tz">
                      <span class="arm-poster-name" id="display-film-name">
                        <% if (typeof newMovie !== "undefined" && newMovie && newMovie.title) { %><%= newMovie.title %><% } else { %>—<% } %>
                      </span>
                      <span class="arm-poster-year" id="display-film-year">
                        <% if (typeof newMovie !== "undefined" && newMovie && newMovie.year) { %><%= newMovie.year %><% } %>
                      </span>
                    </div>
                  </div>
                  <div class="arm-poster-body">
                    <div class="arm-poster-genre-row" id="display-film-genre">
                      <% if (typeof newMovie !== "undefined" && newMovie && newMovie.genre) { %>
                      <span class="arm-genre-badge"><%= newMovie.genre %></span>
                      <% } %>
                    </div>
                    <p id="display-film-synopsis" class="arm-poster-synopsis">
                      <% if (typeof newMovie !== "undefined" && newMovie && newMovie.synopsis) { %><%= newMovie.synopsis %><% } %>
                    </p>
                    <% if (!hasMovieWithImage) { %>
                    <p class="arm-hint arm-hint--italic">
                      * L'affiche sera ajoutée par Ciné Délices
                    </p>
                    <% } %>
                    <p class="arm-poster-empty" id="arm-posterEmpty">
                      <% if (typeof newMovie === "undefined" || !newMovie || !newMovie.title) { %>
                      Remplissez les champs pour prévisualiser
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>

            </div><!-- /arm-s1-layout -->
          </form>

        </div>
      </article>

      <!-- ══════════════════════════════════════════
         SECTIONS 2, 3 & TICKET — dans unified-form
      ══════════════════════════════════════════ -->
      <form
        id="unified-form"
        action="/add-recipes-movies/movie-and-recipe"
        method="post"
        enctype="multipart/form-data"
      >
        <!-- CHAMPS CACHÉS -->
        <input type="hidden" name="filmId" id="filmId-hidden" value="<% if (typeof newMovie !== 'undefined' && newMovie && newMovie.id) { %><%= newMovie.id %><% } %>" />
        <input type="hidden" name="title" id="film-title-hidden" value="" />
        <input type="hidden" name="year" id="film-year-hidden" value="" />
        <input type="hidden" name="genre" id="film-genre-hidden" value="" />
        <input type="hidden" name="synopsis" id="film-synopsis-hidden" value="" />
        <input type="hidden" name="tmdbId" id="tmdbId-hidden" value="" />
        <input type="hidden" name="titleFR" id="titleFR-hidden" value="" />
        <input type="hidden" name="tmdbYear" id="tmdbYear-hidden" value="" />
        <input type="hidden" name="tmdbGenre" id="tmdbGenre-hidden" value="" />

        <!-- ══════════════════════════════════════════
           SECTION 2 — MA RECETTE
        ══════════════════════════════════════════ -->
        <article class="arm-card" id="arm-s2" aria-labelledby="arm-s2-title">
          <span class="arm-card__num" aria-hidden="true">02</span>
          <div class="arm-body">

            <div class="arm-hd">
              <div class="arm-hd__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" x2="18" y1="17" y2="17"/></svg>
              </div>
              <div class="arm-hd__text">
                <span class="arm-hd__step">Étape 2</span>
                <h2 class="arm-hd__title" id="arm-s2-title">MA RECETTE</h2>
                <p class="arm-hd__desc">
                  Décrivez votre recette, choisissez la catégorie et ajoutez votre photo.
                </p>
              </div>
              <div class="arm-hd__rule"></div>
            </div>



            <!-- Nom de la recette -->
            <div class="arm-field">
              <label for="recipe-name" class="arm-label">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                Nom de la recette
                <span class="arm-req">*</span>
              </label>
              <input
                type="text"
                name="name"
                id="recipe-name"
                class="arm-input"
                placeholder="Ex : Le Ragoût de l'Explorateur, Tarte des Sorcières…"
                value=""
                spellcheck="true"
                lang="fr"
              />
              <span class="arm-hint">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                Un nom évocateur qui rappelle le film ou la scène.
              </span>
            </div>

            <!-- Méta : Portions | Temps | Catégorie | Difficulté -->
            <div class="arm-row arm-row--meta">

              <div class="arm-field">
                <label class="arm-label">
