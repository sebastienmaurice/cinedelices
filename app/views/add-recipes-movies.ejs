<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajouter un film et une recette - Ciné Délices</title>
    <meta
      name="description"
      content="Ciné Délices — Ajoutez votre film et votre recette inspirée"
    />

    <!-- Ressources globales -->
    <%- include("partials/head-resources") %>

    <!-- Styles -->
    <link rel="stylesheet" href="/css/add-recipes-movies.css" />
  </head>
  <body class="arm-full-bleed">
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- ═══════════ HERO CINÉMA FULL-WIDTH ═══════════ -->
    <section class="arm-hero">
      <!-- Couche décorative clippée séparément pour que les dropdowns ne soient pas masqués -->
      <div class="arm-hero__deco" aria-hidden="true">
        <div class="arm-hero__bg"></div>
        <div class="arm-hero__reel arm-hero__reel--1"></div>
        <div class="arm-hero__reel arm-hero__reel--2"></div>
        <div class="arm-hero__scanlines"></div>
        <div class="arm-hero__vignette"></div>
      </div>
      <div class="arm-hero__content">
        <div class="arm-hero__top">
          <p class="arm-hero__breadcrumb">
            <i data-lucide="film" width="14" height="14" stroke-width="2" aria-hidden="true"></i>
            Contribution · Communauté
          </p>
          <h1 class="arm-hero__title">AJOUTER UN FILM &amp; <em>UNE RECETTE</em></h1>
          <p class="arm-hero__sub">Partagez votre passion du cinéma et de la cuisine avec la communauté Ciné Délices.</p>
        </div>

        <div class="arm-hero__bottom">
          <!-- Tags — classes officielles moodboard v3 -->
          <div class="arm-hero__tags" aria-hidden="true">
            <span class="tag tag--or">
              <i data-lucide="film" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Film &amp; Série
            </span>
            <span class="tag tag--rouge">
              <i data-lucide="lightbulb" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Recette inspirée
            </span>
            <span class="tag tag--bleu">
              <i data-lucide="users" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Communauté
            </span>
            <span class="tag tag--vert">
              <i data-lucide="sparkles" width="11" height="11" stroke-width="2.2" aria-hidden="true"></i>
              Contribution libre
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ STEPPER STICKY ═══════════ -->
    <div class="arm-stepper-wrap">
      <nav class="arm-stepper" aria-label="Progression du formulaire">
        <a class="arm-step <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-step--done<% } else { %>arm-step--active<% } %>" href="#arm-s1" id="tab1">
          <div class="arm-step__bubble">
            <% if (typeof newMovie !== 'undefined' && newMovie) { %>
            <i data-lucide="check" width="14" height="14" stroke-width="2.5" aria-hidden="true"></i>
            <% } else { %>1<% } %>
          </div>
          <div class="arm-step__info">
            <span class="arm-step__label">Étape 1 / 3</span>
            <span class="arm-step__name">Mon film ou ma série</span>
          </div>
          <div class="arm-step__progress"><div class="arm-step__progress-bar" id="prog1" <% if (typeof newMovie !== 'undefined' && newMovie) { %>style="width:100%;background:linear-gradient(90deg,#2a7a50,#3daa72)"<% } %>></div></div>
        </a>
        <a class="arm-step <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-step--active<% } %>" href="#arm-s2" id="tab2">
          <div class="arm-step__bubble">2</div>
          <div class="arm-step__info">
            <span class="arm-step__label">Étape 2 / 3</span>
            <span class="arm-step__name">Ma recette</span>
          </div>
          <div class="arm-step__progress"><div class="arm-step__progress-bar" id="prog2"></div></div>
        </a>
        <a class="arm-step" href="#arm-s3" id="tab3">
          <div class="arm-step__bubble">3</div>
          <div class="arm-step__info">
            <span class="arm-step__label">Étape 3 / 3</span>
            <span class="arm-step__name">Ingrédients &amp; préparation</span>
          </div>
          <div class="arm-step__progress"><div class="arm-step__progress-bar" id="prog3"></div></div>
        </a>
      </nav>
    </div>

    <!-- ═══════════ MAIN ═══════════ -->
    <main id="main-content" class="arm-page">

      <!-- ALERTES -->
      <% if (typeof success !== "undefined" && success && typeof successMessage !== "undefined" && successMessage) { %>
      <div class="alert alert-success alert-success--with-actions">
        <i data-lucide="circle-check" width="24" height="24" class="lucide-icon" aria-hidden="true"></i>
        <div class="alert__content">
          <p><%= successMessage %></p>
          <div class="alert__actions">
            <a href="/movies" class="btn btn--primary btn--sm">Voir les films</a>
            <a href="/auth/profil/<%= typeof userId !== 'undefined' && userId ? userId : '' %>" class="btn btn--secondary btn--sm">Mon compte</a>
          </div>
        </div>
      </div>
      <% } %>
      <% if (typeof error !== "undefined" && error && typeof errorMessage !== "undefined" && errorMessage) { %>
      <div class="alert alert-error">
        <i data-lucide="circle-x" width="24" height="24" class="lucide-icon" aria-hidden="true"></i>
        <p><%= errorMessage %></p>
      </div>
      <% } %>
      <% if (typeof duplicateWarning !== "undefined" && duplicateWarning) { %>
      <div class="alert alert-info">
        <i data-lucide="circle-alert" width="24" height="24" class="lucide-icon" aria-hidden="true"></i>
        <p>
          Ce film existe déjà dans notre base de données. Vous pouvez continuer
          à ajouter votre recette.
        </p>
      </div>
      <% } %>

      <!-- ═══ TOAST badge débloqué ═══ -->
      <% if (typeof newBadges !== 'undefined' && newBadges && newBadges.length > 0) {
        const _badgeIcon  = { STRANGE: 'wand-2', HARRY: 'zap', INDIANA: 'compass', MATRIX: 'code-2' };
        const _badgeLabel = { STRANGE: 'Doctor Strange', HARRY: 'Harry Potter', INDIANA: 'Indiana Jones', MATRIX: 'Matrix' };
        newBadges.forEach(function(b) {
          const _code  = (b.code || '').toUpperCase();
          const _icon  = _badgeIcon[_code] || 'trophy';
          const _label = _badgeLabel[_code] || b.label || b.code;
      %>
      <div class="badge-unlock-toast" role="status" aria-live="polite">
        <span class="badge-unlock-toast__icon" aria-hidden="true">
          <i data-lucide="<%= _icon %>" width="20" height="20" aria-hidden="true"></i>
        </span>
        <div class="badge-unlock-toast__body">
          <strong>Badge débloqué !</strong>
          <span>Tu as obtenu "<%= _label %>"</span>
        </div>
      </div>
      <% }); } %>

      <!-- ══════════════════════════════════════════
         SECTION 1 — MON FILM
         Layout 2 colonnes : champs | poster preview
      ══════════════════════════════════════════ -->
      <article class="arm-card <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-card--confirmed arm-card--done<% } else { %>arm-card--active<% } %>" id="arm-s1" aria-labelledby="arm-s1-title">
        <span class="arm-card__num" aria-hidden="true">01</span>
        <div class="arm-body">

        <% if (typeof newMovie !== 'undefined' && newMovie) { %>
          <!-- ── Film existant : résumé compact ── -->
          <div class="arm-film-confirmed">
            <div class="arm-film-confirmed__poster film-selected-image">
              <img
                src="<%= newMovie.cardPath || newMovie.picture || '/images/movie-default-img.png' %>"
                alt="Affiche <%= newMovie.title %>"
                onerror="this.onerror=null;this.src='/images/movie-default-img.png'"
              />
            </div>
            <div class="arm-film-confirmed__info">
              <span class="arm-film-confirmed__check">
                <i data-lucide="check" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
                Film sélectionné
              </span>
              <h2 class="arm-film-confirmed__title" id="arm-s1-title"><%= newMovie.title %></h2>
              <div class="arm-film-confirmed__meta">
                <% if (newMovie.year) { %><span class="arm-film-confirmed__year"><%= newMovie.year %></span><% } %>
                <% if (newMovie.genre) { %><span class="arm-film-confirmed__genre"><%= newMovie.genre %></span><% } %>
              </div>
              <% if (newMovie.synopsis) { %>
              <p class="arm-film-confirmed__synopsis"><%= newMovie.synopsis.length > 140 ? newMovie.synopsis.slice(0, 140) + '…' : newMovie.synopsis %></p>
              <% } %>
            </div>
            <a href="/add-recipes-movies/" class="arm-film-confirmed__change">
              <i data-lucide="square-pen" width="13" height="13" stroke-width="2" aria-hidden="true"></i>
              Changer de film
            </a>
          </div>
          <!-- Champ caché pour les JS qui lisent #film-preview-form -->
          <form id="film-preview-form" method="post" onsubmit="return false;" style="display:none">
            <input type="text" id="film-name" value="<%= newMovie.title %>" />
            <input type="number" id="film-year" value="<%= newMovie.year %>" />
            <select id="film-genre"><option value="<%= newMovie.genre %>" selected><%= newMovie.genre %></option></select>
            <textarea id="film-synopsis"><%= newMovie.synopsis || '' %></textarea>
          </form>
        <% } else { %>
          <form id="film-preview-form" method="post" onsubmit="return false;">
            <div class="arm-s1-layout">

              <!-- ── Champs formulaire ── -->
              <div class="arm-s1-fields">

                <div class="arm-hd">
                  <div class="arm-hd__step-badge" id="s1badge">
                    <span class="badge-num">1</span>
                    <span class="badge-lbl">Étape</span>
                  </div>
                  <div class="arm-hd__text">
                    <span class="arm-hd__step">Étape 1</span>
                    <h2 class="arm-hd__title" id="arm-s1-title">MON FILM OU MA SÉRIE</h2>
                    <p class="arm-hd__desc">
                      Renseignez l'œuvre qui inspire votre recette. Titre, année,
                      genre — ces informations apparaîtront sur votre fiche.
                    </p>
                  </div>
                  <div class="arm-hd__rule"></div>
                </div>

                <!-- Titre · Année · Genre -->
                <div class="arm-row arm-row--film">
                  <div class="arm-field">
                    <label for="film-name" class="arm-label">
                      <i data-lucide="film" aria-hidden="true"></i>
                      Titre
                      <span class="arm-req">*</span>
                    </label>
                    <div class="film-name-input-wrapper">
                      <input
                        type="text"
                        name="title"
                        id="film-name"
                        class="arm-input"
                        spellcheck="true"
                        lang="fr en"
                        autocomplete="off"
                        required
                        <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                        placeholder="Ex: Retour vers le futur, Breaking Bad..."
                        value=""
                        <% } else { %>
                        placeholder="<%= newMovie.title %>"
                        value="<%= newMovie.title %>"
                        <% } %>
                      />
                      <div
                        id="film-search-results"
                        class="film-search-results"
                        aria-live="polite"
                      ></div>
                    </div>
                    <span class="arm-hint">
                      <i data-lucide="circle-alert" aria-hidden="true"></i>
                      Film, série, anime, documentaire…
                    </span>
                  </div>

                  <div class="arm-field arm-field--year" id="arm-field-year">
                    <label for="film-year" class="arm-label">
                      <i data-lucide="calendar" aria-hidden="true"></i>
                      Année
                      <span class="arm-req">*</span>
                      <span class="arm-label__source">TMDB</span>
                    </label>
                    <input
                      type="number"
                      name="year"
                      id="film-year"
                      class="arm-input"
                      min="1888"
                      max="<%= new Date().getFullYear() + 5 %>"
                      required
                      <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                      placeholder="Ex: 1985"
                      value=""
                      <% } else { %>
                      placeholder="<%= newMovie.year %>"
                      value="<%= newMovie.year %>"
                      <% } %>
                    />
                  </div>

                  <div class="arm-field arm-field--genre" id="arm-field-genre">
                    <label for="film-genre" class="arm-label">
                      <i data-lucide="tag" aria-hidden="true"></i>
                      Genre
                      <span class="arm-req">*</span>
                      <span class="arm-label__source">TMDB</span>
                    </label>
                    <select name="genre" id="film-genre" class="arm-select" required>
                      <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                      <option value="" disabled selected>Choisir…</option>
                      <% } else { %>
                      <option value="<%= newMovie.genre %>" selected><%= newMovie.genre %></option>
                      <% } %>
                      <option value="action">Action</option>
                      <option value="animation">Animation</option>
                      <option value="aventure">Aventure</option>
                      <option value="comédie">Comédie</option>
                      <option value="crime">Crime</option>
                      <option value="documentaire">Documentaire</option>
                      <option value="drame">Drame</option>
                      <option value="familial">Familial</option>
                      <option value="fantastique">Fantastique</option>
                      <option value="guerre">Guerre</option>
                      <option value="histoire">Histoire</option>
                      <option value="horreur">Horreur</option>
                      <option value="musique">Musique</option>
                      <option value="mystère">Mystère</option>
                      <option value="romance">Romance</option>
                      <option value="science-fiction">Science-Fiction</option>
                      <option value="thriller">Thriller</option>
                      <option value="téléfilm">Téléfilm</option>
                      <option value="western">Western</option>
                    </select>
                  </div>
                </div>

                <!-- Synopsis -->
                <div class="arm-field" id="arm-field-synopsis">
                  <label for="film-synopsis" class="arm-label">
                    <i data-lucide="file-text" aria-hidden="true"></i>
                    Synopsis
                    <span class="arm-label__source">TMDB</span>
                  </label>
                  <textarea
                    name="synopsis"
                    id="film-synopsis"
                    class="arm-textarea"
                    rows="3"
                    spellcheck="true"
                    lang="fr"
                    maxlength="800"
                    placeholder="Résumé court du film ou de la série — rempli automatiquement depuis TMDB…"
                  ><% if (typeof newMovie !== "undefined" && newMovie && newMovie.synopsis) { %><%= newMovie.synopsis %><% } %></textarea>
                </div>

                <!-- CTA -->
                <div class="arm-cta-row">
                  <span class="arm-cta-row__hint">Renseignez votre film pour continuer</span>
                  <% if (typeof newMovie === "undefined" || !newMovie || newMovie.length === 0) { %>
                  <button class="btn btn--hero arm-cta-btn">
                    <i data-lucide="utensils" aria-hidden="true"></i>
                    Je passe à la recette
                  </button>
                  <% } %>
                </div>
              </div>

              <!-- ── Poster preview droite ── -->
              <div class="arm-poster-wrap">
                <p class="arm-poster__label">Aperçu de votre fiche film</p>
                <div class="arm-poster-card" id="arm-posterCard">
                  <%
                    let hasMovieWithImage = false;
                    if (
                      typeof newMovie !== "undefined" &&
                      newMovie &&
                      (newMovie.cardPath || newMovie.picture) &&
                      typeof (newMovie.cardPath || newMovie.picture) === "string" &&
                      (newMovie.cardPath || newMovie.picture).trim() !== ""
                    ) {
                      hasMovieWithImage = true;
                    }
                  %>
                  <div class="arm-poster-img film-selected-image">
                    <% if (hasMovieWithImage) { %>
                    <img
                      src="<%= newMovie.cardPath || newMovie.picture %>"
                      alt="Affiche du film ajouté"
                      onerror="this.onerror=null;this.src='/images/movie-default-img.png'"
                    />
                    <% } else { %>
                    <img
                      src="/images/movie-default-img.png"
                      alt="Image de film par défaut"
                    />
                    <% } %>
                    <div class="arm-poster-ph" id="arm-posterPh">
                      <i data-lucide="film" stroke-width="1" aria-hidden="true"></i>
                    </div>
                    <div class="arm-poster-tz">
                      <span class="arm-poster-name" id="display-film-name">
                        <% if (typeof newMovie !== "undefined" && newMovie && newMovie.title) { %><%= newMovie.title %><% } else { %>—<% } %>
                      </span>
                      <span class="arm-poster-year" id="display-film-year">
                        <% if (typeof newMovie !== "undefined" && newMovie && newMovie.year) { %><%= newMovie.year %><% } %>
                      </span>
                    </div>
                  </div>
                  <div class="arm-poster-body">
                    <div class="arm-poster-genre-row" id="display-film-genre">
                      <% if (typeof newMovie !== "undefined" && newMovie && newMovie.genre) { %>
                      <span class="arm-genre-badge"><%= newMovie.genre %></span>
                      <% } %>
                    </div>
                    <p id="display-film-synopsis" class="arm-poster-synopsis">
                      <% if (typeof newMovie !== "undefined" && newMovie && newMovie.synopsis) { %><%= newMovie.synopsis %><% } %>
                    </p>
                    <% if (!hasMovieWithImage) { %>
                    <p class="arm-hint arm-hint--italic">
                      * L'affiche sera ajoutée par Ciné Délices
                    </p>
                    <% } %>
                    <p class="arm-poster-empty" id="arm-posterEmpty">
                      <% if (typeof newMovie === "undefined" || !newMovie || !newMovie.title) { %>
                      Remplissez les champs pour prévisualiser
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>

            </div><!-- /arm-s1-layout -->
          </form>
        <% } %>

        </div>
      </article>

      <!-- ══════════════════════════════════════════
         SECTIONS 2, 3 & TICKET — dans unified-form
      ══════════════════════════════════════════ -->
      <form
        id="unified-form"
        action="/add-recipes-movies/movie-and-recipe"
        method="post"
        enctype="multipart/form-data"
      >
        <!-- CHAMPS CACHÉS -->
        <input type="hidden" name="filmId" id="filmId-hidden" value="<% if (typeof newMovie !== 'undefined' && newMovie && newMovie.id) { %><%= newMovie.id %><% } %>" />
        <input type="hidden" name="title" id="film-title-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.title || '' %><% } %>" />
        <input type="hidden" name="year" id="film-year-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.year || '' %><% } %>" />
        <input type="hidden" name="genre" id="film-genre-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.genre || '' %><% } %>" />
        <input type="hidden" name="synopsis" id="film-synopsis-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.synopsis || '' %><% } %>" />
        <input type="hidden" name="tmdbId" id="tmdbId-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.tmdbId || '' %><% } %>" />
        <input type="hidden" name="titleFR" id="titleFR-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.title || '' %><% } %>" />
        <input type="hidden" name="tmdbYear" id="tmdbYear-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.year || '' %><% } %>" />
        <input type="hidden" name="tmdbGenre" id="tmdbGenre-hidden" value="<% if (typeof retainFilm !== 'undefined' && retainFilm) { %><%= retainFilm.genre || '' %><% } %>" />

        <!-- ══════════════════════════════════════════
           SECTION 2 — MA RECETTE
        ══════════════════════════════════════════ -->
        <article class="arm-card <% if (typeof newMovie !== 'undefined' && newMovie) { %>arm-card--active<% } %>" id="arm-s2" aria-labelledby="arm-s2-title">
          <span class="arm-card__num" aria-hidden="true">02</span>
          <div class="arm-body">

            <div class="arm-hd">
              <div class="arm-hd__step-badge" id="s2badge">
                <span class="badge-num">2</span>
                <span class="badge-lbl">Étape</span>
              </div>
              <div class="arm-hd__text">
                <span class="arm-hd__step">Étape 2</span>
                <h2 class="arm-hd__title" id="arm-s2-title">MA RECETTE</h2>
                <p class="arm-hd__desc">
                  Décrivez votre recette, choisissez la catégorie et ajoutez votre photo.
                </p>
              </div>
              <div class="arm-hd__rule"></div>
            </div>



            <!-- Nom de la recette -->
            <div class="arm-field">
              <label for="recipe-name" class="arm-label">
                <i data-lucide="sparkles" aria-hidden="true"></i>
                Nom de la recette
                <span class="arm-req">*</span>
              </label>
              <input
                type="text"
                name="name"
                id="recipe-name"
                class="arm-input arm-input--recipe"
                placeholder="Ex : Le Ragoût de l'Explorateur, Tarte des Sorcières…"
                value="<% if (typeof newRecipe !== 'undefined' && newRecipe && newRecipe.name) { %><%= newRecipe.name %><% } %>"
                spellcheck="true"
                lang="fr"
                required
              />
              <span class="arm-hint">
                <i data-lucide="lightbulb" aria-hidden="true"></i>
                Un nom évocateur qui rappelle le film ou la scène.
              </span>
            </div>

            <!-- Méta : Portions | Temps | Catégorie | Difficulté -->
            <div class="arm-row arm-row--meta">

              <div class="arm-field">
                <label class="arm-label" for="recipe-servings">
                  <i data-lucide="users" aria-hidden="true"></i>
                  Portions
                </label>
                <div class="arm-portions-ctrl" id="arm-portionsCtrl">
                  <button type="button" class="arm-portions-btn" id="arm-portionsMinus" aria-label="Moins">
                    <i data-lucide="minus" stroke-width="2.2" aria-hidden="true"></i>
                  </button>
                  <span class="arm-portions-val" id="arm-portionsVal">4</span>
                  <input type="hidden" name="servings" id="recipe-servings" value="4" />
                  <button type="button" class="arm-portions-btn" id="arm-portionsPlus" aria-label="Plus">
                    <i data-lucide="plus" stroke-width="2.2" aria-hidden="true"></i>
                  </button>
                </div>
              </div>

              <div class="arm-field">
                <label for="recipe-time" class="arm-label">
                  <i data-lucide="clock" aria-hidden="true"></i>
                  Temps (min)
                  <span class="arm-req">*</span>
                </label>
                <input
                  type="number"
                  name="time"
                  id="recipe-time"
                  class="arm-input"
                  min="1"
                  step="1"
                  placeholder="45"
                  value=""
                />
              </div>

              <div class="arm-field">
                <label for="category" class="arm-label">
                  <i data-lucide="layout-grid" aria-hidden="true"></i>
                  Catégorie
                  <span class="arm-req">*</span>
                </label>
                <select name="category" id="category" class="arm-select">
                  <option value="" disabled selected>Choisir…</option>
                  <option value="apéritif">Apéritif</option>
                  <option value="entrée">Entrée</option>
                  <option value="plat">Plat</option>
                  <option value="dessert">Dessert</option>
                  <option value="boisson">Boisson</option>
                  <option value="autres">Autres</option>
                </select>
              </div>

              <div class="arm-field">
                <label for="difficulty" class="arm-label">
                  <i data-lucide="flame" aria-hidden="true"></i>
                  Difficulté
                  <span class="arm-req">*</span>
                </label>
                <select name="difficulty" id="difficulty" class="arm-select">
                  <option value="" disabled selected>Niveau…</option>
                  <option value="Facile">Facile</option>
