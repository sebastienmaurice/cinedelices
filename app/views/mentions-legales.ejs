    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <script>
    /* Sidebar active state au scroll */
    const _mlSections = document.querySelectorAll('.legal-section');
    const _mlLinks    = document.querySelectorAll('.ml-sidebar__link');

    const _mlObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          _mlLinks.forEach(l => l.classList.remove('active'));
          const id = entry.target.getAttribute('id');
          const active = document.querySelector(`.ml-sidebar__link[href="#${id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px' });

    _mlSections.forEach(s => _mlObserver.observe(s));

    /* Smooth scroll */
    _mlLinks.forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        const id = link.getAttribute('href').slice(1);
        const target = document.getElementById(id);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    </script>

