<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez les détails de la recette cultissime <%= recipe.name %>"
    />
    <title><%= recipe.name %> - Ciné Délices</title>

    <%- include("partials/head-resources") %>

    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/recipe-detail.css" />
  </head>

  <body>
    <%- include("partials/header") %>

    <main class="recipe-detail-main">
      <% const recipeImage = recipe.picture ||
      "/images/image-default-recipe-1.jpg"; %>
      <% const movieImage = movie ? (movie.bannerPath || movie.cardPath || movie.picture || "/images/image-default-film.jpg") : "/images/image-default-film.jpg"; %>
      <% const contributorName = contributor && contributor.pseudo ? contributor.pseudo : "Contributeur"; %>
      <% const contributorImage = contributor && contributor.picture ? contributor.picture : "/images/image-default-profile.jpg"; %>
      <% const contributorQuery = contributorName ? encodeURIComponent(contributorName.toLowerCase()) : ""; %>
      <% const ingredientsCount = ingredientsBlocks ? ingredientsBlocks.length : 0; %>
      <% const preparationCount = preparationBlocks ? preparationBlocks.length : 0; %>

      <section class="banner__image__recipes" aria-hidden="true">
        <div class="banner__image__recipes__overlay"></div>
        <span class="banner__image__recipes__badge">
          Film associé
        </span>
        <div class="banner__image__recipes__film-meta">
          <div class="film-meta__badges">
            <span class="film-meta__badge">
              <%= movie ? movie.title : "Film associé" %>
            </span>
            <% if (movie && movie.year) { %>
            <span class="film-meta__badge"><%= movie.year %></span>
            <% } %>
            <% if (movie && movie.genre) { %>
            <span class="film-meta__badge"><%= movie.genre %></span>
            <% } %>
          </div>
        </div>
        <img
          src="<%= movieImage %>"
          alt="Visuel du film associé à <%= recipe.name %>"
          loading="lazy"
        />
      </section>

      <section class="banner__recipes" aria-labelledby="recipe-title">
        <div class="banner__recipes__content">
          <p class="recipe-hero__eyebrow">Détails recette</p>
          <h1 id="recipe-title"><%= recipe.name %></h1>
          <p class="recipe-hero__subtitle">
            Recette inspirée du cinéma, ingrédients, préparation et avis des
            visiteurs.
          </p>
          <div class="recipe-meta-bar">
            <div class="banner__recipes__meta">
              <span class="meta-pill meta-pill--category">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                <%= recipe.category %>
              </span>
              <% if (recipe.servings) { %>
              <span class="meta-pill">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <%= recipe.servings %> personnes
              </span>
              <% } %>
              <span class="meta-pill">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <%= recipe.time %> min
              </span>
              <span class="meta-pill">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                Difficulté : <%= recipe.difficulty %>
              </span>
            </div>
          </div>
        </div>

        <div class="banner__recipes__rating" data-rating-container>
          <p class="rating-label">
            Note générale de la recette :
            <span
              class="current-rating"
              id="banner-rating-output"
              data-rating-output
              ><%= averageQuote %>/5</span
            >
          </p>
          <div class="banner__recipes__actions">
            <div
              class="rating-stars rating-stars--lifted"
              role="group"
              aria-label="Note générale (lecture seule)"
              data-current-rating="<%= averageQuote %>"
              data-output="#banner-rating-output"
              data-readonly="true"
            >
              <% for (let i = 1; i <= 5; i++) { %>
              <button
                type="button"
                class="rating-star"
                data-value="<%= i %>"
                aria-label="<%= i %> étoile<%= i > 1 ? 's' : '' %>"
              >
                ★
              </button>
              <% } %>
            </div>

            <!-- Bouton Favori -->
            <button
              class="btn-favorite btn-favorite--detail"
              data-entity-id="<%= recipe.id %>"
              data-entity-type="recipe"
              data-is-favorite="<%= recipe.isFavorite || false %>"
              aria-label="<%= recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
              title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="<%= recipe.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              <span class="btn-favorite__text">
                <%= recipe.isFavorite ? 'Dans mes favoris' : 'Ajouter aux favoris' %>
              </span>
            </button>
          </div>
          <a
            class="recipe-meta-bar__author"
            href="/recipes-movie?author=<%= contributorQuery %>"
            aria-label="Voir les recettes de <%= contributorName %>"
            data-author="<%= contributorName %>"
          >
            <div class="profile-photo">
              <img
                src="<%= contributorImage %>"
                alt="Profil de <%= contributorName %>"
                loading="lazy"
              />
            </div>
            <div class="recipe-meta-bar__author-text">
              <span class="author-name">
                <%= contributorName %>
                <% if (contributor && contributor.role === "admin") { %>
                  <span class="author-badge">Par Ciné Délices</span>
                <% } %>
              </span>
              <span class="author-subtitle">Auteur de la recette</span>
            </div>
          </a>
        </div>
      </section>

      <section
        class="recipe-section recipe-section--details"
        aria-label="Détails complets de la recette"
      >
        <div class="recipe-section__header">
          <div class="recipe-section__header-content">
          </div>
        </div>
        <div class="recipe-details-group">
          <div class="recipe-info-grid">
            <div class="recipe-main-column">
              <div class="overview-card">
                <div class="overview-card__actions">
                  <a class="btn btn--gold btn--sm" href="/recipes-movie/<%= recipe.id_movie %>">
                    Revenir aux recettes du film
                  </a>
                  <a class="btn btn--red btn--sm" href="/add-recipes-movies/">
                    Je crée ma recette
                  </a>
                </div>
                <h3 class="overview-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                  Le contexte cinématographique
                </h3>
                <p class="overview-card__subtitle">
                  Découvrez la scène du film qui a inspiré cette recette
                </p>
                <% if (descriptionBlocks && descriptionBlocks.length) { %>
                <% descriptionBlocks.forEach((paragraph, index) => { %>
                <p class="overview-card__text <%= index === 0 ? 'overview-card__text--lead' : '' %>">
                  <%= paragraph %>
                </p>
                <% }) %>
                <% } else { %>
                <p class="overview-card__text overview-card__text--lead">
                  Aucune description détaillée n'a encore été partagée pour cette
                  recette.
                </p>
                <% } %>
              </div>
            </div>

            <aside class="recipe-aside">
              <div class="recipe-aside__media">
                <button
                  type="button"
                  class="overview-image-button"
                  data-lightbox-trigger
                  data-lightbox-image="<%= recipeImage %>"
                  data-lightbox-alt="Présentation de la recette <%= recipe.name %>"
                  aria-label="Voir l'image de <%= recipe.name %> en plein écran"
                >
                  <img
                    src="<%= recipeImage %>"
                    alt="Présentation de la recette <%= recipe.name %>"
                    loading="lazy"
                  />
                  <span class="overview-image-hint">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  </span>
                </button>
              </div>

            </aside>
          </div>
          <div class="recipe-columns">
            <div class="recipe-column column-ingredients">
              <div class="column-overlay" aria-hidden="true"></div>
              <div class="column-header">
                <div class="column-header__row">
                  <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="m5 11 4-7"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8c.9 0 1.8-.7 2-1.6l1.7-7.4"/><path d="m9 11 1 9"/><path d="M4.5 15.5h15"/><path d="m15 11-1 9"/></svg>
                    Les Ingrédients
                  </h3>
                  <span class="column-count">
                    <%= ingredientsCount %> ingrédient<%= ingredientsCount > 1 ? 's' : '' %>
                  </span>
                </div>
                <p>Liste complète pour réussir cette recette</p>
              </div>
              <% if (ingredientsBlocks && ingredientsBlocks.length) { %> <%
              ingredientsBlocks.forEach((ingredient, index) => { %>
              <div class="ingredient-item">
                <span class="ingredient-text"><%= ingredient %></span>
                <% if (index < ingredientsBlocks.length - 1) { %>
                <div class="ingredient-separator"></div>
                <% } %>
              </div>
              <% }) %> <% } else { %>
              <div class="ingredient-item">
                <span class="ingredient-text"
                  >Les ingrédients seront bientôt disponibles.</span
                >
              </div>
              <% } %>
            </div>

            <div class="recipe-column column-preparation">
              <div class="column-overlay" aria-hidden="true"></div>
              <div class="column-header">
                <div class="column-header__row">
                  <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                    La Préparation
                  </h3>
                  <span class="column-count">
                    <%= preparationCount %> étape<%= preparationCount > 1 ? 's' : '' %>
                  </span>
                </div>
                <p>Suivez les étapes pour créer cette recette du grand écran</p>
              </div>
              <% if (preparationBlocks && preparationBlocks.length) { %> <%
              preparationBlocks.forEach((step, index) => { %>
              <div class="preparation-step">
                <div class="step-content">
                  <span class="badge badge--gold preparation-badge">
                    Etape <%= index + 1 %>
                  </span>
                  <p class="step-text"><%= step %></p>
                </div>
              </div>
              <% }) %> <% } else { %>
              <div class="preparation-step">
                <div class="step-content">
                  <p class="step-text">
                    Le détail de cette préparation arrive bientôt.
                  </p>
                </div>
              </div>
              <% } %>
              <div class="column-cta">
                <a
                  href="#review-banner"
                  class="btn btn--gold btn--sm recipe-hero__cta"
                  aria-label="Aller à la bannière d'avis"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"/></svg>
                  Je donne mon avis
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION TITLE FOR REVIEWS -->
      <div class="review-section-header">
        <h2 class="review-section-title">Partage ton expérience</h2>
        <p class="review-section-description">
          Partagez votre expérience culinaire et aidez la communauté à
          découvrir les meilleures recettes inspirées du cinéma.
        </p>
      </div>

        <!-- RECIPE REVIEW BANNER -->
        <section
          id="review-banner"
          class="recipe-review-banner"
          aria-labelledby="review-banner-title"
        >
          <div class="review-banner__content">
            <div class="review-banner__texts">
              <h2 id="review-banner-title">
                Partagez votre expérience culinaire
              </h2>
              <p class="review-banner__subtitle">
                <span class="subtitle--lead">Inspirez la communauté</span>
                <span class="subtitle--brand">Ciné Délices</span>
                <span class="subtitle--lead">
                  : racontez votre avis sur cette recette ou votre ressenti en
                  la dégustant devant votre film préféré.
                </span>
              </p>
            </div>

            <form
              class="review-banner__form"
              action="#"
              method="post"
              novalidate
            >
              <div class="form-row">
                <fieldset
                  class="review-stars"
                  aria-label="Ta note pour la recette"
                >
                  <legend class="review-stars__label">
                    Ta note pour la recette
                    <span class="review-stars__value">0/5</span> :
                  </legend>
                  <div class="stars-group" role="group" aria-label="Note sur 5">
                    <input type="radio" id="star1" name="rating" value="1" />
                    <label for="star1" aria-label="1 étoile">★</label>
                    <input type="radio" id="star2" name="rating" value="2" />
                    <label for="star2" aria-label="2 étoiles">★</label>
                    <input type="radio" id="star3" name="rating" value="3" />
                    <label for="star3" aria-label="3 étoiles">★</label>
                    <input type="radio" id="star4" name="rating" value="4" />
                    <label for="star4" aria-label="4 étoiles">★</label>
                    <input type="radio" id="star5" name="rating" value="5" />
                    <label for="star5" aria-label="5 étoiles">★</label>
                  </div>
                </fieldset>
              </div>

              <div class="review-actions">
                <label for="review-comment" class="sr-only"
                  >Donne ton avis sur la recette</label
                >
                <textarea
                  id="review-comment"
                  name="comment"
                  class="review-textarea"
                  placeholder="Partagez votre avis sur cette recette inspirée du cinéma..."
                  rows="3"
                  spellcheck="true"
                  lang="fr en"
                ></textarea>
                <button type="submit" class="btn btn--gold review-submit">
                  Je donne mon avis
                </button>
              </div>
            </form>
          </div>
          <div class="review-banner__illustration" aria-hidden="true"></div>
        </section>

        <!-- SECTION AVIS DES VISITEURS -->
        <% if (notices && notices.length > 0) { %>
        <section
          class="reviews-display-section"
          aria-labelledby="reviews-title"
        >
          <div class="reviews-header">
            <h2 id="reviews-title" class="reviews-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M15.8 11.8 19 8"/></svg>
              Avis des visiteurs
            </h2>
            <p class="reviews-count">
              <%= notices.length %> avis<%= notices.length > 1 ? '' : '' %>
            </p>
          </div>

          <div class="reviews-container">
            <div class="reviews-grid" id="reviewsList">
              <% notices.slice(0, 5).forEach((notice, index) => { %>
              <article
                class="review-card review-card-<%= index === 0 ? 'large' : index === 1 || index === 4 ? 'medium' : 'small' %>"
                data-review-index="<%= index %>"
              >
                <div class="review-card-header">
                  <div class="review-user-info">
                    <div class="review-user-avatar">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="review-user-details">
                      <h3 class="review-user-name">
                        <% if (notice.User) { %> <%= notice.User.first_name %>
                        <%= notice.User.last_name %> <% } else { %> Visiteur
                        anonyme <% } %>
                      </h3>
                      <span class="review-date">
                        <% if (notice.createdAt) { %> <% const date = new
                        Date(notice.createdAt); %> <%=
                        date.toLocaleDateString('fr-FR', { day: 'numeric',
                        month: 'long', year: 'numeric' }) %> <% } else { %> Avis
                        récent <% } %>
                      </span>
                    </div>
                  </div>
                  <div class="review-rating">
                    <% for (let i = 1; i <= 5; i++) { %>
                    <span
                      class="review-star <%= i <= notice.quote ? 'active' : '' %>"
                    >
                      ★
                    </span>
                    <% } %>
                    <span class="review-rating-value"
                      ><%= notice.quote %>/5</span
                    >
                  </div>
                </div>
                <div class="review-card-body">
                  <p class="review-content-main"><%= notice.content %></p>
                </div>
              </article>
              <% }) %>

              <!-- Avis supplémentaires (cachés initialement) -->
              <% if (notices.length > 5) { %> <%
              notices.slice(5).forEach((notice, index) => { %>
              <article
                class="review-card review-card-hidden review-card-<%= (index + 5) % 3 === 0 ? 'large' : (index + 5) % 3 === 1 ? 'medium' : 'small' %>"
                data-review-index="<%= index + 5 %>"
              >
                <div class="review-card-header">
                  <div class="review-user-info">
                    <div class="review-user-avatar">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="review-user-details">
                      <h3 class="review-user-name">
                        <% if (notice.User) { %> <%= notice.User.first_name %>
                        <%= notice.User.last_name %> <% } else { %> Visiteur
                        anonyme <% } %>
                      </h3>
                      <span class="review-date">
                        <% if (notice.createdAt) { %> <% const date = new
                        Date(notice.createdAt); %> <%=
                        date.toLocaleDateString('fr-FR', { day: 'numeric',
                        month: 'long', year: 'numeric' }) %> <% } else { %> Avis
                        récent <% } %>
                      </span>
                    </div>
                  </div>
                  <div class="review-rating">
                    <% for (let i = 1; i <= 5; i++) { %>
                    <span
                      class="review-star <%= i <= notice.quote ? 'active' : '' %>"
                    >
                      ★
                    </span>
                    <% } %>
                    <span class="review-rating-value"
                      ><%= notice.quote %>/5</span
                    >
                  </div>
                </div>
                <div class="review-card-body">
                  <p class="review-content-main"><%= notice.content %></p>
                </div>
              </article>
              <% }) %> <% } %>
            </div>

            <% if (notices.length > 5) { %>
            <button
              type="button"
              class="btn btn--gold btn-see-more-reviews"
              id="seeMoreReviews"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="m6 9 6 6 6-6"/></svg>
              Voir Plus (<%= notices.length - 5 %>)
            </button>
            <% } %>
          </div>
        </section>

        <% } %>

      <section class="recipe-section recipe-section--movie" aria-label="Film associé">
        <div class="recipe-section__header">
          <h2>Film associé</h2>
          <p>Le film qui a inspiré cette recette</p>
        </div>
        <% if (movie) { %>
          <div class="recipe-movie-card">
            <div class="recipe-movie-card__media">
              <img src="<%= movieImage %>" alt="Affiche du film <%= movie.title %>" loading="lazy" />
            </div>
            <div class="recipe-movie-card__content">
              <p class="recipe-movie-card__title"><%= movie.title %></p>
              <p class="recipe-movie-card__meta">
                <%= movie.year %> • <%= movie.genre %>
              </p>
              <div class="recipe-movie-card__actions">
                <a class="btn btn--gold btn--sm" href="/recipes-movie/<%= movie.id %>">
                  Voir les recettes du film
                </a>
              </div>
            </div>
          </div>
        <% } else { %>
          <p class="recipe-empty">Aucun film associé disponible.</p>
        <% } %>
      </section>

      <div class="recipe-lightbox" id="recipe-lightbox" aria-hidden="true">
        <div
          class="recipe-lightbox__backdrop"
          data-lightbox-close
          aria-hidden="true"
        ></div>
        <div class="recipe-lightbox__dialog" role="dialog" aria-modal="true">
          <button
            type="button"
            class="recipe-lightbox__close"
            aria-label="Fermer l'aperçu"
            data-lightbox-close
          >
            &times;
          </button>
          <img
            src=""
            alt="Recette Ciné Délices"
            class="recipe-lightbox__image"
            loading="lazy"
          />
        </div>
      </div>
    </main>

