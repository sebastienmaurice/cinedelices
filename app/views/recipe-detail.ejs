<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%
      const _rdDesc  = (recipe.description || recipe.anecdote || `Recette inspirée du film ${(movie && movie.title) || 'cinéma'} — à cuisiner sur Ciné Délices.`).slice(0, 155);
      const _rdImgRaw = recipe.picture || '/images/image-default-recipe-1.jpg';
      const _rdImg   = /^https?:\/\//i.test(_rdImgRaw) ? _rdImgRaw : (siteUrl + _rdImgRaw);
      const _rdSlug  = recipe.slug || recipe.id;
      const _rdAuthor = (typeof contributor !== 'undefined' && contributor) ? contributor.pseudo : 'Ciné Délices';
    %>
    <meta name="description" content="<%= _rdDesc %>" />
    <title><%= recipe.name %> - Ciné Délices</title>

    <% const suppressCanonical = true; %>
    <%- include("partials/head-resources") %>
    <!-- SEO — Open Graph -->
    <meta property="og:type"        content="article" />
    <meta property="og:site_name"   content="Ciné Délices" />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:title"       content="<%= recipe.name %> — Ciné Délices" />
    <meta property="og:description" content="<%= _rdDesc %>" />
    <meta property="og:image"       content="<%= _rdImg %>" />
    <meta property="og:url"         content="<%= siteUrl %>/recipes-movie/details/<%= _rdSlug %>" />
    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="<%= recipe.name %> — Ciné Délices" />
    <meta name="twitter:description" content="<%= _rdDesc %>" />
    <meta name="twitter:image"       content="<%= _rdImg %>" />
    <!-- Canonical -->
    <link rel="canonical" href="<%= siteUrl %>/recipes-movie/details/<%= _rdSlug %>" />
    <!-- JSON-LD Recipe Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Recipe",
      "name": "<%- (recipe.name || '').replace(/"/g, '&quot;') %>",
      "description": "<%- _rdDesc.replace(/"/g, '&quot;') %>",
      "image": "<%= _rdImg %>",
      "author": {
        "@type": "Person",
        "name": "<%- _rdAuthor.replace(/"/g, '&quot;') %>"
      },
      "datePublished": "<%= recipe.createdAt ? new Date(recipe.createdAt).toISOString().split('T')[0] : '' %>",
      <% if (recipe.time) { %>"totalTime": "PT<%= recipe.time %>M",<% } %>
      <% if (recipe.servings) { %>"recipeYield": "<%= recipe.servings %> portion<%= recipe.servings > 1 ? 's' : '' %>",<% } %>
      <% if (recipe.category) { %>"recipeCategory": "<%= recipe.category %>",<% } %>
      <% if (recipe.difficulty) { %>"keywords": "<%= recipe.difficulty %>",<% } %>
      <% if (typeof averageQuote !== 'undefined' && averageQuote && totalAvis > 0) { %>
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "<%= averageQuote %>",
        "ratingCount": "<%= totalAvis %>",
        "bestRating": "5",
        "worstRating": "1"
      },
      <% } %>
      "url": "<%= siteUrl %>/recipes-movie/details/<%= _rdSlug %>"
    }
    </script>

    <link rel="stylesheet" href="/css/recipe-detail.css?v=202608292" />
  </head>

  <body class="recipe-page">
    <%- include("partials/header") %>

    <main id="main-content">
      <%
        const recipeImage     = recipe.picture || "/images/image-default-recipe-1.jpg";
        const movieImage      = movie ? (movie.bannerPath || movie.cardPath || movie.picture || "/images/image-default-film.jpg") : "/images/image-default-film.jpg";
        const contributorName  = contributor.pseudo;
        const contributorImage = contributor.picture || "/images/image-default-profile.jpg";
        const ingredientsCount = ingredientsBlocks ? ingredientsBlocks.filter(i => !String(i).startsWith('<h3')).length : 0;
        const preparationCount = preparationBlocks ? preparationBlocks.length : 0;
        const displayServings  = recipe.servings || 4;

        /* Photos de la galerie : position 1 = principale, 2 = secondaire, 3 = détail
           (le filtre !p.step_number exclut explicitement les photos d'étapes, qui
           utilisent une position décalée 100+N mais ne devraient de toute façon
           jamais entrer en collision avec 1/2/3) */
        const allPics = recipePictures || [];
        const galPic1 = allPics.find(p => p.position === 1 && !p.step_number) || null;
        const galPic2 = allPics.find(p => p.position === 2 && !p.step_number) || null;
        const galPic3 = allPics.find(p => p.position === 3 && !p.step_number) || null;
        const mainGalSrc = galPic1 ? galPic1.file_path : recipeImage;

        /* Synopsis du film — affiché dans le hero (à la place du contexte de
           la recette, qui reste dans la carte Inspiration plus bas afin
           d'éviter la duplication de texte). Même découpage en paragraphes
           que formatDescriptionBlocks() côté contrôleur. */
        const synopsisBlocks = ((movie && movie.synopsis) || "")
          .replace(/\r\n/g, "\n")
          .split(/\n{2,}/)
          .map((p) => p.trim())
          .filter(Boolean);

        /* Photos de préparation — une par étape (optionnelle), numéro choisi
           librement par le contributeur à l'upload (pas forcément 1:1 avec
           la position d'upload). */
        const stepPicsMap = {};
        allPics.forEach(p => { if (p.step_number) stepPicsMap[p.step_number] = p.file_path; });

        /* Découpe "quantité + nom" pour l'affichage en 2 colonnes des
           ingrédients (ex. "400 g Spaghetti" → "400 g" | "Spaghetti").
           Best-effort : ne s'applique qu'au texte brut sans mise en forme
           (gras/italique via l'éditeur riche) et seulement si une quantité
           reconnaissable est trouvée en tête — sinon on retombe sur
           l'affichage pleine largeur existant (ex. "Sel", "Poivre"). */
        function splitIngredient(raw) {
          const s = String(raw).trim();
          if (/<[^>]+>/.test(s)) return null;
          const unit = '(?:g|kg|mg|ml|cl|l|c\\.\\s*à\\s*(?:soupe|café)|cuill[eè]res?\\s*(?:à|a)\\s*(?:soupe|café)|gousses?|poign[ée]es?|pinc[ée]es?|tranches?|feuilles?|branches?|sachets?|verres?|tasses?)';
          const re = new RegExp('^(\\d+(?:[.,]\\d+)?(?:\\/\\d+)?\\s*' + unit + '?)\\s+(.+)$', 'i');
          const m = s.match(re);
          if (!m) return null;
          return { qty: m[1].trim(), name: m[2].trim() };
        }

        /* Répartition des notes (1-5 étoiles) — utilisée par la bannière
           dorée, déplacée dans la colonne "Le film" (voir plus bas). */
        const starCounts = [0, 0, 0, 0, 0];
        if (notices) notices.forEach((n) => { const q = parseInt(n.quote); if (q >= 1 && q <= 5) starCounts[q - 1]++; });
        const pct = (n) => (totalAvis > 0 ? Math.round((n / totalAvis) * 100) : 0);

        /* Nom + avatar affichés pour un avis — "Anonyme" si is_anonymous,
           sinon pseudo/nom réel + avatar réel + anneau de cadre/niveau. */
        function avisAuthorName(n) {
          if (n.is_anonymous) return 'Anonyme';
          return n.User ? (n.User.pseudo || [n.User.first_name, n.User.last_name].filter(Boolean).join(' ') || 'Visiteur') : 'Visiteur';
        }
        function avisAuthorAvatar(n) {
          if (n.is_anonymous) return null;
          return n.User && n.User.picture ? n.User.picture : null;
        }
        const HIGHLIGHT_LABELS = { coup_de_coeur: '♥ Coup de cœur', astuce_utile: '💡 Astuce utile' };
        const fmtNum = (n) => (typeof n === 'number' ? n.toLocaleString('fr-FR') : '0');
        const escHtml = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));

        /* Avatar en anneau doré + badge de niveau (chiffre) en bas — même
           logique visuelle que la page auteur, appliquée à chaque avis.
           size: 'sm' (derniers avis) | 'md' (grille "tous les avis") */
        function avisAvatarHTML(n, size) {
          const src = avisAuthorAvatar(n);
          const name = escHtml(avisAuthorName(n));
          const frameStyle = n.authorFrameThumb ? ` style="background-image:url('${n.authorFrameThumb}')"` : '';
          const inner = src
            ? `<img src="${escHtml(src)}" alt="${name}" loading="lazy" />`
            : `<i data-lucide="user" width="16" height="16" stroke-width="1.5" aria-hidden="true"></i>`;
          return `<div class="avis-avatar-ring avis-avatar-ring--${size}"${frameStyle}>
            <div class="avis-avatar-ring__pic">${inner}</div>
            <span class="avis-avatar-ring__lvl">${n.authorLevel || 1}</span>
          </div>`;
        }

        /* Photos jointes à un avis (jusqu'à 3), avec lightbox. */
        function avisPicturesHTML(n) {
          if (!n.pictures || !n.pictures.length) return '';
          const cells = n.pictures.map((p) => `
            <img class="avis-card__photo" src="${cldCard(p.file_path)}" alt="Photo jointe à l'avis" loading="lazy"
              data-lightbox-trigger data-lightbox-image="${cldFull(p.file_path)}" data-lightbox-alt="Photo jointe à l'avis" />
          `).join('');
          return `<div class="avis-card__photos">${cells}</div>`;
        }

        /* Like + Répondre — bas de card, identique pour avis racine et réponse. */
        function avisFooterHTML(n) {
          const likedClass = n.likedByUser ? ' is-liked' : '';
          return `<div class="avis-card__actions">
            <button type="button" class="avis-like-btn${likedClass}" data-notice-like data-notice-id="${n.id}" aria-pressed="${n.likedByUser ? 'true' : 'false'}">
              <i data-lucide="thumbs-up" width="14" height="14" aria-hidden="true"></i>
              <span data-notice-like-count>${n.likes_count || 0}</span>
            </button>
            <button type="button" class="avis-reply-btn" data-notice-reply-toggle data-notice-id="${n.id}">
              <i data-lucide="reply" width="14" height="14" aria-hidden="true"></i> Répondre
            </button>
          </div>`;
        }

        /* Réponses affichées sous un avis (1 niveau, pas de photos). */
        function avisRepliesHTML(n) {
          if (!n.replies || !n.replies.length) return '';
          const items = n.replies.map((r) => `
            <div class="avis-reply">
              ${avisAvatarHTML(r, 'sm')}
              <div class="avis-reply__body">
                <div class="avis-reply__head">
                  <span class="avis-reply__name">${escHtml(avisAuthorName(r))}</span>
                  <span class="avis-reply__date">${r.timeAgo}</span>
                </div>
                <p class="avis-reply__text">${escHtml(r.content)}</p>
                ${avisFooterHTML(r)}
              </div>
            </div>
          `).join('');
          return `<div class="avis-card__replies">${items}</div>`;
        }

        /* Card complète pour la grille "Tous les avis" — factorisée pour éviter
           la duplication entre le premier lot (avisGrid) et le lot "charger
           plus" (avisGridExtra), et pour garder likes/réponses/photos/badge
           cohérents partout. */
        function avisCardHTML(notice, isFeatured) {
          const isAdmin = notice.User && notice.User.role === 'admin';
          const adminBadge = isAdmin
            ? `<p class="avis-user__level avis-user__level--legend gamification-badge gamification-badge--official">✦ Équipe Ciné Délices</p>`
            : '';
          const stars = Array.from({ length: 5 }, (_, i) =>
            `<span class="${i < notice.quote ? 's' : 'se'}">★</span>`
          ).join('');
          // Badge éditorial posé en modération admin uniquement — jamais
          // automatique (cf. discussion : rien ne doit "décider" tout seul
          // qu'un avis est un coup de cœur ou une astuce utile).
          const highlight = notice.highlight && HIGHLIGHT_LABELS[notice.highlight]
            ? `<span class="avis-featured-badge avis-featured-badge--${notice.highlight}">${HIGHLIGHT_LABELS[notice.highlight]}</span>`
            : '';
          const userBlock = `<div class="avis-card__user">
            ${avisAvatarHTML(notice, 'md')}
            <div><p class="avis-user__name">${escHtml(avisAuthorName(notice))}</p>${adminBadge}</div>
          </div>`;
          const text = `<p class="avis-card__text">${escHtml(notice.content)}</p>`;
          const photos = avisPicturesHTML(notice);
          const replies = avisRepliesHTML(notice);

          // La card "vedette" garde son style doré mais la même structure en
          // une seule colonne que les autres — sa hauteur suit son propre
          // contenu (comme le reste du masonry) au lieu d'un vide généré par
          // un layout 2 colonnes pleine largeur.
          return `
          <article class="avis-card${isFeatured ? ' avis-card--featured' : ''}" data-rating="${notice.quote}" data-likes="${notice.likes_count || 0}">
            <div class="avis-card__head">
              ${highlight ? `<div class="avis-card__badge-row">${highlight}</div>` : ''}
              ${userBlock}
            </div>
            <div class="avis-stars">${stars}</div>
            <div class="avis-card__quote"><span class="avis-quote-mark">"</span>${text}</div>
            ${photos}
            <div class="avis-card__foot"><span class="avis-date">${notice.timeAgo}</span></div>
            ${avisFooterHTML(notice)}
            ${replies}
          </article>`;
        }
      %>

      <!-- ══ BREADCRUMB ══ -->
      <div class="bc-bar">
        <nav class="bc" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a><span class="bc-sep">›</span>
          <a href="/movies">Films</a><span class="bc-sep">›</span>
          <% if (movie) { %>
          <a href="/recipes-movie/<%= movie.slug || movie.id %>"><%= movie.title %></a><span class="bc-sep">›</span>
          <% } %>
          <span class="bc-cur"><%= recipe.name %></span>
        </nav>
      </div>

      <!-- ═══════════════════════════════════════
           RECIPE HERO + INFO-BAR INTÉGRÉE
      ════════════════════════════════════════ -->
      <section class="recipe-hero" aria-labelledby="recipe-title">
        <!-- Image plein cadre à droite — photo principale de la recette.
             <img> natif (pas de background-image CSS) : fetchpriority="high" +
             pas de lazy-load, car c'est l'élément LCP probable de la page. -->
        <div class="recipe-hero__media">
          <button
            type="button"
            class="recipe-hero__img-btn"
            data-lightbox-trigger
            data-lightbox-image="<%= cldFull(mainGalSrc) %>"
            data-lightbox-alt="<%= recipe.name %>"
            aria-label="Voir la photo de <%= recipe.name %> en plein écran"
          >
            <img class="recipe-hero__img" src="<%= cldFull(mainGalSrc) %>" alt="<%= recipe.name %>" fetchpriority="high" />
          </button>
          <!-- Fondu bleu nuit — du centre-gauche vers la gauche, ~55% de la largeur du hero,
               pour que le contenu rh-info reste lisible par-dessus l'image -->
          <div class="recipe-hero__fade" aria-hidden="true"></div>
        </div>

        <div class="recipe-hero__scanlines" aria-hidden="true"></div>
        <div class="recipe-hero__vignette" aria-hidden="true"></div>

        <div class="recipe-hero__content">
          <!-- Colonne infos gauche -->
          <div class="rh-info">
            <% if (movie) { %>
            <div class="rh-badge-film">
              <i data-lucide="film" width="14" height="14" stroke-width="1.5" aria-hidden="true"></i>
              <%= movie.title %><% if (movie.year) { %> — <%= movie.year %><% } %>
            </div>
            <% } %>
            <h1 class="rh-title" id="recipe-title"><%= recipe.name %></h1>
            <% if (synopsisBlocks && synopsisBlocks.length) { %>
            <%
              const ctxNeedsToggle = synopsisBlocks.length > 1 || synopsisBlocks[0].length > 140;
            %>
            <div class="rh-context-preview">
              <p class="rh-ctx-label">Synopsis du film</p>
              <div class="rh-ctx-body" id="rh-ctx-body">
                <p class="rh-ctx-text rh-ctx-lead"><%= synopsisBlocks[0] %></p>
                <% if (synopsisBlocks.length > 1) { %>
                <div class="rh-ctx-extra" id="rh-ctx-extra" hidden>
                  <% synopsisBlocks.slice(1).forEach(p => { %>
                  <p class="rh-ctx-text"><%= p %></p>
                  <% }) %>
                </div>
                <% } %>
              </div>
              <% if (ctxNeedsToggle) { %>
              <button class="rh-ctx-toggle" id="rh-ctx-toggle" aria-expanded="false">
                <span>Lire plus</span>
                <i data-lucide="chevron-down" width="11" height="11" aria-hidden="true"></i>
              </button>
              <% } %>
            </div>
            <% } %>
            <div class="rh-tags">
              <span class="tag tag--recette-cat"><%= recipe.category %></span>
              <% const _diff = (recipe.difficulty || '').toLowerCase();
                 const _diffCls = _diff.includes('facile') ? 'tag--recette-facile' : _diff.includes('difficile') ? 'tag--recette-difficile' : 'tag--recette-moyen'; %>
              <span class="tag <%= _diffCls %>"><%= recipe.difficulty %></span>
              <span class="tag tag--vert"><i data-lucide="clock" width="10" height="10" aria-hidden="true"></i> <%= recipe.time %> min</span>
              <% if (recipe.servings) { %>
              <span class="tag tag--bleu"><i data-lucide="users" width="10" height="10" aria-hidden="true"></i> <%= recipe.servings %> pers.</span>
              <% } %>
              <span class="tag tag--or"><i data-lucide="list" width="10" height="10" aria-hidden="true"></i> <%= ingredientsCount %> ingrédient<%= ingredientsCount > 1 ? 's' : '' %></span>
            </div>
            <div class="rh-actions">
              <a href="#preparation" class="btn btn--red">
                <i data-lucide="shopping-basket" width="16" height="16" aria-hidden="true"></i>
                Voir la recette
              </a>
              <a href="#avis" class="btn btn--outline">Donner mon avis</a>
              <button
                type="button"
                class="btn btn--outline js-share-recipe"
                data-share-title="<%= recipe.name %>"
                data-share-text="<%= _rdDesc %>"
              >
                <i data-lucide="share-2" width="15" height="15" aria-hidden="true"></i>
                Partager
              </button>
              <button
                class="btn-fav"
                data-entity-id="<%= recipe.id %>"
                data-entity-type="recipe"
                data-is-favorite="<%= recipe.isFavorite || false %>"
                aria-label="<%= recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
              >
                <i data-lucide="heart" width="20" height="20" fill="<%= recipe.isFavorite ? '#fff' : 'none' %>" stroke="#ffffff" stroke-width="2.5" style="display:block;flex-shrink:0" aria-hidden="true"></i>
              </button>
            </div>
          </div>

        </div>

        <!-- Stat dorée — Golden Ticket — flotte sur l'image, en bas à droite -->
        <div class="rh-poster__stat">
          <div class="rh-poster__stat-half rh-poster__stat-half--l" aria-hidden="true"></div>
          <div class="rh-poster__stat-half rh-poster__stat-half--r" aria-hidden="true"></div>
          <div class="rh-poster__stat-content">
            <div class="rh-poster__stat-inner">
              <div class="rh-ps-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="20" height="20">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="3"/>
                  <circle cx="12" cy="5"  r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="12" cy="19" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="5"  cy="12" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="19" cy="12" r="1.2" fill="currentColor" stroke="none"/>
                </svg>
              </div>
              <div class="rh-poster__stat-tear" aria-hidden="true"></div>
              <div class="rh-ps-text">
                <span class="rh-ps-num"><%= averageQuote || 0 %><span style="font-size:.55em;opacity:.5">/5</span></span>
                <span class="rh-ps-label">Note</span>
              </div>
            </div>
            <span class="rh-ps-watermark" aria-hidden="true">★</span>
          </div>
        </div>

        <div class="rd-hero-footer" aria-hidden="true"></div>
      </section>

      <!-- ═══════════════════════════════════════
           MAIN LAYOUT
      ════════════════════════════════════════ -->
      <div class="recipe-main">
          <div class="recipe-main-col">

            <%
              const stepPhotoEntries = Object.keys(stepPicsMap).map(Number).sort((a, b) => a - b);
              const galCount = [galPic1, galPic2, galPic3].filter(Boolean).length || 1;
            %>

            <!-- ═══ RANGÉE 1 : GALERIE + AUTEUR/XP ═══ -->
            <div class="rd-3col-grid rd-top-row">

              <!-- Galerie (3 photos de la recette) -->
              <div class="rd-gallery-block">
                <div class="rd-sec-h">
                  <p class="rd-sec-h__eye">Médias de la recette</p>
                  <h2 class="rd-sec-h__title">La <span>Galerie</span></h2>
                  <div class="rd-sec-h__rule"></div>
                </div>
                <div class="rd-combo-card rd-combo-card--single">
                  <div class="rd-gallery rd-gallery--<%= galCount %>">
                    <!-- Photo principale -->
                    <div
                      class="rd-gallery__main"
                      role="button"
                      tabindex="0"
                      aria-label="Agrandir la photo principale"
                      data-lightbox-trigger
                      data-lightbox-image="<%= cldFull(mainGalSrc) %>"
                      data-lightbox-alt="Photo principale — <%= recipe.name %>"
                    >
                      <img src="<%= cldFull(mainGalSrc) %>" alt="Photo principale — <%= recipe.name %>" loading="lazy" />
                      <div class="rd-gallery__label">
                        <div class="rd-gallery__label-text">
                          <span class="rd-gallery__label-num">01</span>
                          <span class="rd-gallery__label-name">Photo principale</span>
                        </div>
                        <button class="rd-gallery__zoom" aria-label="Agrandir">
                          <i data-lucide="zoom-in" width="13" height="13" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>

                    <!-- Photo secondaire -->
                    <% if (galPic2) { %>
                    <div
                      class="rd-gallery__secondary"
                      role="button"
                      tabindex="0"
                      aria-label="Agrandir la photo secondaire"
                      data-lightbox-trigger
                      data-lightbox-image="<%= cldFull(galPic2.file_path) %>"
                      data-lightbox-alt="Photo secondaire — <%= recipe.name %>"
                    >
                      <img src="<%= cldFull(galPic2.file_path) %>" alt="Photo secondaire — <%= recipe.name %>" loading="lazy" />
                      <div class="rd-gallery__label">
                        <div class="rd-gallery__label-text">
                          <span class="rd-gallery__label-num">02</span>
                          <span class="rd-gallery__label-name">Photo secondaire</span>
                        </div>
                        <button class="rd-gallery__zoom" aria-label="Agrandir">
                          <i data-lucide="zoom-in" width="13" height="13" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>
                    <% } %>

                    <!-- Photo détail -->
                    <% if (galPic3) { %>
                    <div
                      class="rd-gallery__detail"
                      role="button"
                      tabindex="0"
                      aria-label="Agrandir la photo détail"
                      data-lightbox-trigger
                      data-lightbox-image="<%= cldFull(galPic3.file_path) %>"
                      data-lightbox-alt="Photo détail — <%= recipe.name %>"
                    >
                      <img src="<%= cldFull(galPic3.file_path) %>" alt="Photo détail — <%= recipe.name %>" loading="lazy" />
                      <div class="rd-gallery__label">
                        <div class="rd-gallery__label-text">
                          <span class="rd-gallery__label-num">03</span>
                          <span class="rd-gallery__label-name">Photo détail</span>
                        </div>
                        <button class="rd-gallery__zoom" aria-label="Agrandir">
                          <i data-lucide="zoom-in" width="13" height="13" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Auteur + progression XP (version condensée du composant profil) -->
              <% if (contributor) { %>
              <div class="rd-author-xp-block">
                <div class="rd-sec-h">
                  <p class="rd-sec-h__eye">Contributeur</p>
                  <h2 class="rd-sec-h__title">Créé <span>par</span></h2>
                  <div class="rd-sec-h__rule"></div>
                </div>
              <a href="/auteur/<%= contributor.id %>" class="rd-author-xp-card" aria-label="Voir le profil de <%= contributorName %>">
                <div class="rd-author-xp-card__head">
                  <div class="rd-author-avatar">
                    <img src="<%= cldAvatar(contributorImage) %>" alt="<%= contributorName %>" loading="lazy" />
                  </div>
                  <div class="rd-author-xp-card__info">
                    <span class="rd-author-label">Recette proposée par</span>
                    <span class="rd-author-name">
                      <%= contributorName %>
                      <% if (contributor.role === "admin" || contributor.role === "superadmin") { %>
                      <span class="rd-author-official gamification-badge gamification-badge--official">✦ Ciné Délices</span>
                      <% } %>
                    </span>
                    <% if (contributor.rank) { %>
                    <span class="rd-author-xp-card__rank"><%= contributor.rank %></span>
                    <% } %>
                  </div>
                </div>
                <div class="rd-author-xp-card__bar">
                  <span class="rd-author-xp-card__lvl">Niv. <%= contributor.level %></span>
                  <div class="xp-track rd-author-xp-track">
                    <div class="xp-fill" style="width:<%= contributor.xpProgress.pct %>%"></div>
                  </div>
                  <span class="rd-author-xp-card__pct"><%= contributor.xpProgress.current %>/<%= contributor.xpProgress.span %> XP</span>
                </div>
                <div class="rd-author-xp-card__stats">
                  <div class="rd-author-xp-card__stat">
                    <strong><%= contributor.recipesCount %></strong>
                    <span><%= contributor.recipesCount > 1 ? 'Recettes' : 'Recette' %></span>
                  </div>
                  <div class="rd-author-xp-card__stat-sep"></div>
                  <div class="rd-author-xp-card__stat">
                    <strong><%= contributor.frames.length %>/<%= contributor.framesTotal %></strong>
                    <span>Cadres débloqués</span>
                  </div>
                </div>
                <% if (contributor.frames && contributor.frames.length) { %>
                <div class="rd-author-xp-card__frames">
                  <div class="rd-author-frames-row">
                    <% contributor.frames.forEach((f) => { %>
                    <span
                      class="rd-author-frame-pill"
                      title="<%= f.label %>"
                      <% if (f.thumbUrl) { %>style="background-image:url('<%= f.thumbUrl %>')"<% } %>
                    ><% if (!f.thumbUrl) { %><%= f.icon %><% } %></span>
                    <% }) %>
                  </div>
                  <span class="rd-author-xp-card__frames-lbl">Cadres de contribution</span>
                </div>
                <% } %>
              </a>
              </div>
              <% } %>
            </div>

            <!-- ═══ RANGÉE 2 : 3 COLONNES ═══ -->
            <div class="rd-3col-grid rd-content-row">

              <!-- COLONNE 1 : INGRÉDIENTS + INSPIRATION -->
              <div class="rd-col rd-col--left">
                <div class="rd-panel rd-panel--ingredients">
                  <div class="rd-ingredients__header">
                    <div class="rd-ingredients__icon">
                      <i data-lucide="shopping-basket" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i>
                    </div>
                    <div class="rd-ingredients__title rd-combo-col__title--sm">INGRÉDIENTS</div>
                    <div class="rd-ing-portions-ctrl">
                      <button class="rd-srv-btn" id="rd-srv-minus2" aria-label="Moins de portions" type="button">−</button>
                      <span class="rd-ing-portions-ctrl__val" id="rd-ing-portions-val" data-base="<%= displayServings %>"><%= displayServings %> pers.</span>
                      <button class="rd-srv-btn" id="rd-srv-plus2" aria-label="Plus de portions" type="button">+</button>
                    </div>
                  </div>
                  <div class="rd-ingredients__sub"><%= ingredientsCount %> ingrédient<%= ingredientsCount > 1 ? 's' : '' %></div>

                  <div class="rd-ing-progress">
                    <div class="rd-ing-progress__bar">
                      <div class="rd-ing-progress__fill" id="ing-progress-fill"></div>
                    </div>
                    <span class="rd-ing-progress__label" id="ing-progress-label">0 / <%= ingredientsCount %></span>
                  </div>

                  <div class="rd-ing-list">
                    <% if (ingredientsBlocks && ingredientsBlocks.length) { %>
                    <% ingredientsBlocks.forEach((ingredient) => {
                         const parsed = String(ingredient).startsWith('<h3') ? null : splitIngredient(ingredient);
                    %>
                    <% if (String(ingredient).startsWith('<h3')) { %>
                    <div class="rd-ing-group-hd"><%- ingredient %></div>
                    <% } else if (parsed) { %>
                    <div class="rd-ing-item rd-ing-item--split" role="checkbox" aria-checked="false" tabindex="0">
                      <div class="rd-ing-chk" aria-hidden="true">
                        <i data-lucide="check" width="11" height="11" stroke-width="2.5" aria-hidden="true"></i>
                      </div>
                      <div class="rd-ing-item__body">
                        <span class="rd-ing-qty"><%= parsed.qty %></span>
                        <span class="rd-ing-text"><%= parsed.name %></span>
                      </div>
                    </div>
                    <% } else { %>
                    <div class="rd-ing-item" role="checkbox" aria-checked="false" tabindex="0">
                      <div class="rd-ing-chk" aria-hidden="true">
                        <i data-lucide="check" width="11" height="11" stroke-width="2.5" aria-hidden="true"></i>
                      </div>
                      <span class="rd-ing-text"><%- ingredient %></span>
                    </div>
                    <% } %>
                    <% }) %>
                    <% } else { %>
                    <div class="rd-ing-item">
                      <span class="rd-ing-text">Les ingrédients seront bientôt disponibles.</span>
                    </div>
                    <% } %>
                  </div>
                </div>

                <% if (descriptionBlocks && descriptionBlocks.length) { %>
                <div class="rd-panel rd-panel--inspiration">
                  <div class="rd-panel__head">
                    <div class="rd-panel__icon">
                      <i data-lucide="sparkles" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i>
                    </div>
                    <div>
                      <p class="rd-combo-col__eye">Anecdote</p>
                      <h2 class="rd-combo-col__title rd-combo-col__title--sm">L'inspiration</h2>
                    </div>
                  </div>
                  <div class="rd-inspiration__text">
                    <% descriptionBlocks.forEach(p => { %>
                    <p><%= p %></p>
                    <% }) %>
                  </div>
                </div>
                <% } %>
              </div>

              <!-- COLONNE 2 : ÉTAPES DE PRÉPARATION + PHOTOS -->
              <div class="rd-col rd-col--center" id="preparation">
                <div class="rd-panel rd-panel--steps">
                  <div class="rd-combo-col__title-row">
                    <div class="rd-panel__head" style="margin-bottom:0">
                      <div class="rd-panel__icon">
                        <i data-lucide="chef-hat" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i>
                      </div>
                      <h3 class="rd-combo-col__title rd-combo-col__title--sm">Étapes de préparation</h3>
                    </div>
                    <div class="rd-steps-header-row">
                      <div class="rd-steps-count">
                        <i data-lucide="clipboard-check" width="14" height="14" aria-hidden="true"></i>
                        <%= preparationCount %> étape<%= preparationCount > 1 ? 's' : '' %><% if (recipe.time) { %> · <%= recipe.time %> min<% } %>
                      </div>
                      <div class="rd-steps-progress" id="steps-progress">0 / <%= preparationCount %> étapes</div>
                    </div>
                  </div>
                  <div class="rd-steps-list">
                    <% if (preparationBlocks && preparationBlocks.length) { %>
                    <% preparationBlocks.forEach((step, index) => {
                         const rowNum = index + 1;
                    %>
                    <div class="rd-step-item" data-step="<%= rowNum %>">
                      <div class="rd-step-num-wrap">
                        <div class="rd-step-num" aria-hidden="true"><%= String(rowNum).padStart(2, '0') %></div>
                      </div>
                      <div class="rd-step-body">
                        <p class="rd-step-title">
                          <span class="rd-step-title__txt">Étape <%= rowNum %><% if (step.title) { %> — <%= step.title %><% } %></span>
                          <% if (step.typeLabel || step.duration) { %>
                          <span class="rd-step-badge">
                            <% if (step.typeLabel) { %><%= step.typeLabel %><% } %><% if (step.typeLabel && step.duration) { %> · <% } %><% if (step.duration) { %><%= step.duration %> min<% } %>
                          </span>
                          <% } %>
                          <button class="rd-step-check" aria-label="Marquer l'étape comme faite" aria-pressed="false">
                            <i data-lucide="check" width="11" height="11" stroke-width="2.5" aria-hidden="true"></i>
                          </button>
                        </p>
                        <div class="rd-step-text"><%- step.body %></div>
                      </div>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="rd-step-item" data-step="1">
                      <div class="rd-step-num-wrap"><div class="rd-step-num" aria-hidden="true">1</div></div>
                      <div class="rd-step-body">
                        <p class="rd-step-text">Le détail de cette préparation arrive bientôt.</p>
                      </div>
                    </div>
                    <% } %>
                  </div>

                  <% if (stepPhotoEntries.length) { %>
                  <p class="rd-combo-col__eye rd-steps-photos-eye">Aperçu — <%= stepPhotoEntries.length %> photo<%= stepPhotoEntries.length > 1 ? 's' : '' %> de la recette</p>
                  <div class="rd-steps-photos-grid rd-steps-photos-grid--flow">
                    <% stepPhotoEntries.forEach((n) => { %>
                    <div class="rd-step-photo-cell">
                      <span class="rd-step-photo-num"><%= n %></span>
                      <img
                        class="rd-step-img"
                        src="<%= cldCard(stepPicsMap[n]) %>"
                        alt="Photo — étape <%= n %>"
                        loading="lazy"
                        data-lightbox-trigger
                        data-lightbox-group="steps"
                        data-lightbox-step="<%= n %>"
                        data-lightbox-image="<%= cldFull(stepPicsMap[n]) %>"
                        data-lightbox-alt="Photo — étape <%= n %>"
                      />
                    </div>
                    <% }) %>
                  </div>
                  <% } %>
                </div>
              </div>

              <!-- COLONNE 3 : LE FILM + AVIS -->
              <div class="rd-col rd-col--right">
                <!-- Bannière dorée Golden Ticket — résumé des avis, format vertical -->
                <div class="avis-banner avis-banner--vertical">
                  <div class="avis-banner__shimmer"></div>
                  <div class="avis-banner__inner avis-banner__inner--vertical">
                    <p class="avis-banner__eyebrow avis-banner__eyebrow--vertical">Communauté</p>
                    <h2 class="avis-banner__title avis-banner__title--vertical">Avis de la<br/>communauté</h2>
                    <p class="avis-banner__sub">Des passionnés qui partagent leur amour du cinéma et de la gastronomie.</p>
                    <div class="avis-banner__tear avis-banner__tear--vertical"></div>
                    <div class="avis-banner__note avis-banner__note--vertical">
                      <span class="global-note"><%= averageQuote || 0 %></span>
                      <div class="avis-banner__note-meta">
                        <div class="global-stars">
                          <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= Math.round(averageQuote || 0) ? 's' : 'sh' %>">★</span><% } %>
                        </div>
                        <span class="global-note__lbl">Note moyenne globale (<%= totalAvis %> avis)</span>
                      </div>
                    </div>
                    <div class="avis-distrib">
                      <div class="distrib-row">
                        <span class="distrib-label">5 <span class="fs">★</span></span>
                        <div class="distrib-bar-track"><div class="distrib-bar-fill d5" style="width:<%= pct(starCounts[4]) %>%"></div></div>
                        <span class="distrib-count"><%= pct(starCounts[4]) %>%</span>
                      </div>
                      <div class="distrib-row">
                        <span class="distrib-label">4 <span class="fs">★</span></span>
                        <div class="distrib-bar-track"><div class="distrib-bar-fill d4" style="width:<%= pct(starCounts[3]) %>%"></div></div>
                        <span class="distrib-count"><%= pct(starCounts[3]) %>%</span>
                      </div>
                      <div class="distrib-row">
                        <span class="distrib-label">3 <span class="fs">★</span></span>
                        <div class="distrib-bar-track"><div class="distrib-bar-fill d3" style="width:<%= pct(starCounts[2]) %>%"></div></div>
                        <span class="distrib-count"><%= pct(starCounts[2]) %>%</span>
                      </div>
                      <div class="distrib-row">
                        <span class="distrib-label">2 <span class="fs">★</span></span>
                        <div class="distrib-bar-track"><div class="distrib-bar-fill d2" style="width:<%= pct(starCounts[1]) %>%"></div></div>
                        <span class="distrib-count"><%= pct(starCounts[1]) %>%</span>
                      </div>
                      <div class="distrib-row">
                        <span class="distrib-label">1 <span class="fs">★</span></span>
                        <div class="distrib-bar-track"><div class="distrib-bar-fill d1" style="width:<%= pct(starCounts[0]) %>%"></div></div>
                        <span class="distrib-count"><%= pct(starCounts[0]) %>%</span>
                      </div>
                    </div>
                    <a href="#avis" class="avis-banner__thanks">
                      <span class="avis-banner__thanks-icon">♡</span>
                      Merci pour vos partages et votre enthousiasme !
                    </a>
                  </div>
                </div>

                <% if (movie) { %>
                <div class="rd-panel rd-panel--film">
                  <div class="rd-panel__head">
                    <div class="rd-panel__icon">
                      <i data-lucide="clapperboard" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i>
                    </div>
                    <div>
                      <p class="rd-combo-col__eye">Film associé</p>
                      <h3 class="rd-combo-col__title rd-combo-col__title--sm">Le film</h3>
                    </div>
                  </div>
                  <a
                    href="/recipes-movie/<%= movie.slug || movie.id %>"
                    class="rd-movie-poster rd-movie-poster--col3"
                    style="background-image:url('<%= movieImage %>')"
                    aria-label="Voir les recettes du film <%= movie.title %>"
                  >
                    <div class="rd-movie-poster__overlay"></div>
                    <div class="rd-movie-poster__body">
                      <p class="rd-movie-poster__title"><%= movie.title %></p>
                      <p class="rd-movie-poster__meta"><%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %></p>
                    </div>
                  </a>

                  <% if (movie.tmdb_rating) { %>
                  <div class="rd-film-score" title="Score TMDB">
                    <% const _tmdbStars = Math.round(movie.tmdb_rating / 2); %>
                    <div class="rd-film-score__stars">
                      <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= _tmdbStars ? 's' : 'sh' %>">★</span><% } %>
                    </div>
                    <span class="rd-film-score__val"><%= movie.tmdb_rating %>/10 <em>TMDB</em></span>
                  </div>
                  <% } %>

                  <div class="rd-film-info-table">
                    <% if (movie.director) { %><div class="rd-film-info-row"><span>Réalisateur</span><strong><%= movie.director %></strong></div><% } %>
                    <% if (movie.composer) { %><div class="rd-film-info-row"><span>Compositeur</span><strong><%= movie.composer %></strong></div><% } %>
                    <% if (movie.runtime) { %><div class="rd-film-info-row"><span>Durée</span><strong><%= Math.floor(movie.runtime / 60) %>h<%= String(movie.runtime % 60).padStart(2,'0') %></strong></div><% } %>
                    <% if (movie.genre) { %><div class="rd-film-info-row"><span>Genre</span><strong><%= movie.genre %></strong></div><% } %>
                    <% if (movie.year) { %><div class="rd-film-info-row"><span>Année</span><strong><%= movie.year %></strong></div><% } %>
                    <% if (movie.main_cast) { %><div class="rd-film-info-row"><span>Avec</span><strong><%= movie.main_cast %></strong></div><% } %>
                  </div>

                  <% if (movie.trailer_key) { %>
                  <a
                    href="https://www.youtube.com/watch?v=<%= movie.trailer_key %>"
                    target="_blank" rel="noopener noreferrer"
                    class="rd-movie-meta__trailer"
                  >
                    <i data-lucide="play-circle" width="15" height="15" aria-hidden="true"></i>
                    Bande-annonce
                  </a>
                  <% } %>
                </div>
                <% } %>
              </div>
            </div>

            <!-- ── NAV RECETTES ── -->
            <div class="rd-nav-actions">
              <a class="btn btn--outline" href="/recipes-movie/<%= movie ? (movie.slug || movie.id) : recipe.id_movie %>">
                <i data-lucide="chevron-left" width="16" height="16" aria-hidden="true"></i>
                Recettes du film
              </a>
              <a class="btn btn--red" href="/add-recipes-movies/">
                <i data-lucide="plus" width="16" height="16" aria-hidden="true"></i>
                Je crée ma recette
              </a>
            </div>

            <!-- ══ BANNIÈRE STATS — en-tête de la section avis (même doré que .avis-banner) ══ -->
            <div class="avis-banner avis-stats-banner">
              <div class="avis-banner__shimmer"></div>
              <div class="avis-stats-banner__notch avis-stats-banner__notch--l"></div>
              <div class="avis-stats-banner__notch avis-stats-banner__notch--r"></div>
              <img class="avis-stats-banner__bg" src="/images/pre-footer-bg-1.jpg" alt="" aria-hidden="true" loading="lazy" />
              <div class="avis-banner__inner avis-stats-banner__inner">
                <div class="avis-banner__reel">
                  <i data-lucide="message-circle" width="30" height="30" stroke-width="1.5" class="avis-banner__reel-icon" aria-hidden="true"></i>
                </div>
                <div class="avis-banner__text">
                  <p class="avis-banner__eyebrow">Communauté</p>
                  <h2 class="avis-banner__title">Avis de la communauté</h2>
                  <p class="avis-banner__sub">Des passionnés qui partagent leur amour du cinéma et de la gastronomie.</p>
                  <div class="avis-stats-banner__stats">
                    <div class="avis-stat-block">
                      <div class="avis-stat-block__icon"><i data-lucide="message-circle" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i></div>
                      <div><strong><%= fmtNum((typeof footerStats !== 'undefined' && footerStats && footerStats.avis) || 0) %></strong><span>Avis publiés</span></div>
                    </div>
                    <div class="avis-stat-block">
                      <div class="avis-stat-block__icon"><i data-lucide="users" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i></div>
                      <div><strong><%= fmtNum((typeof footerStats !== 'undefined' && footerStats && footerStats.members) || 0) %></strong><span>Membres</span></div>
                    </div>
                    <div class="avis-stat-block">
                      <div class="avis-stat-block__icon"><i data-lucide="clapperboard" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i></div>
                      <div><strong><%= fmtNum((typeof footerStats !== 'undefined' && footerStats && footerStats.recipes) || 0) %></strong><span>Recettes partagées</span></div>
                    </div>
                    <div class="avis-stat-block">
                      <div class="avis-stat-block__icon"><i data-lucide="clapperboard" width="18" height="18" stroke-width="1.5" aria-hidden="true"></i></div>
                      <div><strong><%= fmtNum((typeof footerStats !== 'undefined' && footerStats && footerStats.films) || 0) %></strong><span>Films référencés</span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ══ DERNIERS AVIS + FORMULAIRE, côte à côte ══ -->
            <div class="rd-avis-row">
              <!-- Derniers avis (aperçu, renvoie vers la liste complète) -->
              <div class="rd-panel rd-panel--derniers-avis">
                <div class="rd-derniers-avis__head">
                  <h2 class="rd-combo-col__title rd-combo-col__title--sm" id="avis-section-title">Derniers avis</h2>
                  <a href="#avis" class="rd-derniers-avis__link">Voir tous les avis <i data-lucide="arrow-right" width="14" height="14" aria-hidden="true"></i></a>
                </div>
                <% if (notices && notices.length > 0) { %>
                <div class="rd-derniers-avis__list">
                  <% notices.slice(0, 3).forEach((notice) => { %>
                  <div class="rd-derniers-avis__item">
                    <%- avisAvatarHTML(notice, 'sm') %>
                    <div class="rd-derniers-avis__body">
                      <div class="rd-derniers-avis__item-head">
                        <span class="rd-derniers-avis__item-name"><%= avisAuthorName(notice) %></span>
                        <span class="rd-derniers-avis__item-stars">
                          <% for (let s = 1; s <= 5; s++) { %><span class="<%= s <= notice.quote ? 's' : 'se' %>">★</span><% } %>
                        </span>
                        <% if (notice.highlight && HIGHLIGHT_LABELS[notice.highlight]) { %>
                        <span class="avis-highlight-tag avis-highlight-tag--<%= notice.highlight %>"><%= HIGHLIGHT_LABELS[notice.highlight] %></span>
                        <% } %>
                        <span class="rd-derniers-avis__item-date"><%= notice.timeAgo %></span>
                      </div>
                      <p class="rd-derniers-avis__item-text"><%= notice.content %></p>
                      <%- avisFooterHTML(notice) %>
                    </div>
                  </div>
                  <% }) %>
                </div>
                <% } else { %>
                <p class="rd-derniers-avis__empty">Aucun avis pour l'instant — soyez le premier à partager votre expérience !</p>
                <% } %>
              </div>

              <!-- Formulaire / état non connecté -->
              <div class="avis-form-block" id="avisFormBlock">
                <div class="avis-form-block__inner">
                  <div class="avis-form-block__head">
                    <div class="avis-form-block__icon">✍️</div>
                    <div>
                      <h3 class="avis-form-block__title">LAISSER UN AVIS</h3>
                      <p class="avis-form-block__sub">Partagez votre expérience avec la communauté Ciné Délices</p>
                    </div>
                  </div>
                  <% if (typeof userId !== 'undefined' && userId) { %>
                  <form id="avisForm" action="/recipes-movie/details/<%= recipe.slug || recipe.id %>/avis" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" id="avisQuoteInput" name="quote" value="" />
                    <div class="star-picker">
                      <span class="star-picker__lbl">Note :</span>
                      <span class="star-pick" data-v="1">★</span>
                      <span class="star-pick" data-v="2">★</span>
                      <span class="star-pick" data-v="3">★</span>
                      <span class="star-pick" data-v="4">★</span>
                      <span class="star-pick" data-v="5">★</span>
                      <span class="star-picker__hint">Cliquez sur une étoile pour noter</span>
                    </div>
                    <div class="form-g">
                      <label class="form-lbl" for="avisTexte">Votre avis <span style="color:var(--rouge-cta)">*</span></label>
                      <textarea class="form-inp form-ta" id="avisTexte" name="comment" rows="4" maxlength="500" placeholder="Partagez votre avis sur la recette, le film, vos astuces…" required></textarea>
                    </div>
                    <div class="avis-photo-upload">
                      <input type="file" id="avisPhotos" name="noticePictures" accept="image/*" multiple hidden />
                      <label for="avisPhotos" class="avis-photo-upload__btn">
                        <i data-lucide="camera" width="15" height="15" aria-hidden="true"></i> Ajouter une photo
                      </label>
                      <div class="avis-photo-upload__previews" id="avisPhotoPreviews"></div>
                    </div>
                    <label class="avis-anonymous-toggle">
                      <input type="checkbox" name="anonymous" value="true" />
                      <span>Avis anonyme</span>
                    </label>
                    <div id="avisFormError" class="form-error" style="display:none;color:var(--rouge-cta);font-size:.85rem;margin-bottom:.5rem"></div>
                    <div id="avisFormSuccess" class="form-success" style="display:none;color:var(--vert-ok,#4caf50);font-size:.85rem;margin-bottom:.5rem"></div>
                    <div class="form-actions">
                      <span class="form-hint-global">Votre avis sera relu avant publication.</span>
                      <button class="btn-submit-avis" type="submit" id="avisSubmitBtn">✦ Publier mon avis</button>
                    </div>
                  </form>
                  <% } else { %>
                  <div class="avis-locked">
                    <i data-lucide="lock" width="32" height="32" stroke-width="1.5" aria-hidden="true"></i>
                    <p class="avis-locked__text">Connectez-vous pour partager votre avis,<br>une suggestion ou une variante de cette recette.</p>
                    <div class="avis-locked__actions">
                      <a href="#" class="btn btn--red js-open-login">Se connecter</a>
                      <a href="#" class="btn btn--outline js-open-register">Créer un compte</a>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>
            </div><!-- /rd-avis-row -->

            <section class="avis-section" id="avis" aria-labelledby="avis-section-title">
              <div class="avis-section__head">
                <div>
                  <h2 class="rd-combo-col__title rd-combo-col__title--sm">Tous les avis <span class="avis-section__count">(<%= notices ? notices.length : 0 %>)</span></h2>
                  <p class="avis-section__sub">Découvrez les retours et partages de la communauté sur cette recette et le film.</p>
                </div>
                <div class="avis-section__tools">
                  <label class="avis-sort">
                    <span>Trier par</span>
                    <select id="avisSortSelect">
                      <option value="recent">Plus récents</option>
                      <option value="top">Mieux notés</option>
                      <option value="liked">Plus aimés</option>
                    </select>
                  </label>
                  <div class="avis-view-toggle" role="group" aria-label="Mode d'affichage">
                    <button type="button" class="avis-view-btn is-active" data-avis-view="grid" aria-label="Vue grille">
                      <i data-lucide="layout-grid" width="16" height="16" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="avis-view-btn" data-avis-view="list" aria-label="Vue liste">
                      <i data-lucide="list" width="16" height="16" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>
              </div>
              <!-- Grille des avis (tous chargés, paginés côté client — cf.
                   recipe-detail.js — pour éviter de tout recharger au clic
                   sur une page tout en gardant un rendu léger par page). -->
              <% if (notices && notices.length > 0) { %>
              <div class="avis-grid" id="avisGrid">
                <% notices.forEach((notice) => { %>
                <%- avisCardHTML(notice, notice.highlight === 'coup_de_coeur') %>
                <% }) %>
              </div>
              <nav class="avis-pagination" id="avisPagination" aria-label="Pages des avis" hidden>
                <button type="button" class="avis-pagination__arrow" data-avis-page-prev aria-label="Page précédente">
                  <i data-lucide="chevron-left" width="18" height="18" aria-hidden="true"></i>
                </button>
                <div class="avis-pagination__pages" id="avisPaginationPages"></div>
                <button type="button" class="avis-pagination__arrow" data-avis-page-next aria-label="Page suivante">
                  <i data-lucide="chevron-right" width="18" height="18" aria-hidden="true"></i>
                </button>
              </nav>
              <% } %>

            </section>

            <!-- ══ RECETTES RECOMMANDÉES ══ -->
            <% if (recommendedRecipes && recommendedRecipes.length) { %>
            <section class="rd-reco-section" aria-label="Recettes recommandées">
              <div class="rd-sec-h">
                <p class="rd-sec-h__eye">À découvrir aussi</p>
                <h2 class="rd-sec-h__title">Vous <span>aimerez aussi</span></h2>
                <div class="rd-sec-h__rule"></div>
              </div>
              <div class="rd-reco-carousel-wrap">
                <button type="button" class="rd-reco-nav rd-reco-nav--prev" id="rdRecoPrev" aria-label="Recettes précédentes">
                  <i data-lucide="chevron-left" width="20" height="20" aria-hidden="true"></i>
                </button>
                <div class="rd-reco-carousel" id="rdRecoCarousel">
                  <% recommendedRecipes.forEach((r) => { %>
                  <a href="/recipes-movie/details/<%= r.slug || r.id %>" class="rd-reco-card">
                    <div class="rd-reco-card__img">
                      <img src="<%= cldCard(r.picture || '/images/image-default-recipe-1.jpg') %>" alt="<%= r.name %>" loading="lazy" />
                      <% if (r.category) { %><span class="rd-reco-card__cat"><%= r.category %></span><% } %>
                    </div>
                    <div class="rd-reco-card__body">
                      <p class="rd-reco-card__name"><%= r.name %></p>
                      <% if (r.Movie) { %><p class="rd-reco-card__movie">Comme dans <%= r.Movie.title %></p><% } %>
                      <div class="rd-reco-card__meta">
                        <% if (r.time) { %><span><i data-lucide="clock" width="11" height="11" aria-hidden="true"></i> <%= r.time %> min</span><% } %>
                        <% if (r.difficulty) { %><span><%= r.difficulty %></span><% } %>
                      </div>
                    </div>
                  </a>
                  <% }) %>
                </div>
                <button type="button" class="rd-reco-nav rd-reco-nav--next" id="rdRecoNext" aria-label="Recettes suivantes">
                  <i data-lucide="chevron-right" width="20" height="20" aria-hidden="true"></i>
                </button>
              </div>
            </section>
            <% } %>

          </div><!-- /recipe-main-col -->
      </div><!-- /recipe-main -->

      <!-- Gabarit de formulaire de réponse à un avis, cloné par JS (recipe-detail.js) -->
      <% if (typeof userId !== 'undefined' && userId) { %>
      <template id="avisReplyTemplate">
        <form class="avis-reply-form" data-notice-reply-form>
          <textarea class="form-inp form-ta" rows="2" maxlength="500" placeholder="Écrire une réponse…" required></textarea>
          <div class="avis-reply-form__error" style="display:none"></div>
          <div class="avis-reply-form__actions">
            <button type="button" class="btn btn--outline" data-notice-reply-cancel>Annuler</button>
            <button type="submit" class="btn btn--red">Répondre</button>
          </div>
        </form>
      </template>
      <% } %>

      <!-- ══ LIGHTBOX ══ -->
      <div class="recipe-lightbox" id="recipe-lightbox" aria-hidden="true">
        <div class="recipe-lightbox__backdrop" data-lightbox-close aria-hidden="true"></div>
        <div class="recipe-lightbox__dialog" role="dialog" aria-modal="true">
          <button type="button" class="recipe-lightbox__close" aria-label="Fermer l'aperçu" data-lightbox-close>&times;</button>
          <span class="recipe-lightbox__step-badge" data-lightbox-step-badge></span>
          <button type="button" class="recipe-lightbox__nav recipe-lightbox__nav--prev" aria-label="Photo précédente" data-lightbox-prev>
            <i data-lucide="chevron-left" width="20" height="20" aria-hidden="true"></i>
          </button>
          <button type="button" class="recipe-lightbox__nav recipe-lightbox__nav--next" aria-label="Photo suivante" data-lightbox-next>
            <i data-lucide="chevron-right" width="20" height="20" aria-hidden="true"></i>
          </button>
          <img src="" alt="Recette Ciné Délices" class="recipe-lightbox__image" loading="lazy" />
        </div>
      </div>

    </main>

    <%- include("partials/footer") %>

    <!-- Configuration favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/recipe-detail.js?v=20260829a" defer></script>
    <script src="/js/favorites.js" defer></script>
  </body>
</html>
