<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez les détails de la recette cultissime <%= recipe.name %>"
    />
    <title><%= recipe.name %> - Ciné Délices</title>

    <%- include("partials/head-resources") %>

    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/recipe-detail.css?v=20260310" />
  </head>

  <body class="recipe-page">
    <%- include("partials/header") %>

    <main>
      <% const recipeImage = recipe.picture || "/images/image-default-recipe-1.jpg"; %>
      <% const movieImage = movie ? (movie.bannerPath || movie.cardPath || movie.picture || "/images/image-default-film.jpg") : "/images/image-default-film.jpg"; %>
      <%/* L'auteur est toujours présent (id_user NOT NULL côté backend) */ %>
      <% const contributorName = contributor.pseudo; %>
      <% const contributorImage = contributor.picture || "/images/image-default-profile.jpg"; %>
      <% const contributorQuery = contributorName ? encodeURIComponent(contributorName.toLowerCase()) : ""; %>
      <% const ingredientsCount = ingredientsBlocks ? ingredientsBlocks.length : 0; %>
      <% const preparationCount = preparationBlocks ? preparationBlocks.length : 0; %>

      <!-- ══ BREADCRUMB ══ -->
      <div class="bc-bar">
        <nav class="bc" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a><span class="bc-sep">›</span>
          <a href="/movies">Films</a><span class="bc-sep">›</span>
          <% if (movie) { %>
          <a href="/recipes-movie/<%= movie.slug || movie.id %>"><%= movie.title %></a><span class="bc-sep">›</span>
          <% } %>
          <span class="bc-cur"><%= recipe.name %></span>
        </nav>
      </div>

      <!-- ══ HERO CINÉMATOGRAPHIQUE ══ -->
      <section class="recipe-hero" aria-labelledby="recipe-title">
        <div
          class="recipe-hero__bg"
          style="background-image: url('<%= movieImage %>')"
        ></div>
        <div class="recipe-hero__overlay"></div>
        <div class="recipe-hero__lisere" aria-hidden="true"></div>
        <div class="recipe-hero__scanlines" aria-hidden="true"></div>
        <div class="recipe-hero__vignette" aria-hidden="true"></div>

        <div class="recipe-hero__content">
          <!-- Colonne infos -->
          <div class="rh-info">
            <% if (movie) { %>
            <div class="rh-badge-film">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M17 3v18M3 7.5h4M17 7.5h4M3 12h18M3 16.5h4M17 16.5h4"/></svg>
              <%= movie.title %><% if (movie.year) { %> — <%= movie.year %><% } %>
            </div>
            <% } %>
            <p class="rh-eyebrow">Recette inspirée du film</p>
            <h1 class="rh-title" id="recipe-title"><%= recipe.name %></h1>
            <div class="rh-tags">
              <span class="rh-tag rh-tag--or"><%= recipe.category %></span>
              <span class="rh-tag rh-tag--bleu"><%= recipe.difficulty %></span>
              <span class="rh-tag rh-tag--vert"><%= recipe.time %> min</span>
              <% if (recipe.servings) { %>
              <span class="rh-tag rh-tag--violet"><%= recipe.servings %> pers.</span>
              <% } %>
            </div>
            <div class="rh-meta">
              <div class="rh-meta__item">
                <span class="rh-meta__label">Temps</span>
                <span class="rh-meta__val"><%= recipe.time %> min</span>
              </div>
              <% if (recipe.servings) { %>
              <div class="rh-meta__sep"></div>
              <div class="rh-meta__item">
                <span class="rh-meta__label">Personnes</span>
                <span class="rh-meta__val"><%= recipe.servings %></span>
              </div>
              <% } %>
              <div class="rh-meta__sep"></div>
              <div class="rh-meta__item">
                <span class="rh-meta__label">Difficulté</span>
                <span class="rh-meta__val"><%= recipe.difficulty %></span>
              </div>
              <div class="rh-meta__sep"></div>
              <div
                class="rh-meta__item"
                data-rating-container
                data-current-rating="<%= averageQuote %>"
                data-readonly="true"
              >
                <span class="rh-meta__label">Note</span>
                <span class="rh-meta__val rh-meta__val--gold">
                  <svg class="icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" width="12" height="12"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  <strong id="banner-rating-output" data-rating-output><%= averageQuote %></strong>/5
                </span>
              </div>
            </div>
            <div class="rh-actions">
              <a href="#preparation" class="btn btn--red">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="m5 11 4-7"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8c.9 0 1.8-.7 2-1.6l1.7-7.4"/><path d="m9 11 1 9"/><path d="M4.5 15.5h15"/><path d="m15 11-1 9"/></svg>
                Voir la recette
              </a>
              <button
                class="btn-fav btn-fav--banner"
                data-entity-id="<%= recipe.id %>"
                data-entity-type="recipe"
                data-is-favorite="<%= recipe.isFavorite || false %>"
                aria-label="<%= recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="<%= recipe.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              </button>
              <a href="#avis" class="btn btn--outline btn--sm">
                Donner mon avis
              </a>
            </div>
          </div>

          <!-- Colonne poster / image recette -->
          <div class="rh-poster-wrap">
            <div class="rh-poster">
              <div class="rh-poster__lbox rh-poster__lbox--t" aria-hidden="true">
                <div class="rh-perf"></div><div class="rh-perf"></div><div class="rh-perf"></div><div class="rh-perf"></div><div class="rh-perf"></div>
              </div>
              <button
                type="button"
                class="rh-poster__img-btn"
                data-lightbox-trigger
                data-lightbox-image="<%= recipeImage %>"
                data-lightbox-alt="Présentation de la recette <%= recipe.name %>"
                aria-label="Voir l'image de <%= recipe.name %> en plein écran"
              >
                <img
                  src="<%= recipeImage %>"
                  alt="Présentation de la recette <%= recipe.name %>"
                  loading="lazy"
                />
              </button>
              <div class="rh-poster__lbox rh-poster__lbox--b" aria-hidden="true">
                <div class="rh-perf"></div><div class="rh-perf"></div><div class="rh-perf"></div><div class="rh-perf"></div><div class="rh-perf"></div>
              </div>
            </div>
            <div class="rh-poster__stat">
              <div class="rh-ps-icon">
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="rh-ps-text">
                <span class="rh-ps-num"><%= averageQuote %></span>
                <span class="rh-ps-label">Note / 5</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ MAIN LAYOUT ══ -->
      <div class="recipe-main">
        <div class="recipe-main-grid">

          <!-- ═══ COLONNE GAUCHE ═══ -->
          <div class="recipe-main-col">

            <!-- Contexte ciné : image + auteur + description -->
            <div class="rd-context">
              <!-- Image cliquable -->
              <div class="rd-context__media">
                <button
                  type="button"
                  class="rd-context__img-btn"
                  data-lightbox-trigger
                  data-lightbox-image="<%= recipeImage %>"
                  data-lightbox-alt="Présentation de la recette <%= recipe.name %>"
                  aria-label="Voir l'image en plein écran"
                >
                  <img
                    src="<%= recipeImage %>"
                    alt="Présentation de la recette <%= recipe.name %>"
                    loading="lazy"
                  />
                  <span class="rd-context__zoom" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  </span>
                </button>
              </div>

              <!-- Colonne droite : auteur + description -->
              <div class="rd-context__aside">
                <!-- Badge auteur -->
                <div class="rd-author-row">
                  <a
                    class="rd-author-badge"
                    href="/movies"
                    aria-label="Voir les films sur Ciné Délices"
                  >
                    <div class="rd-author-avatar">
                      <img src="<%= contributorImage %>" alt="<%= contributorName %>" loading="lazy" />
                    </div>
                    <div class="rd-author-info">
                      <span class="rd-author-label">Recette proposée par</span>
                      <span class="rd-author-name">
                        <%= contributorName %>
                        <% if (contributor && contributor.role === "admin") { %>
                        <span class="rd-author-official">Officiel</span>
                        <% } %>
                      </span>
                    </div>
                    <span class="rd-author-arrow">›</span>
                  </a>
                </div>

                <!-- Description -->
                <div class="rd-context__body">
                  <h3 class="rd-context__title">Le contexte cinématographique</h3>
                  <% if (descriptionBlocks && descriptionBlocks.length) { %>
                    <% descriptionBlocks.forEach((paragraph, index) => { %>
                    <p class="rd-context__text<%= index === 0 ? ' rd-context__text--lead' : '' %>"><%= paragraph %></p>
                    <% }) %>
                  <% } else { %>
                    <p class="rd-context__text rd-context__text--lead">Aucune description détaillée n'a encore été partagée pour cette recette.</p>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Info bar -->
            <div class="rd-info-bar" role="list" aria-label="Informations de la recette">
              <div class="rd-ib-item" role="listitem">
                <svg class="rd-ib-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                <span class="rd-ib-val"><%= recipe.category %></span>
                <span class="rd-ib-label">Catégorie</span>
              </div>
              <div class="rd-ib-item" role="listitem">
                <svg class="rd-ib-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="rd-ib-val"><%= recipe.time %> min</span>
                <span class="rd-ib-label">Temps</span>
              </div>
              <% if (recipe.servings) { %>
              <div class="rd-ib-item" role="listitem">
                <svg class="rd-ib-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span class="rd-ib-val"><%= recipe.servings %></span>
                <span class="rd-ib-label">Personnes</span>
              </div>
              <% } %>
              <div class="rd-ib-item" role="listitem">
                <svg class="rd-ib-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                <span class="rd-ib-val"><%= recipe.difficulty %></span>
                <span class="rd-ib-label">Difficulté</span>
              </div>
              <div class="rd-ib-item" role="listitem">
                <svg class="rd-ib-icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m5 11 4-7"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8c.9 0 1.8-.7 2-1.6l1.7-7.4"/><path d="m9 11 1 9"/><path d="M4.5 15.5h15"/><path d="m15 11-1 9"/></svg>
                <span class="rd-ib-val"><%= ingredientsCount %></span>
                <span class="rd-ib-label">Ingrédient<%= ingredientsCount > 1 ? 's' : '' %></span>
              </div>
            </div>

            <!-- Préparation -->
            <div id="preparation" class="rd-steps-section">
              <div class="rd-sec-h">
                <span class="rd-sec-h__eye">Étapes</span>
                <h2 class="rd-sec-h__title">PRÉPARATION</h2>
              </div>
              <p class="rd-steps-count">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                <%= preparationCount %> étape<%= preparationCount > 1 ? 's' : '' %>
              </p>
              <% if (preparationBlocks && preparationBlocks.length) { %>
              <% preparationBlocks.forEach((step, index) => { %>
              <div class="rd-step-item">
                <div class="rd-step-num-wrap">
                  <div class="rd-step-num"><%= index + 1 %></div>
                </div>
                <div class="rd-step-body">
                  <p class="rd-step-title">Étape <%= index + 1 %></p>
                  <p class="rd-step-text"><%= step %></p>
                </div>
              </div>
              <% }) %>
              <% } else { %>
              <div class="rd-step-item">
                <div class="rd-step-num-wrap"><div class="rd-step-num">1</div></div>
                <div class="rd-step-body">
                  <p class="rd-step-text">Le détail de cette préparation arrive bientôt.</p>
                </div>
              </div>
              <% } %>
            </div>

            <!-- Actions de navigation -->
            <div class="rd-nav-actions">
              <a class="btn btn--outline" href="/recipes-movie/<%= movie ? (movie.slug || movie.id) : recipe.id_movie %>">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="m15 18-6-6 6-6"/></svg>
                Recettes du film
              </a>
              <a class="btn btn--red" href="/add-recipes-movies/">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                Je crée ma recette
              </a>
            </div>

          <!-- ══ SECTION AVIS ══ -->
          <%
            const totalAvis = notices ? notices.length : 0;
            const starCounts = [0,0,0,0,0];
            if (notices) notices.forEach(n => { const q = parseInt(n.quote); if(q>=1&&q<=5) starCounts[q-1]++; });
            const pct = (n) => totalAvis > 0 ? Math.round((n / totalAvis) * 100) : 0;
          %>
          <section class="avis-section" id="avis" aria-labelledby="avis-section-title">

            <!-- Bannière dorée Golden Ticket -->
            <div class="avis-banner">
              <div class="avis-banner__tear"></div>
              <div class="avis-banner__stamp">
                <div class="avis-banner__stamp-inner">CINÉ<br/>DÉLICES<br/>✦</div>
              </div>
              <div class="avis-banner__shimmer"></div>
              <div class="avis-banner__inner">

                <div class="avis-banner__reel">
                  <span class="avis-banner__reel-icon">💬</span>
                </div>

                <div class="avis-banner__text">
                  <p class="avis-banner__eyebrow">Communauté · Critiques &amp; Impressions</p>
                  <h2 class="avis-banner__title" id="avis-section-title">AVIS DE LA COMMUNAUTÉ</h2>
                  <p class="avis-banner__sub">Des passionnés qui partagent leur amour du cinéma et de la gastronomie.</p>
                  <div class="avis-distrib">
                    <div class="distrib-row">
                      <span class="distrib-label"><span class="fs">★</span> 5</span>
                      <div class="distrib-bar-track"><div class="distrib-bar-fill d5" style="width:<%= pct(starCounts[4]) %>%"></div></div>
                      <span class="distrib-count"><%= starCounts[4] %></span>
                    </div>
                    <div class="distrib-row">
                      <span class="distrib-label"><span class="fs">★</span> 4</span>
                      <div class="distrib-bar-track"><div class="distrib-bar-fill d4" style="width:<%= pct(starCounts[3]) %>%"></div></div>
                      <span class="distrib-count"><%= starCounts[3] %></span>
                    </div>
                    <div class="distrib-row">
                      <span class="distrib-label"><span class="fs">★</span> 3</span>
                      <div class="distrib-bar-track"><div class="distrib-bar-fill d3" style="width:<%= pct(starCounts[2]) %>%"></div></div>
                      <span class="distrib-count"><%= starCounts[2] %></span>
                    </div>
                    <div class="distrib-row">
                      <span class="distrib-label"><span class="fs">★</span> 2</span>
                      <div class="distrib-bar-track"><div class="distrib-bar-fill d2" style="width:<%= pct(starCounts[1]) %>%"></div></div>
                      <span class="distrib-count"><%= starCounts[1] %></span>
                    </div>
                    <div class="distrib-row">
                      <span class="distrib-label"><span class="fs">★</span> 1</span>
                      <div class="distrib-bar-track"><div class="distrib-bar-fill d1" style="width:<%= pct(starCounts[0]) %>%"></div></div>
                      <span class="distrib-count"><%= starCounts[0] %></span>
                    </div>
                  </div>
                </div>

                <div class="avis-banner__stats">
                  <div class="avis-stat">
                    <span class="avis-stat__num"><%= totalAvis %></span>
                    <span class="avis-stat__lbl">Avis publiés</span>
                  </div>
                  <div class="avis-stat-sep"></div>
                  <div class="avis-stat">
                    <span class="avis-stat__num"><%= averageQuote %></span>
                    <span class="avis-stat__lbl">Note moyenne</span>
                  </div>
                </div>

                <div class="avis-banner__note">
                  <div class="global-stars">
                    <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= Math.round(averageQuote) ? 's' : 'sh' %>">★</span><% } %>
                  </div>
                  <div style="display:flex;align-items:baseline;gap:3px">
                    <span class="global-note"><%= averageQuote %></span>
                    <span class="global-note__max">/ 5</span>
                  </div>
                  <span class="global-note__lbl">Note moyenne</span>
                </div>

              </div>
            </div>

            <!-- Grille des avis -->
            <% if (notices && notices.length > 0) { %>
            <div class="avis-grid" id="avisGrid">
              <% notices.slice(0, 6).forEach((notice, i) => {
                const avatarSrc = notice.User && notice.User.picture ? notice.User.picture : null;
                const userName = notice.User ? (notice.User.pseudo || (notice.User.first_name + ' ' + notice.User.last_name)) : 'Visiteur';
                const isAdmin = notice.User && notice.User.role === 'admin';
                const nd = notice.createdAt ? new Date(notice.createdAt) : null;
                const noticeDate = nd ? nd.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
              %>
              <article class="avis-card<%= i === 0 ? ' avis-card--featured' : '' %>" data-rating="<%= notice.quote %>">
                <div class="avis-card__head">
                  <div class="avis-card__user">
                    <div class="avis-avatar<%= isAdmin ? ' avis-avatar--gold' : '' %>">
                      <% if (avatarSrc) { %>
                      <img src="<%= avatarSrc %>" alt="<%= userName %>" loading="lazy" />
                      <% } else { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      <% } %>
                    </div>
                    <div>
                      <p class="avis-user__name"><%= userName %></p>
                      <% if (isAdmin) { %><p class="avis-user__level avis-user__level--legend">✦ Équipe Ciné Délices</p><% } %>
                    </div>
                  </div>
                  <% if (i === 0) { %><span class="avis-featured-badge">✦ Coup de cœur</span><% } %>
                </div>
                <div class="avis-stars">
                  <% for (let s = 1; s <= 5; s++) { %><span class="<%= s <= notice.quote ? 's' : 'se' %>">★</span><% } %>
                </div>
                <div class="avis-card__quote">
                  <span class="avis-quote-mark">"</span>
                  <p class="avis-card__text"><%= notice.content %></p>
                </div>
                <div class="avis-card__foot">
                  <span class="avis-date"><%= noticeDate %></span>
                </div>
              </article>
              <% }) %>
            </div>

            <% if (notices.length > 6) { %>
            <div class="avis-loadmore" id="avisLoadmore">
              <div class="load-bar"></div>
              <p class="load-info" id="avisLoadInfo">6 avis affichés sur <%= notices.length %></p>
              <button class="btn-more" id="seeMoreAvis" type="button">↓ Charger plus d'avis</button>
            </div>
            <div class="avis-grid" id="avisGridExtra" hidden>
              <% notices.slice(6).forEach((notice) => {
                const avatarSrc = notice.User && notice.User.picture ? notice.User.picture : null;
                const userName = notice.User ? (notice.User.pseudo || (notice.User.first_name + ' ' + notice.User.last_name)) : 'Visiteur';
                const isAdmin = notice.User && notice.User.role === 'admin';
                const nd = notice.createdAt ? new Date(notice.createdAt) : null;
                const noticeDate = nd ? nd.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
              %>
              <article class="avis-card" data-rating="<%= notice.quote %>">
                <div class="avis-card__head">
                  <div class="avis-card__user">
                    <div class="avis-avatar<%= isAdmin ? ' avis-avatar--gold' : '' %>">
                      <% if (avatarSrc) { %>
                      <img src="<%= avatarSrc %>" alt="<%= userName %>" loading="lazy" />
                      <% } else { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      <% } %>
                    </div>
                    <div>
                      <p class="avis-user__name"><%= userName %></p>
                      <% if (isAdmin) { %><p class="avis-user__level avis-user__level--legend">✦ Équipe Ciné Délices</p><% } %>
                    </div>
                  </div>
                </div>
                <div class="avis-stars">
                  <% for (let s = 1; s <= 5; s++) { %><span class="<%= s <= notice.quote ? 's' : 'se' %>">★</span><% } %>
                </div>
                <div class="avis-card__quote">
                  <span class="avis-quote-mark">"</span>
                  <p class="avis-card__text"><%= notice.content %></p>
                </div>
                <div class="avis-card__foot">
                  <span class="avis-date"><%= noticeDate %></span>
                </div>
              </article>
              <% }) %>
            </div>
            <% } %>
            <% } %>

            <!-- Formulaire / état non connecté -->
            <div class="avis-form-block" id="avisForm">
              <div class="avis-form-block__head">
                <div class="avis-form-block__icon">✍️</div>
                <div>
                  <h3 class="avis-form-block__title">LAISSER UN AVIS</h3>
                  <p class="avis-form-block__sub">Partagez votre expérience avec la communauté</p>
                </div>
              </div>
              <% if (typeof userId !== 'undefined' && userId) { %>
              <form action="#" method="post" novalidate>
                <div class="star-picker">
                  <span class="star-picker__lbl">Note :</span>
                  <span class="star-pick" data-v="1">★</span>
                  <span class="star-pick" data-v="2">★</span>
                  <span class="star-pick" data-v="3">★</span>
                  <span class="star-pick" data-v="4">★</span>
                  <span class="star-pick" data-v="5">★</span>
                </div>
                <div class="form-g">
                  <label class="form-lbl" for="avisTexte">Votre avis <span style="color:var(--rouge-cta)">*</span></label>
                  <textarea class="form-inp form-ta" id="avisTexte" name="comment" rows="4" maxlength="500" placeholder="Partagez votre expérience, vos conseils, ce qui vous a touché dans ce plat ou ce film…"></textarea>
                </div>
                <div class="form-actions">
                  <span class="form-hint-global">Votre avis sera relu avant publication.</span>
                  <button class="btn-submit-avis" type="submit">✦ Publier mon avis</button>
                </div>
              </form>
              <% } else { %>
              <div class="avis-locked">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32" style="opacity:.35"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <p class="avis-locked__text">Connectez-vous pour partager votre avis,<br>une suggestion ou une variante de cette recette.</p>
                <div class="avis-locked__actions">
                  <a href="#" class="btn btn--red js-open-login">Se connecter</a>
                  <a href="#" class="btn btn--outline js-open-register">Créer un compte</a>
                </div>
              </div>
              <% } %>
            </div>

          </section>

          </div><!-- /recipe-main-col -->

          <!-- ═══ SIDEBAR DROITE ═══ -->
          <aside class="rd-sidebar">

            <!-- Ingrédients — card dorée -->
            <div class="rd-ingredients">
              <div class="rd-ingredients__inner">
                <div class="rd-ingredients__header">
                  <div class="rd-ingredients__icon">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="m5 11 4-7"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8c.9 0 1.8-.7 2-1.6l1.7-7.4"/><path d="m9 11 1 9"/><path d="M4.5 15.5h15"/><path d="m15 11-1 9"/></svg>
                  </div>
                  <div>
                    <div class="rd-ingredients__title">INGRÉDIENTS</div>
                    <div class="rd-ingredients__sub"><%= ingredientsCount %> ingrédient<%= ingredientsCount > 1 ? 's' : '' %></div>
                  </div>
                </div>
                <% if (recipe.servings) { %>
                <div class="rd-ing-portions">
                  <span class="rd-ing-portions__label">Pour</span>
                  <span class="rd-ing-portions__val"><%= recipe.servings %> personne<%= recipe.servings > 1 ? 's' : '' %></span>
                </div>
                <% } %>
                <div class="rd-ing-list">
                  <% if (ingredientsBlocks && ingredientsBlocks.length) { %>
                  <% ingredientsBlocks.forEach((ingredient) => { %>
                  <div class="rd-ing-item">
                    <span class="rd-ing-text"><%= ingredient %></span>
                  </div>
                  <% }) %>
                  <% } else { %>
                  <div class="rd-ing-item">
                    <span class="rd-ing-text">Les ingrédients seront bientôt disponibles.</span>
                  </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Note communauté -->
            <div class="rd-sidebar-card">
              <h3 class="rd-sc-title">
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" width="14" height="14"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Note communauté
              </h3>
              <div
                class="rd-rating-summary rating-stars"
                data-rating-container
                data-current-rating="<%= averageQuote %>"
                data-readonly="true"
              >
                <div class="rd-rating-big"><%= averageQuote %></div>
                <div class="rd-rating-stars-row">
                  <% for (let i = 1; i <= 5; i++) { %>
                  <span
                    class="rating-star<%= i <= Math.round(averageQuote) ? ' is-active' : '' %>"
                    data-value="<%= i %>"
                  >★</span>
                  <% } %>
                </div>
                <p class="rd-rating-sub">
                  <%= notices && notices.length > 0 ? notices.length + (notices.length > 1 ? ' avis' : ' avis') : 'Soyez le premier !' %>
                </p>
              </div>
              <a href="#avis" class="btn btn--primary btn--sm rd-rating-cta">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"/></svg>
                Donner mon avis
              </a>
            </div>

            <!-- Film associé -->
            <% if (movie) { %>
            <div class="rd-sidebar-card rd-movie-card">
              <h3 class="rd-sc-title">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M17 3v18M3 7.5h4M17 7.5h4M3 12h18M3 16.5h4M17 16.5h4"/></svg>
                Film associé
              </h3>
              <div class="rd-movie-media">
                <img src="<%= movieImage %>" alt="Affiche du film <%= movie.title %>" loading="lazy" />
              </div>
              <div class="rd-movie-info">
                <p class="rd-movie-title"><%= movie.title %></p>
                <p class="rd-movie-meta"><%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %></p>
                <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="btn btn--primary btn--sm rd-movie-link">
                  Voir les recettes
                </a>
              </div>
            </div>
            <% } %>

          </aside><!-- /rd-sidebar -->

        </div><!-- /recipe-main-grid -->
      </div><!-- /recipe-main -->

      <!-- ══ LIGHTBOX ══ -->
      <div class="recipe-lightbox" id="recipe-lightbox" aria-hidden="true">
        <div
          class="recipe-lightbox__backdrop"
          data-lightbox-close
          aria-hidden="true"
        ></div>
        <div class="recipe-lightbox__dialog" role="dialog" aria-modal="true">
          <button
            type="button"
            class="recipe-lightbox__close"
            aria-label="Fermer l'aperçu"
            data-lightbox-close
          >
            &times;
          </button>
          <img
            src=""
            alt="Recette Ciné Délices"
            class="recipe-lightbox__image"
            loading="lazy"
          />
        </div>
      </div>

    </main>

    <%- include("partials/footer") %>

    <script src="/js/burger-menu.js" defer></script>
    <script src="/js/recipe-detail.js" defer></script>

    <!-- Configuration pour les favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>
  </body>
</html>
