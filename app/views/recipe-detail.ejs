<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez les détails de la recette cultissime <%= recipe.name %>"
    />
    <title><%= recipe.name %> - Ciné Délices</title>

    <%- include("partials/head-resources") %>

    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/recipe-detail.css" />
  </head>

  <body>
    <%- include("partials/header") %>

    <main class="recipe-detail-main">
      <% const recipeImage = recipe.picture ||
      "/images/default-image-cine-delices-1.jpg"; %>

      <section class="banner__image__recipes" aria-hidden="true">
        <div class="banner__image__recipes__overlay"></div>
        <img
          src="<%= recipeImage %>"
          alt="Visuel de la recette <%= recipe.name %>"
          loading="lazy"
        />
      </section>

      <section class="banner__recipes" aria-labelledby="recipe-title">
        <div class="banner__recipes__content">
          <h1 id="recipe-title"><%= recipe.name %></h1>

          <div class="banner__recipes__meta">
            <span class="meta-pill meta-pill--category">
              <i class="fa-solid fa-utensils" aria-hidden="true"></i>
              <%= recipe.category %>
            </span>
            <span class="meta-pill">
              <i class="fa-regular fa-clock" aria-hidden="true"></i>
              <%= recipe.time %> min
            </span>
            <span class="meta-pill">
              <i class="fa-solid fa-fire" aria-hidden="true"></i>
              Difficulté : <%= recipe.difficulty %>
            </span>
          </div>
        </div>

        <div class="banner__recipes__rating" data-rating-container>
          <p class="rating-label">
            Note générale de la recette :
            <span
              class="current-rating"
              id="banner-rating-output"
              data-rating-output
              ><%= recipe.quote %>/5</span
            >
          </p>
          <div
            class="rating-stars rating-stars--lifted"
            role="group"
            aria-label="Note générale (lecture seule)"
            data-current-rating="<%= recipe.quote %>"
            data-output="#banner-rating-output"
            data-readonly="true"
          >
            <% for (let i = 1; i <= 5; i++) { %>
            <button
              type="button"
              class="rating-star"
              data-value="<%= i %>"
              aria-label="<%= i %> étoile<%= i > 1 ? 's' : '' %>"
            >
              ★
            </button>
            <% } %>
          </div>
          <a
            href="#review-banner"
            class="rating-hint__cta rating-hint__cta--primary"
            aria-label="Aller à la bannière d'avis"
          >
            Je donne mon avis
          </a>
        </div>
      </section>

      <section
        class="recipe-details-group"
        aria-label="Détails complets de la recette"
      >
        <div class="recipe-overview" aria-labelledby="overview-title">
          <div class="overview-card">
            <div class="overview-card__description">
              <h3 class="overview-card__title">
                La recette culte de : <span><%= recipe.name %></span>
              </h3>
              <% if (descriptionBlocks && descriptionBlocks.length) { %> <%
              descriptionBlocks.forEach((paragraph, index) => { %>
              <label class="sr-only" for="desc-<%= index %>"
                >Description paragraphe <%= index + 1 %></label
              >
              <textarea readonly id="desc-<%= index %>" class="recipe-textarea">
<%= paragraph %></textarea
              >
              <% }) %> <% } else { %>
              <textarea readonly class="recipe-textarea">
Aucune description détaillée n'a encore été partagée pour cette
                recette.</textarea
              >
              <% } %>
            </div>
          </div>

          <div class="overview-image">
            <button
              type="button"
              class="overview-image-button"
              data-lightbox-trigger
              data-lightbox-image="/images/<%= recipeImage %>"
              data-lightbox-alt="Présentation de la recette <%= recipe.name %>"
              aria-label="Voir l'image de <%= recipe.name %> en plein écran"
            >
              <img
                src="/images/<%= recipeImage %>"
                alt="Présentation de la recette <%= recipe.name %>"
                loading="lazy"
              />
              <span class="overview-image-hint">
                <i class="fa-solid fa-magnifying-glass"></i>
              </span>
            </button>
          </div>
        </div>

        <div class="recipe-columns">
          <div class="recipe-column column-ingredients">
            <div class="column-overlay" aria-hidden="true"></div>
            <div class="column-header">
              <h3>Les Ingrédients</h3>
              <p>Prêts à cuisiner ?</p>
            </div>
            <div class="textarea-stack">
              <% if (ingredientsBlocks && ingredientsBlocks.length) { %> <%
              ingredientsBlocks.forEach((ingredient, index) => { %>
              <label class="sr-only" for="ingredient-<%= index %>"
                >Ingrédient <%= index + 1 %></label
              >
              <textarea
                readonly
                id="ingredient-<%= index %>"
                class="recipe-textarea"
              >
<%= ingredient %></textarea
              >
              <% }) %> <% } else { %>
              <textarea readonly class="recipe-textarea">
Les ingrédients seront bientôt disponibles.</textarea
              >
              <% } %>
            </div>
          </div>

          <div class="recipe-column column-preparation">
            <div class="column-overlay" aria-hidden="true"></div>
            <div class="column-header">
              <h3>La Préparation</h3>
              <p>Pas à pas</p>
            </div>
            <div class="textarea-stack">
              <% if (preparationBlocks && preparationBlocks.length) { %> <%
              preparationBlocks.forEach((step, index) => { %>
              <label class="sr-only" for="step-<%= index %>"
                >Étape <%= index + 1 %></label
              >
              <textarea readonly id="step-<%= index %>" class="recipe-textarea">
<%= step %></textarea
              >
              <% }) %> <% } else { %>
              <textarea readonly class="recipe-textarea">
Le détail de cette préparation arrive bientôt.</textarea
              >
              <% } %>
            </div>
          </div>
        </div>

        <!-- RECIPE CTA BUTTONS -->
        <section class="recipe-cta">
          <a class="btn btn--gold" href="/recipes-movie/<%= recipe.id_movie %>">
            Revenir aux recettes du film
          </a>
          <a class="btn btn--red" href="/add-recipes-movies/">
            Je veux créer ma recette
          </a>
        </section>

        <!-- SECTION TITLE FOR REVIEWS -->
        <div class="review-section-header">
          <h2 class="review-section-title">Partage ton expérience</h2>
          <p class="review-section-description">
            Ta voix compte ! Partage ton avis sur cette recette et inspire la
            communauté Ciné Délices.
          </p>
        </div>

        <!-- RECIPE REVIEW BANNER -->
        <section
          id="review-banner"
          class="recipe-review-banner"
          aria-labelledby="review-banner-title"
        >
          <div class="review-banner__content">
            <div class="review-banner__texts">
              <h2 id="review-banner-title">Partage ton moment culte</h2>
              <p class="review-banner__subtitle">
                <span class="subtitle--lead">Inspires la communauté</span>
                <span class="subtitle--brand">Ciné Délices</span>
                <span class="subtitle--lead">
                  : Raconte ce que tu as pensé de la recette
                </span>
                <span class="subtitle--brand">ou</span>
                <span class="subtitle--lead">
                  ton ressenti en dégustant cette recette devant ton film
                  préféré !</span
                >
              </p>
            </div>

            <form
              class="review-banner__form"
              action="#"
              method="post"
              novalidate
            >
              <div class="form-row">
                <label for="review-username" class="sr-only">Ton pseudo</label>
                <input
                  id="review-username"
                  name="username"
                  type="text"
                  class="review-input"
                  placeholder="Ton pseudo"
                  autocomplete="name"
                />

                <fieldset
                  class="review-stars"
                  aria-label="Ta note pour la recette"
                >
                  <legend class="review-stars__label">
                    Ta note pour la recette
                    <span class="review-stars__value">0/5</span> :
                  </legend>
                  <div class="stars-group" role="group" aria-label="Note sur 5">
                    <input type="radio" id="star1" name="rating" value="1" />
                    <label for="star1" aria-label="1 étoile">★</label>
                    <input type="radio" id="star2" name="rating" value="2" />
                    <label for="star2" aria-label="2 étoiles">★</label>
                    <input type="radio" id="star3" name="rating" value="3" />
                    <label for="star3" aria-label="3 étoiles">★</label>
                    <input type="radio" id="star4" name="rating" value="4" />
                    <label for="star4" aria-label="4 étoiles">★</label>
                    <input type="radio" id="star5" name="rating" value="5" />
                    <label for="star5" aria-label="5 étoiles">★</label>
                  </div>
                </fieldset>
              </div>

              <div class="review-actions">
                <label for="review-comment" class="sr-only"
                  >Donne ton avis sur la recette</label
                >
                <textarea
                  id="review-comment"
                  name="comment"
                  class="review-textarea"
                  placeholder="Donne ton avis sur la recette..."
                  rows="3"
                  spellcheck="true" 
                  lang="fr en"
                ></textarea>
                <button type="submit" class="btn btn--gold review-submit">
                  Je donne mon avis
                </button>
              </div>
            </form>
          </div>
          <div class="review-banner__illustration" aria-hidden="true"></div>
        </section>

        <!-- SECTION AVIS DES VISITEURS -->
        <% if (notices && notices.length > 0) { %>
        <section class="reviews-display-section" aria-labelledby="reviews-title">
          <div class="reviews-header">
            <h2 id="reviews-title" class="reviews-title">
              <i class="fa-solid fa-comments"></i>
              Avis des visiteurs
            </h2>
            <p class="reviews-count">
              <%= notices.length %> avis<%= notices.length > 1 ? '' : '' %>
            </p>
          </div>

          <div class="reviews-container">
            <div class="reviews-grid" id="reviewsList">
              <% notices.slice(0, 5).forEach((notice, index) => { %>
              <article class="review-card review-card-<%= index === 0 ? 'large' : index === 1 || index === 4 ? 'medium' : 'small' %>" data-review-index="<%= index %>">
                <div class="review-card-header">
                  <div class="review-user-info">
                    <div class="review-user-avatar">
                      <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="review-user-details">
                      <h3 class="review-user-name">
                        <% if (notice.User) { %>
                          <%= notice.User.first_name %> <%= notice.User.last_name %>
                        <% } else { %>
                          Visiteur anonyme
                        <% } %>
                      </h3>
                      <span class="review-date">
                        <% if (notice.createdAt) { %>
                          <% const date = new Date(notice.createdAt); %>
                          <%= date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                        <% } else { %>
                          Avis récent
                        <% } %>
                      </span>
                    </div>
                  </div>
                  <div class="review-rating">
                    <% for (let i = 1; i <= 5; i++) { %>
                    <span class="review-star <%= i <= notice.quote ? 'active' : '' %>">
                      ★
                    </span>
                    <% } %>
                    <span class="review-rating-value"><%= notice.quote %>/5</span>
                  </div>
                </div>
                <div class="review-card-body">
                  <p class="review-content-main"><%= notice.content %></p>
                </div>
              </article>
              <% }) %>

              <!-- Avis supplémentaires (cachés initialement) -->
              <% if (notices.length > 5) { %>
                <% notices.slice(5).forEach((notice, index) => { %>
                <article class="review-card review-card-hidden review-card-<%= (index + 5) % 3 === 0 ? 'large' : (index + 5) % 3 === 1 ? 'medium' : 'small' %>" data-review-index="<%= index + 5 %>">
                  <div class="review-card-header">
                    <div class="review-user-info">
                      <div class="review-user-avatar">
                        <i class="fa-solid fa-user"></i>
                      </div>
                      <div class="review-user-details">
                        <h3 class="review-user-name">
                          <% if (notice.User) { %>
                            <%= notice.User.first_name %> <%= notice.User.last_name %>
                          <% } else { %>
                            Visiteur anonyme
                          <% } %>
                        </h3>
                        <span class="review-date">
                          <% if (notice.createdAt) { %>
                            <% const date = new Date(notice.createdAt); %>
                            <%= date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                          <% } else { %>
                            Avis récent
                          <% } %>
                        </span>
                      </div>
                    </div>
                    <div class="review-rating">
                      <% for (let i = 1; i <= 5; i++) { %>
                      <span class="review-star <%= i <= notice.quote ? 'active' : '' %>">
                        ★
                      </span>
                      <% } %>
                      <span class="review-rating-value"><%= notice.quote %>/5</span>
                    </div>
                  </div>
                  <div class="review-card-body">
                    <p class="review-content-main"><%= notice.content %></p>
                  </div>
                </article>
                <% }) %>
              <% } %>
            </div>

            <% if (notices.length > 5) { %>
            <button type="button" class="btn btn--gold btn-see-more-reviews" id="seeMoreReviews">
              <i class="fa-solid fa-chevron-down"></i>
              Voir Plus (<%= notices.length - 5 %>)
            </button>
            <% } %>
          </div>
        </section>
        <% } %>
      </section>

      <div class="recipe-lightbox" id="recipe-lightbox" aria-hidden="true">
        <div
          class="recipe-lightbox__backdrop"
          data-lightbox-close
          aria-hidden="true"
        ></div>
        <div class="recipe-lightbox__dialog" role="dialog" aria-modal="true">
          <button
            type="button"
            class="recipe-lightbox__close"
            aria-label="Fermer l'aperçu"
            data-lightbox-close
          >
            &times;
          </button>
          <img
            src=""
            alt="Recette Ciné Délices"
            class="recipe-lightbox__image"
            loading="lazy"
          />
        </div>
      </div>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/burger-menu.js" defer></script>
    <script src="/js/recipe-detail.js" defer></script>
  </body>
</html>
