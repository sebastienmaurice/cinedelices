<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= author.pseudo %> — Auteur sur Ciné Délices · <%= recipesCount %> recette<%= recipesCount > 1 ? 's' : '' %> cinéphiles inspirées du cinéma." />
    <title><%= author.pseudo %> — Page Auteur · Ciné Délices</title>

    <meta property="og:type"        content="profile" />
    <meta property="og:site_name"   content="Ciné Délices" />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:title"       content="<%= author.pseudo %> — Ciné Délices" />
    <meta property="og:description" content="Découvrez les <%= recipesCount %> recette<%= recipesCount > 1 ? 's' : '' %> de <%= author.pseudo %> inspirées du cinéma." />
    <meta property="og:image"       content="<%= siteUrl %><%= author.picture || '/images/image-default-profile.jpg' %>" />
    <meta property="og:url"         content="<%= siteUrl %>/auteur/<%= author.id %>" />
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content="<%= author.pseudo %> — Ciné Délices" />
    <meta name="twitter:description" content="Découvrez les recettes cinéphiles de <%= author.pseudo %>." />
    <link rel="canonical" href="<%= siteUrl %>/auteur/<%= author.id %>" />

    <%- include("partials/head-resources") %>

    <!-- Styles : hero profil + cards recettes + surcharges auteur -->
    <link rel="stylesheet" href="/css/user-profile.css" />
    <link rel="stylesheet" href="/css/recipes-movie.css" />
    <link rel="stylesheet" href="/css/all-recipes.css" />
    <link rel="stylesheet" href="/css/author-page.css" />
    <link rel="stylesheet" href="/css/badge-strange.css" />
    <style>
      /* Titre + temps — identique à recipes-movie.ejs */
      .recipe-card .recipe-card__title-row {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 0.5rem !important;
        margin-bottom: 0.6rem !important;
      }
      .recipe-card .meta-time {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 3px !important;
        margin-left: auto !important;
        font-size: 0.68rem !important;
        color: rgba(232, 232, 232, 0.5) !important;
        white-space: nowrap !important;
      }
      .recipe-card .meta-time svg {
        display: block !important;
        width: 0.7rem !important;
        height: 0.7rem !important;
        flex-shrink: 0 !important;
      }
      /* Overlay hover — contourne le problème Windows hover:none */
      .recipe-card .cd-hover-overlay { display: flex !important; }
      .recipe-card:hover .cd-hover-overlay { opacity: 1 !important; }
      .recipe-card:hover .cd-icon-btn { transform: translateY(0) scale(1) !important; opacity: 1 !important; }
      .recipe-card:hover .cd-icon-btn__ring { border-color: rgba(242,200,75,.9) !important; transform: rotate(60deg) !important; }
      .recipe-card:hover .cd-icon-btn__bg { box-shadow: 0 6px 28px rgba(184,136,42,.65) !important; filter: brightness(1.08) !important; }
      .recipe-card:hover .cd-icon-btn__bg svg { transform: scale(1.15) translateY(-1px) !important; }
      .recipe-card:hover .cd-icon-btn__wrap { animation: cdIconFloat 2.2s ease-in-out infinite !important; }
      .recipe-card:hover .cd-icon-btn__bg::after { animation: cdPulse 1.9s ease-out infinite !important; }
    </style>

  </head>

  <body class="author-page">
    <%- include("partials/header") %>

    <%
      /* Sur la page publique, on n'affiche la bannière que si elle est approuvée par un admin */
      const bannerUrl = (author.banner_status === 'approved' && (author.banner || author.banner_image))
        ? (author.banner || author.banner_image)
        : null;
    %>

    <main id="main-content" data-author-id="<%= author.id %>">

      <!-- ══════════════════════════════════════════
           BREADCRUMB
      ══════════════════════════════════════════ -->
      <div class="bc-bar">
        <nav class="bc" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-cur">Page auteur · <%= author.pseudo %></span>
        </nav>
      </div>

      <!-- ══════════════════════════════════════════
           HERO AUTEUR (même structure que profile-hero)
      ══════════════════════════════════════════ -->
      <section class="profile-hero" aria-labelledby="authorName">

        <!-- Bannière -->
        <div class="hero-banner">
          <% if (bannerUrl) { %>
          <img src="<%= bannerUrl %>" alt="Bannière de <%= author.pseudo %>" />
          <% } %>
          <div class="hero-banner-grad"></div>
        </div>

        <!-- Déco cinématographique -->
        <div class="hero-reel hero-reel--1" aria-hidden="true"></div>
        <div class="hero-reel hero-reel--2" aria-hidden="true"></div>
        <div class="hero-scanlines" aria-hidden="true"></div>
        <div class="hero-vignette" aria-hidden="true"></div>

        <!-- Modifier la bannière (propriétaire uniquement) -->
        <% if (isOwner) { %>
        <div class="hero-banner-status">
          <% if (author.banner_status === 'pending') { %>
            <span class="banner-btn banner-btn--pending"><span class="b-dot"></span>Bannière en attente</span>
          <% } else if (author.banner_status === 'rejected') { %>
            <span class="banner-btn banner-btn--rejected"><span class="b-dot"></span>Bannière refusée</span>
          <% } else { %>
            <button class="banner-btn banner-btn--upload" type="button" id="authorBannerBtn">
              <i data-lucide="upload" width="10" height="10" aria-hidden="true"></i>
              Modifier la bannière
            </button>
          <% } %>
        </div>
        <input id="authorBannerInput" type="file" name="banner" accept="image/*" hidden />
        <% } %>

        <!-- Contenu hero bas -->
        <div class="hero-content">
          <div class="hero-row">

          <!-- Avatar badge + cadre gamification -->
          <div class="avatar-block">
            <% if (typeof userActiveFrameId !== 'undefined' && userActiveFrameId === 'strange') { %>
            <!-- Dr Strange — badge CSS animé -->
            <div class="profile-badge-hero profile-badge-hero--css-only"
                 id="authorBadgeHero"
                 data-frame-code="strange"
                 data-photo-src="<%= author.picture || '/images/image-default-profile.jpg' %>">
              <%- include('partials/badge-strange-avatar', {
                photoSrc: author.picture || '/images/image-default-profile.jpg',
                photoAlt: 'Avatar de ' + author.pseudo
              }) %>
            </div>
            <% } else { %>
            <!-- Standard — photo + cadre PNG (BadgeEngine si animé) -->
            <div class="profile-badge-hero"
                 id="authorBadgeHero"
                 data-frame-code="<%= typeof userActiveFrameId !== 'undefined' ? userActiveFrameId : 'cine' %>"
                 data-photo-src="<%= author.picture || '/images/image-default-profile.jpg' %>">

              <img
                class="pbh-photo"
                src="<%= author.picture || '/images/image-default-profile.jpg' %>"
                alt="Avatar de <%= author.pseudo %>"
              />
              <% if (typeof userActiveFrame !== 'undefined' && userActiveFrame) { %>
              <img class="pbh-frame" src="<%= userActiveFrame %>" alt="" aria-hidden="true" />
              <% } else { %>
              <div class="pbh-ring"></div>
              <% } %>
            </div>
            <% } %>
          </div>

          <!-- Identité -->
          <div class="hero-identity">

            <!-- Badge rang / niveau -->
            <% if (isAdminAuthor) { %>
            <div class="hero-rank-badge hero-rank-badge--official gamification-badge gamification-badge--official">
              <i data-lucide="star" width="12" height="12" fill="currentColor" stroke="currentColor" aria-hidden="true"></i>
              Ciné Délices
            </div>
            <% } else { %>
            <div class="hero-rank-badge gamification-badge gamification-badge--rank">
              <i data-lucide="star" width="12" height="12" fill="currentColor" stroke="currentColor" aria-hidden="true"></i>
              Niveau <%= userLevel %>
            </div>
            <% } %>

            <!-- Pseudo : dernier mot en doré (style page-hero__title movies) -->
            <%
              const _pp    = author.pseudo.trim().split(' ');
              const _pLast = _pp.pop();
              const _pRest = _pp.join(' ');
            %>
            <h1 class="hero-pseudo hero-pseudo--static" id="authorName"><% if (_pRest) { %><%= _pRest %> <% } %><em><%= _pLast %></em></h1>

            <!-- Titre rang -->
            <p class="hero-rank-title"><%= isAdminAuthor ? 'Équipe Ciné Délices' : userRank %></p>

            <!-- Stats -->
            <div class="hero-stats-row">
              <div class="h-stat">
                <span class="h-stat__num"><%= recipesCount %></span>
                <span class="h-stat__lbl">Recettes</span>
              </div>
              <% if (!isAdminAuthor) { %>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userXP %></span>
                <span class="h-stat__lbl">XP</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userLevel %></span>
                <span class="h-stat__lbl">Niveau</span>
              </div>
              <% } %>
              <% if (typeof userFrames !== 'undefined' && userFrames.length > 0) { %>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat h-stat--frames">
                <div class="h-frames-row">
                  <% userFrames.forEach(function(f) { %>
                  <% if (f.unlocked) { %>
                  <span
                    class="h-frame-pill<%= f.isActive ? ' h-frame-pill--active' : '' %>"
                    title="<%= f.label %>"
                    data-code="<%= f.code %>"
                    <% if (f.thumbUrl) { %>style="background-image:url('<%= f.thumbUrl %>')"<% } %>
                  ><% if (!f.thumbUrl) { %><%= f.icon %><% } %></span>
                  <% } else { %>
                  <span
                    class="h-frame-pill h-frame-pill--locked"
                    title="<%= f.label %> · Niveau <%= f.minLvl %> requis"
                    data-code="<%= f.code %>"
                    <% if (f.thumbUrl) { %>style="background-image:url('<%= f.thumbUrl %>')"<% } %>
                  ><% if (!f.thumbUrl) { %><%= f.icon %><% } %></span>
                  <% } %>
                  <% }) %>
                </div>
                <span class="h-stat__lbl">Cadres de contribution</span>
              </div>
              <% } %>
            </div>

            <!-- Barre XP -->
            <% if (!isAdminAuthor) { %>
            <div class="hero-xp">
              <div class="hero-xp__header">
                <span class="hero-xp__lbl">Progression</span>
                <span class="hero-xp__val"><%= userXP %> XP</span>
              </div>
              <div class="hero-xp__track">
                <div class="hero-xp__fill" data-pct="<%= xpPct %>" style="width:0"></div>
              </div>
              <span class="hero-xp__remain">
                <% if (xpNeeded > 0) { %>
                  <%= xpNeeded %> XP jusqu'au prochain niveau
                <% } else { %>
                  Niveau maximum atteint
                <% } %>
              </span>
            </div>
            <% } %>

          </div>
          </div><!-- /.hero-row -->
        </div>
      </section>

      <!-- ══════════════════════════════════════════
           SECTION RECETTES
      ══════════════════════════════════════════ -->
      <section class="author-recipes-section" aria-labelledby="authorRecipesTitle">

        <%
          /* Films et catégories uniques pour les quick-tags */
          const _filmMap  = new Map();
          recipes.forEach(r => {
            if (r.Movie && r.Movie.title && !_filmMap.has(r.Movie.title))
              _filmMap.set(r.Movie.title, r.Movie.slug || r.Movie.id);
          });
          const _uniqueMovies = [..._filmMap.entries()].map(([title, slug]) => ({ title, slug }));
          const _uniqueCats   = [...new Set(
            recipes.filter(r => r.category).map(r => r.category.toLowerCase())
          )];
        %>

        <!-- ── Toolbar (style films-toolbar /movies) ── -->
        <div class="author-films-toolbar">
          <div class="tb-left">
            <div class="tb-label">Créations de <%= author.pseudo %></div>
            <h2 class="tb-title" id="authorRecipesTitle">SES RECETTES</h2>
          </div>

          <% if (_uniqueMovies.length > 0 || _uniqueCats.length > 0) { %>
          <div class="tb-right">
            <span class="af-label">
              <i data-lucide="filter" width="13" height="13" aria-hidden="true"></i>
              Filtrer
            </span>

            <% if (_uniqueMovies.length > 0) { %>
            <div class="dd-filter-wrap" id="ddFilmWrap">
              <button class="dropdown-trigger" id="ddFilmTrigger" type="button" aria-haspopup="true" aria-expanded="false">
                <i data-lucide="film" aria-hidden="true"></i>
                <span id="ddFilmLabel">Tous les films</span>
                <span class="dt-arrow">▾</span>
              </button>
              <div class="dropdown dropdown--films dropdown--filtres" id="ddFilmPanel" aria-hidden="true">
                <div class="dropdown__header"></div>
                <div class="dropdown__cat">Films</div>
                <button class="dropdown__item dropdown__item--active" type="button" data-filter="film" data-value="all">
                  <span class="dropdown__icon"><i data-lucide="film" aria-hidden="true"></i></span>
                  Tous les films
                </button>
                <% _uniqueMovies.forEach(m => { %>
                <button class="dropdown__item" type="button" data-filter="film" data-value="<%= m.title.toLowerCase() %>">
                  <span class="dropdown__icon"><i data-lucide="video" aria-hidden="true"></i></span>
                  <%= m.title %>
                </button>
                <% }) %>
              </div>
            </div>
            <% } %>

            <% if (_uniqueCats.length > 0) { %>
            <div class="dd-filter-wrap" id="ddCatWrap">
              <button class="dropdown-trigger" id="ddCatTrigger" type="button" aria-haspopup="true" aria-expanded="false">
                <i data-lucide="utensils" aria-hidden="true"></i>
                <span id="ddCatLabel">Toutes les catégories</span>
                <span class="dt-arrow">▾</span>
              </button>
              <div class="dropdown dropdown--recettes dropdown--filtres" id="ddCatPanel" aria-hidden="true">
                <div class="dropdown__header"></div>
                <div class="dropdown__cat">Type de plat</div>
                <button class="dropdown__item dropdown__item--active" type="button" data-filter="cat" data-value="all">Toutes les catégories</button>
                <% _uniqueCats.forEach(cat => { %>
                <button class="dropdown__item" type="button" data-filter="cat" data-value="<%= cat %>">
                  <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
                </button>
                <% }) %>
              </div>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>

        <!-- Grille de recettes + CTA -->
        <div class="ar-grid-wrap">

          <% if (!recipes || recipes.length === 0) { %>
          <p class="author-no-recipes">Aucune recette publiée pour le moment.</p>
          <% } else { %>

          <div id="recipes__list" class="recipes-grid only__display__9__recipes">
            <% recipes.forEach(recipe => { %>
            <%
              const apContrib  = recipe.contributor;
              const apIsStaff  = apContrib && (apContrib.role === 'admin' || apContrib.role === 'superadmin');
              const movieTitle = recipe.Movie ? recipe.Movie.title : null;
              const movieSlug  = recipe.Movie ? (recipe.Movie.slug || recipe.Movie.id) : null;
            %>
            <article class="recipe-card"
              data-film="<%= movieTitle ? movieTitle.toLowerCase() : '' %>"
              data-cat="<%= (recipe.category || '').toLowerCase() %>">
              <!-- Stretched link -->
              <a href="/recipes-movie/details/<%= recipe.slug || recipe.id %>" class="recipe-card__link" aria-label="Voir la recette <%= recipe.name %>"></a>

              <!-- Image 3:2 -->
              <div class="recipe-card__img">
                <img
                  src="<%= recipe.picture || '/images/image-default-recipe-1.jpg' %>"
                  alt="<%= recipe.name %>"
                  loading="lazy"
                  decoding="async"
                />
                <!-- Overlay hover doré — centré sur l'image -->
                <div class="cd-hover-overlay">
                  <div class="cd-icon-btn">
                    <div class="cd-icon-btn__wrap">
                      <span class="cd-icon-btn__ring"></span>
                      <span class="cd-icon-btn__bg">
                        <i data-lucide="utensils" width="18" height="18" aria-hidden="true"></i>
                      </span>
                    </div>
                    <span class="cd-icon-btn__label">Voir la recette</span>
                  </div>
                </div>
                <!-- Overlay top : catégorie + difficulté + NEW -->
                <div class="recipe-card__ot">
                  <div class="recipe-card__ot-badges">
                    <span class="tag tag--recette-cat"><%= recipe.category %></span>
                    <span class="tag <%= !recipe.difficulty ? 'tag--gris' : recipe.difficulty.toLowerCase().includes('facile') ? 'tag--recette-facile' : recipe.difficulty.toLowerCase().includes('difficile') ? 'tag--recette-difficile' : 'tag--recette-moyen' %>"><%= recipe.difficulty || 'N/A' %></span>
                    <% if (recipe.isNew) { %><span class="badge-new badge-new--new recipe-badge-new">NEW</span><% } %>
                  </div>
                </div>
                <!-- Badge film bas-gauche -->
                <% if (movieTitle) { %>
                <div class="recipe-card__ob">
                  <span class="badge badge--film-dk">
                    <i data-lucide="film" class="icon" aria-hidden="true"></i>
                    <%= movieTitle.length > 22 ? movieTitle.slice(0, 22) + '…' : movieTitle %>
                  </span>
                </div>
                <% } %>
              </div>

              <!-- Corps -->
              <div class="recipe-card__body">
                <!-- Titre (gauche) + Temps (droite) -->
                <div class="recipe-card__title-row">
                  <h3 class="recipe-ttl"><%= recipe.name %></h3>
                  <span class="meta-time">
                    <i data-lucide="clock" class="meta-time__icon" width="13" height="13" aria-hidden="true"></i><%= recipe.time %> min
                  </span>
                </div>
                <!-- Étoiles + valeur -->
                <div class="rating rating--sm" data-entity-id="<%= recipe.id %>" data-entity-type="recipe" data-average="<%= recipe.avgRating || '0' %>">
                  <% for (let i = 1; i <= 5; i++) { %>
                  <span class="rating__star <%= i <= Math.round(parseFloat(recipe.avgRating || 0)) ? 'rating__star--filled' : '' %>">
                    <i data-lucide="star" class="icon" fill="currentColor" stroke="currentColor" aria-hidden="true"></i>
                  </span>
                  <% } %>
                  <span class="rating__value"><%= recipe.avgRating || '0' %></span>
                </div>
                <!-- Description courte -->
                <p class="recipe-card__desc"><%= (recipe.description || '').length > 80 ? recipe.description.substring(0, 80) + '...' : (recipe.description || 'Découvrez cette délicieuse recette inspirée du cinéma...') %></p>
              </div>

              <!-- Séparateur doré bas de card -->
              <div class="recipe-card__glow-sep"></div>

              <!-- Footer -->
              <div class="recipe-card__foot">
                <% if (apContrib && apContrib.id) { %>
                <a href="/auteur/<%= apContrib.id %>" class="contrib recipe-card-contrib-link <%= apIsStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                <% } else { %>
                <div class="contrib <%= apIsStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                <% } %>
                  <div class="contrib__av"><img src="<%= apContrib && apContrib.picture ? apContrib.picture : (author.picture || '/images/image-default-profile.jpg') %>" alt="<%= apContrib ? apContrib.pseudo : author.pseudo %>" loading="lazy"></div>
                  <div class="contrib__info">
                    <span class="contrib__pseudo"><%= apContrib ? apContrib.pseudo : author.pseudo %></span>
                    <span class="contrib__pill <%= apIsStaff ? 'contrib__pill--admin' : 'contrib__pill--membre' %>"><span class="contrib__pill-dot"></span><%= apIsStaff ? 'Ciné Délices' : 'Membre' %></span>
                  </div>
                <% if (apContrib && apContrib.id) { %></a><% } else { %></div><% } %>
                <button
                  class="btn-fav"
                  data-entity-id="<%= recipe.id %>"
                  data-entity-type="recipe"
                  data-is-favorite="<%= recipe.isFavorite || false %>"
                  aria-label="<%= recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                >
                  <i data-lucide="heart" class="icon" fill="<%= recipe.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></i>
                </button>
              </div>
            </article>
            <% }) %>
          </div><!-- /#recipes__list -->

          <% if (recipes && recipes.length > 9) { %>
          <div class="center-button">
            <button id="see__all__recipes__button" class="btn btn--red" aria-label="Voir plus de recettes">
              <span class="btn__shimmer"></span>
              <i data-lucide="lightbulb" class="icon" aria-hidden="true"></i>
              <span class="btn__text">Voir plus</span>
            </button>
          </div>
          <% } %>

          <% } %>

        </div><!-- /.ar-grid-wrap -->

      </section>

      <!-- CTA — Proposer un film -->
      <% if (ctaMovies && ctaMovies.length > 0) { %>
      <%
        const ctaMoviesRev = ctaMovies.slice().reverse();
      %>
      <div class="author-cta-wrap">
        <article class="fcard fcard--cta movies-cta" aria-label="Proposer votre film culte à Ciné Délices">
          <a href="/add-recipes-movies/" class="fcard--cta__link">
            <div class="fcard--cta__shimmer" aria-hidden="true"></div>
            <div class="fcard--cta__body">
              <p class="fcard--cta__eyebrow">
                <i data-lucide="film" width="11" height="11" stroke-width="2.5" aria-hidden="true"></i>
                Communauté · Ciné Délices
              </p>
              <h2 class="fcard--cta__title">VOTRE FILM<em>MÉRITE UNE RECETTE.</em></h2>
              <p class="fcard--cta__desc">Proposez un film culte et créez la recette qui va avec — rejoignez des cinéphiles gourmands.</p>
              <span class="fcard--cta__action">
                <i data-lucide="plus" width="13" height="13" stroke-width="3" aria-hidden="true"></i>
                Proposer un film
              </span>
            </div>
            <div class="fcard--cta__deco" aria-hidden="true">
              <div class="fcard--cta__poster-row fcard--cta__poster-row--left">
                <div class="fcard--cta__poster-track">
                  <% ctaMovies.forEach(m => { %><div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div><% }) %>
                  <% ctaMovies.forEach(m => { %><div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div><% }) %>
                </div>
              </div>
              <div class="fcard--cta__poster-row fcard--cta__poster-row--right">
                <div class="fcard--cta__poster-track">
                  <% ctaMoviesRev.forEach(m => { %><div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div><% }) %>
                  <% ctaMoviesRev.forEach(m => { %><div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div><% }) %>
                </div>
              </div>
            </div>
          </a>
        </article>
      </div>
      <% } %>

    </main>

    <%- include("partials/footer") %>

    <!-- Scripts globaux -->

    <!-- Badge gamification -->
    <script src="/js/gamification-sherlock.js" defer></script>
    <script src="/js/gamification-engine.js" defer></script>

    <!-- Init canvas hero auteur (équivalent de gamification.js pour profileBadgeHero) -->
    <script>
      (function () {
        const ANIMATED = ['sherlock', 'matrix', 'indiana', 'harry', 'cine'];
        function initAuthorHero() {
          const heroEl = document.getElementById('authorBadgeHero');
          if (!heroEl || typeof window.BadgeEngine === 'undefined') return;
          const frameCode = heroEl.dataset.frameCode || 'cine';
          if (!ANIMATED.includes(frameCode)) return;
          const photoSrc = heroEl.dataset.photoSrc || '';
          heroEl.querySelector('#pbhPhoto')?.remove();
          heroEl.querySelector('.pbh-frame')?.remove();
          heroEl.querySelector('.pbh-ring')?.remove();
          const inner = document.createElement('div');
          inner.style.cssText = 'position:absolute;inset:0;width:260px;height:260px;overflow:visible;';
          heroEl.insertBefore(inner, null);
          heroEl._badgeEngine = new window.BadgeEngine(inner, frameCode, photoSrc);
        }
        // gamification-engine.js est defer — on attend qu'il soit prêt
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAuthorHero);
        } else {
          initAuthorHero();
        }
      })();
    </script>

    <!-- Favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>
    <script src="/js/recipe-card-click.js" defer></script>

    <!-- Filtrage dropdowns : film + catégorie combinés -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        let activeFilm = 'all';
        let activeCat  = 'all';
        const countEl  = document.getElementById('afCount');

        /* ── Logique de filtrage ── */
        function applyFilters() {
          const cards = document.querySelectorAll('#recipes__list .recipe-card');
          let visible = 0;
          cards.forEach(function (card) {
            const filmOk = activeFilm === 'all' || (card.dataset.film || '') === activeFilm;
            const catOk  = activeCat  === 'all' || (card.dataset.cat  || '') === activeCat;
            const show   = filmOk && catOk;
            card.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          if (countEl) countEl.textContent = visible + (visible > 1 ? ' recettes' : ' recette');
        }

        /* ── Helper : ouvrir/fermer un dd-filter-wrap ── */
        function initFilterDropdown(wrapperId, triggerId, panelId, labelId) {
          const wrap    = document.getElementById(wrapperId);
          const trigger = document.getElementById(triggerId);
          const panel   = document.getElementById(panelId);
          const labelEl = document.getElementById(labelId);
          if (!wrap || !trigger || !panel) return;

          function open()  { wrap.classList.add('is-open'); trigger.classList.add('is-open'); trigger.setAttribute('aria-expanded','true'); panel.setAttribute('aria-hidden','false'); }
          function close() { wrap.classList.remove('is-open'); trigger.classList.remove('is-open'); trigger.setAttribute('aria-expanded','false'); panel.setAttribute('aria-hidden','true'); }
          function toggle(){ wrap.classList.contains('is-open') ? close() : open(); }

          trigger.addEventListener('click', function(e){ e.stopPropagation(); toggle(); });

          panel.querySelectorAll('.dropdown__item[data-value]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              const filter = btn.dataset.filter;
              const value  = btn.dataset.value;
              if (filter === 'film') activeFilm = value;
              else activeCat = value;

              /* maj label trigger */
              if (labelEl) labelEl.textContent = btn.textContent.trim();

              /* maj état actif */
              panel.querySelectorAll('.dropdown__item').forEach(function(b){ b.classList.remove('dropdown__item--active'); });
              btn.classList.add('dropdown__item--active');

              close();
              applyFilters();
            });
          });

          /* fermeture au clic extérieur */
          document.addEventListener('click', function(e){ if (!wrap.contains(e.target)) close(); });
          document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });
        }

        initFilterDropdown('ddFilmWrap', 'ddFilmTrigger', 'ddFilmPanel', 'ddFilmLabel');
        initFilterDropdown('ddCatWrap',  'ddCatTrigger',  'ddCatPanel',  'ddCatLabel');
      });
    </script>

    <!-- XP bar animation -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const fill = document.querySelector('.hero-xp__fill');
        if (fill) {
          const pct = parseInt(fill.dataset.pct) || 0;
          setTimeout(function () { fill.style.width = pct + '%'; }, 400);
        }
      });
    </script>

    <!-- Init BadgeEngine sur le hero auteur -->
    <script>
      window.addEventListener('load', function () {
        const hero = document.getElementById('authorBadgeHero');
        if (!hero || typeof window.BadgeEngine === 'undefined') return;
        const frameCode = hero.dataset.frameCode || 'cine';
        const photoSrc  = hero.dataset.photoSrc  || '/images/image-default-profile.jpg';
        const ANIMATED  = ['sherlock', 'matrix', 'indiana', 'harry'];
        if (!ANIMATED.includes(frameCode)) return;
        hero.querySelector('.pbh-photo')?.remove();
        hero.querySelector('.pbh-frame')?.remove();
        hero.querySelector('.pbh-ring')?.remove();
        const inner = document.createElement('div');
        inner.style.cssText = 'position:absolute;inset:0;width:260px;height:260px;overflow:visible;';
        hero.appendChild(inner);
        new window.BadgeEngine(inner, frameCode, photoSrc);
      });
    </script>

    <% if (isOwner) { %>
    <!-- Upload bannière (propriétaire) -->
    <script>
      (function () {
        const btn   = document.getElementById('authorBannerBtn');
        const input = document.getElementById('authorBannerInput');
        const authorId = '<%= author.id %>';

        if (!btn || !input) return;

        btn.addEventListener('click', function () { input.click(); });

        input.addEventListener('change', async function () {
          const file = input.files[0];
          if (!file) return;
          if (!file.type.startsWith('image/')) {
            alert('Veuillez sélectionner une image.');
            return;
          }

          btn.disabled = true;
          btn.textContent = 'Envoi en cours…';

          const formData = new FormData();
          formData.append('banner', file);

          try {
            const res  = await fetch('/auth/profil/' + authorId + '/banner', { method: 'POST', body: formData });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.message || 'Erreur upload.');

            // Prévisualisation immédiate
            const bannerImg = document.querySelector('.hero-banner img');
            if (bannerImg) {
              bannerImg.src = data.banner_image;
            } else {
              const heroDiv = document.querySelector('.hero-banner');
              if (heroDiv) {
                const img = document.createElement('img');
                img.src = data.banner_image;
                img.alt = 'Bannière';
                heroDiv.prepend(img);
              }
            }

            // Remplacer le bouton par le badge "en attente"
            const wrap = btn.closest('.hero-banner-status');
            if (wrap) {
              wrap.innerHTML = '<span class="banner-btn banner-btn--pending"><span class="b-dot"></span>Bannière en attente</span>';
            }
          } catch (err) {
            alert('Erreur : ' + err.message);
            btn.disabled = false;
            btn.textContent = 'Modifier la bannière';
          }

          input.value = '';
        });
      })();
    </script>
    <% } %>

  </body>
</html>
