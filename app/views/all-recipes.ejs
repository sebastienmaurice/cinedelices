<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Toutes les recettes inspirées du cinéma, à découvrir et à cuisiner" />
    <title>Recettes — Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>
    <!-- SEO — Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Ciné Délices" />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:title"       content="Toutes les recettes — Ciné Délices" />
    <meta property="og:description" content="Toutes les recettes inspirées du cinéma. Filtrez par genre, difficulté, durée et cuisinez comme au ciné !" />
    <meta property="og:image"       content="<%= siteUrl %>/images/image-default-recipe-1.jpg" />
    <meta property="og:url"         content="<%= siteUrl %>/recipes" />
    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="Toutes les recettes — Ciné Délices" />
    <meta name="twitter:description" content="Toutes les recettes inspirées du cinéma. Filtrez par genre, difficulté, durée et cuisinez comme au ciné !" />
    <meta name="twitter:image"       content="<%= siteUrl %>/images/image-default-recipe-1.jpg" />
    <!-- Canonical -->
    <link rel="canonical" href="<%= siteUrl %>/recipes" />

    <!-- styles -->
    <link rel="stylesheet" href="/css/movies.css" />
    <link rel="stylesheet" href="/css/recipes-movie.css" />
    <link rel="stylesheet" href="/css/all-recipes.css" />

    <!-- scripts -->
    <script src="/js/more-views.js" defer></script>
  </head>

  <body class="all-recipes-page">
    <%- include("partials/header") %>

    <main>

      <!-- ╔╔ HERO — identique à movies.ejs ╔╔ -->
      <section class="page-hero" aria-labelledby="arTitle">
        <div class="page-hero__deco" aria-hidden="true">
          <div class="page-hero__bg"></div>
          <div class="page-hero__reel page-hero__reel--1"></div>
          <div class="page-hero__reel page-hero__reel--2"></div>
          <div class="page-hero__scanlines"></div>
          <div class="page-hero__vignette"></div>
        </div>
        <div class="page-hero__content">

          <!-- Colonne gauche : titre, stats, filtres catégorie -->
          <div class="page-hero__left">
            <p class="page-hero__eyebrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
              Recettes Ciné Délices
            </p>
            <h1 class="page-hero__title" id="arTitle">LES <em>RECETTES</em></h1>
            <p class="page-hero__sub">Toutes les recettes inspirées du cinéma, à cuisiner chez vous</p>

            <!-- Stats + filtres catégorie -->
            <div class="page-hero__meta-row">
              <div class="page-hero__stats" aria-label="Statistiques des recettes">
                <div class="hero-stat">
                  <span class="hero-stat__num"><%= totalCount %></span>
                  <span class="hero-stat__label">Recettes</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                  <span class="hero-stat__num"><%= movieCount %></span>
                  <span class="hero-stat__label">Films représentés</span>
                </div>
              </div>
              <div class="quick-tags-row">
                <span class="qt-label">Catégorie :</span>
                <a href="/recipes-movie/" class="qtag qtag-or <%= categoryFilter === 'all' ? 'active' : '' %>">Toutes</a>
                <a href="/recipes-movie/?category=entr%C3%A9e" class="qtag qtag-vert <%= categoryFilter === 'entrée' ? 'active' : '' %>">Entrée</a>
                <a href="/recipes-movie/?category=plat" class="qtag qtag-bleu <%= categoryFilter === 'plat' ? 'active' : '' %>">Plat</a>
                <a href="/recipes-movie/?category=dessert" class="qtag qtag-rouge <%= categoryFilter === 'dessert' ? 'active' : '' %>">Dessert</a>
              </div>
            </div>
          </div>

          <!-- Colonne droite : recherche simplifiée -->
          <div class="page-hero__search-col" aria-label="Recherche de recettes">
            <p class="page-hero__search-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              Trouver une recette
            </p>
            <form class="search-main-row" action="/recipes-movie/" method="GET" role="search">
              <% if (categoryFilter !== 'all') { %>
              <input type="hidden" name="category" value="<%= categoryFilter %>" />
              <% } %>
              <div class="search-input-wrap">
                <input
                  type="text"
                  id="ar-search-input"
                  name="q"
                  class="search__input__film"
                  placeholder="Rechercher une recette..."
                  value="<%= searchQuery %>"
                  autocomplete="off"
                  aria-label="Rechercher une recette"
                />
              </div>
              <button type="submit" class="btn-search-boost" aria-label="Lancer la recherche">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              </button>
            </form>
            <% if (searchQuery) { %>
            <p class="ar-search-info">Résultats pour « <strong><%= searchQuery %></strong> » — <a href="/recipes-movie/<%= categoryFilter !== 'all' ? '?category=' + encodeURIComponent(categoryFilter) : '' %>">Effacer</a></p>
            <% } %>
          </div>

        </div>
      </section>

      <!-- ╔╔ SECTION RECETTES ╔╔ -->
      <section class="ar-section">

        <!-- Toolbar — identique à la page /movies -->
        <div class="films-toolbar">
          <div class="tb-left">
            <div class="tb-label">Cuisine du cinéma</div>
            <h2 class="tb-title">
              <% if (searchQuery) { %>
                RÉSULTATS POUR « <%= searchQuery.toUpperCase() %> »
              <% } else if (categoryFilter !== 'all') { %>
                RECETTES — <%= categoryFilter.toUpperCase() %>
              <% } else { %>
                TOUTES NOS RECETTES
              <% } %>
            </h2>
          </div>
          <div class="toolbar-right">
            <!-- Sélecteur de tri — dropdown custom -->
            <div class="dd-filter-wrap" id="ddSortWrap">
              <button class="dropdown-trigger" id="ddSortTrigger" type="button" aria-haspopup="true" aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
                <span id="ddSortLabel"><%=
                  sortBy === 'oldest'   ? 'Plus anciennes' :
                  sortBy === 'duration' ? 'Durée (+ rapide)' :
                  sortBy === 'rating'   ? 'Mieux notées' :
                  'Plus récentes'
                %></span>
                <span class="dt-arrow">▾</span>
              </button>
              <div class="dropdown dropdown--filtres" id="ddSortPanel" aria-hidden="true">
                <div class="dropdown__header"></div>
                <button class="dropdown__item<%= sortBy === 'recent'   ? ' dropdown__item--active' : '' %>" type="button" data-sort="recent">Plus récentes</button>
                <button class="dropdown__item<%= sortBy === 'oldest'   ? ' dropdown__item--active' : '' %>" type="button" data-sort="oldest">Plus anciennes</button>
                <button class="dropdown__item<%= sortBy === 'duration' ? ' dropdown__item--active' : '' %>" type="button" data-sort="duration">Durée (+ rapide)</button>
                <button class="dropdown__item<%= sortBy === 'rating'   ? ' dropdown__item--active' : '' %>" type="button" data-sort="rating">Mieux notées</button>
              </div>
            </div>
            <a class="btn btn--primary btn--sm" href="/movies">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
              Voir les films
            </a>
          </div>
        </div>

        <!-- Grille + CTA -->
        <div class="ar-grid-wrap">

          <% if (!recipes || recipes.length === 0) { %>
          <p class="ar-empty">Aucune recette trouvée<% if (searchQuery) { %> pour « <%= searchQuery %> »<% } %>.</p>
          <% } else { %>

          <div id="recipes__list" class="recipes-grid only__display__9__recipes">
            <% recipes.forEach(recipe => { %>
            <%
              const arContrib = recipe.contributor;
              const arIsStaff = arContrib && (arContrib.role === 'admin' || arContrib.role === 'superadmin');
              const movieTitle = recipe.Movie ? recipe.Movie.title : null;
              const movieSlug = recipe.Movie ? (recipe.Movie.slug || recipe.Movie.id) : null;
            %>
            <%
              const arDisplayRating = recipe.avgRating || '0';
              const arDesc = recipe.description || recipe.anecdote || '';
              const arTruncDesc = arDesc.length > 80 ? arDesc.substring(0, 80) + '...' : arDesc;
              const arCardImg = (recipe.RecipePictures && recipe.RecipePictures[0]) ? recipe.RecipePictures[0].file_path : (recipe.picture || '/images/image-default-recipe-1.jpg');
            %>
            <article class="recipe-card">
              <!-- Stretched link -->
              <a href="/recipes-movie/details/<%= recipe.slug || recipe.id %>" class="recipe-card__link" aria-label="Voir la recette <%= recipe.name %>"></a>

              <!-- Image 3:2 -->
              <div class="recipe-card__img">
                <img src="<%= arCardImg %>" alt="<%= recipe.name %>" loading="lazy" decoding="async" />
                <!-- Overlay hover doré -->
                <div class="cd-hover-overlay">
                  <div class="cd-icon-btn">
                    <div class="cd-icon-btn__wrap">
                      <span class="cd-icon-btn__ring"></span>
                      <span class="cd-icon-btn__bg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                      </span>
                    </div>
                    <span class="cd-icon-btn__label">Voir la recette</span>
                  </div>
                </div>
                <!-- Badges top -->
                <div class="recipe-card__ot">
                  <div class="recipe-card__ot-badges">
                    <span class="badge badge--type-b"><%= recipe.category %></span>
                    <span class="tag <%= !recipe.difficulty ? 'tag--gris' : recipe.difficulty.toLowerCase().includes('facile') ? 'tag--recette-facile' : recipe.difficulty.toLowerCase().includes('difficile') ? 'tag--recette-difficile' : 'tag--recette-moyen' %>"><%= recipe.difficulty || 'N/A' %></span>
                    <% if (recipe.isNew) { %><span class="badge-new badge-new--new recipe-badge-new">NEW</span><% } %>
                  </div>
                </div>
                <!-- Badge film bas-gauche — lien vers la page du film -->
                <% if (movieTitle) { %>
                <div class="recipe-card__ob">
                  <a class="badge badge--film-dk" href="/recipes-movie/<%= movieSlug %>" style="pointer-events:auto;position:relative;z-index:2;">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                    <%= movieTitle.length > 22 ? movieTitle.slice(0, 22) + '…' : movieTitle %>
                  </a>
                </div>
                <% } %>
              </div>

              <!-- Corps -->
              <div class="recipe-card__body">
                <div class="recipe-card__title-row">
                  <h3 class="recipe-ttl"><%= recipe.name %></h3>
                  <span class="meta-time">
                    <svg class="meta-time__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><%= recipe.time %> min
                  </span>
                </div>
                <div class="rating rating--sm" data-entity-id="<%= recipe.id %>" data-entity-type="recipe" data-average="<%= arDisplayRating %>">
                  <% for (let i = 1; i <= 5; i++) { %>
                  <span class="rating__star <%= i <= Math.round(parseFloat(arDisplayRating)) ? 'rating__star--filled' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </span>
                  <% } %>
                  <span class="rating__value"><%= arDisplayRating %></span>
                </div>
                <p class="recipe-card__desc"><%= arTruncDesc || 'Découvrez cette délicieuse recette inspirée du cinéma...' %></p>
              </div>

              <!-- Séparateur doré bas de card -->
              <div class="recipe-card__glow-sep"></div>

              <!-- Footer -->
              <div class="recipe-card__foot">
                <% if (arContrib && arContrib.id) { %>
                <a href="/auteur/<%= arContrib.id %>" class="contrib recipe-card-contrib-link <%= arIsStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                <% } else { %>
                <div class="contrib <%= arIsStaff ? 'contrib--admin' : 'contrib--membre' %> contrib--sm">
                <% } %>
                  <div class="contrib__av"><img src="<%= arContrib && arContrib.picture ? arContrib.picture : '/images/image-default-profile.jpg' %>" alt="<%= arContrib ? arContrib.pseudo : 'Chef' %>" loading="lazy"></div>
                  <div class="contrib__info">
                    <span class="contrib__pseudo"><%= arContrib ? arContrib.pseudo : '—' %></span>
                    <span class="contrib__pill <%= arIsStaff ? 'contrib__pill--admin' : 'contrib__pill--membre' %>"><span class="contrib__pill-dot"></span><%= arIsStaff ? 'Ciné Délices' : 'Membre' %></span>
                  </div>
                <% if (arContrib && arContrib.id) { %></a><% } else { %></div><% } %>
                <button
                  class="btn-fav"
                  data-entity-id="<%= recipe.id %>"
                  data-entity-type="recipe"
                  data-is-favorite="<%= recipe.isFavorite || false %>"
                  aria-label="<%= recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                  title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (recipe.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
                >
                  <svg class="icon" viewBox="0 0 24 24" fill="<%= recipe.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                </button>
              </div>
            </article>
            <% }) %>
          </div><!-- /#recipes__list -->

          <!-- FCARD CTA : partager une recette — full-width banner -->
          <%
            const ctaRecipes = recipes.filter(r => r.picture).slice(0, 12);
            const ctaRecipesRev = ctaRecipes.slice().reverse();
          %>
          <article class="fcard fcard--cta" aria-label="Partagez votre recette inspirée du cinéma">
            <a href="/add-recipes-movies/" class="fcard--cta__link">
              <div class="fcard--cta__shimmer" aria-hidden="true"></div>
              <div class="fcard--cta__body">
                <p class="fcard--cta__eyebrow">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>
                  Communauté · Ciné Délices
                </p>
                <h2 class="fcard--cta__title">UN FILM,<em>UNE RECETTE CULTE.</em></h2>
                <p class="fcard--cta__desc">Vous avez cuisiné une recette inspirée d'un film ? Partagez-la avec des milliers de cinéphiles gourmands.</p>
                <span class="fcard--cta__action">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  Partager ma recette
                </span>
              </div>
              <% if (ctaRecipes.length > 0) { %>
              <div class="fcard--cta__deco" aria-hidden="true">
                <!-- Rangée 1 : glisse vers la gauche -->
                <div class="fcard--cta__poster-row fcard--cta__poster-row--left">
                  <div class="fcard--cta__poster-track">
                    <% ctaRecipes.forEach(r => { %>
                    <div class="fcard--cta__mini">
                      <img src="<%= r.picture %>" alt="" loading="lazy" decoding="async">
                    </div>
                    <% }) %>
                    <% ctaRecipes.forEach(r => { %>
                    <div class="fcard--cta__mini">
                      <img src="<%= r.picture %>" alt="" loading="lazy" decoding="async">
                    </div>
                    <% }) %>
                  </div>
                </div>
                <!-- Rangée 2 : glisse vers la droite -->
                <div class="fcard--cta__poster-row fcard--cta__poster-row--right">
                  <div class="fcard--cta__poster-track">
                    <% ctaRecipesRev.forEach(r => { %>
                    <div class="fcard--cta__mini">
                      <img src="<%= r.picture %>" alt="" loading="lazy" decoding="async">
                    </div>
                    <% }) %>
                    <% ctaRecipesRev.forEach(r => { %>
                    <div class="fcard--cta__mini">
                      <img src="<%= r.picture %>" alt="" loading="lazy" decoding="async">
                    </div>
                    <% }) %>
                  </div>
                </div>
              </div>
              <% } %>
            </a>
          </article>

          <% if (recipes.length > 9) { %>
          <div class="center-button">
            <button
              id="see__all__recipes__button"
              class="btn btn--red"
              aria-label="Voir plus de recettes"
            >
              <span class="btn__shimmer"></span>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" x2="18" y1="17" y2="17"/></svg>
              <span class="btn__text">Voir plus</span>
            </button>
          </div>
          <% } %>

          <% } %>

        </div><!-- /.ar-grid-wrap -->

      </section>

    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->

    <!-- Configuration favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>

    <!-- Tri des recettes : dropdown custom — préserve category + q dans l'URL -->
    <script>
      (function () {
        const wrap    = document.getElementById('ddSortWrap');
        const trigger = document.getElementById('ddSortTrigger');
        const panel   = document.getElementById('ddSortPanel');
        const labelEl = document.getElementById('ddSortLabel');
        if (!wrap || !trigger || !panel) return;

        function open()  { wrap.classList.add('is-open'); trigger.classList.add('is-open'); trigger.setAttribute('aria-expanded','true'); panel.setAttribute('aria-hidden','false'); }
        function close() { wrap.classList.remove('is-open'); trigger.classList.remove('is-open'); trigger.setAttribute('aria-expanded','false'); panel.setAttribute('aria-hidden','true'); }

        trigger.addEventListener('click', function(e){ e.stopPropagation(); wrap.classList.contains('is-open') ? close() : open(); });

        panel.querySelectorAll('.dropdown__item[data-sort]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            const params = new URLSearchParams(window.location.search);
            params.set('sort', btn.dataset.sort);
            window.location.href = '/recipes-movie/?' + params.toString();
          });
        });

        document.addEventListener('click', function(e){ if (!wrap.contains(e.target)) close(); });
        document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });
      })();
    </script>

  </body>
</html>
