<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajouter un film et une recette - Ciné Délices</title>
    <link rel="stylesheet" href="../css/home.css" />
  </head>
  <body>
    <!-- ================= HEADER ================= -->
    <header class="header" role="banner">
      <div class="title" aria-label="Titre du site">
        🎬 <span class="title-cine">Ciné</span>
        <span class="title-delices">Délices</span>
      </div>

      <button class="burger-menu" aria-label="Menu" aria-expanded="false">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>

      <nav
        class="navigationheader"
        role="navigation"
        aria-label="Navigation principale"
      >
        <a class="navigationheader-link" href="/home">Accueil</a>
        <a class="navigationheader-link" href="/films">Films</a>
        <a class="navigationheader-link" href="/admin/add-movie-recipe"
          >Ajouter un film</a
        >
      </nav>

      <div class="buttons__header">
        <button class="btn btn--gold" aria-label="Connexion">Connexion</button>
        <button class="btn btn--red" aria-label="Inscription">
          Inscription
        </button>
      </div>
    </header>

    <!-- ================ MAIN ================= -->
    <main>
      <section
        class="recipeofthe__day"
        id="ajouter-film"
        role="region"
        aria-labelledby="ajouter-film-titre"
      >
        <div class="section-header">
          <h2 id="ajouter-film-titre">Ajouter un film et sa recette</h2>
          <p class="section-subtitle">
            Les admins peuvent enrichir le site avec de nouvelles recettes
            cultes
          </p>
        </div>

        <div class="recipeofthe__day-container">
          <article class="recipe-card recipe-card--left">
            <form
              action="/admin/add-movie-recipe"
              method="POST"
              enctype="multipart/form-data"
              class="recipe-info"
            >
              <label for="movieTitle">Titre du film :</label>
              <input type="text" id="movieTitle" name="movieTitle" required />

              <label for="recipeTitle">Titre de la recette :</label>
              <input type="text" id="recipeTitle" name="recipeTitle" required />

              <label for="image">Image :</label>
              <input
                type="file"
                id="image"
                name="image"
                accept="image/*"
                required
              />

              <label for="description">Description :</label>
              <textarea
                id="description"
                name="description"
                rows="6"
                placeholder="Décris le film et la recette..."
                required
              ></textarea>

              <button type="submit" class="btn btn--red btn--full">
                Ajouter la recette
              </button>
            </form>
          </article>

          <article class="recipe-card recipe-card--right">
            <div class="film-image-placeholder">
              <img src="../images/bg-8.jpg" alt="Film et recette" />
            </div>
            <blockquote class="film-quote">
              <p>
                Les nouvelles recettes rendront le site encore plus savoureux et
                cinéphile !
              </p>
            </blockquote>
          </article>
        </div>
      </section>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer" role="contentinfo">
      <div class="footer-main">
        <div class="footer-left">
          <h1 class="footer-logo-text">
            <span class="cine">Ciné</span> <span class="delices">Délices</span>
          </h1>
          <p class="footer-slogan">🎬 Où le 7e art rencontre la gastronomie.</p>
        </div>
        <div class="footer-right">
          <nav class="footer-menu" aria-label="Liens de bas de page">
            <a href="/home">Accueil</a>
            <a href="/films">Films</a>
            <a href="/admin/add-movie-recipe">Ajouter un film</a>
          </nav>
          <div class="footer-socials">
            <a href="https://twitter.com" target="_blank">X</a>
            <a href="https://instagram.com" target="_blank">Instagram</a>
            <a href="https://facebook.com" target="_blank">Facebook</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2025 Ciné Délices</p>
      </div>
    </footer>

    <script>
      const burgerMenu = document.querySelector(".burger-menu");
      const nav = document.querySelector(".navigationheader");
      burgerMenu.addEventListener("click", () => {
        const isExpanded = burgerMenu.getAttribute("aria-expanded") === "true";
        burgerMenu.setAttribute("aria-expanded", !isExpanded);
        burgerMenu.classList.toggle("active");
        nav.classList.toggle("active");
      });
    </script>
  </body>
</html>
