<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title>Films - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/movies.css" />

    <!-- scripts -->
    <script src="/js/movie-search.js" defer></script>
    <script src="/js/more-views.js" defer></script>
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- HERO IMAGE -->
      <section
        class="banner__image__film banner__image__film--movies"
        aria-hidden="true"
      >
        <div class="banner__image__film__overlay"></div>
        <img
          src="/images/image-banner-movies.jpg"
          alt="Sélection de films Ciné Délices"
        />
      </section>

      <!-- BANNIÈRE -->
      <section class="banner" aria-labelledby="movies-title">
        <div class="banner__title">
          <p class="banner__meta">Films cultes</p>
          <h2 id="movies-title">Bienvenue dans nos films</h2>
          <p class="banner__subtitle">Le goût du cinéma et le cinéma de goût</p>
        </div>

        <div class="banner__search__films">
          <label for="search-movie" class="search__label"
            >Rechercher un film ou une série :</label
          >

          <div class="search-container">
            <div class="search-input-wrapper">
              <input
                type="text"
                id="search-movie"
                name="search-movie"
                class="search__input__film"
                placeholder="Titre, année, genre..."
                autocomplete="off"
                aria-label="Rechercher un film"
              />
              <button
                type="button"
                id="search-ai-button"
                class="btn btn--ai"
                title="Recherche IA (à venir)"
                aria-label="Recherche IA"
                disabled
              >
                <i class="fa-solid fa-robot"></i>
                <span>IA</span>
              </button>
            </div>

            <!-- Dropdown des résultats de recherche -->
            <div id="search-results" class="search-results" aria-live="polite">
              <!-- Les résultats s'afficheront ici dynamiquement -->
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION FILMS -->
      <section id="films">
        <div class="presentation__film">
          <div class="presentation__text__film">
            <h3>Nos films et séries cultes</h3>
            <p>Parce que le goût se partage</p>
          </div>
          <div class="presentation__button__film">
            <a class="btn btn--gold" href="/add-recipes-movies/"
              >J'ajoute mon film</a
            >
          </div>
        </div>

        <div id="movies__list" class="articles only__display__3__films">
          <% if (!movies || movies.length === 0) { %>
          <p>Aucun film trouvé pour ce genre.</p>
          <% } else { %> <% movies.forEach(movie => { %>
          <article id="film-<%= movie.id %>">
            <div class="film-card-image">
              <img
                src="<%= movie.picture %>"
                alt="Affiche du film <%= movie.title %>"
              />
            </div>
            <div class="film-card-info">
              <h4 class="film-title"><%= movie.title %></h4>
              <div class="film-meta">
                <span class="film-year"><%= movie.year %></span>
                <span class="film-separator">•</span>
                <span class="film-genre"><%= movie.genre %></span>
              </div>
              <a class="btn btn--red" href="/recipes-movie/<%= movie.id %>">
                Voir les recettes
              </a>
            </div>
          </article>
          <% }) %> <% } %>
        </div>

        <div class="center-button">
          <button
            id="see__all__movies__button"
            class="btn btn--gold-special"
            aria-label="Voir tous les films"
          >
            Voir moins
          </button>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/films.js" defer></script>
  </body>
</html>
