<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes" />
    <title>Films - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>
    <!-- SEO — Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Ciné Délices" />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:title"       content="Films &amp; Séries — Ciné Délices" />
    <meta property="og:description" content="Parcourez tous les films et séries cultes et leurs recettes inspirées du cinéma." />
    <meta property="og:image"       content="<%= siteUrl %>/images/image-banner-movie-default.jpg" />
    <meta property="og:url"         content="<%= siteUrl %>/movies" />
    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="Films &amp; Séries — Ciné Délices" />
    <meta name="twitter:description" content="Parcourez tous les films et séries cultes et leurs recettes inspirées du cinéma." />
    <meta name="twitter:image"       content="<%= siteUrl %>/images/image-banner-movie-default.jpg" />
    <!-- Canonical -->
    <link rel="canonical" href="<%= siteUrl %>/movies" />

    <!-- styles -->
    <link rel="stylesheet" href="/css/movies.css" />

    <!-- scripts -->
    <script src="/js/utils/text-utils.js" defer></script>
    <script src="/js/movie-search-advanced.js" defer></script>
    <script src="/js/more-views.js" defer></script>
  </head>

  <body class="movies-page">
    <%- include("partials/header") %>

    <main id="main-content">

      <!-- PAGE HERO : deux colonnes (texte + recherche) -->
      <section class="page-hero" aria-labelledby="heroTitle">
        <!-- Couche décorative clippée séparément pour que le dropdown ne soit pas masqué -->
        <div class="page-hero__deco" aria-hidden="true">
          <div class="page-hero__bg"></div>
          <div class="page-hero__reel page-hero__reel--1"></div>
          <div class="page-hero__reel page-hero__reel--2"></div>
          <div class="page-hero__scanlines"></div>
          <div class="page-hero__vignette"></div>
        </div>
        <div class="page-hero__content">

          <!-- Colonne gauche : identité & stats -->
          <div class="page-hero__left">
            <p class="page-hero__eyebrow">
              <i data-lucide="film" width="14" height="14" aria-hidden="true"></i>
              Filmothèque Ciné Délices
            </p>
            <h1 class="page-hero__title" id="heroTitle">FILMS &amp; <em>SÉRIES</em></h1>
            <p class="page-hero__sub">Chaque film cache une recette — explorez, savourez, cuisinez</p>
            <div class="page-hero__meta-row">
              <div class="page-hero__stats" aria-label="Statistiques de la filmothèque">
                <div class="hero-stat">
                  <span class="hero-stat__num"><%= typeof totalMovies !== 'undefined' ? totalMovies : movies.length %></span>
                  <span class="hero-stat__label">Films &amp; Séries</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                  <span class="hero-stat__num"><%= typeof totalRecipes !== 'undefined' ? totalRecipes : '...' %></span>
                  <span class="hero-stat__label">Recettes</span>
                </div>
                <% if (typeof genres !== 'undefined' && genres && genres.length > 0) { %>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                  <span class="hero-stat__num"><%= genres.length %></span>
                  <span class="hero-stat__label">Genres</span>
                </div>
                <% } %>
              </div>
              <% if (typeof genres !== 'undefined' && genres && genres.length > 0) { %>
              <div class="quick-tags-row">
                <span class="qt-label">Genre :</span>
                <a href="/movies" class="qtag qtag-or <%= (typeof selectedGenre === 'undefined' || selectedGenre === 'tous') ? 'active' : '' %>">Tous</a>
                <% genres.forEach(function(g) {
                  const gl = g.toLowerCase();
                  let cls = 'qtag-or';
                  if (gl.includes('aventure') || gl.includes('action')) cls = 'qtag-rouge';
                  else if (gl.includes('com') ) cls = 'qtag-bleu';
                  else if (gl.includes('fanta') || gl.includes('magic') || gl.includes('merv')) cls = 'qtag-violet';
                  else if (gl.includes('sci') || gl.includes('sf')) cls = 'qtag-vert';
                  else if (gl.includes('horr') || gl.includes('épou') || gl.includes('effroi')) cls = 'qtag-rouge';
                  else if (gl.includes('anima')) cls = 'qtag-bleu';
                %>
                <a href="/movies?genre=<%= encodeURIComponent(g) %>"
                   class="qtag <%= cls %> <%= selectedGenre === g ? 'active' : '' %>">
                  <%= g.charAt(0).toUpperCase() + g.slice(1) %>
                </a>
                <% }) %>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Colonne droite : barre de recherche (sans encadrement) -->
          <div class="page-hero__search-col" aria-label="Recherche de films">
            <p class="page-hero__search-label">
              <i data-lucide="search" width="13" height="13" stroke-width="2.5" aria-hidden="true"></i>
              Trouver un film ou une série
            </p>
            <div class="search-main-row">
              <!-- search-input-wrapper = classe attendue par movie-search-advanced.js -->
              <div class="search-input-wrap search-input-wrapper" id="search-results-parent" style="position:relative;">
                <input
                  type="text"
                  id="search-movie"
                  name="search-movie"
                  class="search__input__film"
                  placeholder="Rechercher un film ou une série..."
                  autocomplete="off"
                  aria-label="Rechercher un film"
                />
                <!-- Dropdown résultats (movie-search-advanced.js) -->
                <div id="search-results" class="search-results" aria-live="polite"></div>
              </div>
              <button
                type="button"
                id="search-boost-button"
                class="btn-search-boost"
                title="Recherche boostée"
                aria-label="Recherche boostée"
              >
                <i data-lucide="bot" width="20" height="20" aria-hidden="true"></i>
              </button>
            </div>
          </div>

        </div>
      </section>

      <!-- FILMS TOOLBAR -->
      <div class="films-toolbar">
        <div class="tb-left">
          <div class="tb-label">Filmothèque</div>
          <h2 class="tb-title">NOS FILMS ET SÉRIES CULTES</h2>
        </div>
        <div class="toolbar-right">
          <div class="view-toggle" role="group" aria-label="Mode d'affichage">
            <button class="view-btn active" id="vGrid" title="Vue grille" aria-pressed="true">
              <i data-lucide="layout-grid" aria-hidden="true"></i>
            </button>
            <button class="view-btn" id="vList" title="Vue liste" aria-pressed="false">
              <i data-lucide="list" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- FILMS GRID -->
      <div class="films-wrap">
        <div id="movies__list" class="films-grid only__display__9__films">

          <% if (!movies || movies.length === 0) { %>
          <div class="no-results">
            <div class="no-results__icon"><i data-lucide="film" width="48" height="48" stroke-width="1" aria-hidden="true"></i></div>
            <p class="no-results__title">Aucun film trouvé</p>
            <p class="no-results__sub">Aucun film pour ce genre — essayez un autre filtre</p>
          </div>
          <% } else { %>
          <% movies.forEach(function(movie) {
            const recipesCount = typeof movie.recipeCount === 'number' ? movie.recipeCount : 0;
            const displayRating = movie.rating || '4.0';
            const movieSynopsis = movie.synopsis || 'Synopsis à venir...';

            // Genre → classe tag moodboard
            const genreRaw = (movie.genre || '').toLowerCase();
            let fgtClass = 'tag--bleu';
            if (genreRaw.includes('aventure') || genreRaw.includes('action')) fgtClass = 'tag--or';
            else if (genreRaw.includes('com')) fgtClass = 'tag--vert';
            else if (genreRaw.includes('thriller') || genreRaw.includes('policier')) fgtClass = 'tag--gris';
            else if (genreRaw.includes('fanta') || genreRaw.includes('merv')) fgtClass = 'tag--genre-cinema';
            else if (genreRaw.includes('horr') || genreRaw.includes('épou')) fgtClass = 'tag--rouge';
            else if (genreRaw.includes('sci') || genreRaw.includes(' sf') || genreRaw.includes('sf ')) fgtClass = 'tag--vert';
            else if (genreRaw.includes('anim')) fgtClass = 'tag--bleu';
            else if (genreRaw.includes('docu')) fgtClass = 'tag--gris';

            const ratingNum = parseFloat(displayRating);
            const starsRounded = Math.round(ratingNum);

            // Data attributes pour filtrage JS
            const dataGenre = (movie.genre || '').toLowerCase();
            const dataTitle = (movie.title || '').toLowerCase();
          %>
          <article
            id="film-<%= movie.id %>"
            class="fcard"
            data-genre="<%= dataGenre %>"
            data-year="<%= movie.year || '' %>"
            data-rating="<%= displayRating %>"
            data-recipes="<%= recipesCount %>"
            data-title="<%= dataTitle %>"
          >
            <!-- POSTER -->
            <div class="fcard__poster">
              <img
                class="fcard__img"
                src="<%= movie.cardPath || movie.picture %>"
                alt="Affiche du film <%= movie.title %>"
                loading="lazy"
                width="400"
                height="600"
                decoding="async"
              />
              <div class="fcard__overlay"></div>

              <!-- Badges haut-gauche : "Film" toujours affiché + Nouveau / Populaire -->
              <div class="fcard__badges">
                <span class="fcard__type-badge">Film</span>
                <% if (movie.isNew) { %>
                <span class="badge-new badge-new--new">
                  <i data-lucide="sparkles" class="icon" aria-hidden="true"></i>
                  Nouveau
                </span>
                <% } %>
                <% if (movie.isPopular) { %>
                <span class="badge-new badge-new--trending">
                  <i data-lucide="flame" class="icon" aria-hidden="true"></i>
                  Populaire
                </span>
                <% } %>
              </div>

              <!-- Favori -->
              <button
                class="fcard__fav btn-fav"
                data-entity-id="<%= movie.id %>"
                data-entity-type="movie"
                data-is-favorite="<%= movie.isFavorite || false %>"
                aria-label="<%= movie.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (movie.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
              >
                <i data-lucide="heart" class="icon" fill="<%= movie.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></i>
              </button>

              <!-- Compteur recettes bas-droite (disparaît au hover) -->
              <span class="fcard__count-img" aria-hidden="true">
                <i data-lucide="utensils" width="11" height="11" aria-hidden="true"></i>
                <%= recipesCount %> <%= recipesCount > 1 ? 'recettes' : 'recette' %>
              </span>

              <!-- Overlay hover → centré sur le poster -->
              <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="fcard__hover-overlay" aria-label="Voir les recettes de <%= movie.title %>">
                <div class="fcard__cta-pill">
                  <div class="fcard__cta-icon-wrap">
                    <span class="fcard__cta-ring"></span>
                    <span class="fcard__cta-bg">
                      <i data-lucide="film" width="20" height="20" aria-hidden="true"></i>
                    </span>
                  </div>
                  <span class="fcard__cta-label">Voir les recettes</span>
                </div>
              </a>

              <!-- Titre + réalisateur en bas du poster -->
              <div class="fcard__title-area">
                <p class="fcard__director"><%= movie.director ? (movie.director + ' · ') : '' %><%= movie.year %></p>
                <h3 class="fcard__title-main"><%= movie.title %></h3>
              </div>
            </div>

            <!-- BODY -->
            <div class="fcard__body">
              <!-- Genre tag -->
              <div class="fcard__genres">
                <span class="tag <%= fgtClass %>"><%= movie.genre %></span>
              </div>

              <!-- Synopsis -->
              <p class="fcard__desc"><%= movieSynopsis %></p>
              <button class="fcard__desc-toggle" aria-expanded="false">voir plus</button>

              <!-- Footer : étoiles + lien visible en vue liste & mobile -->
              <div class="fcard__footer">
                <div class="fcard__stars" data-entity-id="<%= movie.id %>" data-entity-type="movie" data-average="<%= displayRating %>">
                  <span class="fcard__foot-label">Note</span>
                  <% for (let i = 1; i <= 5; i++) { %>
                  <span class="<%= i <= starsRounded ? 's' : 'se' %>">★</span>
                  <% } %>
                  <span class="fcard__rating"><%= displayRating %></span>
                </div>
                <a class="btn-vr fcard__btn-mobile" href="/recipes-movie/<%= movie.slug || movie.id %>" aria-label="Voir les recettes de <%= movie.title %>">
                  <i data-lucide="film" width="10" height="10" aria-hidden="true"></i>
                  <span aria-hidden="true">Voir les recettes</span>
                </a>
              </div>
            </div>
          </article>
          <% }) %>

          <% } %>

        </div><!-- /#movies__list -->
      </div><!-- /.films-wrap -->

      <!-- FCARD CTA : indépendante de la grille -->
      <% if (movies && movies.length > 0) { %>
      <%
        const ctaMovies = movies.slice(0, Math.min(12, movies.length));
        const ctaMoviesRev = ctaMovies.slice().reverse();
      %>
      <article class="fcard fcard--cta movies-cta" aria-label="Proposer votre film culte à Ciné Délices">
        <a href="/add-recipes-movies/" class="fcard--cta__link">
          <div class="fcard--cta__shimmer" aria-hidden="true"></div>
          <div class="fcard--cta__body">
            <p class="fcard--cta__eyebrow">
              <i data-lucide="film" width="11" height="11" stroke-width="2.5" aria-hidden="true"></i>
              Communauté · Ciné Délices
            </p>
            <h2 class="fcard--cta__title">VOTRE FILM<em>MÉRITE UNE RECETTE.</em></h2>
            <p class="fcard--cta__desc">Proposez un film culte et créez la recette qui va avec — rejoignez des cinéphiles gourmands.</p>
            <span class="fcard--cta__action">
              <i data-lucide="plus" width="13" height="13" stroke-width="3" aria-hidden="true"></i>
              Proposer un film
            </span>
          </div>
          <div class="fcard--cta__deco" aria-hidden="true">
            <div class="fcard--cta__poster-row fcard--cta__poster-row--left">
              <div class="fcard--cta__poster-track">
                <% ctaMovies.forEach(m => { %>
                <div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div>
                <% }) %>
                <% ctaMovies.forEach(m => { %>
                <div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div>
                <% }) %>
              </div>
            </div>
            <div class="fcard--cta__poster-row fcard--cta__poster-row--right">
              <div class="fcard--cta__poster-track">
                <% ctaMoviesRev.forEach(m => { %>
                <div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div>
                <% }) %>
                <% ctaMoviesRev.forEach(m => { %>
                <div class="fcard--cta__mini"><img src="<%= m.cardPath || m.picture %>" alt="" loading="lazy" decoding="async"></div>
                <% }) %>
              </div>
            </div>
          </div>
        </a>
      </article>
      <% } %>

      <!-- LOAD MORE (more-views.js) -->
      <% if (movies && movies.length > 9) { %>
      <div class="load-more-wrap">
        <div class="load-bar"></div>
        <p class="load-info"><%= movies.length %> films dans la filmothèque</p>
        <button id="see__all__movies__button" class="btn-more" aria-label="Voir plus de films">
          <span class="btn-txt">Voir plus de films</span>
        </button>
      </div>
      <% } %>

    </main>

    <%- include("partials/footer") %>

    <!-- Scripts globaux -->

    <!-- Config favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>

    <!-- Vue toggle grid/list -->
    <script>
      (function() {
        const grid = document.getElementById('movies__list');
        const vGrid = document.getElementById('vGrid');
        const vList = document.getElementById('vList');
        if (!grid || !vGrid || !vList) return;

        vGrid.addEventListener('click', function() {
          grid.classList.remove('list-view');
          vGrid.classList.add('active');
          vGrid.setAttribute('aria-pressed', 'true');
          vList.classList.remove('active');
          vList.setAttribute('aria-pressed', 'false');
          updateSynopsisToggles(false);
        });
        vList.addEventListener('click', function() {
          grid.classList.add('list-view');
          vList.classList.add('active');
          vList.setAttribute('aria-pressed', 'true');
          vGrid.classList.remove('active');
          vGrid.setAttribute('aria-pressed', 'false');
          updateSynopsisToggles(true);
        });

        function updateSynopsisToggles(isListView) {
          if (!isListView) {
            document.querySelectorAll('.fcard__desc').forEach(function(desc) {
              desc.classList.remove('is-expanded');
            });
            document.querySelectorAll('.fcard__desc-toggle').forEach(function(btn) {
              btn.textContent = 'voir plus';
              btn.setAttribute('aria-expanded', 'false');
            });
          }
        }

        document.getElementById('movies__list').addEventListener('click', function(e) {
          const btn = e.target.closest('.fcard__desc-toggle');
          if (!btn) return;
          const desc = btn.previousElementSibling;
          const expanded = desc.classList.toggle('is-expanded');
          btn.textContent = expanded ? 'voir moins' : 'voir plus';
          btn.setAttribute('aria-expanded', String(expanded));
        });
      })();
    </script>
  </body>
</html>
