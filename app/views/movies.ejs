<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title>Films - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/films.css">

    <!-- scripts -->
    <script src="/js/filtred-genre.js" defer></script>

  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- BANNIÈRE -->
      <section class="banner">

          <div class="banner__title">

              <h2>Bienvenue dans nos films</h2>
              <p>Le goût du cinéma et le cinéma de goût</p>
          
          </div>

            <div class="banner__search__films">

                <label for="search" class="search__label">Rechercher un film ou une série par genre:</label>

                <select name="films" id="search" class="search__select__film">
                    <option value="">Genre</option>
                    <option value="all">Tous les films</option>
                    <option value="action">Action</option>
                    <option value="animé">Animé</option>
                    <option value="aventure">Aventure</option>
                    <option value="comédie">Comédie</option>
                    <option value="drame">Drame</option>
                    <option value="fantastique">Fantastique</option>
                    <option value="horreur">Horreur</option>
                    <option value="romantique">Romantique</option>
                    <option value="science-fiction">Science-fiction</option>
                    <option value="thriller">Thriller</option>
                </select>

            </div>

      </section>

    




      <!-- SECTION FILMS -->
      <section id="films">
        <div class="presentation__film">
          <div class="presentation__text__film">
            <h3>Nos films et séries cultes</h3>
            <p>Parce que le goût se partage</p>
          </div>

          <div class="presentation__button__film">
            <button class="add__film">Ajouter mon film</button>
          </div>
        </div>

        <div class="articles only__3__films">
          <% movies.forEach(movie => { %>
          <article>
            <img
              src="/images/<%= movie.picture %>"
              alt="Affiche du film <%= movie.title %>"
            />
            <div>
              <h4><%= movie.title %></h4>
              <p><%= movie.year %></p>
              <p><%= movie.genre %></p>
              <a class="recipe-button" href="/recipes-movie/<%= movie.id %>">
                Voir les recettes
              </a>
            </div>
          </article>
          <% }) %>
        </div>

        <div class="center-button">
          <button class="cta-button-secondary" aria-label="Voir tous les films">
            Voir tous les films
          </button>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>
    <script src="/js/modal.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/films.js" defer></script>
  </body>
</html>
