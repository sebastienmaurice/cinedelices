<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title>Films - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/movies.css" />

    <!-- scripts -->
    <!-- utils centralisés (doivent être chargés avant les scripts qui les utilisent) -->
    <script src="/js/utils/text-utils.js" defer></script>
    <script src="/js/movie-search-advanced.js" defer></script>
    <script src="/js/more-views.js" defer></script>
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- HERO IMAGE -->
      <section
        class="banner__image__film banner__image__film--movies"
        aria-hidden="true"
      >
        <div class="banner__image__film__overlay"></div>
        <img
          src="/images/image-banner-movie-default.jpg"
          alt="Sélection de films Ciné Délices"
        />
      </section>

      <!-- BANNIÈRE -->
      <section class="banner" aria-labelledby="movies-title">
        <div class="banner__title">
          <p class="banner__meta">Films cultes</p>
          <h2 id="movies-title">Découvrez nos films et séries cultes</h2>
          <p class="banner__subtitle">
            Explorez notre filmothèque et savourez le goût du cinéma
          </p>
        </div>

        <div class="banner__search__films">
          <div class="search-container">
            <div class="search-input-wrapper">
              <input
                type="text"
                id="search-movie"
                name="search-movie"
                class="search__input__film"
                placeholder="Rechercher un film ou une série ..."
                autocomplete="off"
                aria-label="Rechercher un film"
              />
              <button
                type="button"
                id="search-boost-button"
                class="btn-search-boost"
                title="Recherche boostée"
                aria-label="Recherche boostée"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
              </button>
            </div>

            <!-- Dropdown des résultats de recherche -->
            <div id="search-results" class="search-results" aria-live="polite">
              <!-- Les résultats s'afficheront ici dynamiquement -->
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION FILMS -->
      <section id="films">
        <div class="presentation__film">
          <h3 class="presentation__title">Nos films et séries cultes</h3>
          <div class="presentation__rule"></div>
          <div class="presentation__actions__film">
            <% if (typeof genres !== 'undefined' && genres && genres.length > 0) { %>
            <div class="genre-filter">
              <label for="genre-select" class="genre-filter__label">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              </label>
              <select id="genre-select" class="genre-filter__select" onchange="window.location.href=this.value">
                <option value="/movies" <%= (typeof selectedGenre === 'undefined' || selectedGenre === 'tous') ? 'selected' : '' %>>Tous les genres</option>
                <% genres.forEach(genre => { %>
                <option value="/movies?genre=<%= genre %>" <%= selectedGenre === genre ? 'selected' : '' %>><%= genre.charAt(0).toUpperCase() + genre.slice(1) %></option>
                <% }) %>
              </select>
            </div>
            <% } %>
            <a class="btn btn--primary" href="/add-recipes-movies/">
              <span class="btn__shimmer"></span>
              <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
              <span class="btn__text">J'ajoute mon film</span>
            </a>
          </div>
        </div>

        <div id="movies__list" class="articles only__display__9__films">
          <% if (!movies || movies.length === 0) { %>
          <p class="no-movies">Aucun film trouvé pour ce genre.</p>
          <% } else { %> <% movies.forEach(movie => { %>
          <%
            const recipesCount = typeof movie.recipeCount === "number" ? movie.recipeCount : 0;
            const displayRating = movie.rating || '4.0';
            // Synopsis : priorité au champ BDD, fallback propre si NULL
            const movieSynopsis = movie.synopsis || 'Synopsis à venir...';
          %>
          <article id="film-<%= movie.id %>" class="film-card">
            <!-- Image portrait 2:3 avec overlay et titre dans le fondu -->
            <div class="film-card__img">
              <img
                src="<%= movie.cardPath || movie.picture %>"
                alt="Affiche du film <%= movie.title %>"
                loading="lazy"
                width="400"
                height="600"
                decoding="async"
              />
              <!-- Overlay top : badges + favori -->
              <div class="film-card__ot">
                <div style="display:flex;flex-direction:column;gap:0.4rem;">
                  <% if (movie.isNew) { %>
                  <span class="badge badge--type-b">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                    Nouveau
                  </span>
                  <% } %>
                  <% if (movie.isPopular) { %>
                  <span class="badge badge--type-r">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                    Populaire
                  </span>
                  <% } %>
                </div>
                <button
                  class="btn-fav"
                  data-entity-id="<%= movie.id %>"
                  data-entity-type="movie"
                  data-is-favorite="<%= movie.isFavorite || false %>"
                  aria-label="<%= movie.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                  title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (movie.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
                >
                  <svg class="icon" viewBox="0 0 24 24" fill="<%= movie.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                </button>
              </div>
              <!-- Titre dans le fondu bas de l'image -->
              <div class="film-card__tz">
                <span class="film-ttl"><%= movie.title %></span>
                <span class="film-byl"><%= movie.year %></span>
              </div>
            </div>

            <!-- Corps de la card -->
            <div class="film-card__body">
              <!-- Tags meta -->
              <div class="film-card__meta">
                <span class="tag tag--bleu"><%= movie.genre %></span>
              </div>

              <!-- Notation -->
              <div class="rating rating--sm" data-entity-id="<%= movie.id %>" data-entity-type="movie" data-average="<%= displayRating %>">
                <% for (let i = 1; i <= 5; i++) { %>
                <span class="rating__star <%= i <= Math.round(parseFloat(displayRating)) ? 'rating__star--filled' : '' %>">
                  <svg class="icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </span>
                <% } %>
                <span class="rating__value"><%= displayRating %></span>
              </div>

              <!-- Synopsis -->
              <p class="film-card__desc"><%= movieSynopsis %></p>

              <!-- Footer : compteur recettes + bouton -->
              <div class="film-card__foot">
                <span class="film-count">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                  <%= recipesCount %> <%= recipesCount > 1 ? "recettes" : "recette" %>
                </span>
                <a class="btn btn--red" href="/recipes-movie/<%= movie.id %>">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  Voir les recettes
                </a>
              </div>
            </div>
          </article>
          <% }) %> <% } %>
        </div>

        <% if (movies && movies.length > 9) { %>
        <div class="center-button">
          <button
            id="see__all__movies__button"
            class="btn btn--red"
            aria-label="Voir plus de films"
          >
            <span class="btn__shimmer"></span>
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
            <span class="btn__text">Voir plus</span>
          </button>
        </div>
        <% } %>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Configuration pour les favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>
  </body>
</html>
