<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Découvrez tous les films et séries cultes et leurs recettes"
    />
    <title>Films - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- styles-->
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/movies.css" />

    <!-- scripts -->
    <!-- utils centralisés (doivent être chargés avant les scripts qui les utilisent) -->
    <script src="/js/utils/text-utils.js" defer></script>
    <script src="/js/movie-search-advanced.js" defer></script>
    <script src="/js/more-views.js" defer></script>
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <!-- HERO IMAGE -->
      <section
        class="banner__image__film banner__image__film--movies"
        aria-hidden="true"
      >
        <div class="banner__image__film__overlay"></div>
        <img
          src="/images/image-banner-movies.jpg"
          alt="Sélection de films Ciné Délices"
        />
      </section>

      <!-- BANNIÈRE -->
      <section class="banner" aria-labelledby="movies-title">
        <div class="banner__title">
          <p class="banner__meta">Films cultes</p>
          <h2 id="movies-title">Découvrez nos films et séries cultes</h2>
          <p class="banner__subtitle">
            Explorez notre filmothèque et savourez le goût du cinéma
          </p>
        </div>

        <div class="banner__search__films">
          <div class="search-container">
            <div class="search-input-wrapper">
              <input
                type="text"
                id="search-movie"
                name="search-movie"
                class="search__input__film"
                placeholder="Rechercher un film ou une série ..."
                autocomplete="off"
                aria-label="Rechercher un film"
              />
              <button
                type="button"
                id="search-boost-button"
                class="btn-search-boost"
                title="Recherche boostée"
                aria-label="Recherche boostée"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
              </button>
            </div>

            <!-- Dropdown des résultats de recherche -->
            <div id="search-results" class="search-results" aria-live="polite">
              <!-- Les résultats s'afficheront ici dynamiquement -->
            </div>
          </div>
        </div>
      </section>

      <!-- CHIPS FILTRAGE PAR GENRE -->
      <% if (typeof genres !== 'undefined' && genres && genres.length > 0) { %>
      <section class="genre-chips-container" aria-label="Filtrer par genre">
        <div class="genre-chips">
          <a href="/movies"
             class="genre-chip <%= selectedGenre === 'tous' ? 'genre-chip--active' : '' %>"
             data-genre="tous">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg> Tous
          </a>
          <% genres.forEach(genre => { %>
          <a href="/movies?genre=<%= genre %>"
             class="genre-chip <%= selectedGenre === genre ? 'genre-chip--active' : '' %>"
             data-genre="<%= genre %>">
            <%= genre.charAt(0).toUpperCase() + genre.slice(1) %>
          </a>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- SECTION FILMS -->
      <section id="films">
        <div class="presentation__film">
          <div class="presentation__text__film">
            <h3>Nos films et séries cultes</h3>
            <p>
              Chaque film ou série cultes avec ses recettes inspirées du grand
              écran
            </p>
          </div>
          <div class="presentation__button__film">
            <a class="btn btn--gold" href="/add-recipes-movies/"
              >J'ajoute mon film</a
            >
          </div>
        </div>

        <div id="movies__list" class="articles only__display__9__films">
          <% if (!movies || movies.length === 0) { %>
          <p>Aucun film trouvé pour ce genre.</p>
          <% } else { %> <% movies.forEach(movie => { %>
          <article id="film-<%= movie.id %>" class="film-card">
            <div class="film-card-image">
              <!-- Overlay gradient pour améliorer la lisibilité -->
              <div class="film-card-overlay"></div>

              <!-- Badges Nouveau / Populaire -->
              <% if (movie.isNew || movie.isPopular) { %>
              <div class="film-card-badges">
                <% if (movie.isNew) { %>
                <span class="badge badge--new">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg> Nouveau
                </span>
                <% } %>
                <% if (movie.isPopular) { %>
                <span class="badge badge--popular">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg> Populaire
                </span>
                <% } %>
              </div>
              <% } %>

              <!-- Bouton Favori (cœur) -->
              <button
                class="btn-favorite"
                data-movie-id="<%= movie.id %>"
                data-is-favorite="<%= movie.isFavorite || false %>"
                aria-label="<%= movie.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                title="<%= typeof userId === 'undefined' || !userId ? 'Connectez-vous pour ajouter aux favoris' : (movie.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris') %>"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="<%= movie.isFavorite ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              </button>

              <!-- Note du film (interactive) -->
              <div
                class="film-card-rating rating-interactive"
                data-entity-id="<%= movie.id %>"
                data-entity-type="movie"
                data-average="<%= movie.rating || '4.0' %>"
                data-user-rating="<%= movie.userRating || '' %>"
                data-count="<%= movie.ratingCount || 0 %>"
                title="<%= movie.userRating ? 'Votre note : ' + movie.userRating + '/5' : 'Cliquez pour noter' %>"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span class="rating-value"><%= movie.rating || '4.0' %></span>
              </div>

              <img
                src="<%= movie.cardPath || movie.picture %>"
                alt="Affiche du film <%= movie.title %>"
              />
            </div>
            <div class="film-card-info">
              <h4 class="film-title"><%= movie.title %></h4>
              <div class="film-meta">
                <% const recipesCount = typeof movie.recipeCount === "number" ? movie.recipeCount : 0; %>
                <span class="film-meta-tag film-meta-tag--year">
                  <%= movie.year %>
                </span>
                <span class="film-meta-tag film-meta-tag--genre">
                  <%= movie.genre %>
                </span>
                <span
                  class="film-meta-tag film-meta-tag--recipes"
                  title="Nombre de recettes disponibles"
                >
                  <%= recipesCount %>
                  <%= recipesCount > 1 ? "recettes" : "recette" %>
                </span>
              </div>
              <a class="btn btn--red" href="/recipes-movie/<%= movie.id %>">
                Voir les recettes
              </a>
            </div>
          </article>
          <% }) %> <% } %>
        </div>

        <% if (movies && movies.length > 9) { %>
        <div class="center-button">
          <button
            id="see__all__movies__button"
            class="btn btn--gold-special"
            aria-label="Voir plus de films"
          >
            Voir plus
          </button>
        </div>
        <% } %>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Configuration pour les favoris -->
    <script>
      window.CINEDELICES = {
        isLoggedIn: <%= typeof userId !== 'undefined' && userId !== null %>,
        userId: <%= typeof userId !== 'undefined' && userId !== null ? userId : 'null' %>
      };
    </script>
    <script src="/js/favorites.js" defer></script>
  </body>
</html>
