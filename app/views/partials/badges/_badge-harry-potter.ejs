<%
/**
 * _badge-harry-potter.ejs — Badge Harry Potter Patronus (CSS-only)
 *
 * Params :
 *   badgeId  {string}  — suffixe unique pour les IDs SVG (ex: "hp1")
 *   size     {string}  — 'lg'|'md'|'sm'  (défaut : 'md')
 *   photoSrc {string}  — URL de l'avatar
 *   photoAlt {string}  — alt de l'image
 *   locked   {boolean} — true = badge verrouillé
 *
 * Tailles CSS (badge--harry-potter.css) :
 *   lg → 380px (--R:148px, --avatar-sz:218px, --orb-sz:22px)  — SVG viewBox 380×380
 *   md → 260px (--R:113px, --avatar-sz:167px, --orb-sz:18px)  — SVG viewBox 260×260
 *   sm → 140px (--R:60px,  --avatar-sz:91px,  --orb-sz:12px)  — SVG viewBox 140×140
 */
const _sz  = (typeof size    !== 'undefined' && size)    ? size    : 'md';
const _bid = (typeof badgeId !== 'undefined' && badgeId) ? badgeId : 'hp1';
const _lk  = (typeof locked  !== 'undefined' && locked);
const _src = (typeof photoSrc !== 'undefined' && photoSrc) ? photoSrc : '';
const _alt = (typeof photoAlt !== 'undefined' && photoAlt) ? photoAlt : 'Badge Harry Potter';
const _lockedClass = _lk ? ' badge--locked' : '';

/* SVG rings per size — scaled from source (340/230/130px) to site (380/260/140px) */
const _svgRings = {
  lg: {
    vb: '0 0 380 380', cx: 190, cy: 190,
    rf: 'rf-lg-' + _bid, rg: 'rg-lg-' + _bid,
    r1: 182, da1: '5 16',  sw1: '.8',
    r2: 169, da2: '2.5 12', sw2: '1',
    r3: 125, sw3: '.8',
    dots: [{x:190,y:8},{x:372,y:190},{x:190,y:372},{x:8,y:190}],
    dsz: 1.6,
  },
  md: {
    vb: '0 0 260 260', cx: 130, cy: 130,
    rf: 'rf-md-' + _bid, rg: 'rg-md-' + _bid,
    r1: 124, da1: '4 13',  sw1: '.7',
    r2: 114, da2: '2 10',  sw2: '.9',
    r3: 85,  sw3: '.7',
    dots: [{x:130,y:6},{x:254,y:130},{x:130,y:254},{x:6,y:130}],
    dsz: 1.3,
  },
  sm: {
    vb: '0 0 140 140', cx: 70, cy: 70,
    rf: null, rg: 'rg-sm-' + _bid,
    r1: 67, da1: '3 10',  sw1: '.6',
    r2: 61, da2: '1.5 8', sw2: '.7',
    r3: 46, sw3: '.6',
    dots: null,
    dsz: 0,
  },
};
const _r = _svgRings[_sz] || _svgRings.md;
%>
<div class="badge-wrap" data-badge="harry-potter" data-size="<%= _sz %>">
  <div class="badge badge--harry-potter<%= _lockedClass %>" role="img" aria-label="<%= _alt %>">

    <%# — Halo ambiant — %>
    <div class="halo" aria-hidden="true"></div>

    <%# — Anneaux SVG (z:3) — %>
    <svg
      class="rings"
      viewBox="<%= _r.vb %>"
      xmlns="http://www.w3.org/2000/svg"
      style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3;border-radius:50%;overflow:hidden"
      aria-hidden="true"
    >
      <defs>
        <% if (_r.rf) { %>
        <filter id="<%= _r.rf %>">
          <feGaussianBlur stdDeviation="<%= _sz === 'lg' ? '1.3' : '1' %>" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <% } %>
        <filter id="<%= _r.rg %>">
          <feGaussianBlur stdDeviation="<%= _sz === 'lg' ? '3' : _sz === 'md' ? '2.2' : '1.5' %>" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>

      <%# Anneau extérieur — rotation lente reverse %>
      <circle
        cx="<%= _r.cx %>" cy="<%= _r.cy %>" r="<%= _r.r1 %>"
        fill="none" stroke="rgba(180,230,255,.18)"
        stroke-width="<%= _r.sw1 %>" stroke-dasharray="<%= _r.da1 %>"
        style="animation:hp-spin 30s linear infinite reverse;transform-origin:<%= _r.cx %>px <%= _r.cy %>px"
      />

      <%# Anneau médian — rotation normale %>
      <circle
        cx="<%= _r.cx %>" cy="<%= _r.cy %>" r="<%= _r.r2 %>"
        fill="none" stroke="rgba(123,211,255,.15)"
        stroke-width="<%= _r.sw2 %>" stroke-dasharray="<%= _r.da2 %>"
        <% if (_r.rf) { %>filter="url(#<%= _r.rf %>)"<% } %>
        style="animation:hp-spin 18s linear infinite;transform-origin:<%= _r.cx %>px <%= _r.cy %>px"
      />

      <%# Anneau intérieur + glow %>
      <circle
        cx="<%= _r.cx %>" cy="<%= _r.cy %>" r="<%= _r.r3 %>"
        fill="none" stroke="rgba(180,230,255,.1)"
        stroke-width="<%= _r.sw3 %>"
        filter="url(#<%= _r.rg %>)"
        style="animation:hp-spin 40s linear infinite reverse;transform-origin:<%= _r.cx %>px <%= _r.cy %>px"
      />

      <% if (_r.dots) { %>
      <%# Marqueurs cardinal (lg + md uniquement) %>
      <g
        fill="rgba(201,241,255,.45)"
        style="animation:hp-spin 18s linear infinite;transform-origin:<%= _r.cx %>px <%= _r.cy %>px"
      >
        <% _r.dots.forEach(function(dot) { %><circle cx="<%= dot.x %>" cy="<%= dot.y %>" r="<%= _r.dsz %>"/><% }); %>
      </g>
      <% } %>
    </svg>

    <%# — Avatar photo (z:10) — %>
    <img class="avatar" src="<%= _src %>" alt="<%= _alt %>" />

    <%# — Orbe fantôme — %>
    <div class="orb-ghost" aria-hidden="true"></div>

    <%# — Évaporation ×6 (sm : 3 seulement) — %>
    <div class="evap" aria-hidden="true"></div>
    <div class="evap" aria-hidden="true"></div>
    <div class="evap" aria-hidden="true"></div>
    <% if (_sz !== 'sm') { %>
    <div class="evap" aria-hidden="true"></div>
    <div class="evap" aria-hidden="true"></div>
    <div class="evap" aria-hidden="true"></div>
    <% } %>

    <%# — Ondes de choc — %>
    <div class="shockwave"  aria-hidden="true"></div>
    <div class="shockwave2" aria-hidden="true"></div>

    <%# — Orbital : orb + 14 tp + 6 sw (sm : 10 tp + 2 sw) — %>
    <div class="orbital" aria-hidden="true">
      <div class="orb"></div>
      <%# Traînée %>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <% if (_sz !== 'sm') { %>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <div class="tp"><span></span></div>
      <% } %>
      <%# Étincelles %>
      <div class="sw"><span class="sp"></span></div>
      <div class="sw"><span class="sp"></span></div>
      <% if (_sz !== 'sm') { %>
      <div class="sw"><span class="sp"></span></div>
      <div class="sw"><span class="sp"></span></div>
      <div class="sw"><span class="sp"></span></div>
      <div class="sw"><span class="sp"></span></div>
      <% } %>
    </div>

    <%# — Vignette locked overlay — %>
    <div class="badge__vignette" aria-hidden="true"></div>

    <%# — Icône verrou — %>
    <span class="badge__lock-icon" aria-hidden="true">🔒</span>

  </div>
</div>
