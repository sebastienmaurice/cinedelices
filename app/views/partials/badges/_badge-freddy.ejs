<%
/**
 * _badge-freddy.ejs — Badge Freddy Krueger
 * Rendu identique au badge Strange verrouillé (pas de CSS dédié).
 */
const _sz  = (typeof size     !== 'undefined' && size)     ? size     : 'md';
const _bid = (typeof badgeId  !== 'undefined' && badgeId)  ? badgeId  : 'fr1';
const _src = (typeof photoSrc !== 'undefined' && photoSrc) ? photoSrc : '';
const _alt = (typeof photoAlt !== 'undefined' && photoAlt) ? photoAlt : 'Badge Freddy';
%>
<%- include('_badge-strange', {
  badgeId:  _bid,
  size:     _sz,
  photoSrc: _src,
  photoAlt: _alt,
  locked:   true,
}) %>
