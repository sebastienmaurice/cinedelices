<%
/**
 * _gm-badge.ejs — Composant badge gamification (72px, footer)
 *
 * Locals attendus :
 *   badgeId   {string}  Suffixe unique pour les IDs SVG (ex: 'b1', 'b2')
 *   theme     {string}  Modificateur CSS (spectateur|cinephile|critique|collectionneur|epique|maitre)
 *   ariaLabel {string}  Texte accessible
 *   photoSrc  {string}  URL de la photo (avatar ou placeholder)
 *   photoAlt  {string}  Alt de la photo
 *   label     {string}  Libellé court sous le badge
 *   locked    {boolean} true = badge verrouillé (filtre grisé)
 */
const _lockedClass = (typeof locked !== 'undefined' && locked) ? ' gm-badge--locked' : '';
%>
<div class="ft__badge-slot">
  <div
    class="gm-badge gm-badge--<%= theme %><%= _lockedClass %>"
    role="img"
    aria-label="<%= ariaLabel %>"
    title="<%= ariaLabel %>"
  >
    <div class="gm-badge__sparks" aria-hidden="true">
      <span class="gm-spark"></span><span class="gm-spark"></span>
      <span class="gm-spark"></span><span class="gm-spark"></span>
      <span class="gm-spark"></span><span class="gm-spark"></span>
    </div>
    <div class="gm-badge__smoke" aria-hidden="true">
      <span class="gm-smoke"></span><span class="gm-smoke"></span><span class="gm-smoke"></span>
    </div>
    <img class="gm-badge__photo" src="<%= photoSrc %>" alt="<%= photoAlt %>" />

    <%# ── SVG BASE (anneaux + glyphes) ── %>
    <div class="gm-badge__svg-base" style="width:72px;height:72px" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="72" height="72" xmlns="http://www.w3.org/2000/svg" style="overflow:hidden;display:block">
        <defs>
          <filter id="gf-<%= badgeId %>" x="0%" y="0%" width="100%" height="100%">
            <feGaussianBlur stdDeviation="1.4" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="gg-<%= badgeId %>" x="0%" y="0%" width="100%" height="100%">
            <feGaussianBlur stdDeviation="2" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="gs-<%= badgeId %>" x="0%" y="0%" width="100%" height="100%">
            <feGaussianBlur stdDeviation="1" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <clipPath id="cp-<%= badgeId %>"><circle cx="160" cy="160" r="136"/></clipPath>
          <path id="gp-<%= badgeId %>" d="M160,160 m-107,0 a107,107 0 1,1 214,0 a107,107 0 1,1 -214,0"/>
        </defs>
        <g clip-path="url(#cp-<%= badgeId %>)">
          <%# Anneau intérieur ripple %>
          <circle cx="160" cy="160" r="85" fill="none" stroke="currentColor" stroke-width="0.5"
            opacity="0.18" stroke-dasharray="3 6"
            style="color:var(--c-ring);animation:ft-time-ripple 6s linear infinite"/>

          <%# Anneau 1 CW — r92 + ticks %>
          <g style="animation:ft-cw var(--dur-r1) cubic-bezier(.45,.05,.55,.95) infinite;transform-origin:160px 160px">
            <circle cx="160" cy="160" r="92" fill="none" stroke="currentColor" stroke-width="1.2"
              filter="url(#gf-<%= badgeId %>)"
              style="color:var(--c-ring);animation:ft-breathe-slow 5.2s ease-in-out infinite"/>
            <g style="color:var(--c-ring);stroke:currentColor">
              <line x1="160" y1="68" x2="160" y2="76" stroke-width="1.5" opacity=".95"/>
              <line x1="160" y1="68" x2="160" y2="76" stroke-width="1.5" opacity=".95" transform="rotate(90,160,160)"/>
              <line x1="160" y1="68" x2="160" y2="76" stroke-width="1.5" opacity=".95" transform="rotate(180,160,160)"/>
              <line x1="160" y1="68" x2="160" y2="76" stroke-width="1.5" opacity=".95" transform="rotate(270,160,160)"/>
            </g>
          </g>

          <%# Anneau 2 CCW — r104 + losanges %>
          <g style="animation:ft-ccw var(--dur-r2) cubic-bezier(.5,0,.5,1) infinite;transform-origin:160px 160px">
            <circle cx="160" cy="160" r="104" fill="none" stroke="currentColor" stroke-width="1.5"
              filter="url(#gf-<%= badgeId %>)"
              style="color:var(--c-ring);animation:ft-breathe-slow 6.3s ease-in-out infinite"/>
            <g style="color:var(--c-ring);fill:currentColor">
              <polygon points="160,100.5 164,104 160,107.5 156,104" opacity=".88"/>
              <polygon points="264,160 267.5,164 264,167.5 260.5,164" opacity=".88"/>
              <polygon points="160,212.5 164,216 160,219.5 156,216" opacity=".88"/>
              <polygon points="56,160 59.5,164 56,167.5 52.5,164" opacity=".88"/>
            </g>
          </g>

          <%# Anneau 3 CW lent — r104.5 + r123.5 + glyphes runiques %>
          <g style="animation:ft-cw var(--dur-rb) linear infinite;transform-origin:160px 160px">
            <circle cx="160" cy="160" r="104.5" fill="none" stroke="currentColor" stroke-width=".6" opacity=".5" style="color:var(--c-ring)"/>
            <circle cx="160" cy="160" r="123.5" fill="none" stroke="currentColor" stroke-width=".6" opacity=".5" style="color:var(--c-ring)"/>
            <text fill="currentColor" font-family="Georgia,serif" font-size="14"
              filter="url(#gg-<%= badgeId %>)"
              style="color:var(--c-glyph);animation:ft-glyph-flicker 4.2s ease-in-out infinite">
              <textPath href="#gp-<%= badgeId %>" startOffset="0%" textLength="672" lengthAdjust="spacing">ᚠ⌖ᚦᚨᛉ☽ᚱ⊕ᛒᛏ△ᚷᛚ⟁ᚹᛜ✦ᚺ⌘ᚾᛞ⊗ᛁᛃ⧖ᛇᛈ⊛ᛉ☿ᚠ⌖ᚦᛟ△ᚨᛊ⟁ᚱ⌘ᚲᛗ⊕ᚷᛖ☽ᚹᚺ⊗ᚾ</textPath>
            </text>
          </g>

          <%# Anneau 4 CCW — r124 fractal pulse %>
          <g style="animation:ft-ccw var(--dur-r3) cubic-bezier(.4,.1,.6,.9) infinite;transform-origin:160px 160px">
            <circle cx="160" cy="160" r="124" fill="none" stroke="currentColor" stroke-width="1.5"
              filter="url(#gf-<%= badgeId %>)"
              style="color:var(--c-ring);animation:ft-fractal-pulse 3.5s ease-in-out infinite"/>
          </g>

          <%# Anneau 5 CW — r136 pointillés %>
          <g style="animation:ft-cw var(--dur-r4) cubic-bezier(.45,.05,.55,.95) infinite;transform-origin:160px 160px">
            <circle cx="160" cy="160" r="136" fill="none" stroke="currentColor" stroke-width=".9"
              stroke-dasharray="3 8" opacity=".4"
              style="color:var(--c-ring);animation:ft-breathe-fast 6.2s ease-in-out infinite"/>
          </g>

          <%# Carré A CW %>
          <g style="animation:ft-cw var(--dur-sqa) cubic-bezier(.3,.1,.7,.9) infinite;transform-origin:160px 160px"
            filter="url(#gs-<%= badgeId %>)">
            <rect x="92.1" y="92.1" width="135.8" height="135.8" fill="none" stroke="currentColor"
              style="color:var(--c-star);animation:ft-star-pulse-a 3.8s ease-in-out infinite"/>
          </g>

          <%# Carré B CCW rot 22.5° %>
          <g style="animation:ft-ccw var(--dur-sqb) cubic-bezier(.6,0,.4,1) infinite;transform-origin:160px 160px"
            filter="url(#gs-<%= badgeId %>)">
            <rect x="92.1" y="92.1" width="135.8" height="135.8" fill="none" stroke="currentColor"
              transform="rotate(22.5,160,160)"
              style="color:var(--c-star);animation:ft-star-pulse-b 5.1s ease-in-out infinite .9s"/>
          </g>
        </g>
      </svg>
    </div>

    <%# ── SVG OVER (carrés par-dessus la photo) ── %>
    <div class="gm-badge__svg-over" style="width:72px;height:72px" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="72" height="72" xmlns="http://www.w3.org/2000/svg" style="overflow:hidden;display:block">
        <defs>
          <filter id="gso-<%= badgeId %>" x="0%" y="0%" width="100%" height="100%">
            <feGaussianBlur stdDeviation="1" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <clipPath id="cpo-<%= badgeId %>"><circle cx="160" cy="160" r="136"/></clipPath>
        </defs>
        <g clip-path="url(#cpo-<%= badgeId %>)">
          <g style="animation:ft-cw var(--dur-sqa) cubic-bezier(.3,.1,.7,.9) infinite;transform-origin:160px 160px"
            filter="url(#gso-<%= badgeId %>)">
            <rect x="92.1" y="92.1" width="135.8" height="135.8" fill="none" stroke="currentColor"
              style="color:var(--c-star);animation:ft-star-pulse-a 3.8s ease-in-out infinite"/>
          </g>
          <g style="animation:ft-ccw var(--dur-sqb) cubic-bezier(.6,0,.4,1) infinite;transform-origin:160px 160px"
            filter="url(#gso-<%= badgeId %>)">
            <rect x="92.1" y="92.1" width="135.8" height="135.8" fill="none" stroke="currentColor"
              transform="rotate(22.5,160,160)"
              style="color:var(--c-star);animation:ft-star-pulse-b 5.1s ease-in-out infinite .9s"/>
          </g>
        </g>
      </svg>
    </div>
  </div>
  <span class="ft__badge-label" title="<%= ariaLabel %>"><%= label %></span>
</div>
