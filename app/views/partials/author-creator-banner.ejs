<%
  /* Bannière « Les créations de … » d'un créateur partenaire, construite en HTML (bas de page,
     avant le pied de page). Données réelles uniquement : avatar, nom, bio, compteurs du site et
     publications les plus populaires (creatorPosts, ordre du plus au moins populaire).
     Deux rails de vignettes défilent en sens inverse, chacun parcourable à la main (creator-banner.js). */
  const cb = creatorBanner;
  const th = cb.theme;
  const soc = cb.socials || {};
  const _posts = creatorPosts || [];
  const _n = _posts.length;
  // Deux rails : répartis une publication sur deux si la galerie est grande, sinon les deux rails
  // montrent toutes les vignettes (le second décalé) pour rester vivants.
  let rowA = _posts, rowB = _posts;
  if (_n >= 8) {
    rowA = _posts.filter((_, i) => i % 2 === 0);
    rowB = _posts.filter((_, i) => i % 2 === 1);
  } else if (_n > 1) {
    const k = Math.ceil(_n / 2);
    rowB = _posts.slice(k).concat(_posts.slice(0, k));
  }
  const _avatar = author.picture || '/images/image-default-profile.jpg';
  const _mini = (typeof cldCard === 'function') ? cldCard(_avatar) : _avatar;
%>
<section class="creator-showcase" id="creatorShowcase" aria-label="Les créations de <%= author.pseudo %>">
  <div class="cs-wrap">
    <div class="creator-banner" style="--creator-primary: <%= th.primary %>; --creator-accent: <%= th.accent %>;<% if (th.bannerBg) { %> --cb-watermark: url('<%= th.bannerBg %>');<% } %>">

      <svg class="cb-deco cb-deco--heart1" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.6 5 5.9 5c1.9 0 3.3 1 4.1 2.4C10.8 6 12.2 5 14.1 5c3.3 0 5 3.4 3.5 6.8C19.5 16.4 12 21 12 21z" fill="currentColor"/></svg>
      <svg class="cb-deco cb-deco--daisy" viewBox="0 0 40 40" aria-hidden="true"><g fill="#fff" stroke="rgba(0,0,0,.1)" stroke-width=".6"><ellipse cx="20" cy="8" rx="5" ry="8"/><ellipse cx="20" cy="32" rx="5" ry="8"/><ellipse cx="8" cy="20" rx="8" ry="5"/><ellipse cx="32" cy="20" rx="8" ry="5"/><ellipse cx="11.5" cy="11.5" rx="5" ry="8" transform="rotate(-45 11.5 11.5)"/><ellipse cx="28.5" cy="28.5" rx="5" ry="8" transform="rotate(-45 28.5 28.5)"/><ellipse cx="28.5" cy="11.5" rx="8" ry="5" transform="rotate(-45 28.5 11.5)"/><ellipse cx="11.5" cy="28.5" rx="8" ry="5" transform="rotate(-45 11.5 28.5)"/></g><circle cx="20" cy="20" r="5.2" fill="#F6C945"/></svg>

      <div class="creator-banner__left">
        <div class="cb-top">
          <div class="cb-headline">
            <h2 class="cb-title" id="creatorBannerTitle">
              <span class="cb-title__brush"><%= th.title || 'Les créations de' %></span>
              <span class="cb-title__name"><%= author.pseudo %></span>
            </h2>
            <% if (th.signature) { %>
            <p class="cb-signature"><% th.signature.split(/\s*[•·|]\s*/).filter(Boolean).forEach(function(part, i) { %><% if (i) { %><span class="cb-heart" aria-hidden="true">•</span><% } %><span><%= part %></span><% }) %></p>
            <% } %>
          </div>
        </div>

        <div class="cb-profile">
          <span class="cb-avatar"><img src="<%= _mini %>" alt="Avatar de <%= author.pseudo %>" width="124" height="124" loading="lazy" decoding="async" /></span>
          <div class="cb-info">
            <div class="cb-id">
              <p class="cb-handle"><%= cb.handle ? '@' + cb.handle : author.pseudo %></p>
              <% if (author.special_title) { %><p class="cb-badge"><i data-lucide="award" width="12" height="12" aria-hidden="true"></i><%= author.special_title %></p><% } %>
            </div>
            <div class="cb-stats">
              <span class="cb-stat"><b><%= recipesCount %></b> recette<%= recipesCount > 1 ? 's' : '' %> sur Ciné Délices</span>
              <% if (_n) { %><span class="cb-stat"><b><%= _n %></b> publication<%= _n > 1 ? 's' : '' %> à la une</span><% } %>
            </div>
            <% if (soc.tiktok) { %>
            <a class="cb-tiktok" href="<%= soc.tiktok %>" target="_blank" rel="noopener noreferrer nofollow" aria-label="TikTok de <%= author.pseudo %> (nouvel onglet)">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              TikTok <span aria-hidden="true">↗</span>
            </a>
            <% } %>
          </div>
        </div>
        <% if (author.bio) { %><p class="cb-bio"><%= author.bio.replace(/\n{2,}/g, "\n") %></p><% } %>
      </div>

      <% if (_n) { %>
      <div class="creator-banner__right" aria-label="Publications les plus populaires de <%= author.pseudo %>">
        <% [['left', rowA, 34], ['right', rowB, 28]].forEach(function(row, ri) { %>
        <div class="cb-row" data-dir="<%= row[0] %>" data-speed="<%= row[2] %>">
          <button type="button" class="cb-nav cb-nav--prev" aria-label="Ligne <%= ri + 1 %> : publications précédentes"><i data-lucide="chevron-left" width="18" height="18" aria-hidden="true"></i></button>
          <div class="cb-viewport" tabindex="0" role="group" aria-label="Ligne <%= ri + 1 %> de publications">
            <div class="cb-track">
              <% row[1].forEach(function(post) { %>
              <a class="cb-thumb" href="<%= post.url %>" title="<%= post.title || '' %>" target="_blank" rel="noopener noreferrer nofollow" aria-label="<%= (post.title || 'Voir la publication') %> sur TikTok (nouvel onglet)">
                <% if (post.cover_url) { %><img src="<%= post.cover_url %>" alt="" width="132" height="176" loading="lazy" decoding="async" /><% } %>
                <span class="cb-thumb__badge" aria-hidden="true"><i data-lucide="play" width="10" height="10"></i></span>
              </a>
              <% }) %>
            </div>
          </div>
          <button type="button" class="cb-nav cb-nav--next" aria-label="Ligne <%= ri + 1 %> : publications suivantes"><i data-lucide="chevron-right" width="18" height="18" aria-hidden="true"></i></button>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>
