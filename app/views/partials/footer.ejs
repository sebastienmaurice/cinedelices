<footer class="footer">
  <div class="footer-main">
    <!-- Colonne gauche : Logo et slogan -->
    <div class="footer-left">
      <div class="footer-logo-container">
        <img
          src="/images/logo-cine-delices-2025.png"
          alt="Logo Ciné Délices"
          class="footer-logo"
        />
        <h2 class="footer-logo-text">
          <span class="cine">Ciné</span>
          <span class="delices">Délices</span>
        </h2>
      </div>
      <p class="footer-slogan">Le goût du cinéma, et le cinéma du goût.</p>
    </div>

    <!-- Colonne; droite : Navigation et réseaux sociaux -->
    <div class="footer-right">
      <nav class="footer-menu">
        <a href="/" class="footer-menu-link">Accueil</a>
        <a href="/movies" class="footer-menu-link">Films</a>
        <a href="#" class="footer-menu-link">Recettes</a>
        <a href="#" class="footer-menu-link">A propos</a>
        <a href="#" class="footer-menu-link">Mention légales</a>
      </nav>

      <nav class="social-links">
        <a
          href="#"
          class="social-link social-link--facebook"
          title="Facebook"
          aria-label="Facebook"
        >
          <svg class="icon" viewBox="0 0 24 24">
            <path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            />
          </svg>
        </a>
        <a
          href="#"
          class="social-link social-link--instagram"
          title="Instagram"
          aria-label="Instagram"
        >
          <svg class="icon" viewBox="0 0 24 24">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
        </a>
        <a
          href="#"
          class="social-link social-link--github"
          title="GitHub"
          aria-label="GitHub"
        >
          <svg class="icon" viewBox="0 0 24 24">
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
        <a
          href="#"
          class="social-link social-link--linkedin"
          title="LinkedIn"
          aria-label="LinkedIn"
        >
          <svg class="icon" viewBox="0 0 24 24">
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            />
            <rect width="4" height="12" x="2" y="9" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
      </nav>
    </div>
  </div>

  <!-- Ligne de séparation cinématographique -->
  <div class="footer-divider"></div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <a href="#" class="back-to-top" aria-label="Remonter en haut de page"
      >↑ Haut</a
    >
    <p class="footer-copyright">
      &copy <%= new Date().getFullYear() %> Ciné Délices — Tous droits réservés
    </p>
  </div>
</footer>

<div class="confirm-modal" data-confirm-modal aria-hidden="true">
  <div class="confirm-modal__backdrop" data-confirm-close></div>
  <div class="confirm-modal__dialog" role="dialog" aria-modal="true">
    <h3 class="confirm-modal__title">
      <span class="confirm-modal__icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide-icon"
        >
          <path
            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
          />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </svg>
      </span>
      <span class="confirm-modal__title-text">Confirmer l'action</span>
    </h3>
    <p class="confirm-modal__message"></p>
    <div class="confirm-modal__actions">
      <button type="button" class="btn btn--ghost btn--sm" data-confirm-cancel>
        Annuler
      </button>
      <button type="button" class="btn btn--primary btn--sm" data-confirm-accept>
        Confirmer
      </button>
    </div>
  </div>
</div>

<script type="module" src="/js/confirm-actions.js"></script>
<script src="/js/confirm-modal.js" defer></script>

<!-- Fond scintillant cinématographique -->
<canvas id="cinedelices-bg" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<script src="/js/starfield.js" defer></script>
