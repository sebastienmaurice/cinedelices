<!-- ── Bannière de consentement cookies ────────────────────────── -->
<div id="cookie-banner" role="dialog" aria-live="polite" aria-label="Gestion des cookies">
  <div class="ck-inner">
    <div class="ck-shimmer"></div>

    <span class="ck-icon" aria-hidden="true">🍪</span>

    <div class="ck-body">
      <p class="ck-eyebrow">Cookies &amp; Confidentialité</p>
      <p class="ck-title">Votre expérience, vos choix</p>
      <p class="ck-desc">
        Ciné Délices utilise des cookies pour assurer le bon fonctionnement du site et mémoriser vos préférences.
        Aucune donnée n'est revendue ni transmise à des tiers à des fins publicitaires.
        <a href="/mentions-legales#cookies">En savoir plus</a>
      </p>
    </div>

    <div class="ck-actions">
      <button id="ck-accept" class="ck-btn ck-btn--accept" type="button">
        Tout accepter
      </button>
      <button id="ck-refuse" class="ck-btn ck-btn--refuse" type="button">
        Continuer sans accepter
      </button>
    </div>
  </div>
</div>
<script src="/js/cookie-banner.js" defer></script>
