<!-- ── Bannière de consentement cookies ────────────────────────── -->
<div id="cookie-banner" role="dialog" aria-live="polite" aria-label="Gestion des cookies">
  <div class="ck-inner">
    <div class="ck-shimmer"></div>

    <span class="ck-icon" aria-hidden="true">🍪</span>

    <div class="ck-body">
      <p class="ck-eyebrow">Cookies &amp; Confidentialité</p>
      <p class="ck-title">Votre expérience, vos choix</p>
      <p class="ck-desc">
        Ciné Délices utilise des cookies pour assurer le bon fonctionnement du site et mémoriser vos préférences.
        Aucune donnée n'est revendue ni transmise à des tiers à des fins publicitaires.
        <a href="/mentions-legales#cookies">En savoir plus</a>
      </p>

      <!-- Choix granulaires RGPD -->
      <div class="ck-choices" role="group" aria-label="Choisir vos préférences cookies">
        <label class="ck-choice ck-choice--disabled">
          <input type="checkbox" checked disabled aria-label="Cookies nécessaires — toujours actifs" />
          <span class="ck-choice__box" aria-hidden="true"></span>
          <span class="ck-choice__label">
            <strong>Nécessaires</strong>
            <span>Authentification, session — toujours actifs</span>
          </span>
        </label>
        <label class="ck-choice">
          <input type="checkbox" id="ck-analytics" aria-label="Cookies analytiques — optionnels" />
          <span class="ck-choice__box" aria-hidden="true"></span>
          <span class="ck-choice__label">
            <strong>Analytiques</strong>
            <span>Mesure d'audience anonyme — optionnels</span>
          </span>
        </label>
      </div>
    </div>

    <div class="ck-actions">
      <button id="ck-accept" class="ck-btn ck-btn--accept" type="button">
        Tout accepter
      </button>
      <button id="ck-save" class="ck-btn ck-btn--save" type="button">
        Enregistrer mes choix
      </button>
      <button id="ck-refuse" class="ck-btn ck-btn--refuse" type="button">
        Tout refuser
      </button>
    </div>
  </div>
</div>
<script src="/js/cookie-banner.js" defer></script>
