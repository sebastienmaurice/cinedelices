<header class="header">
  <a href="/" class="title">
    <img
      src="/images/logo-cine-delices-2025.png"
      alt="Logo Ciné Délices"
      class="logo-header"
    />
    <span class="title-cine">Ciné</span>
    <span class="title-delices">Délices</span>
  </a>

  <nav class="navigationheader" id="site-nav" aria-hidden="true">
    <a href="/" class="navigationheader-link">Accueil</a>
    <!-- admin visible uniquement avec role admin -->
    <% if (role === "admin") { %>
    <a href="/admin/" class="navigationheader-link">Admin</a>
    <% } %>
    <a href="/movies" class="navigationheader-link">Films</a>
    <a href="/contact-about/" class="navigationheader-link">Contact</a>

    <% if (typeof role === "undefined") { %>
    <!-- Bouton Mon compte pour utilisateur non connecté (menu burger) -->
    <div class="navigationheader-auth">
      <button type="button" class="header-icon header-icon--account js-open-login" title="Mon compte">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="header-icon__label">Mon compte</span>
      </button>
    </div>
    <% } %>

    <% if (typeof role !== "undefined") { %>
    <!-- Boutons utilisateur connecté (menu burger) -->
    <div class="navigationheader-auth">
      <!-- Favoris -->
      <a href="/auth/profil/<%= userId %>#favoris" class="header-icon" title="Mes favoris">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        <span class="header-icon__label">Favoris</span>
      </a>

      <!-- Dropdown Mon compte (mobile) -->
      <div class="mobile-account-dropdown">
        <button type="button" class="header-icon header-icon--account mobile-account-dropdown__trigger" id="mobileAccountTrigger" aria-expanded="false" aria-haspopup="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="header-icon__label">Mon compte</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon mobile-account-dropdown__arrow"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="mobile-account-dropdown__menu" id="mobileAccountMenu" aria-hidden="true">
          <a href="/auth/profil/<%= userId %>" class="mobile-account-dropdown__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Mon profil</span>
          </a>
          <a href="/auth/logout" class="mobile-account-dropdown__item mobile-account-dropdown__item--logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            <span>Se déconnecter</span>
          </a>
        </div>
      </div>
    </div>
    <% } %>
  </nav>

  <!-- Boutons header desktop (non connecté) -->
  <% if (typeof role === "undefined") { %>
  <div class="buttons__header">
    <!-- Dropdown connexion -->
    <div class="user-dropdown" id="authDropdown">
      <button class="header-icon header-icon--account user-dropdown__trigger" id="authDropdownTrigger" aria-expanded="false" aria-haspopup="true" title="Mon compte">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </button>
      <div class="user-dropdown__menu" id="authDropdownMenu" aria-hidden="true">
        <button type="button" class="user-dropdown__item js-open-login">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Se connecter</span>
        </button>
        <button type="button" class="user-dropdown__item user-dropdown__item--register js-open-register">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          <span>Créer un compte</span>
        </button>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Boutons header desktop (connecté) -->
  <% if (typeof role !== "undefined") { %>
  <div class="buttons__header">
    <a href="/auth/profil/<%= userId %>#favoris" class="header-icon" id="btnFavorites" title="Mes favoris">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
    </a>
    <!-- Dropdown utilisateur -->
    <div class="user-dropdown" id="userDropdown">
      <button class="header-icon header-icon--account user-dropdown__trigger" id="userDropdownTrigger" aria-expanded="false" aria-haspopup="true" title="Mon compte">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </button>
      <div class="user-dropdown__menu" id="userDropdownMenu" aria-hidden="true">
        <a href="/auth/profil/<%= userId %>" class="user-dropdown__item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Mon compte</span>
        </a>
        <a href="/auth/logout" class="user-dropdown__item user-dropdown__item--logout">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
          <span>Se déconnecter</span>
        </a>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Burger menu for mobile -->
  <button class="burger-menu" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="site-nav">
    <span class="burger-line"></span>
    <span class="burger-line"></span>
    <span class="burger-line"></span>
  </button>
</header>
<script>
  (function () {
    const current = location.pathname;
    const links = document.querySelectorAll(".navigationheader-link");
    links.forEach((a) => {
      const href = a.getAttribute("href");
      if (href === "/" && current === "/") {
        a.classList.add("is-active");
      } else if (href === "/movies" && current.startsWith("/movies")) {
        a.classList.add("is-active");
      } else if (href === "/contact" && current.startsWith("/contact")) {
        a.classList.add("is-active");
      } else if (href && href !== "/" && current.startsWith(href)) {
        a.classList.add("is-active");
      }
    });
  })();
</script>

<!-- ===================== MODAL AUTH ===================== -->
<div id="authModal" class="modal">
  <div id="modalOverlay" class="modal-overlay"></div>
  <div class="modal-content">
    <button id="modalClose" class="modal-close">&times;</button>

    <!-- ===== Connexion ===== -->
    <div id="loginForm" class="auth-form active">
      <h2>Connexion</h2>
      <form method="POST" action="/auth/login">
        <input name="pseudo" placeholder="Pseudo ou adresse e-mail" required />
        <input
          name="password"
          type="password"
          placeholder="Mot de passe"
          required
        />
        <button type="submit" class="btn btn--primary btn--full">
          Se connecter
        </button>
      </form>
      <p class="switch-form">
        Pas encore de compte ?
        <button id="goToRegister" class="btn-link">S'inscrire</button>
      </p>
    </div>

    <!-- ===== Inscription ===== -->
    <div id="registerForm" class="auth-form">
      <h2>Inscription</h2>
    
      <form method="POST" action="/auth/register">
        
        <div class="form-group">
          <input name="first_name" placeholder="Prénom" required />
          <p class="help">Votre prénom ne doit pas dépasser 100 caractères.</p>
        </div>
    
        <div class="form-group">
          <input name="last_name" placeholder="Nom" required />
          <p class="help">Votre nom ne doit pas dépasser 100 caractères.</p>
        </div>
    
        <div class="form-group">
          <input name="pseudo" placeholder="Nom d'utilisateur" required />
          <p class="help">Seulement lettres, chiffres et underscores ( _ ).</p>
        </div>
    
        <div class="form-group">
          <input name="email" type="email" placeholder="Adresse e-mail" required />
          <p class="help">Entrez une adresse e-mail valide (ex : nom@gmail.com).</p>
        </div>
    
        <div class="form-group">
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Mot de passe"
            required
          />
          <p class="help">
            Min. 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial.
          </p>
        </div>
    
        <div class="form-group">
          <input
            id="confirmPassword"
            name="confirm_password"
            type="password"
            placeholder="Confirmer le mot de passe"
            required
          />
          <p class="help">Doit être identique au mot de passe.</p>
        </div>

        <!-- <input type="hidden" name="role" value="admin"> -->
        
        <div id="errorMessage" class="error">
          * Les mots de passe ne correspondent pas.
        </div>
    
        <button type="submit" class="btn btn--red btn--full">
          Créer mon compte
        </button>
      </form>
    
      <p class="switch-form">
        Déjà un compte ?
        <button id="goToLogin" class="btn-link">Se connecter</button>
      </p>
    </div>
  </div>
</div>

<script src="/js/popup-connexion.js"></script>
<script src="/js/register-form.js"></script>

<!-- Dropdowns et boutons auth -->
<script>
(function() {
  // ===== Gestion des dropdowns =====
  function initDropdown(dropdownId, triggerId, menuId) {
    const dropdown = document.getElementById(dropdownId);
    const trigger = document.getElementById(triggerId);
    const menu = document.getElementById(menuId);

    if (!dropdown || !trigger || !menu) return null;

    function openDropdown() {
      // Fermer tous les autres dropdowns
      document.querySelectorAll('.user-dropdown.is-open').forEach(d => {
        if (d !== dropdown) d.classList.remove('is-open');
      });
      dropdown.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
    }

    function closeDropdown() {
      dropdown.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    }

    // Toggle dropdown
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (dropdown.classList.contains('is-open')) {
        closeDropdown();
      } else {
        openDropdown();
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
        items[nextIndex].focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prevIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
        items[prevIndex].focus();
      }
    });

    return { dropdown, trigger, menu, closeDropdown };
  }

  // Initialiser les deux dropdowns
  const userDropdown = initDropdown('userDropdown', 'userDropdownTrigger', 'userDropdownMenu');
  const authDropdown = initDropdown('authDropdown', 'authDropdownTrigger', 'authDropdownMenu');

  // Fermer au clic extérieur
  document.addEventListener('click', (e) => {
    if (userDropdown && !userDropdown.dropdown.contains(e.target)) {
      userDropdown.closeDropdown();
    }
    if (authDropdown && !authDropdown.dropdown.contains(e.target)) {
      authDropdown.closeDropdown();
    }
  });

  // Fermer avec Échap
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (userDropdown && userDropdown.dropdown.classList.contains('is-open')) {
        userDropdown.closeDropdown();
        userDropdown.trigger.focus();
      }
      if (authDropdown && authDropdown.dropdown.classList.contains('is-open')) {
        authDropdown.closeDropdown();
        authDropdown.trigger.focus();
      }
    }
  });

  // ===== Boutons pour ouvrir le popup auth =====
  // Utilise openModal() de popup-connexion.js
  document.querySelectorAll('.js-open-login').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      // Fermer le dropdown si ouvert
      if (authDropdown) authDropdown.closeDropdown();
      // Ouvrir le modal en mode connexion
      if (typeof openModal === 'function') {
        openModal('login');
      }
    });
  });

  document.querySelectorAll('.js-open-register').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      // Fermer le dropdown si ouvert
      if (authDropdown) authDropdown.closeDropdown();
      // Ouvrir le modal en mode inscription
      if (typeof openModal === 'function') {
        openModal('register');
      }
    });
  });

  // ===== Gestion du dropdown Mon compte (mobile) =====
  const mobileAccountDropdown = document.querySelector('.mobile-account-dropdown');
  const mobileAccountTrigger = document.getElementById('mobileAccountTrigger');

  if (mobileAccountDropdown && mobileAccountTrigger) {
    mobileAccountTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileAccountDropdown.classList.toggle('is-open');
      const isOpen = mobileAccountDropdown.classList.contains('is-open');
      mobileAccountTrigger.setAttribute('aria-expanded', isOpen);
      const menu = document.getElementById('mobileAccountMenu');
      if (menu) {
        menu.setAttribute('aria-hidden', !isOpen);
      }
    });

    // Fermer au clic extérieur (mobile)
    document.addEventListener('click', (e) => {
      if (!mobileAccountDropdown.contains(e.target)) {
        mobileAccountDropdown.classList.remove('is-open');
        mobileAccountTrigger.setAttribute('aria-expanded', 'false');
        const menu = document.getElementById('mobileAccountMenu');
        if (menu) menu.setAttribute('aria-hidden', 'true');
      }
    });
  }
})();
</script>
