          <div class="dropdown__sep"></div>
          <button type="button" class="dropdown__item js-open-register">
            <span class="dropdown__icon">
              <i data-lucide="user-plus" aria-hidden="true"></i>
            </span>
            Créer un compte
          </button>
        </div>
      </div>
      <% } %>

      <!-- Connecté : dropdown compte -->
      <% if (typeof role !== "undefined") { %>
      <div class="user-dropdown" id="userDropdown">
        <button
          class="header-icon header-icon--account user-dropdown__trigger nav-badge-trigger"
