    <!-- Hamburger mobile -->
    <button
      class="nav-hamburger"
      id="navHamburger"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <span class="nav-hamburger__line"></span>
      <span class="nav-hamburger__line"></span>
      <span class="nav-hamburger__line"></span>
    </button>
  </div>
</nav>

<!-- ===================== MOBILE DRAWER ===================== -->
<div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
  <div class="mobile-drawer__backdrop" id="drawerBackdrop"></div>
  <div class="mobile-drawer__panel" role="dialog" aria-label="Menu navigation mobile">

    <div class="mobile-drawer__header">
      <span class="mobile-drawer__logo">Ciné Délices</span>
      <button class="mobile-drawer__close" id="drawerClose" aria-label="Fermer le menu">✕</button>
    </div>

    <!-- Bloc utilisateur connecté -->
    <% if (typeof role !== "undefined") { %>
    <div class="mobile-drawer__user">
      <div class="mobile-drawer__user-av">
        <img src="<%= navAvatar || '/images/image-default-profile.jpg' %>" alt="" class="mobile-drawer__user-photo" />
        <% if (typeof navFrameUrl !== 'undefined' && navFrameUrl) { %>
        <img src="<%= navFrameUrl %>" alt="" class="mobile-drawer__user-frame" aria-hidden="true" />
        <% } %>
      </div>
      <div class="mobile-drawer__user-info">
        <span class="mobile-drawer__user-name"><%= typeof navPseudo !== 'undefined' && navPseudo ? navPseudo : 'Mon compte' %></span>
        <span class="mobile-drawer__user-role">
          <% if (role === 'admin' || role === 'superadmin' || role === 'super_admin') { %>
          <i data-lucide="shield" width="9" height="9" aria-hidden="true"></i> Administrateur
          <% } else { %>
          <i data-lucide="star" width="9" height="9" aria-hidden="true"></i> Membre
          <% } %>
        </span>
      </div>
    </div>
    <% } %>

    <nav class="mobile-drawer__nav" aria-label="Navigation mobile">
