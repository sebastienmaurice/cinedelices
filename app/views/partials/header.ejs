<!-- ===================== SEARCH OVERLAY ===================== -->
<div class="search-overlay" id="searchOverlay" aria-hidden="true" role="dialog" aria-label="Recherche">
  <div class="search-overlay__backdrop" id="searchBackdrop"></div>
  <div class="search-overlay__box">
    <form class="search-overlay__inner" id="searchForm" action="/movies/search-advanced" method="GET">
      <i data-lucide="search" width="20" height="20" aria-hidden="true"></i>
      <input
        type="text"
        name="query"
        class="search-overlay__input"
        id="searchInput"
        placeholder="Ex : Harry Potter, Ratatouille, tarte…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <button type="button" class="search-overlay__close" id="searchClose" aria-label="Fermer">✕</button>
    </form>
    <p class="search-overlay__hint">Appuyez sur <kbd>Entrée</kbd> pour rechercher &nbsp;·&nbsp; <kbd>Échap</kbd> pour fermer</p>
  </div>
</div>

<!-- ===================== MODAL AUTH ===================== -->
<div id="authModal" class="modal" aria-hidden="true">
  <div id="modalOverlay" class="modal-overlay"></div>
  <div class="modal-content"
       role="dialog"
       aria-modal="true"
       aria-labelledby="auth-modal-title">
    <!-- Titre accessible partagé entre login/register — mis à jour par JS -->
    <span id="auth-modal-title" class="sr-only">Connexion</span>
    <button id="modalClose" class="modal-close" aria-label="Fermer">
      <i data-lucide="x" width="18" height="18" stroke-width="2.5" aria-hidden="true"></i>
    </button>

    <!-- ===== Connexion ===== -->
    <div id="loginForm" class="auth-form active">
      <h2>Connexion</h2>
      <p id="loginModalHint" class="auth-form__hint" style="display:none"></p>
      <form method="POST" action="/auth/login">
        <input name="pseudo" placeholder="Pseudo ou adresse e-mail" required />
        <input
          name="password"
          type="password"
          placeholder="Mot de passe"
          required
        />
        <button type="submit" class="btn btn--primary btn--full">
          Se connecter
        </button>
      </form>
      <p class="switch-form switch-form--forgot" style="margin-top:8px;">
        <a href="/auth/forgot-password" class="btn-link">Mot de passe / identifiant oublié ?</a>
      </p>

      <div class="auth-divider"><span>ou</span></div>
      <button type="button" class="btn btn--google btn--full js-google-signin">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Se connecter avec Google
      </button>

      <p class="switch-form">
        Pas encore de compte ?
        <button id="goToRegister" class="btn-link">S'inscrire</button>
      </p>
    </div>

    <!-- ===== Inscription ===== -->
    <div id="registerForm" class="auth-form">
      <h2>Inscription</h2>

      <form method="POST" action="/auth/register">

        <div class="form-group">
          <input name="pseudo" placeholder="Mon Pseudo" required />
          <p class="help">Lettres, chiffres, underscore ( _ ). C'est ton identité sur Ciné Délices.</p>
        </div>

        <div class="form-group">
          <input name="email" type="email" placeholder="Adresse e-mail" required />
          <p class="help">ex : nom@gmail.com</p>
        </div>

        <div class="form-group">
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Mot de passe"
            required
          />
          <p class="help">Min. 8 car. — majuscule, chiffre, caractère spécial.</p>
        </div>

        <div class="form-group">
          <input
            id="confirmPassword"
            name="confirm_password"
            type="password"
            placeholder="Confirmer le mot de passe"
            required
          />
          <p class="help">Identique au mot de passe.</p>
        </div>

        <div id="errorMessage" class="error">
          * Les mots de passe ne correspondent pas.
        </div>

        <!-- Consentement RGPD obligatoire -->
        <label class="rgpd-consent">
          <input
            type="checkbox"
            name="rgpd_consent"
            id="rgpdConsent"
            required
            aria-required="true"
          />
          <span>
            J'ai lu et j'accepte la
            <a href="/mentions-legales#cookies" target="_blank" rel="noopener">Politique de confidentialité</a>
            et le traitement de mes données personnelles. <span class="required-star">*</span>
          </span>
        </label>

        <button type="submit" class="btn btn--red btn--full">
          Créer mon compte
        </button>
      </form>

      <div class="auth-divider"><span>ou</span></div>
      <button type="button" class="btn btn--google btn--full js-google-signin">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        S'inscrire avec Google
      </button>

      <p class="switch-form">
        Déjà un compte ?
        <button id="goToLogin" class="btn-link">Se connecter</button>
      </p>
    </div>

    <!-- ===== Choix du pseudo (nouveau compte Google) ===== -->
    <div id="googlePseudoForm" class="auth-form">
      <h2>Choisissez votre pseudo</h2>
      <p class="auth-form__hint" style="display:block;margin-bottom:1.2rem;">
        Votre pseudo est votre identité sur Ciné Délices. Choisissez-le bien !
      </p>
      <div class="form-group">
        <input
          id="googlePseudoInput"
          type="text"
          placeholder="pseudo_exemple"
          maxlength="20"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        />
        <p class="help">3 à 20 caractères : lettres minuscules, chiffres, underscore (_).</p>
      </div>
      <p id="googlePseudoError" class="error" style="display:none"></p>
      <button id="googlePseudoSubmit" type="button" class="btn btn--primary btn--full">
        Confirmer
      </button>
      <p class="switch-form" style="margin-top:0.75rem;">
        <button id="googlePseudoBack" class="btn-link">← Retour</button>
      </p>
    </div>

  </div>
</div>

<meta name="google-client-id" content="<%= googleClientId || '' %>">
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script src="/js/popup-connexion.js" defer></script>
<script src="/js/register-form.js" defer></script>
<script src="/js/google-auth.js" defer></script>

<script>
(function () {
  /* ── Active nav link ── */
  const current = location.pathname;
  document.querySelectorAll(".nav-link, .mobile-drawer__link").forEach((a) => {
    const href = a.getAttribute("href");
    if (href === "/" && current === "/") {
      a.classList.add("nav-link--active");
    } else if (href && href !== "/" && current.startsWith(href)) {
      a.classList.add("nav-link--active");
    }
  });

  /* ── Scroll glassmorphism ── */
  const navBar = document.getElementById("site-header");
  if (navBar) {
    const onScroll = () => navBar.classList.toggle("scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  /* ── Mobile drawer ── */
  const hamburger     = document.getElementById("navHamburger");
  const drawer        = document.getElementById("mobileDrawer");
  const drawerClose   = document.getElementById("drawerClose");
  const drawerBackdrop = document.getElementById("drawerBackdrop");

  function openDrawer() {
    drawer.classList.add("is-open");
    drawer.setAttribute("aria-hidden", "false");
    hamburger.classList.add("is-open");
    hamburger.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }
  function closeDrawer() {
    drawer.classList.remove("is-open");
    drawer.setAttribute("aria-hidden", "true");
    hamburger.classList.remove("is-open");
    hamburger.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  hamburger?.addEventListener("click", () => {
    drawer.classList.contains("is-open") ? closeDrawer() : openDrawer();
  });
  drawerClose?.addEventListener("click", closeDrawer);
  drawerBackdrop?.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDrawer(); });

  /* ── Dropdowns desktop ── */
  function initDropdown(dropdownId, triggerId, menuId) {
    const dropdown = document.getElementById(dropdownId);
    const trigger  = document.getElementById(triggerId);
    const menu     = document.getElementById(menuId);
    if (!dropdown || !trigger || !menu) return null;

    function openDropdown() {
      document.querySelectorAll(".user-dropdown.is-open").forEach((d) => {
        if (d !== dropdown) {
          d.classList.remove("is-open");
          d.querySelector(".dropdown-trigger")?.classList.remove("is-open");
        }
      });
      dropdown.classList.add("is-open");
      trigger.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
    }
    function closeDropdown() {
      dropdown.classList.remove("is-open");
      trigger.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    }
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      dropdown.classList.contains("is-open") ? closeDropdown() : openDropdown();
    });
    return { dropdown, trigger, menu, closeDropdown };
  }

  const userDropdown = initDropdown("userDropdown", "userDropdownTrigger", "userDropdownMenu");
  const authDropdown = initDropdown("authDropdown", "authDropdownTrigger", "authDropdownMenu");

  document.addEventListener("click", (e) => {
    if (userDropdown && !userDropdown.dropdown.contains(e.target)) userDropdown.closeDropdown();
    if (authDropdown && !authDropdown.dropdown.contains(e.target)) authDropdown.closeDropdown();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      userDropdown?.closeDropdown();
      authDropdown?.closeDropdown();
    }
  });

  /* ── Search overlay ── */
  const searchOverlay  = document.getElementById("searchOverlay");
  const searchInput    = document.getElementById("searchInput");
  const searchClose    = document.getElementById("searchClose");
  const searchBackdrop = document.getElementById("searchBackdrop");
  const searchBtn      = document.querySelector(".nav-btn-search");

  function openSearch() {
    searchOverlay.classList.add("is-open");
    searchOverlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    setTimeout(() => searchInput?.focus(), 60);
  }
  function closeSearch() {
    searchOverlay.classList.remove("is-open");
    searchOverlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  searchBtn?.addEventListener("click", openSearch);
  searchClose?.addEventListener("click", closeSearch);
  searchBackdrop?.addEventListener("click", closeSearch);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && searchOverlay?.classList.contains("is-open")) closeSearch();
  });

  /* ── Compteur favoris nav ── */
  <% if (typeof role !== "undefined" && userId) { %>
  (async () => {
    try {
      const [rMovies, rRecipes] = await Promise.all([
        fetch("/api/favorites?entityType=movie"),
        fetch("/api/favorites?entityType=recipe"),
      ]);
      const [dMovies, dRecipes] = await Promise.all([rMovies.json(), rRecipes.json()]);
      const total = (dMovies.favoriteIds?.length || 0) + (dRecipes.favoriteIds?.length || 0);
      const el = document.getElementById("navFavCount");
      if (el && total > 0) {
        el.textContent = total > 99 ? "99+" : total;
        el.classList.add("has-favs");
      }
    } catch { /* silencieux */ }
  })();
  <% } %>

  /* Intercepter le submit → rediriger vers /movies?q=QUERY au lieu de l'API JSON */
  document.getElementById("searchForm")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = searchInput?.value?.trim();
    if (!q || q.length < 2) return;
    closeSearch();
    window.location.href = "/movies?q=" + encodeURIComponent(q);
  });

  /* ── Boutons js-open-login / js-open-register (délégation globale) ── */
  document.addEventListener("click", (e) => {
    const loginBtn    = e.target.closest(".js-open-login");
    const registerBtn = e.target.closest(".js-open-register");
    if (loginBtn) {
      e.preventDefault();
      authDropdown?.closeDropdown();
      closeDrawer();
      const hint    = loginBtn.dataset.loginHint || "";
      const hintEl  = document.getElementById("loginModalHint");
      if (hintEl) { hintEl.textContent = hint; hintEl.style.display = hint ? "" : "none"; }
      if (typeof openModal === "function") openModal("login");
    } else if (registerBtn) {
      e.preventDefault();
      authDropdown?.closeDropdown();
      closeDrawer();
      const hintEl = document.getElementById("loginModalHint");
      if (hintEl) { hintEl.style.display = "none"; }
      if (typeof openModal === "function") openModal("register");
    }
  });
})();
</script>
