<!-- Ce partial ne doit contenir que la popup de connexion/inscription -->

<!-- POPUP CONNEXION -->
<div id="authModal" class="modal">
  <div id="modalOverlay" class="modal-overlay"></div>
  <div class="modal-content">
    <button id="modalClose" class="modal-close">⊗</button>

    <!-- Connexion -->
    <div id="loginForm" class="auth-form active">
      <h2>Connexion</h2>
      <form>
        <input type="email" placeholder="Adresse e-mail" required />
        <input type="password" placeholder="Mot de passe" required />
        <button type="submit" class="btn btn--primary btn--full">
          Se connecter
        </button>
      </form>
      <p class="switch-form">
        Pas encore de compte ?
        <button id="goToRegister" class="btn-link">S'inscrire</button>
      </p>
    </div>

    <!-- Inscription -->
    <div id="registerForm" class="auth-form">
      <h2>Inscription</h2>
      <form>
        <input type="text" placeholder="Nom d'utilisateur" required />
        <input type="email" placeholder="Adresse e-mail" required />
        <input type="password" placeholder="Mot de passe" required />
        <input
          type="password"
          placeholder="Confirmer le mot de passe"
          required
        />
        <button type="submit" class="btn btn--red btn--full">
          Créer mon compte
        </button>
      </form>
      <p class="switch-form">
        Déjà un compte ?
        <button id="goToLogin" class="btn-link">Se connecter</button>
      </p>
    </div>
  </div>
</div>
