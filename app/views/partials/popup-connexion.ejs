<!-- ================= HEADER ================= -->
<header class="header">
  <!-- Titre du site -->
  <div class="title">
    <span class="title-cine">Ciné</span>
    <span class="title-delices">Délices</span>
  </div>

  <!-- Menu de navigation principal -->
  <nav class="navigationheader">
    <a href="/" class="navigationheader-link">Accueil</a>
    <a href="#" class="navigationheader-link">Recettes</a>
    <a href="/movies" class="navigationheader-link">Films</a>
    <a href="/auth/profil" class="navigationheader-link">Mon compte</a>
    <a href="#" class="navigationheader-link">Contact</a>
  </nav>

  <!-- Bouton pour ouvrir le modal Connexion / Inscription -->
  <div class="buttons__header">
    <button id="openModal" class="btn btn--gold btn--sm">
      Connexion / S'enregistrer
    </button>
  </div>

  <!-- Burger menu pour mobile -->
  <button class="burger-menu">
    <span class="burger-line"></span>
    <span class="burger-line"></span>
    <span class="burger-line"></span>
  </button>
</header>

<!-- POPUP CONNEXION -->

<div id="authModal" class="modal">
  <div class="modal-content">
    <!-- Crois de fermeture -->
    <span class="close">&times;</span>

    <!-- Boutons switch Connexion / Inscription -->
    <div class="form-toggle">
      <button id="showLogin" class="btn btn--gold active">Connexion</button>
      <button id="showRegister" class="btn btn--red">S'enregistrer</button>
    </div>

    <!-- FORMULAIRE CONNEXION -->
    <form id="loginForm" class="auth-form active">
      <h2>Connexion</h2>
      <input type="text" placeholder="Email" required />
      <input type="password" placeholder="Mot de passe" required />
      <button type="submit" class="btn btn--blue">Se connecter</button>
    </form>

    <!-- FORMULAIRE INSCRIPTION -->
    <form id="registerForm" class="auth-form">
      <h2>S'enregistrer</h2>
      <input type="text" placeholder="Nom" required />
      <input type="text" placeholder="Email" required />
      <input type="password" placeholder="Mot de passe" required />
      <button type="submit" class="btn btn--blue">Créer un compte</button>
    </form>
  </div>
</div>
