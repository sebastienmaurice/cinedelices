            <div class="impact-cell">
              <div class="impact-cell__icon ic--film">
                <i data-lucide="film" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= favoriteMoviesCount || 0 %></div>
                <div class="impact-cell__lbl">Films favoris</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--recipe">
                <i data-lucide="utensils" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= favoriteRecipesCount || 0 %></div>
                <div class="impact-cell__lbl">Recettes favorites</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--note">
                <i data-lucide="star" fill="currentColor" stroke="currentColor" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= ratedMoviesCount || 0 %></div>
                <div class="impact-cell__lbl">Films notés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--valide">
                <i data-lucide="message-square" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= ratedRecipesCount || 0 %></div>
                <div class="impact-cell__lbl">Recettes notées</div>
              </div>
            </div>
          </div>

          <!-- LAYOUT 2 COLONNES -->
          <div class="crea-layout">

            <!-- ── SIDEBAR ── -->
            <aside class="crea-sidebar">

              <!-- Navigation sections -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Accès rapide</span>
                </div>
                <div class="quick-actions">
                  <a href="#favFilmsSection" class="qa-btn qa-btn--violet" onclick="document.getElementById('favFilmsSection').scrollIntoView({behavior:'smooth'});return false;">
                    <div class="qa-icon"><i data-lucide="film" aria-hidden="true"></i></div>
                    <div class="qa-text"><div class="qa-title">Films favoris</div><div class="qa-sub"><%= favoriteMoviesCount || 0 %> film<%= (favoriteMoviesCount || 0) > 1 ? 's' : '' %></div></div>
                  </a>
                  <a href="#favRecettesSection" class="qa-btn qa-btn--gold" onclick="document.getElementById('favRecettesSection').scrollIntoView({behavior:'smooth'});return false;">
                    <div class="qa-icon"><i data-lucide="utensils" aria-hidden="true"></i></div>
                    <div class="qa-text"><div class="qa-title">Recettes favorites</div><div class="qa-sub"><%= favoriteRecipesCount || 0 %> recette<%= (favoriteRecipesCount || 0) > 1 ? 's' : '' %></div></div>
                  </a>
                  <a href="#notedFilmsSection" class="qa-btn qa-btn--vert" onclick="document.getElementById('notedFilmsSection').scrollIntoView({behavior:'smooth'});return false;">
                    <div class="qa-icon"><i data-lucide="star" fill="currentColor" stroke="currentColor" aria-hidden="true"></i></div>
                    <div class="qa-text"><div class="qa-title">Mes notes</div><div class="qa-sub"><%= (ratedMoviesCount || 0) + (ratedRecipesCount || 0) %> évaluation<%= ((ratedMoviesCount || 0) + (ratedRecipesCount || 0)) > 1 ? 's' : '' %></div></div>
                  </a>
                </div>
              </div>

            </aside>

            <!-- ── COLONNE PRINCIPALE ── -->
            <div class="crea-main">

              <!-- FILMS FAVORIS -->
              <section id="favFilmsSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Ma collection cinéma</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">FILMS FAVORIS</div>
                  <span class="sec-link" style="cursor:default;"><%= favoriteMoviesCount || 0 %> film<%= (favoriteMoviesCount || 0) > 1 ? 's' : '' %></span>
                </div>
                <div class="list-grid">
                  <% if (favoriteMovies && favoriteMovies.length > 0) { %>
                    <% favoriteMovies.slice(0, 8).forEach(function(movie) { %>
                    <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="list-row list-row--film list-row--link">
                      <% if (movie.cardPath || movie.picture) { %>
                      <img class="list-row__thumb list-row__thumb--film" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--film list-row__thumb--ph"><i data-lucide="film" width="20" height="20" stroke-width="1.5" aria-hidden="true"></i></div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= movie.title %></span>
                          <span class="tag tag--genre-cinema lr-tag" style="flex-shrink:0"><% if (movie.genre) { %><%= movie.genre %><% } %></span>
                        </div>
                        <div class="list-row__sub">
                          <i data-lucide="film" aria-hidden="true"></i>
                          <%= movie.year %><% if (!movie.genre) { %> · Voir les recettes<% } %>
                        </div>
                      </div>
                      <i data-lucide="chevron-right" class="fav-row-arrow" aria-hidden="true"></i>
                    </a>
                    <% }) %>
                    <% if (favoriteMoviesCount > 8) { %>
                    <div class="crea-empty" style="padding:14px;"><div class="crea-empty__sub">+ <%= favoriteMoviesCount - 8 %> autre<%= (favoriteMoviesCount - 8) > 1 ? 's' : '' %> film<%= (favoriteMoviesCount - 8) > 1 ? 's' : '' %> favoris</div></div>
                    <% } %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon"><i data-lucide="film" width="36" height="36" stroke-width="1" aria-hidden="true"></i></div>
                    <div class="crea-empty__title">Aucun film favori</div>
                    <div class="crea-empty__sub">Explorez la collection et ajoutez vos films préférés</div>
                  </div>
                  <% } %>
                </div>
              </section>

              <!-- RECETTES FAVORITES -->
              <section id="favRecettesSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes recettes préférées</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">RECETTES FAVORITES</div>
                  <span class="sec-link" style="cursor:default;"><%= favoriteRecipesCount || 0 %> recette<%= (favoriteRecipesCount || 0) > 1 ? 's' : '' %></span>
                </div>
                <div class="list-grid">
                  <% if (favoriteRecipes && favoriteRecipes.length > 0) { %>
                    <% favoriteRecipes.slice(0, 8).forEach(function(recipe) { %>
                    <a href="/recipes-movie/details/<%= recipe.slug || recipe.id %>" class="list-row list-row--recette list-row--link">
                      <% if (recipe.picture) { %>
                      <img class="list-row__thumb" src="<%= cldAvatar(recipe.picture) %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--ph">🍽️</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= recipe.name %></span>
                          <span class="tag tag--recette-cat lr-tag" style="flex-shrink:0"><%= recipe.category %></span>
                        </div>
                        <div class="list-row__sub">
                          <i data-lucide="clock" aria-hidden="true"></i>
                          <%= recipe.time %> min<% if (recipe.Movie) { %> · <%= recipe.Movie.title %><% } %>
                        </div>
                      </div>
                      <i data-lucide="chevron-right" class="fav-row-arrow" aria-hidden="true"></i>
                    </a>
                    <% }) %>
                    <% if (favoriteRecipesCount > 8) { %>
                    <div class="crea-empty" style="padding:14px;"><div class="crea-empty__sub">+ <%= favoriteRecipesCount - 8 %> autre<%= (favoriteRecipesCount - 8) > 1 ? 's' : '' %> recette<%= (favoriteRecipesCount - 8) > 1 ? 's' : '' %> favorite<%= (favoriteRecipesCount - 8) > 1 ? 's' : '' %></div></div>
                    <% } %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune recette favorite</div>
                    <div class="crea-empty__sub">Découvrez les recettes et sauvegardez vos préférées</div>
                  </div>
                  <% } %>
                </div>
              </section>

              <!-- FILMS NOTÉS -->
              <section id="notedFilmsSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes évaluations cinéma</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">FILMS NOTÉS</div>
                  <span class="sec-link" style="cursor:default;"><%= ratedMoviesCount || 0 %> noté<%= (ratedMoviesCount || 0) > 1 ? 's' : '' %></span>
                </div>
                <div class="list-grid">
                  <% if (ratedMovies && ratedMovies.length > 0) { %>
                    <% ratedMovies.slice(0, 8).forEach(function(movie) { %>
                    <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="list-row list-row--film list-row--link">
                      <% if (movie.cardPath || movie.picture) { %>
                      <img class="list-row__thumb list-row__thumb--film" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--film list-row__thumb--ph"><i data-lucide="film" width="20" height="20" stroke-width="1.5" aria-hidden="true"></i></div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= movie.title %></span>
                        </div>
                        <div class="list-row__sub">
                          <i data-lucide="film" aria-hidden="true"></i>
                          <%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %>
                        </div>
                      </div>
                      <span class="fav-score-badge">★ <%= movie.userScore %></span>
                    </a>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">⭐</div>
                    <div class="crea-empty__title">Aucun film noté</div>
                    <div class="crea-empty__sub">Notez les films de votre collection</div>
                  </div>
                  <% } %>
                </div>
              </section>

              <!-- RECETTES NOTÉES -->
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes évaluations culinaires</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">RECETTES NOTÉES</div>
                  <span class="sec-link" style="cursor:default;"><%= ratedRecipesCount || 0 %> notée<%= (ratedRecipesCount || 0) > 1 ? 's' : '' %></span>
                </div>
                <div class="list-grid">
                  <% if (ratedRecipes && ratedRecipes.length > 0) { %>
                    <% ratedRecipes.slice(0, 8).forEach(function(recipe) { %>
                    <a href="/recipes-movie/details/<%= recipe.slug || recipe.id %>" class="list-row list-row--recette list-row--link">
                      <% if (recipe.picture) { %>
                      <img class="list-row__thumb" src="<%= cldAvatar(recipe.picture) %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--ph">🍽️</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= recipe.name %></span>
                        </div>
                        <div class="list-row__sub">
                          <i data-lucide="clock" aria-hidden="true"></i>
                          <%= recipe.category %> · <%= recipe.time %> min
                        </div>
                      </div>
                      <span class="fav-score-badge">★ <%= recipe.userScore %></span>
                    </a>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">⭐</div>
                    <div class="crea-empty__title">Aucune recette notée</div>
                    <div class="crea-empty__sub">Notez vos recettes préférées</div>
                  </div>
                  <% } %>
                </div>
              </section>

            </div><!-- /crea-main -->

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#favoris -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : CRÉATIONS                     -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="creations" role="tabpanel">

          <!-- Onglet "Créations" — Étape 2 (Phase 5, recentrage architecture) :
               la gestion complète (listes détaillées, filtres, recherche,
               Éditer, Supprimer) a été déplacée vers /contributions/, qui en
               est désormais l'unique responsable (voir Phase 5, Étape 2).
               Ne pas réintroduire de CRUD ici : Mon compte ne doit plus
               concurrencer /contributions/ pour la gestion de contenu. -->
          <%
            const _crTabTotal = userRecipes.length + userMovies.length + userNoticesCount;
          %>

          <!-- ═══ BANDEAU IMPACT ═══ -->
          <div class="impact-banner">
            <div class="impact-cell">
              <div class="impact-cell__icon ic--recipe">
                <i data-lucide="utensils" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= userRecipes.length %></div>
                <div class="impact-cell__lbl">Recettes créées</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--film">
                <i data-lucide="film" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= userMovies.length %></div>
                <div class="impact-cell__lbl">Films proposés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--avis">
                <i data-lucide="message-square" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= userNoticesCount %></div>
                <div class="impact-cell__lbl">Avis rédigés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--valide">
                <i data-lucide="check" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= _crTabTotal %></div>
                <div class="impact-cell__lbl">Contributions</div>
              </div>
            </div>
          </div>

          <!-- ═══ RÉSUMÉ + LIEN DE GESTION ═══ -->
          <div class="crea-layout crea-layout--single">
            <div class="crea-main">
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Ce que je publie</span>
                </div>
                <div class="widget">
                  <% if (_crTabTotal > 0) { %>
                  <div class="ov-contrib-summary">
                    <div class="ov-contrib-summary__count"><%= _crTabTotal %></div>
                    <div class="ov-contrib-summary__lbl">contribution<%= _crTabTotal > 1 ? 's' : '' %> publiée<%= _crTabTotal > 1 ? 's' : '' %></div>
                    <div class="ov-contrib-summary__breakdown">
                      <%= userRecipes.length %> recette<%= userRecipes.length !== 1 ? 's' : '' %> · <%= userMovies.length %> film<%= userMovies.length !== 1 ? 's' : '' %> · <%= userNoticesCount %> avis
                    </div>
                    <a href="/contributions/" class="lr-btn lr-btn--edit ov-contrib-summary__cta">
                      <i data-lucide="settings-2" aria-hidden="true"></i>
                      <span>Gérer mes contributions</span>
                    </a>
                  </div>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune contribution</div>
                    <div class="crea-empty__sub">Partagez votre première contribution</div>
                  </div>
                  <% } %>
                </div>
              </section>
            </div>
          </div>

        </div><!-- /tab-pane#creations -->

      </div><!-- /profile-content -->

    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Toast global -->
    <div class="toast-wrap" id="toastWrap" aria-live="polite"></div>

    <!-- Modal confirmation suppression -->
    <div class="modal-overlay" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-box">
        <div class="modal-stripe"></div>
        <div class="modal-head">
          <div class="modal-ico">⚠️</div>
          <div class="modal-titles">
            <div class="modal-title" id="modalTitle">SUPPRESSION</div>
            <div class="modal-sub">Cette action est irréversible</div>
          </div>
        </div>
        <div class="modal-body">
          <p>Vous êtes sur le point de supprimer définitivement :</p>
          <div class="modal-target" id="modalTarget"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn--ghost btn--sm" id="modalCancel">Annuler</button>
          <button class="btn btn--red btn--sm" id="modalConfirm">Confirmer</button>
        </div>
      </div>
    </div>

    <!-- Modal édition recette -->
    <div class="modal-overlay" id="editRecipeModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
      <div class="modal-box modal-box--edit">
        <div class="modal-stripe modal-stripe--gold"></div>
        <div class="modal-head">
          <div class="modal-ico modal-ico--edit">✏️</div>
          <div class="modal-titles">
            <div class="modal-title" id="editModalTitle">ÉDITER LA RECETTE</div>
            <div class="modal-sub" id="editModalSub">Les modifications sont soumises à validation</div>
          </div>
        </div>
        <div class="modal-body modal-body--form">
          <div class="ci-ef-row">
            <div><label class="ci-ef-label">Titre</label><input class="ci-ef-input" id="editField-name" type="text" name="name" /></div>
            <div>
              <label class="ci-ef-label">Catégorie</label>
              <select class="ci-ef-input ci-ef-select" id="editField-category" name="category">
                <option value="">Choisir…</option>
                <option value="entrée">Entrée</option>
                <option value="plat">Plat</option>
                <option value="dessert">Dessert</option>
              </select>
            </div>
          </div>
          <div class="ci-ef-row">
            <div><label class="ci-ef-label">Temps (min)</label><input class="ci-ef-input" id="editField-time" type="number" name="time" min="1" /></div>
            <div>
              <label class="ci-ef-label">Difficulté</label>
              <select class="ci-ef-input ci-ef-select" id="editField-difficulty" name="difficulty">
                <option value="">Choisir…</option>
                <option value="Facile">Facile</option>
                <option value="Moyenne">Moyenne</option>
                <option value="Difficile">Difficile</option>
              </select>
            </div>
          </div>
          <div class="ci-ef-full"><label class="ci-ef-label">Description</label><textarea class="ci-ef-textarea" id="editField-description" name="description" rows="2"></textarea></div>
          <div class="ci-ef-full">
            <label class="ci-ef-label">Ingrédients <span class="ci-ef-label-hint">§ titre de section · • liste</span></label>
            <div class="rte-mini-wrap">
              <div class="rte-mini-toolbar" id="profil-ing-tb" role="toolbar" aria-label="Mise en forme ingrédients">
                <button type="button" class="rte-tb-btn" data-cmd="bold" title="Gras"><strong>G</strong></button>
                <button type="button" class="rte-tb-btn" data-cmd="italic" title="Italique"><em>I</em></button>
                <div class="rte-tb-divider"></div>
                <button type="button" class="rte-tb-btn" data-cmd="bulletList" title="Liste à puces">• liste</button>
                <button type="button" class="rte-tb-btn" data-cmd="heading" title="Titre de section">§ titre</button>
              </div>
              <div class="rte-mini-editor" id="profil-ing-rte" contenteditable="true" spellcheck="false" role="textbox" aria-multiline="true" aria-label="Ingrédients"></div>
            </div>
            <input type="hidden" id="editField-ingredients" name="ingredients" />
          </div>
          <div class="ci-ef-full">
            <label class="ci-ef-label">Préparation <span class="ci-ef-label-hint">Ctrl+↵ ou + étape pour séparer les étapes</span></label>
            <div class="rte-mini-wrap">
              <div class="rte-mini-toolbar" id="profil-prep-tb" role="toolbar" aria-label="Mise en forme préparation">
                <button type="button" class="rte-tb-btn" data-cmd="bold" title="Gras"><strong>G</strong></button>
                <button type="button" class="rte-tb-btn" data-cmd="italic" title="Italique"><em>I</em></button>
                <div class="rte-tb-divider"></div>
                <button type="button" class="rte-tb-btn" data-cmd="bulletList" title="Liste à puces">• liste</button>
                <div class="rte-tb-divider"></div>
                <button type="button" class="rte-tb-btn" data-cmd="separator" title="Nouvelle étape (Ctrl+Entrée)">+ étape</button>
              </div>
              <div class="rte-mini-editor" id="profil-prep-rte" contenteditable="true" spellcheck="false" role="textbox" aria-multiline="true" aria-label="Préparation"></div>
            </div>
            <input type="hidden" id="editField-preparation" name="preparation" />
          </div>
          <div class="ci-ef-full">
            <label class="ci-ef-label">Photos <span class="ci-ef-label-hint">max 3 · ratio 3:2 · 2 Mo par photo · remplace les photos actuelles si modifiées</span></label>
            <div class="ci-ef-photo-slots" id="editPhotoSlots">
              <% for (var ps = 1; ps <= 3; ps++) { %>
              <div class="ci-ef-ps" id="edit-ps-<%= ps %>">
                <div class="ci-ef-ps__prev" id="edit-ps-prev-<%= ps %>"></div>
                <span class="ci-ef-ps__n"><%= ps === 1 ? '01 PRINC.' : '0' + ps %></span>
                <input type="file" name="pictures" id="edit-ps-input-<%= ps %>"
                  accept="image/jpeg,image/jpg,image/png,image/webp"
                  class="ci-ef-ps__file" />
                <button type="button" class="ci-ef-ps__del" id="edit-ps-del-<%= ps %>" title="Retirer">×</button>
              </div>
              <% } %>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn--ghost btn--sm" id="editModalCancel">Annuler</button>
          <button class="btn btn--primary btn--sm" id="editModalSave">Enregistrer</button>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="/js/profile-tabs.js?v=3" defer></script>
    <script src="/js/rte-mini.js"></script>
    <script src="/js/account.js" defer></script>
    <script>
    // Initialiser les RTEs du modal d'édition recette (une seule fois)
    document.addEventListener('DOMContentLoaded', function () {
      var ingRte  = document.getElementById('profil-ing-rte');
      var ingTb   = document.getElementById('profil-ing-tb');
      var prepRte = document.getElementById('profil-prep-rte');
      var prepTb  = document.getElementById('profil-prep-tb');
      if (ingRte  && ingTb  && window.RteMini) RteMini.initEditor({ rteEl: ingRte,  tbEl: ingTb,  mode: 'ingredients' });
      if (prepRte && prepTb && window.RteMini) RteMini.initEditor({ rteEl: prepRte, tbEl: prepTb, mode: 'preparation' });
    });
    </script>

    <script src="/js/gamification-sherlock.js" defer></script>
    <script src="/js/gamification-engine.js?v=2" defer></script>
    <script src="/js/gamification.js?v=2" defer></script>
    <script>
      /* ── Init onglet Vue d'ensemble ── */
      (function () {
        function initOverview() {
          /* Count-up sur les impact-cell__val[data-ov-target] */
          document.querySelectorAll('#overview .impact-cell__val[data-ov-target]').forEach(function (el) {
            const target = parseInt(el.dataset.ovTarget) || 0;
            if (target === 0) { el.textContent = '0'; return; }
            const dur = 800, start = performance.now();
            (function step(now) {
              const p = Math.min((now - start) / dur, 1);
              el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
              if (p < 1) requestAnimationFrame(step);
            })(performance.now());
          });

          /* Barres de progression du widget "Ma progression" */
          setTimeout(function () {
            document.querySelectorAll('#overview .ov-prog-bar').forEach(function (bar) {
              const w = bar.style.width;
              bar.style.width = '0%';
              requestAnimationFrame(function () { bar.style.width = w; });
            });
          }, 200);
        }

        /* Vue d'ensemble est l'onglet actif par défaut → lancer au chargement */
        if (document.getElementById('overview')?.classList.contains('active')) {
          setTimeout(initOverview, 150);
        }
        /* Aussi si on revient sur l'onglet */
        const tabOv = document.querySelector('[data-tab="overview"]');
        if (tabOv) tabOv.addEventListener('click', function () { setTimeout(initOverview, 80); });
      })();
    </script>
    <script>
      /* ── Init onglet Créations v2 ── */
      (function () {
        function initCreations() {
          /* Count-up stats */
          document.querySelectorAll('#creations .stat-num[data-crea-target]').forEach(function (el) {
            const target = parseInt(el.dataset.creaTarget) || 0;
            if (target === 0) { el.textContent = '0'; return; }
            const dur = 900, start = performance.now();
            (function step(now) {
              const p = Math.min((now - start) / dur, 1);
              el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
              if (p < 1) requestAnimationFrame(step);
            })(performance.now());
          });

          /* Barres de statut */
          setTimeout(function () {
            document.querySelectorAll('#creations .sb-fill[data-sb-w]').forEach(function (el) {
              el.style.width = (el.dataset.sbW || '0') + '%';
            });
          }, 350);

          /* Filtres */
          document.querySelectorAll('#creations .f-pill').forEach(function (pill) {
            if (pill._creaInit) return;
            pill._creaInit = true;
            pill.addEventListener('click', function () {
              const gridId = pill.dataset.creaGrid;
              const grid   = document.getElementById(gridId);
              if (!grid) return;
              pill.closest('.filter-bar').querySelectorAll('.f-pill').forEach(function (p) { p.classList.remove('active'); });
              pill.classList.add('active');
              const filter = pill.dataset.creaFilter;
              let visible = 0;
              grid.querySelectorAll('[data-crea-status]').forEach(function (item) {
                const show = filter === 'all' || item.dataset.creaStatus === filter;
                item.style.display = show ? '' : 'none';
                if (show) visible++;
              });
              const noRes = grid.querySelector('.crea-no-results');
              if (noRes) noRes.style.display = visible === 0 ? '' : 'none';
            });
          });

          /* Recherche */
          document.querySelectorAll('#creations .crea-search-input').forEach(function (input) {
            if (input._creaInit) return;
            input._creaInit = true;
            input.addEventListener('input', function () {
              const grid = document.getElementById(input.dataset.creaSearch);
              if (!grid) return;
              const q = input.value.toLowerCase().trim();
              grid.querySelectorAll('[data-crea-name]').forEach(function (item) {
                item.style.display = (!q || item.dataset.creaName.includes(q)) ? '' : 'none';
              });
            });
          });
        }

        /* Déclencher au clic sur l'onglet */
        const tab = document.querySelector('[data-tab="creations"]');
        if (tab) tab.addEventListener('click', function () { setTimeout(initCreations, 80); });

        /* Ou si on arrive directement via #creations */
        if (window.location.hash === '#creations') setTimeout(initCreations, 250);
      })();
    </script>

    <!-- Conteneur toast profil — requis par account.js pour afficher les notifications -->
    <div class="profile-toast-wrap" aria-live="polite"></div>
  </body>
</html>
