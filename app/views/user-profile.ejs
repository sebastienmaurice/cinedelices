<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Gérez votre compte et vos préférences cinéma & recettes"
    />
    <title>Mon compte - Ciné Délices</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/user-profile.css" />
  </head>

  <body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <h1 class="profile-title">Mon compte</h1>

      <!-- BANNER -->
      <section class="banner-title">
        <div class="banner-content">
          <p>
            Gérez vos informations personnelles, votre pseudo et votre photo de
            profil.
          </p>
        </div>
      </section>

      <!-- CONTAINER PRINCIPAL -->
      <section class="profile-container">
        <!-- Colonne 1 : Civilités -->
        <div class="profile-column">
          <form class="profile-form">
            <div class="inputs-group">
              <div class="input-container">
                <input
                  type="text"
                  id="firstname"
                  placeholder=""
                  value="<%= user.first_name %>"
                />
                <label for="firstname">Votre prénom</label>
              </div>
              <div class="input-container">
                <input
                  type="text"
                  id="lastname"
                  placeholder=""
                  value="<%= user.last_name %>"
                />
                <label for="lastname">Votre nom</label>
              </div>
              <div class="input-container">
                <input
                  type="email"
                  id="email"
                  placeholder=""
                  value="<%= user.email %>"
                />
                <label for="email">Votre email</label>
              </div>
              <div class="input-container">
                <input type="password" id="password" placeholder="" />
                <label for="password">Votre mot de passe</label>
              </div>
            </div>
          </form>
        </div>

        <!-- Colonne 2 : Photo / pseudo -->
        <div class="profile-column">
          <form class="profile-form">
            <div class="inputs-group">
              <label for="avatar" class="upload-btn">
                <span>Choisir une photo</span>
                <i class="fas fa-upload"></i>
              </label>
              <input type="file" id="avatar" accept="image/*" hidden />
              <div class="input-container">
                <input
                  type="text"
                  id="username"
                  placeholder=""
                  value="<%= user.pseudo %>"
                />
                <label for="username">Votre pseudo</label>
              </div>
            </div>

            <div class="btn-bottom-group">
              <button type="submit" class="btn btn--red">Valider</button>
              <button type="button" class="btn btn--red btn--sm">
                Supprimer ma photo
              </button>
            </div>
          </form>
        </div>

        <!-- Colonne 3 : Photo actuelle -->
        <div class="profile-column">
          <img
            src="/images/image-default-profile.jpg"
            alt="Avatar"
            class="profile-photo"
          />
          <p class="small-text">*sous réserve de validation par Ciné Délices</p>
        </div>
      </section>

      <!-- BAS DE PAGE -->
      <section class="profile-bottom">
        <div class="bottom-text">
          <p>
            Votre compte Ciné Délices vous permet de partager vos recettes et
            critiques de films. Vous pouvez le supprimer à tout moment.
          </p>
          <p>Attention : cette action est irréversible.</p>
        </div>
        <button class="btn btn--red btn-delete-account">
          Supprimer mon compte
        </button>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>
  </body>
</html>
