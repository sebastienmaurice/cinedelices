                        </label>
                      </div>
                      <div class="pf-notif-row">
                        <div class="pf-notif-info">
                          <span class="pf-notif-label">Nouveaux films</span>
                          <span class="pf-notif-sub">Nouveaux films ajoutés à la collection</span>
                        </div>
                        <label class="toggle">
                          <input type="checkbox" name="notify_cinema" <%= user.notify_cinema ? 'checked' : '' %> disabled />
                          <span class="toggle-slider"></span>
                        </label>
                      </div>
                    </form>
                  </div>
                </div>
              </section>

            </div>

            <!-- ── SIDEBAR ── -->
            <aside class="crea-sidebar">

              <!-- MON COMPTE -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Mon compte</span>
                </div>
                <div class="stats-grid">
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= userNoticesCount %></div>
                      <div class="stat-lbl">Avis</div>
                    </div>
