    <script>
      /* ── Init onglet Contributions ── */
      (function () {
        function initContrib() {
          /* Count-up stats */
          document.querySelectorAll('#contributions .stat-num[data-target]').forEach(function (el) {
            const target = parseInt(el.dataset.target) || 0;
            if (target === 0) { el.textContent = '0'; return; }
            const dur = 900, start = performance.now();
            (function step(now) {
              const p = Math.min((now - start) / dur, 1);
              el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
              if (p < 1) requestAnimationFrame(step);
            })(performance.now());
          });

          /* XP bar */
          const fill = document.querySelector('#contributions .xp-fill');
          if (fill) {
            const pct = parseInt(fill.dataset.pct) || 0;
            setTimeout(function () { fill.style.width = pct + '%'; }, 300);
          }

          /* Filtres activité */
          document.querySelectorAll('#contributions .af-pill').forEach(function (pill) {
            pill.addEventListener('click', function () {
              document.querySelectorAll('#contributions .af-pill').forEach(function (p) { p.classList.remove('active'); });
              pill.classList.add('active');
              const f = pill.dataset.filter;
              document.querySelectorAll('#contribActivityList .activity-item').forEach(function (item) {
                item.style.display = (f === 'all' || item.dataset.type === f) ? '' : 'none';
              });
            });
          });

          /* Équiper un cadre — géré par gamification.js (POST /auth/equip-frame) */
        }

        /* Déclencher au clic sur l'onglet */
        const tab = document.querySelector('[data-tab="contributions"]');
        if (tab) tab.addEventListener('click', function () { setTimeout(initContrib, 80); });

        /* Ou si on arrive directement via #contributions */
        if (window.location.hash === '#contributions') setTimeout(initContrib, 250);
      })();
    </script>
    <script>
      /* ── Init onglet Vue d'ensemble ── */
      (function () {
        function initOverview() {
          /* Count-up sur les impact-cell__val[data-ov-target] */
          document.querySelectorAll('#overview .impact-cell__val[data-ov-target]').forEach(function (el) {
            const target = parseInt(el.dataset.ovTarget) || 0;
            if (target === 0) { el.textContent = '0'; return; }
            const dur = 800, start = performance.now();
            (function step(now) {
              const p = Math.min((now - start) / dur, 1);
              el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
              if (p < 1) requestAnimationFrame(step);
            })(performance.now());
          });

          /* Barres de progression du widget "Ma progression" */
          setTimeout(function () {
            document.querySelectorAll('#overview .ov-prog-bar').forEach(function (bar) {
              const w = bar.style.width;
              bar.style.width = '0%';
              requestAnimationFrame(function () { bar.style.width = w; });
            });
          }, 200);
        }

        /* Vue d'ensemble est l'onglet actif par défaut → lancer au chargement */
        if (document.getElementById('overview')?.classList.contains('active')) {
          setTimeout(initOverview, 150);
        }
        /* Aussi si on revient sur l'onglet */
        const tabOv = document.querySelector('[data-tab="overview"]');
        if (tabOv) tabOv.addEventListener('click', function () { setTimeout(initOverview, 80); });
      })();
    </script>
    <script>
      /* ── Init onglet Créations v2 ── */
      (function () {
        function initCreations() {
          /* Count-up stats */
          document.querySelectorAll('#creations .stat-num[data-crea-target]').forEach(function (el) {
            const target = parseInt(el.dataset.creaTarget) || 0;
            if (target === 0) { el.textContent = '0'; return; }
            const dur = 900, start = performance.now();
            (function step(now) {
              const p = Math.min((now - start) / dur, 1);
              el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
              if (p < 1) requestAnimationFrame(step);
            })(performance.now());
          });

          /* Barres de statut */
          setTimeout(function () {
            document.querySelectorAll('#creations .sb-fill[data-sb-w]').forEach(function (el) {
              el.style.width = (el.dataset.sbW || '0') + '%';
            });
          }, 350);

          /* Filtres */
          document.querySelectorAll('#creations .f-pill').forEach(function (pill) {
            if (pill._creaInit) return;
            pill._creaInit = true;
            pill.addEventListener('click', function () {
              const gridId = pill.dataset.creaGrid;
              const grid   = document.getElementById(gridId);
              if (!grid) return;
              pill.closest('.filter-bar').querySelectorAll('.f-pill').forEach(function (p) { p.classList.remove('active'); });
              pill.classList.add('active');
              const filter = pill.dataset.creaFilter;
              let visible = 0;
              grid.querySelectorAll('[data-crea-status]').forEach(function (item) {
                const show = filter === 'all' || item.dataset.creaStatus === filter;
                item.style.display = show ? '' : 'none';
                if (show) visible++;
              });
              const noRes = grid.querySelector('.crea-no-results');
              if (noRes) noRes.style.display = visible === 0 ? '' : 'none';
            });
          });

          /* Recherche */
          document.querySelectorAll('#creations .crea-search-input').forEach(function (input) {
            if (input._creaInit) return;
            input._creaInit = true;
            input.addEventListener('input', function () {
              const grid = document.getElementById(input.dataset.creaSearch);
              if (!grid) return;
              const q = input.value.toLowerCase().trim();
              grid.querySelectorAll('[data-crea-name]').forEach(function (item) {
                item.style.display = (!q || item.dataset.creaName.includes(q)) ? '' : 'none';
              });
            });
          });
        }

        /* Déclencher au clic sur l'onglet */
        const tab = document.querySelector('[data-tab="creations"]');
        if (tab) tab.addEventListener('click', function () { setTimeout(initCreations, 80); });

        /* Ou si on arrive directement via #creations */
        if (window.location.hash === '#creations') setTimeout(initCreations, 250);
      })();
    </script>

