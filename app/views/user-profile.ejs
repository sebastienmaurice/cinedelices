                  <div class="stat-cell">
                    <div class="stat-icon"><i data-lucide="message-square" aria-hidden="true"></i></div>
                    <div class="stat-text">
                      <div class="stat-num" data-crea-target="<%= _cnTotal %>">0</div>
                      <div class="stat-lbl">Avis</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><i data-lucide="check" aria-hidden="true"></i></div>
