<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Gérez votre compte et vos préférences cinéma & recettes" />
    <title>Mon compte - Ciné Délices</title>
    <%- include("partials/head-resources") %>
    <link rel="stylesheet" href="/css/user-profile.css" />
  </head>

  <body class="profile-page" data-user-role="<%= user.role %>">
    <%- include("partials/header") %>

    <% const bannerUrl = user.banner || user.banner_image || null; %>

    <!-- MAIN -->
    <main data-user-id="<%= user.id %>" data-picture-status="<%= user.picture_status || 'approved' %>">

      <h1 class="sr-only"><%= user.pseudo %> — Mon compte Ciné Délices</h1>

      <!-- ══════════════════════════════════════════
           HERO BANNER
      ══════════════════════════════════════════ -->
      <section class="profile-hero">

        <!-- Bannière -->
        <div class="hero-banner">
          <% if (bannerUrl) { %>
          <img src="<%= bannerUrl %>" alt="Bannière de <%= user.pseudo %>" />
          <% } %>
          <div class="hero-banner-grad"></div>
        </div>

        <!-- Déco cinématographique -->
        <div class="hero-reel hero-reel--1" aria-hidden="true"></div>
        <div class="hero-reel hero-reel--2" aria-hidden="true"></div>
        <div class="hero-scanlines" aria-hidden="true"></div>
        <div class="hero-vignette" aria-hidden="true"></div>

        <!-- Page auteur (top-left) -->
        <% if (userRecipes && userRecipes.filter(r => r.status === 'approved').length > 0) { %>
        <div class="hero-author-link">
          <a href="/auteur/<%= user.id %>" class="author-link" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
            Ma page auteur
          </a>
        </div>
        <% } %>

        <!-- Statut bannière (top-right) -->
        <div class="hero-banner-status">
          <% if (user.banner_status === 'pending') { %>
            <span class="banner-btn banner-btn--pending"><span class="b-dot"></span>Bannière en attente</span>
          <% } else if (user.banner_status === 'rejected') { %>
            <button class="banner-btn banner-btn--rejected" type="button" onclick="document.getElementById('bannerInput').click()" title="Votre bannière a été refusée — cliquez pour en proposer une nouvelle">
              <span class="b-dot"></span>Bannière refusée — Réessayer
            </button>
          <% } else { %>
            <button class="banner-btn banner-btn--upload" type="button" onclick="document.getElementById('bannerInput').click()">
              <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Modifier la bannière
            </button>
          <% } %>
        </div>
        <input id="bannerInput" type="file" name="banner" accept="image/*" hidden />

        <!-- Contenu hero bas -->
        <form id="profileAvatarForm" class="hero-content">

          <div class="hero-row">

          <!-- Avatar -->
          <div class="avatar-block">
            <div class="profile-badge-hero"
               id="profileBadgeHero"
               data-frame-code="<%= typeof userActiveFrameId !== 'undefined' ? userActiveFrameId : 'cine' %>"
               data-photo-src="<%= user.picture || '/images/image-default-profile.jpg' %>">

              <!-- Photo statique (remplacée par BadgeEngine si frame animée) -->
              <img
                id="pbhPhoto"
                class="pbh-photo"
                src="<%= user.picture || '/images/image-default-profile.jpg' %>"
                alt="Avatar de <%= user.pseudo %>"
              />
              <!-- Cadre PNG overlay -->
              <% if (typeof userActiveFrame !== 'undefined' && userActiveFrame) { %>
              <img class="pbh-frame" src="<%= userActiveFrame %>" alt="" aria-hidden="true" />
              <% } else { %>
              <div class="pbh-ring"></div>
              <% } %>

              <!-- Statut photo -->
              <% if (user.picture_status === 'pending' || user.picture_status === 'rejected') { %>
              <span class="avatar-photo-status avatar-photo-status--<%= user.picture_status === 'pending' ? 'pending' : 'rejected' %>">
                <span class="b-dot"></span>
                <%= user.picture_status === 'pending' ? 'En attente' : 'Refusée' %>
              </span>
              <% } %>

              <!-- Actions -->
              <div class="avatar-actions">
                <label for="avatar" class="av-btn av-btn--upload" title="Changer la photo">
                  <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </label>
                <input type="file" id="avatar" name="avatar" accept="image/*" hidden />
                <button type="button" class="av-btn av-btn--del" id="removeAvatarBtn" title="Supprimer la photo">
                  <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Identité -->
          <div class="hero-identity">
            <div class="hero-pseudo-row">
              <%
                const _up = user.pseudo.trim().split(' ');
                const _upLast = _up.pop();
                const _upRest = _up.join(' ');
              %>
              <span id="pseudoDisplay" class="hero-pseudo hero-pseudo--display"><% if (_upRest) { %><%= _upRest %> <% } %><em><%= _upLast %></em></span>
              <input
                class="hero-pseudo hero-pseudo--input"
                id="username"
                name="pseudo"
                type="text"
                value="<%= user.pseudo %>"
                maxlength="30"
                disabled
              />
              <% if (user.pseudo_status === 'pending') { %>
                <span class="pseudo-status-badge pseudo-status-badge--pending"><span class="b-dot"></span>En attente</span>
              <% } else if (user.pseudo_status === 'rejected') { %>
                <span class="pseudo-status-badge pseudo-status-badge--rejected"><span class="b-dot"></span>Refusé</span>
              <% } else { %>
                <button type="button" class="hero-pseudo-edit" id="editPseudoBtn" title="Modifier le pseudo">
                  <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
              <% } %>
              <button type="button" class="hero-pseudo-save hero-pseudo-save--validate" id="savePseudoBtn">Valider</button>
              <button type="button" class="hero-pseudo-save hero-pseudo-save--cancel" id="cancelPseudoBtn">Annuler</button>
            </div>
            <p class="hero-sub">
              <%
                const _heroRanks = ['Spectateur Curieux','Cinéphile Amateur','Fin Palais','Analyste du Goût','Connaisseur','Explorateur Cuisinier','Détective des Saveurs','Critique Éclairé','Maître Cinéaste','Grand Gastronome','Virtuose Cinéphile','Légende de Ciné Délices','Ambassadeur','Visionnaire','Architecte des Saveurs','Maître des Écrans','Gardien du Temple','Élu de Ciné Délices','Mythe Vivant'];
                const _heroLvl   = (typeof userLevel !== 'undefined' && userLevel) ? parseInt(userLevel) : 1;
                const _heroRank  = _heroRanks[Math.min(_heroLvl - 1, _heroRanks.length - 1)];
              %>
              <span class="hero-sub__rank"><%= _heroRank %></span>
              <span class="hero-sub__sep" aria-hidden="true">·</span>
              <span class="hero-sub__lvl">Niv. <%= _heroLvl %></span>
            </p>

            <div class="hero-stats-row">
              <div class="h-stat">
                <span class="h-stat__num"><%= userRecipes.length %></span>
                <span class="h-stat__lbl">Recettes</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userMovies.length %></span>
                <span class="h-stat__lbl">Films</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userNoticesCount %></span>
                <span class="h-stat__lbl">Avis</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= (favoriteMoviesCount || 0) + (favoriteRecipesCount || 0) %></span>
                <span class="h-stat__lbl">Favoris</span>
              </div>
            </div>
          </div>

          </div><!-- /hero-row -->

        </form>
      </section>

      <!-- ══════════════════════════════════════════
           TABS NAVIGATION
      ══════════════════════════════════════════ -->
      <div class="profile-tabs-wrap">
        <nav class="profile-tabs" role="tablist" aria-label="Navigation du compte">
          <button class="ptab active" data-tab="overview" role="tab" aria-selected="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="ptab-text">Vue d'ensemble</span>
          </button>
          <button class="ptab" data-tab="profil" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="ptab-text">Profil</span>
          </button>
          <button class="ptab" data-tab="favoris" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span class="ptab-text">Favoris</span>
          </button>
          <button class="ptab" data-tab="creations" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span class="ptab-text">Créations</span>
            <% const totalCreations = userRecipes.length + userMovies.length + userNoticesCount; if (totalCreations > 0) { %>
            <span class="ptab-badge"><%= totalCreations %></span>
            <% } %>
          </button>
          <button class="ptab" data-tab="contributions" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="ptab-text">Contributions</span>
          </button>
        </nav>
      </div>

      <!-- ══════════════════════════════════════════
           CONTENT
      ══════════════════════════════════════════ -->
      <div class="profile-content">

        <!-- ─────────────────────────────────── -->
        <!-- TAB : VUE D'ENSEMBLE               -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane active" id="overview" role="tabpanel">

          <!-- BANDEAU IMPACT -->
          <div class="impact-banner">
            <div class="impact-cell">
              <div class="impact-cell__icon ic--recipe">
                <svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" data-ov-target="<%= userRecipes.length %>">0</div>
                <div class="impact-cell__lbl">Recettes créées</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--film">
                <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" data-ov-target="<%= userMovies.length %>">0</div>
                <div class="impact-cell__lbl">Films proposés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--avis">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" data-ov-target="<%= userNoticesCount %>">0</div>
                <div class="impact-cell__lbl">Avis rédigés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--note">
                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= avgUserRating || '—' %></div>
                <div class="impact-cell__lbl">Note moyenne</div>
              </div>
            </div>
          </div>

          <!-- LAYOUT 2 COLONNES -->
          <div class="crea-layout">

            <!-- ── SIDEBAR ── -->
            <aside class="crea-sidebar">

              <!-- Ma progression -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Ma progression</span>
                  <span class="widget-head__extra" onclick="document.querySelector('[data-tab=\'contributions\']').click()">Détails →</span>
                </div>
                <%
                  const _ovTotal      = userRecipes.length + userMovies.length;
                  const _ovApproved   = userRecipes.filter(r => r.status === 'approved').length + userMovies.filter(m => m.status === 'approved').length;
                  const _ovValPct     = _ovTotal > 0 ? Math.round((_ovApproved / _ovTotal) * 100) : 0;
                  const _ovXP         = (typeof userXP !== 'undefined' && userXP) ? parseInt(userXP) : 0;
                  const _ovLvl        = (typeof userLevel !== 'undefined' && userLevel) ? parseInt(userLevel) : 1;
                  const _ovXpTable    = [0,100,300,600,1100,1800,2800,4200,6000,8500,11500,15000,20000,26000,33000,41000,50000,60000,72000];
                  const _ovXpFloor    = _ovXpTable[_ovLvl - 1] || 0;
                  const _ovXpCeil     = _ovXpTable[_ovLvl] || (_ovLvl * 1500);
                  const _ovXpPct      = Math.min(100, Math.round(((_ovXP - _ovXpFloor) / (_ovXpCeil - _ovXpFloor)) * 100));
                  const _ovSince      = user.createdAt ? new Date(user.createdAt).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' }) : null;
                %>
                <div class="ov-progress-body">

                  <!-- Taux de validation -->
                  <div class="ov-prog-row">
                    <div class="ov-prog-labels">
                      <span class="ov-prog-label">Taux de validation</span>
                      <span class="ov-prog-val"><%= _ovApproved %> / <%= _ovTotal %> contenus</span>
                    </div>
                    <div class="ov-prog-bar-wrap">
                      <div class="ov-prog-bar ov-prog-bar--valide" style="width:<%= _ovValPct %>%"></div>
                    </div>
                    <span class="ov-prog-pct"><%= _ovValPct %>%</span>
                  </div>

                  <!-- Barre XP niveau -->
                  <div class="ov-prog-row">
                    <div class="ov-prog-labels">
                      <span class="ov-prog-label">Niveau <%= _ovLvl %> — <%= _ovXP.toLocaleString('fr-FR') %> XP</span>
                      <span class="ov-prog-val"><%= Math.max(0, _ovXpCeil - _ovXP).toLocaleString('fr-FR') %> XP pour niv. <%= _ovLvl + 1 %></span>
                    </div>
                    <div class="ov-prog-bar-wrap">
                      <div class="ov-prog-bar ov-prog-bar--xp" style="width:<%= _ovXpPct %>%"></div>
                    </div>
                    <span class="ov-prog-pct"><%= _ovXpPct %>%</span>
                  </div>

                  <!-- Membre depuis -->
                  <% if (_ovSince) { %>
                  <div class="ov-member-since">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Membre depuis <%= _ovSince %>
                  </div>
                  <% } %>

                </div>
              </div>

              <!-- Raccourcis -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Navigation rapide</span>
                </div>
                <div class="quick-actions">
                  <button class="qa-btn qa-btn--gold" onclick="document.querySelector('[data-tab=\'creations\']').click()">
                    <div class="qa-icon"><svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></div>
                    <div class="qa-text"><div class="qa-title">Mes créations</div><div class="qa-sub">Recettes, films et avis</div></div>
                  </button>
                  <button class="qa-btn qa-btn--violet" onclick="document.querySelector('[data-tab=\'favoris\']').click()">
                    <div class="qa-icon"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
                    <div class="qa-text"><div class="qa-title">Mes favoris</div><div class="qa-sub">Films et recettes sauvegardés</div></div>
                  </button>
                  <button class="qa-btn qa-btn--vert" onclick="document.querySelector('[data-tab=\'contributions\']').click()">
                    <div class="qa-icon"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
                    <div class="qa-text"><div class="qa-title">Contributions</div><div class="qa-sub">XP, niveaux et cadres</div></div>
                  </button>
                </div>
              </div>

            </aside>

            <!-- ── COLONNE PRINCIPALE ── -->
            <div class="crea-main">

              <!-- DERNIÈRES RECETTES -->
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes créations culinaires</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">DERNIÈRES RECETTES</div>
                  <button class="sec-link" onclick="document.querySelector('[data-tab=\'creations\']').click()">Voir tout →</button>
                </div>
                <div class="list-grid">
                  <% if (userRecipes && userRecipes.length > 0) { %>
                    <% userRecipes.slice(0, 3).forEach(function(recipe) {
                      const _rsCls = recipe.status === 'approved' ? 'lrs--valide' : recipe.status === 'pending' ? 'lrs--attente' : 'lrs--refuse';
                      const _rsTxt = recipe.status === 'approved' ? 'Validée' : recipe.status === 'pending' ? 'En attente' : 'Refusée';
                    %>
                    <div class="list-row list-row--recette">
                      <% if (recipe.picture) { %>
                      <img class="list-row__thumb" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--ph">🍽️</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= recipe.name %></span>
                          <span class="lr-status <%= _rsCls %>">
                            <% if (recipe.status !== 'rejected') { %><span class="lr-status-dot"></span><% } %>
                            <%= _rsTxt %>
                          </span>
                        </div>
                        <div class="list-row__tags">
                          <span class="lr-tag lr-tag--cat"><%= recipe.category %></span>
                          <% if (recipe.Movie) { %><span class="lr-tag lr-tag--film">🎬 <%= recipe.Movie.title %></span><% } %>
                        </div>
                        <div class="list-row__sub">
                          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          <%= recipe.time %> min · <%= recipe.difficulty %>
                        </div>
                      </div>
                      <% if (recipe.status === 'approved') { %>
                      <a href="/recipes-movie/details/<%= recipe.id %>" class="lr-btn lr-btn--view" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><span>Voir</span>
                      </a>
                      <% } %>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune recette</div>
                    <div class="crea-empty__sub">Partagez votre première création</div>
                  </div>
                  <% } %>
                </div>
              </section>

              <!-- FILMS RÉCENTS -->
              <% if (userMovies && userMovies.length > 0) { %>
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Films suggérés à la communauté</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">FILMS RÉCENTS</div>
                  <button class="sec-link" onclick="document.querySelector('[data-tab=\'creations\']').click()">Voir tout →</button>
                </div>
                <div class="list-grid">
                  <% userMovies.slice(0, 3).forEach(function(movie) {
                    const _msCls = movie.status === 'approved' ? 'lrs--valide' : movie.status === 'pending' ? 'lrs--attente' : 'lrs--refuse';
                    const _msTxt = movie.status === 'approved' ? 'Validé' : movie.status === 'pending' ? 'En attente' : 'Refusé';
                  %>
                  <div class="list-row list-row--film">
                    <% if (movie.cardPath || movie.picture) { %>
                    <img class="list-row__thumb list-row__thumb--film" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                    <% } else { %>
                    <div class="list-row__thumb list-row__thumb--film list-row__thumb--ph">🎬</div>
                    <% } %>
                    <div class="list-row__body">
                      <div class="list-row__top">
                        <span class="list-row__name"><%= movie.title %></span>
                        <span class="lr-status <%= _msCls %>">
                          <% if (movie.status !== 'rejected') { %><span class="lr-status-dot"></span><% } %>
                          <%= _msTxt %>
                        </span>
                      </div>
                      <% if (movie.genre) { %><div class="list-row__tags"><span class="lr-tag lr-tag--genre"><%= movie.genre %></span></div><% } %>
                      <div class="list-row__sub">
                        <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg>
                        <%= movie.year %>
                      </div>
                    </div>
                    <% if (movie.status === 'approved') { %>
                    <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="lr-btn lr-btn--violet" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><span>Voir</span>
                    </a>
                    <% } %>
                  </div>
                  <% }) %>
                </div>
              </section>
              <% } %>

              <!-- DERNIERS AVIS -->
              <% if (userNotices && userNotices.length > 0) { %>
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Critiques &amp; évaluations</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">DERNIERS AVIS</div>
                  <button class="sec-link" onclick="document.querySelector('[data-tab=\'creations\']').click()">Voir tout →</button>
                </div>
                <div class="avis-grid">
                  <% userNotices.slice(0, 2).forEach(function(notice) { %>
                  <div class="avis-card">
                    <div class="avis-icon">
                      <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div class="avis-body">
                      <div class="avis-top">
                        <div class="avis-titles">
                          <% if (notice.Recipe) { %>
                          <div class="avis-recipe-name">Recette : <a class="account-item__link" href="/recipes-movie/details/<%= notice.Recipe.id %>"><%= notice.Recipe.name %></a></div>
                          <% if (notice.Recipe.Movie) { %><div class="avis-film-link">Film : <%= notice.Recipe.Movie.title %></div><% } %>
                          <% } %>
                        </div>
                        <div class="avis-stars-row">
                          <div class="avis-score">
                            <% for (let _ai = 1; _ai <= 5; _ai++) { %><span class="star<%= _ai <= parseInt(notice.quote) ? ' star--on' : '' %>">★</span><% } %>
                          </div>
                          <span class="avis-score-val"><%= notice.quote %>/5</span>
                        </div>
                      </div>
                      <% if (notice.content) { %><div class="avis-quote"><%= notice.content %></div><% } %>
                      <div class="avis-footer">
                        <% if (notice.status === 'approved') { %>
                        <span class="avis-status-badge ab--valide">✓ Validé</span>
                        <% } else { %>
                        <span class="avis-status-badge ab--attente">⏳ En attente</span>
                        <% } %>
                        <span class="avis-date"><%= notice.createdAt ? new Date(notice.createdAt).toLocaleDateString('fr-FR') : '' %></span>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                </div>
              </section>
              <% } %>

            </div><!-- /crea-main -->

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#overview -->


