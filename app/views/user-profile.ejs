                  const _sbAttente = _crTotal > 0 ? Math.round((_crPending  / _crTotal) * 100) : 0;
                  const _sbRefuse  = _crTotal > 0 ? Math.round((_crRejected / _crTotal) * 100) : 0;
                %>
