                        </div>
                        <div class="list-row__sub account-item__meta">
                          <i data-lucide="clock" aria-hidden="true"></i>
                          <%= recipe.time %> min<% if (recipe.status === 'pending') { %> <span class="lr-sub-muted">· En cours de modération…</span><% } %>
                        </div>
                        <% if (recipe.edit_status === 'pending') { %>
                        <p class="account-item__hint account-item__hint--pending">⏳ Modification en attente de validation.</p>
                        <% } else if (recipe.edit_status === 'approved') { %>
                        <p class="account-item__hint account-item__hint--approved">✓ Modification approuvée.</p>
                        <% } else if (recipe.edit_status === 'rejected') { %>
                        <p class="account-item__hint account-item__hint--rejected">✕ Modification refusée. Vous pouvez soumettre une nouvelle modification.</p>
                        <% } %>
                      </div>
                      <div class="list-row__actions">
                        <% if (recipe.status === 'approved') { %>
                        <a href="/recipes-movie/details/<%= recipe.id %>" class="lr-btn lr-btn--view" target="_blank" rel="noopener">
                          <i data-lucide="eye" aria-hidden="true"></i><span>Voir</span>
                        </a>
                        <% } %>
                        <button class="lr-btn lr-btn--edit account-edit-btn" <%= recipe.edit_status === 'pending' ? 'disabled' : '' %>>
                          <i data-lucide="square-pen" aria-hidden="true"></i><span>Éditer</span>
                        </button>
                        <% if (recipe.delete_request_status === 'pending') { %>
                        <button class="lr-btn lr-btn--del account-delete-btn" disabled>
                          <i data-lucide="trash-2" aria-hidden="true"></i><span>Suppr.</span>
                        </button>
                        <% } else { %>
                        <button class="lr-btn lr-btn--del account-delete-btn">
                          <i data-lucide="trash-2" aria-hidden="true"></i><span>Suppr.</span>
                        </button>
                        <% } %>
                      </div>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune recette</div>
                    <div class="crea-empty__sub">Partagez votre première création culinaire</div>
                  </div>
                  <% } %>
