<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Ciné Délices — Gérez votre compte et vos préférences cinéma & recettes" />
    <title>Mon compte - Ciné Délices</title>
    <%- include("partials/head-resources") %>
    <link rel="stylesheet" href="/css/user-profile.css?v=60" />
    <link rel="stylesheet" href="/css/ctb2-hero.css" />
    <link rel="stylesheet" href="/css/rte-mini.css" />
    <link rel="stylesheet" href="/css/badge-strange.css" />
  </head>

  <body class="profile-page" data-user-role="<%= user.role %>">
    <%- include("partials/header") %>

    <%
      /* heroBannerUrl calculé côté contrôleur (resolveHeroBanner) : bannière perso
         approuvée > fond officiel du cadre équipé > défaut Ciné Délices — même
         logique que /cinepass/ et /auteur/:id. */
      const _hasCustomBanner = user.banner_status === 'approved' && (user.banner || user.banner_image);
    %>

    <!-- MAIN -->
    <main data-user-id="<%= user.id %>" data-picture-status="<%= user.picture_status || 'approved' %>">

      <h1 class="sr-only"><%= user.pseudo %> — Mon compte Ciné Délices</h1>

      <!-- ══════════════════════════════════════════
           HERO BANNER
      ══════════════════════════════════════════ -->
      <section class="profile-hero">

        <!-- Bannière -->
        <div class="hero-banner">
          <img src="<%= _hasCustomBanner ? cldFull(heroBannerUrl) : heroBannerUrl %>" alt="Bannière de <%= user.pseudo %>" />
          <div class="hero-banner-grad"></div>
        </div>

        <!-- Déco cinématographique -->
        <div class="hero-reel hero-reel--1" aria-hidden="true"></div>
        <div class="hero-reel hero-reel--2" aria-hidden="true"></div>
        <div class="hero-scanlines" aria-hidden="true"></div>
        <div class="hero-vignette" aria-hidden="true"></div>

        <!-- Page auteur + personnalisation (top-left) — Étape 3 (audit UX) :
             le décor/bannière/repositionnement vivent sur la Page Auteur, mais
             rien sur "Mon compte" ne le laissait deviner. Le lien
             "Personnaliser mon profil" rend ce chemin explicite et ouvre
             directement le popover "Personnaliser mon univers" là-bas
             (voir ?personnaliser=1, géré dans author-page.ejs). -->
        <% if (userRecipes && userRecipes.filter(r => r.status === 'approved').length > 0) { %>
        <div class="hero-author-link">
          <a href="/auteur/<%= user.id %>" class="author-link" target="_blank" rel="noopener">
            <i data-lucide="film" aria-hidden="true"></i>
            Ma page auteur
          </a>
          <a href="/auteur/<%= user.id %>?personnaliser=1" class="author-link author-link--customize" target="_blank" rel="noopener">
            <i data-lucide="sparkles" aria-hidden="true"></i>
            Personnaliser mon profil
          </a>
        </div>
        <% } %>

        <!-- Statut bannière (top-right) — upload perso retiré (voir page
             auteur) : les fonds "by Ciné Délices" liés au cadre équipé
             suffisent, plus besoin de modération admin. Les statuts pending/
             rejected restent affichés en info pure pour les fonds perso déjà
             soumis avant ce changement, sans action de nouvel upload. -->
        <% if (user.banner_status === 'pending') { %>
        <div class="hero-banner-status">
          <span class="banner-btn banner-btn--pending"><span class="b-dot"></span>Bannière en attente</span>
        </div>
        <% } else if (user.banner_status === 'rejected') { %>
        <div class="hero-banner-status">
          <span class="banner-btn banner-btn--rejected"><span class="b-dot"></span>Bannière refusée</span>
        </div>
        <% } %>

        <!-- Contenu hero bas -->
        <form id="profileAvatarForm" class="hero-content">

          <div class="hero-row">

          <!-- Avatar -->
          <div class="avatar-block">
            <% if (typeof userActiveFrameId !== 'undefined' && userActiveFrameId === 'strange') { %>
            <!-- Dr Strange — badge CSS animé -->
            <div class="profile-badge-hero profile-badge-hero--css-only"
                 id="profileBadgeHero"
                 data-frame-code="strange"
                 data-photo-src="<%= cldCard(user.picture || '/images/image-default-profile.jpg') %>">
              <%- include('partials/badge-strange-avatar', {
                photoSrc: cldCard(user.picture || '/images/image-default-profile.jpg'),
                photoAlt: 'Avatar de ' + user.pseudo
              }) %>
              <!-- Statut photo -->
              <% if (user.picture_status === 'pending' || user.picture_status === 'rejected') { %>
              <span class="avatar-photo-status avatar-photo-status--<%= user.picture_status === 'pending' ? 'pending' : 'rejected' %>">
                <span class="b-dot"></span>
                <%= user.picture_status === 'pending' ? 'En attente' : 'Refusée' %>
              </span>
              <% } %>
              <!-- Actions -->
              <div class="avatar-actions">
                <label for="avatar" class="av-btn av-btn--upload" title="Changer la photo">
                  <i data-lucide="upload" aria-hidden="true"></i>
                </label>
                <input type="file" id="avatar" name="avatar" accept="image/*" hidden />
                <button type="button" class="av-btn av-btn--del" id="removeAvatarBtn" title="Supprimer la photo">
                  <i data-lucide="trash-2" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <% } else { %>
            <!-- Standard — photo + cadre PNG (BadgeEngine si animé) -->
            <div class="profile-badge-hero"
               id="profileBadgeHero"
               data-frame-code="<%= typeof userActiveFrameId !== 'undefined' ? userActiveFrameId : 'cine' %>"
               data-photo-src="<%= cldCard(user.picture || '/images/image-default-profile.jpg') %>">

              <img
                id="pbhPhoto"
                class="pbh-photo"
                src="<%= cldCard(user.picture || '/images/image-default-profile.jpg') %>"
                alt="Avatar de <%= user.pseudo %>"
              />
              <% if (typeof userActiveFrame !== 'undefined' && userActiveFrame) { %>
              <img class="pbh-frame" src="<%= userActiveFrame %>" alt="" aria-hidden="true" />
              <% } else { %>
              <div class="pbh-ring"></div>
              <% } %>

              <!-- Statut photo -->
              <% if (user.picture_status === 'pending' || user.picture_status === 'rejected') { %>
              <span class="avatar-photo-status avatar-photo-status--<%= user.picture_status === 'pending' ? 'pending' : 'rejected' %>">
                <span class="b-dot"></span>
                <%= user.picture_status === 'pending' ? 'En attente' : 'Refusée' %>
              </span>
              <% } %>

              <!-- Actions -->
              <div class="avatar-actions">
                <label for="avatar" class="av-btn av-btn--upload" title="Changer la photo">
                  <i data-lucide="upload" aria-hidden="true"></i>
                </label>
                <input type="file" id="avatar" name="avatar" accept="image/*" hidden />
                <button type="button" class="av-btn av-btn--del" id="removeAvatarBtn" title="Supprimer la photo">
                  <i data-lucide="trash-2" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Template caché : badge Dr Strange CSS — cloné par gamification.js lors d'un changement de cadre -->
          <template id="bds-badge-tpl">
            <%- include('partials/badge-strange-avatar', {
              photoSrc: cldCard(user.picture || '/images/image-default-profile.jpg'),
              photoAlt: 'Avatar de ' + user.pseudo
            }) %>
          </template>

          <!-- Identité -->
          <div class="hero-identity">
            <div class="hero-pseudo-row">
              <%
                const _up = user.pseudo.trim().split(' ');
                const _upLast = _up.pop();
                const _upRest = _up.join(' ');
              %>
              <span id="pseudoDisplay" class="hero-pseudo hero-pseudo--display"><% if (_upRest) { %><%= _upRest %> <% } %><em><%= _upLast %></em></span>
              <input
                class="hero-pseudo hero-pseudo--input"
                id="username"
                name="pseudo"
                type="text"
                value="<%= user.pseudo %>"
                maxlength="30"
                disabled
              />
              <% if (user.pseudo_status === 'pending') { %>
                <span class="pseudo-status-badge pseudo-status-badge--pending"><span class="b-dot"></span>En attente</span>
              <% } else if (user.pseudo_status === 'rejected') { %>
                <span class="pseudo-status-badge pseudo-status-badge--rejected"><span class="b-dot"></span>Refusé</span>
              <% } else { %>
                <button type="button" class="hero-pseudo-edit" id="editPseudoBtn" title="Modifier le pseudo">
                  <i data-lucide="square-pen" aria-hidden="true"></i>
                </button>
              <% } %>
              <button type="button" class="hero-pseudo-save hero-pseudo-save--validate" id="savePseudoBtn">Valider</button>
              <button type="button" class="hero-pseudo-save hero-pseudo-save--cancel" id="cancelPseudoBtn">Annuler</button>
            </div>
            <p class="hero-sub">
              <%
                const _heroRanks = ['Spectateur Curieux','Cinéphile Amateur','Fin Palais','Analyste du Goût','Connaisseur','Explorateur Cuisinier','Détective des Saveurs','Critique Éclairé','Maître Cinéaste','Grand Gastronome','Virtuose Cinéphile','Légende de Ciné Délices','Ambassadeur','Visionnaire','Architecte des Saveurs','Maître des Écrans','Gardien du Temple','Élu de Ciné Délices','Mythe Vivant'];
                const _heroLvl   = (typeof userLevel !== 'undefined' && userLevel) ? parseInt(userLevel) : 1;
                const _heroRank  = _heroRanks[Math.min(_heroLvl - 1, _heroRanks.length - 1)];
              %>
              <span class="hero-sub__rank"><%= _heroRank %></span>
              <span class="hero-sub__sep" aria-hidden="true">·</span>
              <span class="hero-sub__lvl">Niv. <%= _heroLvl %></span>
            </p>

            <div class="hero-stats-row">
              <div class="h-stat">
                <span class="h-stat__num"><%= userRecipes.length %></span>
                <span class="h-stat__lbl">Recettes</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userMovies.length %></span>
                <span class="h-stat__lbl">Films</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userNoticesCount %></span>
                <span class="h-stat__lbl">Avis</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= (favoriteMoviesCount || 0) + (favoriteRecipesCount || 0) %></span>
                <span class="h-stat__lbl">Favoris</span>
              </div>
            </div>
          </div>

          </div><!-- /hero-row -->

        </form>
      </section>

      <!-- ══════════════════════════════════════════
           TABS NAVIGATION
      ══════════════════════════════════════════ -->
      <div class="profile-tabs-wrap">
        <nav class="profile-tabs" role="tablist" aria-label="Navigation du compte">
          <button class="ptab active" data-tab="overview" role="tab" aria-selected="true">
            <i data-lucide="layout-grid" aria-hidden="true"></i>
            <span class="ptab-text">Vue d'ensemble</span>
          </button>
          <button class="ptab" data-tab="profil" role="tab" aria-selected="false">
            <i data-lucide="user" aria-hidden="true"></i>
            <span class="ptab-text">Profil</span>
          </button>
          <button class="ptab" data-tab="favoris" role="tab" aria-selected="false">
            <i data-lucide="heart" aria-hidden="true"></i>
            <span class="ptab-text">Favoris</span>
          </button>
          <button class="ptab" data-tab="creations" role="tab" aria-selected="false">
            <i data-lucide="plus" aria-hidden="true"></i>
            <span class="ptab-text">Contributions</span>
            <% const totalContributions = userRecipes.length + userMovies.length + userNoticesCount; if (totalContributions > 0) { %>
            <span class="ptab-badge"><%= totalContributions > 9 ? '9+' : totalContributions %></span>
            <% } %>
          </button>
        </nav>
      </div>

      <!-- ══════════════════════════════════════════
           CONTENT
      ══════════════════════════════════════════ -->
      <div class="profile-content">

        <!-- ─────────────────────────────────── -->
        <!-- TAB : VUE D'ENSEMBLE               -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane active" id="overview" role="tabpanel">

          <!-- BANDEAU IMPACT -->
          <div class="impact-banner">
            <div class="impact-cell">
              <div class="impact-cell__icon ic--recipe">
                <i data-lucide="utensils" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" data-ov-target="<%= userRecipes.length %>">0</div>
                <div class="impact-cell__lbl">Recettes créées</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--film">
                <i data-lucide="film" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" data-ov-target="<%= userMovies.length %>">0</div>
                <div class="impact-cell__lbl">Films proposés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--avis">
                <i data-lucide="message-square" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" data-ov-target="<%= userNoticesCount %>">0</div>
                <div class="impact-cell__lbl">Avis rédigés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--note">
                <i data-lucide="star" fill="currentColor" stroke="currentColor" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= avgUserRating || '—' %></div>
                <div class="impact-cell__lbl">Note moyenne</div>
              </div>
            </div>
          </div>

          <!-- LAYOUT 2 COLONNES -->
          <div class="crea-layout">

            <!-- ── SIDEBAR ── -->
            <aside class="crea-sidebar">

              <!-- Ma progression — Étape 1 (Phase 5, recentrage architecture) :
                   résumé contextuel minimal. La mécanique de progression
                   (barre XP, %, seuils, taux de validation) appartient
                   exclusivement à CinéPass, seule destination pour "voir sa
                   progression". Niveau/rang restent ici : ce sont des
                   repères identitaires ("qui je suis"), pas la mécanique
                   elle-même. Ne pas réintroduire XP/% ici — voir Phase 5. -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Ma progression</span>
                </div>
                <%
                  const _ovSince = user.createdAt ? new Date(user.createdAt).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' }) : null;
                %>
                <div class="ov-progress-body ov-progress-body--mini">

                  <p class="hero-sub ov-mini-rank">
                    <span class="hero-sub__rank"><%= _heroRank %></span>
                    <span class="hero-sub__sep" aria-hidden="true">·</span>
                    <span class="hero-sub__lvl">Niv. <%= _heroLvl %></span>
                  </p>

                  <a href="/cinepass/" class="sec-link ov-mini-link">Voir ma progression →</a>

                  <!-- Membre depuis -->
                  <% if (_ovSince) { %>
                  <div class="ov-member-since">
                    <i data-lucide="clock" aria-hidden="true"></i>
                    Membre depuis <%= _ovSince %>
                  </div>
                  <% } %>

                </div>
              </div>

              <!-- Raccourcis -->
              <!-- "Navigation rapide" supprimée — Étape 3 (Phase 5, recentrage
                   architecture) : ses 3 raccourcis étaient tous redondants
                   une fois l'Étape 2 en place — "Mes créations" ouvrait un
                   onglet désormais réduit à un simple lien vers
                   /contributions/ (indirection inutile), "Mes favoris"
                   duplique le cœur ♥ toujours visible dans le header
                   (/auth/profil/:id#favoris, voir partials/header.ejs),
                   et "Mon CinéPass" duplique le lien "Voir ma progression →"
                   du widget juste au-dessus. Aucun remplacement : les
                   chemins contextuels déjà en place (widget progression,
                   "Ce que je publie", hero "Ma page auteur"/"Personnaliser
                   mon profil") suffisent — voir Phase 5, Étape 3. -->

            </aside>

            <!-- ── COLONNE PRINCIPALE ── -->
            <div class="crea-main">

              <!-- Ce que je publie — Étape 1 (Phase 5, recentrage architecture) :
                   résumé contextuel uniquement (compteur + lien). Le détail
                   (listes recettes/films/avis, statuts, édition, suppression)
                   est la responsabilité exclusive de /contributions/, qui ne
                   doit plus être concurrencée par une deuxième destination de
                   consultation ici. Ne pas réintroduire de listing détaillé
                   sur cette page — voir Phase 5, Partie 2/3. -->
              <%
                const _ovPubTotal = userRecipes.length + userMovies.length + userNoticesCount;
              %>
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Ce que je publie</span>
                </div>
                <div class="widget">
                  <% if (_ovPubTotal > 0) { %>
                  <div class="ov-contrib-summary">
                    <div class="ov-contrib-summary__count"><%= _ovPubTotal %></div>
                    <div class="ov-contrib-summary__lbl">contribution<%= _ovPubTotal > 1 ? 's' : '' %> publiée<%= _ovPubTotal > 1 ? 's' : '' %></div>
                    <div class="ov-contrib-summary__breakdown">
                      <%= userRecipes.length %> recette<%= userRecipes.length !== 1 ? 's' : '' %> · <%= userMovies.length %> film<%= userMovies.length !== 1 ? 's' : '' %> · <%= userNoticesCount %> avis
                    </div>
                    <a href="/contributions/" class="lr-btn lr-btn--view ov-contrib-summary__cta">
                      <i data-lucide="folder-open" aria-hidden="true"></i>
                      <span>Voir mes contributions</span>
                    </a>
                  </div>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune contribution</div>
                    <div class="crea-empty__sub">Partagez votre première contribution</div>
                  </div>
                  <% } %>
                </div>
              </section>

            </div><!-- /crea-main -->

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#overview -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : PROFIL                        -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="profil" role="tabpanel">

          <!-- BANDEAU IMPACT -->
          <div class="impact-banner">
            <div class="impact-cell">
              <div class="impact-cell__icon ic--recipe">
                <i data-lucide="user" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= user.pseudo %></div>
                <div class="impact-cell__lbl">Pseudo</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--avis">
                <i data-lucide="message-square" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= userNoticesCount %></div>
                <div class="impact-cell__lbl">Avis publiés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--note">
                <i data-lucide="star" fill="currentColor" stroke="currentColor" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= avgUserRating || '—' %></div>
                <div class="impact-cell__lbl">Note moyenne</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--film">
                <i data-lucide="film" aria-hidden="true"></i>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= userRecipes.length %></div>
                <div class="impact-cell__lbl">Recettes créées</div>
              </div>
            </div>
          </div>

          <!-- LAYOUT 2 COLONNES -->
          <div class="crea-layout">

            <!-- ── SIDEBAR (gauche, étroite) : zone danger ── -->
            <aside class="crea-sidebar">

              <!-- ═══ CARD SUPPRIMER MON COMPTE ═══ -->
              <div class="delacc-card" role="region" aria-labelledby="delacc-title">
                <div class="delacc-card__shimmer" aria-hidden="true"></div>
                <div class="delacc-card__inner">
                  <div class="delacc-card__head">
                    <div class="delacc-card__icon" aria-hidden="true">
                      <i data-lucide="triangle-alert" aria-hidden="true"></i>
                    </div>
                    <div class="delacc-card__titles">
                      <p class="delacc-card__eyebrow">Zone critique</p>
                      <h3 class="delacc-card__title" id="delacc-title">Supprimer<em>mon compte</em></h3>
                    </div>
                  </div>
                  <p class="delacc-card__desc">
                    Action <strong>irréversible</strong>. Recettes, avis, favoris et historique seront définitivement effacés.
                  </p>
                  <button type="button" class="delacc-card__cta" id="deleteAccountBtn">
                    <i data-lucide="trash-2" aria-hidden="true"></i>
                    <span>Supprimer mon compte</span>
                  </button>
                </div>
              </div>

            </aside>

            <!-- ── COLONNE PRINCIPALE (droite, large) : formulaire + préférences ── -->
            <div class="crea-main">

              <!-- INFORMATIONS -->
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Paramètres du compte</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">INFORMATIONS</div>
                  <button type="button" class="sec-link" id="editProfileBtn">Éditer →</button>
                </div>
                <div class="widget">
                  <div class="widget__form-body">
                    <form id="profileInfoForm">
                      <div class="pf-row">
                        <div class="pf-group pf-group--full">
                          <label class="pf-label" for="email">Adresse e-mail</label>
                          <input class="pf-input" type="email" id="email" name="email" value="<%= user.email %>" disabled />
                        </div>
                      </div>
                      <% if (user.google_id) { %>
                      <!-- Compte Google : pas de mot de passe local -->
                      <div class="pf-row">
                        <div class="pf-group pf-group--full">
                          <label class="pf-label">Connexion</label>
                          <div class="pf-google-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 48 48" aria-hidden="true">
                              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.35-8.16 2.35-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
