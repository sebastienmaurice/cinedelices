                </div>
                <div class="list-grid">
                  <% if (favoriteRecipes && favoriteRecipes.length > 0) { %>
                    <% favoriteRecipes.slice(0, 8).forEach(function(recipe) { %>
                    <a href="/recipes-movie/details/<%= recipe.slug || recipe.id %>" class="list-row list-row--recette list-row--link">
                      <% if (recipe.picture) { %>
                      <img class="list-row__thumb" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--ph">🍽️</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= recipe.name %></span>
                          <span class="lr-tag lr-tag--cat" style="flex-shrink:0"><%= recipe.category %></span>
                        </div>
                        <div class="list-row__sub">
                          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          <%= recipe.time %> min<% if (recipe.Movie) { %> · <%= recipe.Movie.title %><% } %>
                        </div>
                      </div>
                      <svg class="fav-row-arrow" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                    <% }) %>
                    <% if (favoriteRecipesCount > 8) { %>
                    <div class="crea-empty" style="padding:14px;"><div class="crea-empty__sub">+ <%= favoriteRecipesCount - 8 %> autre<%= (favoriteRecipesCount - 8) > 1 ? 's' : '' %> recette<%= (favoriteRecipesCount - 8) > 1 ? 's' : '' %> favorite<%= (favoriteRecipesCount - 8) > 1 ? 's' : '' %></div></div>
                    <% } %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune recette favorite</div>
                    <div class="crea-empty__sub">Découvrez les recettes et sauvegardez vos préférées</div>
                  </div>
                  <% } %>
                </div>
              </section>

              <!-- FILMS NOTÉS -->
              <section id="notedFilmsSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes évaluations cinéma</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">FILMS NOTÉS</div>
                  <span class="sec-link" style="cursor:default;"><%= ratedMoviesCount || 0 %> noté<%= (ratedMoviesCount || 0) > 1 ? 's' : '' %></span>
                </div>
                <div class="list-grid">
                  <% if (ratedMovies && ratedMovies.length > 0) { %>
                    <% ratedMovies.slice(0, 8).forEach(function(movie) { %>
                    <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="list-row list-row--film list-row--link">
                      <% if (movie.cardPath || movie.picture) { %>
                      <img class="list-row__thumb list-row__thumb--film" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--film list-row__thumb--ph">🎬</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= movie.title %></span>
                        </div>
                        <div class="list-row__sub">
                          <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg>
                          <%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %>
                        </div>
                      </div>
                      <span class="fav-score-badge">★ <%= movie.userScore %></span>
                    </a>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">⭐</div>
                    <div class="crea-empty__title">Aucun film noté</div>
                    <div class="crea-empty__sub">Notez les films de votre collection</div>
                  </div>
                  <% } %>
                </div>
              </section>

              <!-- RECETTES NOTÉES -->
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes évaluations culinaires</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">RECETTES NOTÉES</div>
                  <span class="sec-link" style="cursor:default;"><%= ratedRecipesCount || 0 %> notée<%= (ratedRecipesCount || 0) > 1 ? 's' : '' %></span>
                </div>
                <div class="list-grid">
                  <% if (ratedRecipes && ratedRecipes.length > 0) { %>
                    <% ratedRecipes.slice(0, 8).forEach(function(recipe) { %>
                    <a href="/recipes-movie/details/<%= recipe.slug || recipe.id %>" class="list-row list-row--recette list-row--link">
                      <% if (recipe.picture) { %>
                      <img class="list-row__thumb" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--ph">🍽️</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= recipe.name %></span>
                        </div>
                        <div class="list-row__sub">
                          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          <%= recipe.category %> · <%= recipe.time %> min
                        </div>
                      </div>
                      <span class="fav-score-badge">★ <%= recipe.userScore %></span>
                    </a>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">⭐</div>
                    <div class="crea-empty__title">Aucune recette notée</div>
                    <div class="crea-empty__sub">Notez vos recettes préférées</div>
                  </div>
                  <% } %>
                </div>
              </section>

            </div><!-- /crea-main -->

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#favoris -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : CRÉATIONS                     -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="creations" role="tabpanel">

          <%
            /* ── Stats créations ── */
            const _cr = (userRecipes || []);
            const _cm = (userMovies || []);
            const _cn = (userNotices || []);
            const _crApproved  = _cr.filter(r => r.status === 'approved').length;
            const _crPending   = _cr.filter(r => r.status === 'pending').length;
            const _crRejected  = _cr.filter(r => r.status === 'rejected').length;
            const _cmApproved  = _cm.filter(m => m.status === 'approved').length;
            const _cnApproved  = _cn.filter(n => n.status === 'approved').length;
            const _crValidated = _crApproved + _cmApproved + _cnApproved;
            const _crTotal     = _cr.length;
            const _cmTotal     = _cm.length;
            const _cnTotal     = (typeof userNoticesCount !== 'undefined' ? userNoticesCount : null) || _cn.length;
            const _crMax       = Math.max(_crTotal, 1);
          %>

          <!-- ═══ BANDEAU IMPACT ═══ -->
          <div class="impact-banner">
            <div class="impact-cell">
              <div class="impact-cell__icon ic--recipe">
                <svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" id="creaStatRecettes"><%= _crTotal %></div>
                <div class="impact-cell__lbl">Recettes créées</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--film">
                <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" id="creaStatFilms"><%= _cmTotal %></div>
                <div class="impact-cell__lbl">Films proposés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--avis">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" id="creaStatAvis"><%= _cnTotal %></div>
                <div class="impact-cell__lbl">Avis rédigés</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--valide">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val" id="creaStatValide"><%= _crValidated %></div>
                <div class="impact-cell__lbl">Contenus validés</div>
              </div>
            </div>
          </div>

          <!-- ═══ LAYOUT 2 COLONNES ═══ -->
          <div class="crea-layout">

            <!-- ── SIDEBAR ── -->
            <aside class="crea-sidebar">

              <!-- STATISTIQUES -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Mes chiffres</span>
                </div>
                <div class="stats-grid">
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-crea-target="<%= _crTotal %>">0</div>
                      <div class="stat-lbl">Recettes</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-crea-target="<%= _cmTotal %>">0</div>
                      <div class="stat-lbl">Films</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-crea-target="<%= _cnTotal %>">0</div>
                      <div class="stat-lbl">Avis</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-crea-target="<%= _crValidated %>">0</div>
                      <div class="stat-lbl">Validés</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- STATUT DES RECETTES -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Statut des recettes</span>
                </div>
                <%
                  const _sbValide  = _crTotal > 0 ? Math.round((_crApproved / _crTotal) * 100) : 0;
                  const _sbAttente = _crTotal > 0 ? Math.round((_crPending  / _crTotal) * 100) : 0;
                  const _sbRefuse  = _crTotal > 0 ? Math.round((_crRejected / _crTotal) * 100) : 0;
                %>
                <div class="status-bars">
                  <div class="status-bar-row sb--valide">
                    <span class="sb-label">Validées</span>
                    <div class="sb-track"><div class="sb-fill" data-sb-w="<%= _sbValide %>" style="width:0%"></div></div>
                    <span class="sb-count"><%= _crApproved %></span>
                  </div>
                  <div class="status-bar-row sb--attente">
                    <span class="sb-label">En attente</span>
                    <div class="sb-track"><div class="sb-fill" data-sb-w="<%= _sbAttente %>" style="width:0%"></div></div>
                    <span class="sb-count"><%= _crPending %></span>
                  </div>
                  <div class="status-bar-row sb--refuse">
                    <span class="sb-label">Refusées</span>
                    <div class="sb-track"><div class="sb-fill" data-sb-w="<%= _sbRefuse %>" style="width:0%"></div></div>
                    <span class="sb-count"><%= _crRejected %></span>
                  </div>
                </div>
              </div>

              <!-- ACTIONS RAPIDES -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Actions rapides</span>
                </div>
                <div class="quick-actions">
                  <a href="/add-recipes-movies" class="qa-btn qa-btn--gold">
                    <div class="qa-icon"><svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></div>
                    <div class="qa-text">
                      <div class="qa-title">Nouvelle recette</div>
                      <div class="qa-sub">Partager une création culinaire</div>
                    </div>
                  </a>
                  <a href="/add-recipes-movies" class="qa-btn qa-btn--violet">
                    <div class="qa-icon"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg></div>
                    <div class="qa-text">
                      <div class="qa-title">Proposer un film</div>
                      <div class="qa-sub">Suggérer un film à la communauté</div>
                    </div>
                  </a>
                  <a href="/all-recipes" class="qa-btn qa-btn--vert">
                    <div class="qa-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                    <div class="qa-text">
                      <div class="qa-title">Rédiger un avis</div>
                      <div class="qa-sub">Évaluer une recette existante</div>
                    </div>
                  </a>
                </div>
              </div>

              <!-- FILMS PROPOSÉS -->
              <% if (_cm.length > 0) { %>
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Films proposés</span>
                  <% if (_cm.length > 3) { %>
                  <span class="widget-head__extra" onclick="document.getElementById('creaFilmsSection').scrollIntoView({behavior:'smooth'})">Voir tout →</span>
                  <% } %>
                </div>
                <div class="film-pending-list">
                  <% _cm.slice(0, 3).forEach(function(movie) { %>
                  <div class="fpl-item">
                    <% if (movie.cardPath || movie.picture) { %>
                    <img class="fpl-poster" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                    <% } else { %>
                    <div class="fpl-poster fpl-poster--ph"></div>
                    <% } %>
                    <div class="fpl-info">
                      <div class="fpl-title"><%= movie.title %></div>
                      <div class="fpl-sub"><%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %></div>
                    </div>
                    <% if (movie.status === 'approved') { %>
                    <span class="fpl-status fpl-status--valide">Validé</span>
                    <% } else if (movie.status === 'rejected') { %>
                    <span class="fpl-status fpl-status--refuse">Refusé</span>
                    <% } else { %>
                    <span class="fpl-status fpl-status--pending">En attente</span>
                    <% } %>
                  </div>
                  <% }) %>
                </div>
              </div>
              <% } %>

            </aside>

            <!-- ── COLONNE PRINCIPALE ── -->
            <div class="crea-main">

              <!-- ═══ MES RECETTES ═══ -->
              <section id="creaRecettesSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Mes créations culinaires</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">MES RECETTES</div>
                  <a href="/add-recipes-movies" class="sec-link">+ Ajouter</a>
                </div>
                <div class="filter-bar" id="creaRecetteFilters">
                  <button class="f-pill active" data-crea-filter="all" data-crea-grid="creaRecettesGrid"><span class="f-pill__dot" style="background:var(--or-titre)"></span>Toutes</button>
                  <button class="f-pill fp--valide" data-crea-filter="approved" data-crea-grid="creaRecettesGrid"><span class="f-pill__dot" style="background:var(--vert-clair)"></span>Validées</button>
                  <button class="f-pill fp--attente" data-crea-filter="pending" data-crea-grid="creaRecettesGrid"><span class="f-pill__dot" style="background:var(--orange-clair)"></span>En attente</button>
                  <button class="f-pill fp--refuse" data-crea-filter="rejected" data-crea-grid="creaRecettesGrid"><span class="f-pill__dot" style="background:#e84020"></span>Refusées</button>
                  <div class="filter-sep"></div>
                  <div class="crea-search-wrap">
                    <svg class="crea-search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input class="crea-search-input" type="text" placeholder="Filtrer mes recettes…" data-crea-search="creaRecettesGrid" />
                  </div>
                </div>
                <div class="list-grid" id="creaRecettesGrid">
                  <% if (_cr.length > 0) { %>
                    <% _cr.forEach(function(recipe) {
                      const rsCls = recipe.status === 'approved' ? 'lrs--valide' : recipe.status === 'pending' ? 'lrs--attente' : 'lrs--refuse';
                      const rsTxt = recipe.status === 'approved' ? 'Validée' : recipe.status === 'pending' ? 'En attente' : 'Refusée';
                      const diffCls = recipe.difficulty === 'Facile' ? 'lr-tag--diff' : recipe.difficulty === 'Difficile' ? 'lr-tag--diff-h' : 'lr-tag--diff-m';
                    %>
                    <div class="list-row list-row--recette account-item"
                      data-type="recipe"
                      data-id="<%= recipe.id %>"
                      data-name="<%= recipe.name %>"
                      data-crea-name="<%= recipe.name.toLowerCase() %>"
                      data-crea-status="<%= recipe.status %>"
                      data-status="<%= recipe.status %>"
                      data-edit-status="<%= recipe.edit_status || 'none' %>"
                      data-delete-request="<%= recipe.delete_request_status || 'none' %>"
                      data-category="<%= recipe.category %>"
                      data-time="<%= recipe.time %>"
                      data-difficulty="<%= recipe.difficulty %>"
                      data-description="<%= encodeURIComponent(recipe.description || '') %>"
                      data-ingredients="<%= encodeURIComponent(recipe.ingredients || '') %>"
                      data-preparation="<%= encodeURIComponent(recipe.preparation || '') %>"
                      data-picture="<%= recipe.picture || '' %>"
                      data-pictures="<%= encodeURIComponent(JSON.stringify((recipe.RecipePictures || []).sort((a,b)=>a.position-b.position).map(p=>p.file_path))) %>"
                    >
                      <% if (recipe.picture) { %>
                      <img class="list-row__thumb" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--ph">🍽️</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name account-item__title"><%= recipe.name %></span>
                          <span class="lr-status <%= rsCls %>">
                            <% if (recipe.status !== 'rejected') { %><span class="lr-status-dot"></span><% } %>
                            <%= rsTxt %>
                          </span>
                        </div>
                        <div class="list-row__tags">
                          <span class="lr-tag lr-tag--cat"><%= recipe.category %></span>
                          <span class="lr-tag <%= diffCls %>"><%= recipe.difficulty %></span>
                          <% if (recipe.Movie) { %><span class="lr-tag lr-tag--film">🎬 <%= recipe.Movie.title %></span><% } %>
                        </div>
                        <div class="list-row__sub account-item__meta">
                          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          <%= recipe.time %> min<% if (recipe.status === 'pending') { %> <span class="lr-sub-muted">· En cours de modération…</span><% } %>
                        </div>
                        <% if (recipe.edit_status === 'pending') { %>
                        <p class="account-item__hint account-item__hint--pending">⏳ Modification en attente de validation.</p>
                        <% } else if (recipe.edit_status === 'approved') { %>
                        <p class="account-item__hint account-item__hint--approved">✓ Modification approuvée.</p>
                        <% } else if (recipe.edit_status === 'rejected') { %>
                        <p class="account-item__hint account-item__hint--rejected">✕ Modification refusée. Vous pouvez soumettre une nouvelle modification.</p>
                        <% } %>
                      </div>
                      <div class="list-row__actions">
                        <% if (recipe.status === 'approved') { %>
                        <a href="/recipes-movie/details/<%= recipe.id %>" class="lr-btn lr-btn--view" target="_blank" rel="noopener">
                          <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><span>Voir</span>
                        </a>
                        <% } %>
                        <button class="lr-btn lr-btn--edit account-edit-btn" <%= recipe.edit_status === 'pending' ? 'disabled' : '' %>>
                          <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 1 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg><span>Éditer</span>
                        </button>
                        <% if (recipe.delete_request_status === 'pending') { %>
                        <button class="lr-btn lr-btn--del account-delete-btn" disabled>
                          <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg><span>Suppr.</span>
                        </button>
                        <% } else { %>
                        <button class="lr-btn lr-btn--del account-delete-btn">
                          <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg><span>Suppr.</span>
                        </button>
                        <% } %>
                      </div>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🍽️</div>
                    <div class="crea-empty__title">Aucune recette</div>
                    <div class="crea-empty__sub">Partagez votre première création culinaire</div>
                  </div>
                  <% } %>
                  <div class="crea-no-results" style="display:none">Aucun résultat pour cette recherche.</div>
                </div>
              </section>

              <!-- ═══ MES FILMS ═══ -->
              <section id="creaFilmsSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Films suggérés à la communauté</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">MES FILMS</div>
                  <a href="/add-recipes-movies" class="sec-link">+ Proposer</a>
                </div>
                <div class="filter-bar" id="creaFilmFilters">
                  <button class="f-pill active" data-crea-filter="all" data-crea-grid="creaFilmsGrid"><span class="f-pill__dot" style="background:var(--violet-clair)"></span>Tous</button>
                  <button class="f-pill fp--valide" data-crea-filter="approved" data-crea-grid="creaFilmsGrid"><span class="f-pill__dot" style="background:var(--vert-clair)"></span>Validés</button>
                  <button class="f-pill fp--attente" data-crea-filter="pending" data-crea-grid="creaFilmsGrid"><span class="f-pill__dot" style="background:var(--orange-clair)"></span>En attente</button>
                  <div class="filter-sep"></div>
                  <div class="crea-search-wrap">
                    <svg class="crea-search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input class="crea-search-input" type="text" placeholder="Filtrer mes films…" data-crea-search="creaFilmsGrid" />
                  </div>
                </div>
                <div class="list-grid" id="creaFilmsGrid">
                  <% if (_cm.length > 0) { %>
                    <% _cm.forEach(function(movie) {
                      const msCls = movie.status === 'approved' ? 'lrs--valide' : movie.status === 'pending' ? 'lrs--attente' : 'lrs--refuse';
                      const msTxt = movie.status === 'approved' ? 'Validé' : movie.status === 'pending' ? 'En attente' : 'Refusé';
                    %>
                    <div class="list-row list-row--film account-item"
                      data-type="movie"
                      data-id="<%= movie.id %>"
                      data-title="<%= movie.title %>"
                      data-year="<%= movie.year %>"
                      data-genre="<%= movie.genre %>"
                      data-status="<%= movie.status %>"
                      data-crea-name="<%= movie.title.toLowerCase() %>"
                      data-crea-status="<%= movie.status %>"
                    >
                      <% if (movie.cardPath || movie.picture) { %>
                      <img class="list-row__thumb list-row__thumb--film" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--film list-row__thumb--ph">🎬</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= movie.title %></span>
                          <span class="lr-status <%= msCls %>">
                            <% if (movie.status !== 'rejected') { %><span class="lr-status-dot"></span><% } %>
                            <%= msTxt %>
                          </span>
                        </div>
                        <% if (movie.genre) { %>
                        <div class="list-row__tags"><span class="lr-tag lr-tag--genre"><%= movie.genre %></span></div>
                        <% } %>
                        <div class="list-row__sub">
                          <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg>
                          <%= movie.year %><% if (movie.status === 'pending') { %> <span class="lr-sub-muted">· En cours de modération…</span><% } %>
                        </div>
                      </div>
                      <div class="list-row__actions">
                        <% if (movie.status === 'approved') { %>
                        <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="lr-btn lr-btn--violet" target="_blank" rel="noopener">
                          <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><span>Voir</span>
                        </a>
                        <% } %>
                        <button class="lr-btn lr-btn--del account-delete-btn">
                          <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg><span>Retirer</span>
                        </button>
                      </div>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">🎬</div>
                    <div class="crea-empty__title">Aucun film proposé</div>
                    <div class="crea-empty__sub">Suggérez un film à la communauté</div>
                  </div>
                  <% } %>
                  <div class="crea-no-results" style="display:none">Aucun résultat pour cette recherche.</div>
                </div>
              </section>

              <!-- ═══ MES AVIS ═══ -->
              <section id="creaAvisSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Critiques &amp; évaluations</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">MES AVIS</div>
                </div>
                <div class="filter-bar" id="creaAvisFilters">
                  <button class="f-pill active" data-crea-filter="all" data-crea-grid="creaAvisGrid"><span class="f-pill__dot" style="background:var(--dore-clair)"></span>Tous</button>
                  <button class="f-pill fp--valide" data-crea-filter="approved" data-crea-grid="creaAvisGrid"><span class="f-pill__dot" style="background:var(--vert-clair)"></span>Validés</button>
                  <button class="f-pill fp--attente" data-crea-filter="pending" data-crea-grid="creaAvisGrid"><span class="f-pill__dot" style="background:var(--orange-clair)"></span>En attente</button>
                </div>
                <div class="avis-grid" id="creaAvisGrid">
                  <% if (_cn.length > 0) { %>
                    <% _cn.forEach(function(notice) { %>
                    <div class="avis-card account-item account-item--notice"
                      data-type="notice"
                      data-id="<%= notice.id %>"
                      data-delete-request="<%= notice.delete_request_status || 'none' %>"
                      data-crea-status="<%= notice.status %>"
                    >
                      <div class="avis-icon">
                        <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                      </div>
                      <div class="avis-body">
                        <div class="avis-top">
                          <div class="avis-titles">
                            <% if (notice.Recipe) { %>
                            <div class="avis-recipe-name">Recette : <a class="account-item__link" href="/recipes-movie/details/<%= notice.Recipe.id %>"><%= notice.Recipe.name %></a></div>
                            <% if (notice.Recipe.Movie) { %><div class="avis-film-link">Film : <a class="account-item__link" href="/recipes-movie/<%= notice.Recipe.Movie.id %>"><%= notice.Recipe.Movie.title %></a></div><% } %>
                            <% } %>
                          </div>
                          <div class="avis-stars-row">
                            <div class="avis-score">
                              <% for (let _i = 1; _i <= 5; _i++) { %><span class="star<%= _i <= parseInt(notice.quote) ? ' star--on' : '' %>">★</span><% } %>
                            </div>
                            <span class="avis-score-val"><%= notice.quote %>/5</span>
                          </div>
                        </div>
                        <% if (notice.content) { %><div class="avis-quote"><%= notice.content %></div><% } %>
                        <div class="avis-footer">
                          <% if (notice.status === 'approved') { %>
                          <span class="avis-status-badge ab--valide">✓ Validé</span>
                          <% } else { %>
                          <span class="avis-status-badge ab--attente">⏳ En attente</span>
                          <% } %>
                          <span class="avis-date"><%= notice.createdAt ? new Date(notice.createdAt).toLocaleDateString('fr-FR') : '' %></span>
                          <% if (notice.delete_request_status === 'pending') { %>
                          <span class="account-item__hint">Suppression en attente.</span>
                          <% } else { %>
                          <button class="avis-del-btn account-delete-btn">
                            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>Supprimer
                          </button>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">💬</div>
                    <div class="crea-empty__title">Aucun avis</div>
                    <div class="crea-empty__sub">Rédigez votre premier avis sur une recette</div>
                  </div>
                  <% } %>
                </div>
              </section>

            </div><!-- /crea-main -->

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#creations -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : CONTRIBUTIONS                 -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="contributions" role="tabpanel">
          <%
            /* ── Valeurs sécurisées ── */
            const _lvl      = (typeof userLevel  !== 'undefined' && userLevel)  ? parseInt(userLevel)  : 1;
            const _xp       = (typeof userXP     !== 'undefined' && userXP)     ? parseInt(userXP)     : 0;
            const _streak   = (typeof userStreak !== 'undefined' && userStreak) ? parseInt(userStreak) : 0;
            const _frameUrl = (typeof userActiveFrame   !== 'undefined' && userActiveFrame)   ? userActiveFrame   : null;
            const _activeId = (typeof userActiveFrameId !== 'undefined' && userActiveFrameId) ? userActiveFrameId : null;
            const _comments = (typeof userCommentsCount !== 'undefined' && userCommentsCount) ? userCommentsCount : 0;

            /* ── XP par niveau ── */
            const XP_TABLE = [0,100,300,600,1100,1800,2800,4200,6000,8500,11500,15000,20000,26000,33000,41000,50000,60000,72000];
            const _xpFloor  = XP_TABLE[_lvl - 1] || 0;
            const _xpCeil   = XP_TABLE[_lvl]     || (_lvl * 1500);
            const _xpInLvl  = _xp - _xpFloor;
            const _xpNeeded = _xpCeil - _xpFloor;
            const _xpPct    = Math.min(100, Math.round((_xpInLvl / _xpNeeded) * 100));
            const _xpLeft   = Math.max(0, _xpCeil - _xp);

            /* ── Titres par niveau ── */
            const _ranks = ['Novice Ciné Délices','Apprenti Cuisinier','Explorateur du Goût','Aventurier Culinaire','Critique Cinéphile','Connaisseur des Saveurs','Sorcier Cuisinier','Critique Éclairé','Maître des Arômes','Grand Cinéphile','Expert Culinaire','Légende Culinaire','Virtuose du Goût','Maître Cinéphile','Grand Maître','Gardien des Saveurs','Légende Vivante','Gardien des Saveurs'];
            const _rank = _ranks[Math.min(_lvl - 1, _ranks.length - 1)];

            /* ── Cadres ── */
            const _unlockedIds = (typeof userFrames !== 'undefined' && Array.isArray(userFrames))
              ? userFrames.filter(f => f.unlocked !== false).map(f => f.code || f.id || f) : [];
            const _allFrames = [
              { id:'none',    label:'Sans cadre',      theme:'Par défaut',       icon:'○',  minLvl:1, bg:'rgba(65,90,119,.1)',   border:'rgba(65,90,119,.35)', hasRealFrame:false, pngUrl:null },
              { id:'cine',    label:'Ciné Délices',   theme:'Cinéma',          icon:'🎬', minLvl:1, bg:'rgba(196,160,82,.18)', border:'rgba(196,160,82,.5)',  hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Cin\u00e9 D\u00e9lices/img/cadre-cine-delices-2.png' },
              { id:'sherlock',label:'Sherlock Holmes',theme:'Policier',         icon:'🔍', minLvl:2, bg:'rgba(160,120,55,.22)', border:'rgba(188,148,78,.45)', hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Sherlock Holmes/img/cadre-sherlock-holmes-1440.png' },
              { id:'matrix',  label:'Matrix',         theme:'Science-Fiction',  icon:'🟢', minLvl:4, bg:'rgba(0,190,75,.18)',   border:'rgba(0,205,80,.4)',    hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Matrix/img/cadre-matrix-260x260.png' },
              { id:'indiana', label:'Indiana Jones',  theme:'Aventure',         icon:'🎩', minLvl:6, bg:'rgba(180,100,20,.22)', border:'rgba(190,135,55,.5)',  hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Indiana Jones/img/cadre-indiana-jones-260x260.png' },
              { id:'harry',   label:'Harry Potter',   theme:'Magie',            icon:'⚡', minLvl:8, bg:'rgba(80,130,255,.22)', border:'rgba(130,185,255,.5)', hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Harry Potter/img/cadre-harry-potter-260x260.png' },
            ];
            const _deblocked   = _allFrames.filter(f => _lvl >= f.minLvl || _unlockedIds.includes(f.id));
            const _locked      = _allFrames.filter(f => _lvl < f.minLvl  && !_unlockedIds.includes(f.id));
            const _activeFrame = _allFrames.find(f => f.id === _activeId) || _deblocked[0] || _allFrames[0];
            const _nextUnlock  = _locked[0] || null;
            const _activity    = (typeof userActivity !== 'undefined' && Array.isArray(userActivity)) ? userActivity : [];
          %>

          <!-- ═══ BANDEAU IMPACT XP ═══ -->
          <div class="impact-banner">
            <div class="impact-cell">
              <div class="impact-cell__icon ic--xp">
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= _xp.toLocaleString('fr-FR') %> XP</div>
                <div class="impact-cell__lbl">XP total accumulé</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--rank">
                <svg viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val">Niv. <%= _lvl %></div>
                <div class="impact-cell__lbl"><%= _rank %></div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--badge">
                <svg viewBox="0 0 24 24"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= _deblocked.length %> / <%= _allFrames.length %></div>
                <div class="impact-cell__lbl">Cadres débloqués</div>
              </div>
            </div>
            <div class="impact-cell">
              <div class="impact-cell__icon ic--streak">
                <svg viewBox="0 0 24 24"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
              </div>
              <div class="impact-cell__body">
                <div class="impact-cell__val"><%= _streak %> jour<%= _streak > 1 ? 's' : '' %></div>
                <div class="impact-cell__lbl">Série active</div>
              </div>
            </div>
          </div>

          <!-- ═══ LAYOUT 2 COLONNES ═══ -->
          <div class="contrib-layout">

            <!-- ── SIDEBAR ── -->
            <aside>

              <!-- STATISTIQUES -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Statistiques</span>
                </div>
                <div class="stats-grid">
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-target="<%= userRecipes.length %>">0</div>
                      <div class="stat-lbl">Recettes</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-target="<%= userNoticesCount %>">0</div>
                      <div class="stat-lbl">Avis</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-target="<%= _comments %>">0</div>
                      <div class="stat-lbl">Commentaires</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num" data-target="<%= userMovies.length %>">0</div>
                      <div class="stat-lbl">Films proposés</div>
                    </div>
                  </div>
                </div>
                <div class="xp-block">
                  <div class="xp-level-row">
                    <div class="xp-level-chip">Niv. <%= _lvl %> → <%= _lvl + 1 %></div>
                    <div class="xp-total"><%= _xp.toLocaleString('fr-FR') %> XP</div>
                  </div>
                  <div class="xp-track-wrap">
                    <div class="xp-track">
                      <div class="xp-fill" data-pct="<%= _xpPct %>" style="width:0%"></div>
                      <div class="xp-milestone<%= _xpPct >= 50 ? ' passed' : '' %>" style="left:50%"></div>
                    </div>
                  </div>
                  <div class="xp-bottom">
                    <div class="xp-sub"><%= _xpLeft.toLocaleString('fr-FR') %> XP avant le niveau <%= _lvl + 1 %></div>
                    <div class="xp-pct"><%= _xpPct %>%</div>
                  </div>
                </div>
              </div>

              <!-- CADRE ACTIF -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Cadre actif</span>
                  <span class="widget-head__extra" onclick="document.getElementById('contrib-frames-list').scrollIntoView({behavior:'smooth'})">Changer →</span>
                </div>
                <div class="active-frame-body">
                  <% if (_activeFrame.id === 'none') { %>
                  <div class="active-frame-preview active-frame-preview--noframe">
                    <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="<%= user.pseudo %>" />
                  </div>
                  <% } else if (_activeFrame.hasRealFrame && _frameUrl) { %>
                  <div class="active-frame-preview">
                    <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="<%= user.pseudo %>" />
                    <img class="bsf" src="<%= _frameUrl %>" alt="Cadre <%= _activeFrame.label %>" />
                  </div>
                  <% } else { %>
                  <div class="active-frame-preview-icon" style="background:radial-gradient(circle,<%= _activeFrame.bg %>,rgba(10,18,30,.05));border-color:<%= _activeFrame.border %>;">
                    <%= _activeFrame.icon %>
                  </div>
                  <% } %>
                  <div class="active-frame-meta">
                    <div class="active-frame-name"><%= _activeFrame.label %></div>
                    <div class="active-frame-theme"><%= _activeFrame.theme %></div>
                    <div class="active-frame-pill">✓ Débloqué · Niv. <%= _activeFrame.minLvl %></div>
                  </div>
                </div>
              </div>

              <!-- MES CADRES -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Mes cadres</span>
                </div>
                <div class="frames-list" id="contrib-frames-list">

                  <div class="frames-divider">
                    <span class="frames-divider__label">Débloqués</span>
                    <div class="frames-divider__line"></div>
                  </div>

                  <% _deblocked.forEach(function(fr) { %>
                  <div
                    class="frame-row<%= fr.id === _activeFrame.id ? ' frame-row--active' : '' %>"
                    data-frame-id="<%= fr.id %>"
                    data-unlocked="true"
                  >
                    <% if (fr.id === 'none') { %>
                    <div class="frame-row-badge-static frame-row-badge-static--noframe">
                      <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="" />
                    </div>
                    <% } else if (fr.hasRealFrame && fr.pngUrl) { %>
                    <div class="frame-row-badge-static">
                      <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="" />
                      <img class="bsf" src="<%= fr.pngUrl %>" alt="" />
                    </div>
                    <% } else { %>
                    <div class="frame-row-icon" style="background:radial-gradient(circle,<%= fr.bg %>,rgba(10,18,30,.05));border-color:<%= fr.border %>;"><%= fr.icon %></div>
                    <% } %>
                    <div class="frame-row-info">
                      <div class="frame-row-name"><%= fr.label %></div>
                      <div class="frame-row-sub"><%= fr.theme %> · niv. <%= fr.minLvl %></div>
                    </div>
                    <div class="frame-row-check <%= fr.id === _activeFrame.id ? 'frame-row-check--active' : 'frame-row-check--ok' %>">
                      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                  </div>
                  <% }); %>

                  <% if (_locked.length > 0) { %>
                  <div class="frames-divider frames-divider--locked" style="margin-top:6px;">
                    <span class="frames-divider__label">Verrouillés</span>
                    <div class="frames-divider__line"></div>
                  </div>
                  <% _locked.forEach(function(fr, idx) { %>
                  <div
                    class="frame-row frame-row--locked<%= idx === 0 ? ' frame-row--next-unlock' : '' %>"
                    data-frame-id="<%= fr.id %>"
                    data-unlocked="false"
                  >
                    <div class="frame-row-icon" style="background:rgba(65,90,119,.08);border-color:rgba(65,90,119,.2);font-size:.9rem;">🔒</div>
                    <div class="frame-row-info">
                      <div class="frame-row-name" style="color:rgba(232,232,232,.4);"><%= fr.label %></div>
                      <div class="frame-row-sub"><%= fr.theme %> · niv. <%= fr.minLvl %> requis</div>
                    </div>
                    <div class="frame-row-check frame-row-check--locked">
                      <svg viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </div>
                  </div>
                  <% }); %>
                  <% } %>

                </div>
              </div>

              <!-- GUIDE XP -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Comment progresser</span>
                </div>
                <div class="xp-guide">
                  <div class="xp-guide-row">
