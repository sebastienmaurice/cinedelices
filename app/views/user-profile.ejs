                </div>
                <div class="sec-header">
                  <div class="sec-title">MES FILMS</div>
                  <a href="/add-recipes-movies" class="sec-link">+ Proposer</a>
                </div>
                <div class="filter-bar" id="creaFilmFilters">
                  <button class="f-pill active" data-crea-filter="all" data-crea-grid="creaFilmsGrid"><span class="f-pill__dot" style="background:var(--violet-clair)"></span>Tous</button>
                  <button class="f-pill fp--valide" data-crea-filter="approved" data-crea-grid="creaFilmsGrid"><span class="f-pill__dot" style="background:var(--vert-clair)"></span>Validés</button>
                  <button class="f-pill fp--attente" data-crea-filter="pending" data-crea-grid="creaFilmsGrid"><span class="f-pill__dot" style="background:var(--orange-clair)"></span>En attente</button>
                  <div class="filter-sep"></div>
                  <div class="crea-search-wrap">
                    <i data-lucide="search" class="crea-search-icon" aria-hidden="true"></i>
                    <input class="crea-search-input" type="text" placeholder="Filtrer mes films…" data-crea-search="creaFilmsGrid" />
                  </div>
                </div>
                <div class="list-grid" id="creaFilmsGrid">
                  <% if (_cm.length > 0) { %>
                    <% _cm.forEach(function(movie) {
                      const msCls = movie.status === 'approved' ? 'lrs--valide' : movie.status === 'pending' ? 'lrs--attente' : 'lrs--refuse';
                      const msTxt = movie.status === 'approved' ? 'Validé' : movie.status === 'pending' ? 'En attente' : 'Refusé';
                    %>
                    <div class="list-row list-row--film account-item"
                      data-type="movie"
                      data-id="<%= movie.id %>"
                      data-title="<%= movie.title %>"
                      data-year="<%= movie.year %>"
                      data-genre="<%= movie.genre %>"
                      data-status="<%= movie.status %>"
                      data-crea-name="<%= movie.title.toLowerCase() %>"
                      data-crea-status="<%= movie.status %>"
                    >
                      <% if (movie.cardPath || movie.picture) { %>
                      <img class="list-row__thumb list-row__thumb--film" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                      <% } else { %>
                      <div class="list-row__thumb list-row__thumb--film list-row__thumb--ph">🎬</div>
                      <% } %>
                      <div class="list-row__body">
                        <div class="list-row__top">
                          <span class="list-row__name"><%= movie.title %></span>
                          <span class="lr-status <%= msCls %>">
                            <% if (movie.status !== 'rejected') { %><span class="lr-status-dot"></span><% } %>
                            <%= msTxt %>
                          </span>
                        </div>
                        <% if (movie.genre) { %>
                        <div class="list-row__tags"><span class="lr-tag lr-tag--genre"><%= movie.genre %></span></div>
                        <% } %>
                        <div class="list-row__sub">
                          <i data-lucide="film" aria-hidden="true"></i>
                          <%= movie.year %><% if (movie.status === 'pending') { %> <span class="lr-sub-muted">· En cours de modération…</span><% } %>
                        </div>
                      </div>
                      <div class="list-row__actions">
                        <% if (movie.status === 'approved') { %>
                        <a href="/recipes-movie/<%= movie.slug || movie.id %>" class="lr-btn lr-btn--violet" target="_blank" rel="noopener">
