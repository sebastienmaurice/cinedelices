                  <button class="lr-btn lr-btn--del" id="deleteAccountBtn" style="width:100%;height:34px;justify-content:center;margin-top:4px;">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    Supprimer mon compte
                  </button>
                </div>
              </div>

            </aside>

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#profil -->


