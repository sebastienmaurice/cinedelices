                            <div class="avis-score">
                              <% for (let _i = 1; _i <= 5; _i++) { %><span class="star<%= _i <= parseInt(notice.quote) ? ' star--on' : '' %>">★</span><% } %>
                            </div>
                            <span class="avis-score-val"><%= notice.quote %>/5</span>
