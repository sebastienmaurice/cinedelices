                          <button class="avis-del-btn account-delete-btn">
                            <i data-lucide="trash-2" aria-hidden="true"></i>Supprimer
                          </button>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <% }) %>
                  <% } else { %>
                  <div class="crea-empty">
                    <div class="crea-empty__icon">💬</div>
                    <div class="crea-empty__title">Aucun avis</div>
                    <div class="crea-empty__sub">Rédigez votre premier avis sur une recette</div>
                  </div>
                  <% } %>
                </div>
              </section>

            </div><!-- /crea-main -->

          </div><!-- /crea-layout -->

        </div><!-- /tab-pane#creations -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : CONTRIBUTIONS                 -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="contributions" role="tabpanel">
          <%
            /* ── Valeurs sécurisées ── */
            const _lvl      = (typeof userLevel  !== 'undefined' && userLevel)  ? parseInt(userLevel)  : 1;
            const _xp       = (typeof userXP     !== 'undefined' && userXP)     ? parseInt(userXP)     : 0;
            const _streak   = (typeof userStreak !== 'undefined' && userStreak) ? parseInt(userStreak) : 0;
            const _frameUrl = (typeof userActiveFrame   !== 'undefined' && userActiveFrame)   ? userActiveFrame   : null;
            const _activeId = (typeof userActiveFrameId !== 'undefined' && userActiveFrameId) ? userActiveFrameId : null;
            const _comments = (typeof userCommentsCount !== 'undefined' && userCommentsCount) ? userCommentsCount : 0;

            /* ── XP par niveau ── */
            const XP_TABLE = [0,100,300,600,1100,1800,2800,4200,6000,8500,11500,15000,20000,26000,33000,41000,50000,60000,72000];
            const _xpFloor  = XP_TABLE[_lvl - 1] || 0;
            const _xpCeil   = XP_TABLE[_lvl]     || (_lvl * 1500);
            const _xpInLvl  = _xp - _xpFloor;
            const _xpNeeded = _xpCeil - _xpFloor;
            const _xpPct    = Math.min(100, Math.round((_xpInLvl / _xpNeeded) * 100));
            const _xpLeft   = Math.max(0, _xpCeil - _xp);

            /* ── Titres par niveau ── */
            const _ranks = ['Novice Ciné Délices','Apprenti Cuisinier','Explorateur du Goût','Aventurier Culinaire','Critique Cinéphile','Connaisseur des Saveurs','Sorcier Cuisinier','Critique Éclairé','Maître des Arômes','Grand Cinéphile','Expert Culinaire','Légende Culinaire','Virtuose du Goût','Maître Cinéphile','Grand Maître','Gardien des Saveurs','Légende Vivante','Gardien des Saveurs'];
            const _rank = _ranks[Math.min(_lvl - 1, _ranks.length - 1)];
            const _nextRank = _ranks[_lvl] || 'Rang légendaire';

            /* ── Cadres ── */
            const _unlockedIds = (typeof userFrames !== 'undefined' && Array.isArray(userFrames))
              ? userFrames.filter(f => f.unlocked !== false).map(f => f.code || f.id || f) : [];
            const _allFrames = [
              { id:'none',    label:'Sans cadre',      theme:'Par défaut',       icon:'○',  minLvl:1, bg:'rgba(65,90,119,.1)',   border:'rgba(65,90,119,.35)', hasRealFrame:false, pngUrl:null },
              { id:'cine',    label:'Ciné Délices',   theme:'Cinéma',          icon:'🎬', minLvl:1, bg:'rgba(196,160,82,.18)', border:'rgba(196,160,82,.5)',  hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Cin\u00e9 D\u00e9lices/img/cadre-cine-delices-2.png' },
              { id:'sherlock',label:'Sherlock Holmes',theme:'Policier',         icon:'🔍', minLvl:2, bg:'rgba(160,120,55,.22)', border:'rgba(188,148,78,.45)', hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Sherlock Holmes/img/cadre-sherlock-holmes-1440.png' },
              { id:'matrix',  label:'Matrix',         theme:'Science-Fiction',  icon:'🟢', minLvl:4, bg:'rgba(0,190,75,.18)',   border:'rgba(0,205,80,.4)',    hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Matrix/img/cadre-matrix-260x260.png' },
              { id:'indiana', label:'Indiana Jones',  theme:'Aventure',         icon:'🎩', minLvl:6, bg:'rgba(180,100,20,.22)', border:'rgba(190,135,55,.5)',  hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Indiana Jones/img/cadre-indiana-jones-260x260.png' },
              { id:'harry',   label:'Harry Potter',   theme:'Magie',            icon:'⚡', minLvl:8, bg:'rgba(80,130,255,.22)', border:'rgba(130,185,255,.5)', hasRealFrame:true,  pngUrl:'/images/cadres-gamification/Harry Potter/img/cadre-harry-potter-260x260.png' },
            ];
            const _deblocked   = _allFrames.filter(f => _lvl >= f.minLvl || _unlockedIds.includes(f.id));
            const _locked      = _allFrames.filter(f => _lvl < f.minLvl  && !_unlockedIds.includes(f.id));
            const _activeFrame = _allFrames.find(f => f.id === _activeId) || _deblocked[0] || _allFrames[0];
            const _nextUnlock  = _locked[0] || null;
            const _activity    = (typeof userActivity !== 'undefined' && Array.isArray(userActivity)) ? userActivity : [];
          %>

          <!-- ═══════════════════════════════════════════════════
               HERO XP BENTO — Cadre actif + XP hub + Streak
          ═══════════════════════════════════════════════════ -->
          <section class="ctb-hero" aria-label="Progression et niveau">

            <!-- ── Bloc 1 : Cadre actif ── -->
            <div class="ctb-hero__block ctb-hero__block--frame">
              <p class="ctb-hero__eyebrow">Cadre équipé</p>
              <div class="active-frame-body">
                <% if (_activeFrame.id === 'none') { %>
                <div class="active-frame-preview active-frame-preview--noframe">
                  <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="<%= user.pseudo %>" />
                </div>
                <% } else if (_activeFrame.hasRealFrame && _frameUrl) { %>
                <div class="active-frame-preview">
                  <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="<%= user.pseudo %>" />
                  <img class="bsf" src="<%= _frameUrl %>" alt="Cadre <%= _activeFrame.label %>" />
                </div>
                <% } else { %>
                <div class="active-frame-preview-icon" style="background:radial-gradient(circle,<%= _activeFrame.bg %>,rgba(10,18,30,.05));border-color:<%= _activeFrame.border %>;">
                  <%= _activeFrame.icon %>
                </div>
                <% } %>
                <div class="active-frame-meta">
                  <div class="active-frame-name"><%= _activeFrame.label %></div>
                  <div class="active-frame-theme"><%= _activeFrame.theme %></div>
                  <div class="active-frame-pill">✓ Débloqué · Niv. <%= _activeFrame.minLvl %></div>
                </div>
              </div>
              <button type="button" class="ctb-hero__frame-cta" onclick="document.getElementById('contrib-frames-list').scrollIntoView({behavior:'smooth',block:'start'})">
                <span>Changer de cadre</span>
                <i data-lucide="arrow-right" aria-hidden="true"></i>
              </button>
            </div>

            <!-- ── Bloc 2 : XP hub ── -->
            <div class="ctb-hero__block ctb-hero__block--xp">
              <div class="ctb-hero__xp-head">
                <span class="ctb-hero__lvl-chip">Niv. <%= _lvl %></span>
                <span class="ctb-hero__rank" title="<%= _rank %>">« <%= _rank %> »</span>
              </div>
              <div class="ctb-hero__xp-num">
                <span class="ctb-hero__xp-val"><%= _xp.toLocaleString('fr-FR') %></span>
                <span class="ctb-hero__xp-unit">XP</span>
              </div>
              <div class="ctb-hero__xp-progress">
                <div class="xp-track">
                  <div class="xp-fill" data-pct="<%= _xpPct %>" style="width:0%"></div>
                  <div class="xp-milestone<%= _xpPct >= 50 ? ' passed' : '' %>" style="left:50%"></div>
                </div>
                <div class="ctb-hero__xp-footer">
                  <span class="ctb-hero__xp-left">
                    <strong><%= _xpLeft.toLocaleString('fr-FR') %> XP</strong>
                    avant le Niv. <%= _lvl + 1 %>
                  </span>
                  <span class="ctb-hero__xp-pct"><%= _xpPct %>%</span>
                </div>
              </div>
            </div>

            <!-- ── Bloc 3 : Streak + cadres ── -->
            <div class="ctb-hero__block ctb-hero__block--streak">
              <div class="ctb-hero__flame" aria-hidden="true">
                <span class="flame flame--1"></span>
                <span class="flame flame--2"></span>
                <span class="flame flame--3"></span>
              </div>
              <div class="ctb-hero__streak-row">
                <div class="ctb-hero__streak-big"><%= _streak %></div>
                <div class="ctb-hero__streak-lblwrap">
                  <div class="ctb-hero__streak-lbl">jour<%= _streak > 1 ? 's' : '' %></div>
                  <div class="ctb-hero__streak-sub">d'affilée</div>
                </div>
              </div>
              <div class="ctb-hero__streak-divider"></div>
              <div class="ctb-hero__frames-count">
                <span class="ctb-hero__frames-n"><%= _deblocked.length %><em>/<%= _allFrames.length %></em></span>
                <span class="ctb-hero__frames-l">Cadres débloqués</span>
              </div>
            </div>

          </section>

          <!-- ═══════════════════════════════════════════════════
               GALERIE DE CADRES — bento
          ═══════════════════════════════════════════════════ -->
          <section class="ctb-frames-section" aria-label="Collection de cadres">
            <div class="sec-eyebrow">
              <div class="sec-eyebrow__line"></div>
              <span class="sec-eyebrow__label">Collection</span>
            </div>
            <div class="sec-header">
              <div class="sec-title">MES CADRES</div>
              <span class="ctb-frames-count">
                <strong><%= _deblocked.length %></strong>/<%= _allFrames.length %> débloqués
              </span>
            </div>

            <div class="ctb-frames-grid" id="contrib-frames-list">
              <% _allFrames.forEach(function(fr) {
                const _isUnlocked = _lvl >= fr.minLvl || _unlockedIds.includes(fr.id);
                const _isActive   = fr.id === _activeFrame.id;
              %>
              <div
                class="frame-row ctb-frame-tile<%= _isActive ? ' frame-row--active is-active' : '' %><%= !_isUnlocked ? ' frame-row--locked is-locked' : '' %>"
                data-frame-id="<%= fr.id %>"
                data-unlocked="<%= _isUnlocked ? 'true' : 'false' %>"
              >
                <!-- Preview -->
                <div class="ctb-frame-tile__preview">
                  <% if (fr.id === 'none') { %>
                  <div class="frame-row-badge-static frame-row-badge-static--noframe">
                    <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="" />
                  </div>
                  <% } else if (_isUnlocked && fr.hasRealFrame && fr.pngUrl) { %>
                  <div class="frame-row-badge-static">
                    <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="" />
                    <img class="bsf" src="<%= fr.pngUrl %>" alt="" />
                  </div>
                  <% } else if (!_isUnlocked && fr.hasRealFrame && fr.pngUrl) { %>
                  <div class="frame-row-badge-static ctb-frame-tile__preview--dimmed">
                    <img class="bsp" src="<%= user.picture || '/images/image-default-profile.jpg' %>" alt="" />
                    <img class="bsf" src="<%= fr.pngUrl %>" alt="" />
                    <div class="ctb-frame-tile__lock-overlay">
                      <i data-lucide="lock" stroke-width="1.8" aria-hidden="true"></i>
                    </div>
                  </div>
                  <% } else { %>
                  <div class="frame-row-icon" style="background:radial-gradient(circle,<%= fr.bg %>,rgba(10,18,30,.05));border-color:<%= fr.border %>;"><%= fr.icon %></div>
                  <% } %>
                </div>

                <!-- Info -->
                <div class="frame-row-info ctb-frame-tile__info">
                  <div class="frame-row-name ctb-frame-tile__name"><%= fr.label %></div>
                  <div class="frame-row-sub ctb-frame-tile__theme"><%= fr.theme %> · niv. <%= fr.minLvl %></div>
                </div>

                <!-- Compat check (lu par gamification.js) -->
                <div class="frame-row-check ctb-frame-tile__check-compat <%= _isActive ? 'frame-row-check--active' : (_isUnlocked ? 'frame-row-check--ok' : 'frame-row-check--locked') %>" aria-hidden="true">
                  <% if (_isActive || _isUnlocked) { %>
                  <i data-lucide="check" aria-hidden="true"></i>
                  <% } else { %>
                  <i data-lucide="lock" aria-hidden="true"></i>
                  <% } %>
                </div>

                <!-- Status pill -->
                <div class="ctb-frame-tile__status<%= _isActive ? ' is-active' : (_isUnlocked ? ' is-ready' : ' is-locked') %>">
                  <% if (_isActive) { %>
                    <i data-lucide="check" stroke-width="2.2" aria-hidden="true"></i>
                    <span>Équipé</span>
                  <% } else if (_isUnlocked) { %>
                    <span>Équiper</span>
                    <i data-lucide="arrow-right" aria-hidden="true"></i>
                  <% } else { %>
                    <i data-lucide="lock" aria-hidden="true"></i>
                    <span>Niv. <%= fr.minLvl %> requis</span>
                  <% } %>
                </div>
              </div>
              <% }); %>
            </div>
          </section>

          <!-- ═══════════════════════════════════════════════════
               MAIN — Timeline activité + Next milestone
          ═══════════════════════════════════════════════════ -->
          <div class="ctb-main">

            <!-- ── Timeline activité ── -->
            <section class="ctb-timeline-col">
              <div class="sec-eyebrow">
                <div class="sec-eyebrow__line"></div>
                <span class="sec-eyebrow__label">Historique</span>
              </div>
              <div class="sec-header">
                <div class="sec-title">ACTIVITÉ RÉCENTE</div>
              </div>

              <div class="activity-filters">
                <button class="af-pill active" data-filter="all">Tout</button>
                <button class="af-pill" data-filter="recipe"><span class="af-pill__dot" style="background:#c97b3a"></span>Recettes</button>
                <button class="af-pill" data-filter="notice"><span class="af-pill__dot" style="background:#c4a052"></span>Avis</button>
                <button class="af-pill" data-filter="movie"><span class="af-pill__dot" style="background:#9b79e0"></span>Films</button>
                <button class="af-pill" data-filter="comment"><span class="af-pill__dot" style="background:rgba(140,180,225,.8)"></span>Commentaires</button>
              </div>

              <div class="ctb-timeline" id="contribActivityList">
                <% if (_activity.length > 0) { %>
                  <% _activity.forEach(function(act, idx) { %>
                  <div class="activity-item ctb-tl-item" data-type="<%= act.type %>" style="animation-delay:<%= idx * 60 %>ms;">
                    <div class="ctb-tl-rail">
                      <div class="ctb-tl-dot ai--<%= act.type %>"></div>
                      <div class="ctb-tl-line"></div>
                    </div>
                    <div class="ctb-tl-card">
                      <div class="activity-icon ai--<%= act.type %>">
                        <% if (act.type === 'recipe') { %>
                        <i data-lucide="utensils" aria-hidden="true"></i>
                        <% } else if (act.type === 'notice') { %>
                        <i data-lucide="star" aria-hidden="true"></i>
                        <% } else if (act.type === 'movie') { %>
                        <i data-lucide="film" aria-hidden="true"></i>
                        <% } else { %>
                        <i data-lucide="message-square" aria-hidden="true"></i>
                        <% } %>
                      </div>
                      <div class="ctb-tl-body">
                        <div class="ctb-tl-title"><%= act.title %></div>
                        <div class="ctb-tl-sub"><%= act.sub %></div>
                        <div class="ctb-tl-time">
                          <i data-lucide="clock" aria-hidden="true"></i>
                          <%= act.time %>
                        </div>
                      </div>
                      <div class="ctb-tl-xp">
                        <div class="ctb-tl-xp__val">+<%= act.xp %></div>
                        <div class="ctb-tl-xp__lbl">XP</div>
                      </div>
                    </div>
                  </div>
                  <% }); %>
                <% } else { %>
                <div class="contrib-empty">
                  <i data-lucide="info" width="28" height="28" stroke-width="1.5" aria-hidden="true"></i>
                  <p>Aucune activité pour le moment.<br />Publiez votre première recette pour gagner vos premiers XP&nbsp;!</p>
                </div>
                <% } %>
              </div>
            </section>

            <!-- ── Sidebar : Next milestone + Guide XP ── -->
            <aside class="ctb-side-col">

              <!-- Next milestone — trading card gold -->
              <div class="ctb-milestone" role="region" aria-label="Prochain palier">
                <div class="ctb-milestone__shimmer" aria-hidden="true"></div>
                <div class="ctb-milestone__inner">
                  <p class="ctb-milestone__eyebrow">✦ Prochain niveau</p>
                  <h3 class="ctb-milestone__title">
                    Niv. <%= _lvl + 1 %>
                    <em><%= _nextRank %></em>
                  </h3>
                  <div class="ctb-milestone__xp">
                    <div class="ctb-milestone__xp-num"><%= _xpLeft.toLocaleString('fr-FR') %></div>
                    <div class="ctb-milestone__xp-lbl">XP restants</div>
                  </div>
                  <div class="ctb-milestone__rewards">
                    <div class="ctb-milestone__reward">
                      <span class="ctb-milestone__reward-ico">🎯</span>
                      <div>
                        <div class="ctb-milestone__reward-title">Nouveau titre</div>
                        <div class="ctb-milestone__reward-sub">« <%= _nextRank %> »</div>
                      </div>
                    </div>
                    <div class="ctb-milestone__reward">
                      <span class="ctb-milestone__reward-ico">✨</span>
                      <div>
                        <div class="ctb-milestone__reward-title">Bonus XP</div>
                        <div class="ctb-milestone__reward-sub">+10% sur les contributions</div>
                      </div>
                    </div>
                    <% if (_nextUnlock && _nextUnlock.minLvl <= _lvl + 2) { %>
                    <div class="ctb-milestone__reward">
                      <span class="ctb-milestone__reward-ico"><%= _nextUnlock.icon %></span>
                      <div>
                        <div class="ctb-milestone__reward-title">Cadre <%= _nextUnlock.label %></div>
                        <div class="ctb-milestone__reward-sub"><%= _nextUnlock.theme %> · Niv. <%= _nextUnlock.minLvl %></div>
                      </div>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Guide XP -->
              <div class="widget ctb-xpguide-widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Gagner de l'XP</span>
                </div>
                <div class="xp-guide">
                  <div class="xp-guide-row">
                    <div class="xp-guide-icon xp-guide-icon--recipe"><i data-lucide="utensils" aria-hidden="true"></i></div>
                    <div class="xp-guide-body">
                      <div class="xp-guide-label">Recette publiée</div>
                      <div class="xp-guide-sub">Validée par la modération</div>
                    </div>
                    <span class="xp-guide-pts">+50 XP</span>
                  </div>
                  <div class="xp-guide-row">
                    <div class="xp-guide-icon xp-guide-icon--movie"><i data-lucide="film" aria-hidden="true"></i></div>
                    <div class="xp-guide-body">
                      <div class="xp-guide-label">Film accepté</div>
                      <div class="xp-guide-sub">Suggestion validée</div>
                    </div>
                    <span class="xp-guide-pts">+25 XP</span>
                  </div>
                  <div class="xp-guide-row">
                    <div class="xp-guide-icon xp-guide-icon--avis"><i data-lucide="message-square" aria-hidden="true"></i></div>
                    <div class="xp-guide-body">
                      <div class="xp-guide-label">Avis approuvé</div>
                      <div class="xp-guide-sub">Critique publiée</div>
                    </div>
                    <span class="xp-guide-pts">+10 XP</span>
                  </div>
                </div>
              </div>

            </aside>

          </div>

        </div><!-- /tab-pane#contributions -->

      </div><!-- /profile-content -->

    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Toast global -->
    <div class="toast-wrap" id="toastWrap" aria-live="polite"></div>

    <!-- Modal confirmation suppression -->
    <div class="modal-overlay" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-box">
        <div class="modal-stripe"></div>
        <div class="modal-head">
          <div class="modal-ico">⚠️</div>
          <div class="modal-titles">
            <div class="modal-title" id="modalTitle">SUPPRESSION</div>
            <div class="modal-sub">Cette action est irréversible</div>
          </div>
        </div>
        <div class="modal-body">
          <p>Vous êtes sur le point de supprimer définitivement :</p>
          <div class="modal-target" id="modalTarget"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn--ghost btn--sm" id="modalCancel">Annuler</button>
          <button class="btn btn--red btn--sm" id="modalConfirm">Confirmer</button>
        </div>
      </div>
    </div>

    <!-- Modal édition recette -->
    <div class="modal-overlay" id="editRecipeModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
      <div class="modal-box modal-box--edit">
        <div class="modal-stripe modal-stripe--gold"></div>
        <div class="modal-head">
          <div class="modal-ico modal-ico--edit">✏️</div>
          <div class="modal-titles">
            <div class="modal-title" id="editModalTitle">ÉDITER LA RECETTE</div>
            <div class="modal-sub" id="editModalSub">Les modifications sont soumises à validation</div>
          </div>
        </div>
        <div class="modal-body modal-body--form">
          <div class="ci-ef-row">
            <div><label class="ci-ef-label">Titre</label><input class="ci-ef-input" id="editField-name" type="text" name="name" /></div>
            <div>
              <label class="ci-ef-label">Catégorie</label>
              <select class="ci-ef-input ci-ef-select" id="editField-category" name="category">
                <option value="">Choisir…</option>
                <option value="entrée">Entrée</option>
                <option value="plat">Plat</option>
                <option value="dessert">Dessert</option>
              </select>
            </div>
          </div>
          <div class="ci-ef-row">
            <div><label class="ci-ef-label">Temps (min)</label><input class="ci-ef-input" id="editField-time" type="number" name="time" min="1" /></div>
            <div>
              <label class="ci-ef-label">Difficulté</label>
              <select class="ci-ef-input ci-ef-select" id="editField-difficulty" name="difficulty">
                <option value="">Choisir…</option>
                <option value="Facile">Facile</option>
                <option value="Moyenne">Moyenne</option>
                <option value="Difficile">Difficile</option>
              </select>
            </div>
          </div>
          <div class="ci-ef-full"><label class="ci-ef-label">Description</label><textarea class="ci-ef-textarea" id="editField-description" name="description" rows="2"></textarea></div>
          <div class="ci-ef-full">
            <label class="ci-ef-label">Ingrédients <span class="ci-ef-label-hint">§ titre de section · • liste</span></label>
            <div class="rte-mini-wrap">
              <div class="rte-mini-toolbar" id="profil-ing-tb" role="toolbar" aria-label="Mise en forme ingrédients">
                <button type="button" class="rte-tb-btn" data-cmd="bold" title="Gras"><strong>G</strong></button>
                <button type="button" class="rte-tb-btn" data-cmd="italic" title="Italique"><em>I</em></button>
                <div class="rte-tb-divider"></div>
                <button type="button" class="rte-tb-btn" data-cmd="bulletList" title="Liste à puces">• liste</button>
                <button type="button" class="rte-tb-btn" data-cmd="heading" title="Titre de section">§ titre</button>
              </div>
              <div class="rte-mini-editor" id="profil-ing-rte" contenteditable="true" spellcheck="false" role="textbox" aria-multiline="true" aria-label="Ingrédients"></div>
            </div>
            <input type="hidden" id="editField-ingredients" name="ingredients" />
          </div>
          <div class="ci-ef-full">
            <label class="ci-ef-label">Préparation <span class="ci-ef-label-hint">Ctrl+↵ ou + étape pour séparer les étapes</span></label>
            <div class="rte-mini-wrap">
              <div class="rte-mini-toolbar" id="profil-prep-tb" role="toolbar" aria-label="Mise en forme préparation">
                <button type="button" class="rte-tb-btn" data-cmd="bold" title="Gras"><strong>G</strong></button>
                <button type="button" class="rte-tb-btn" data-cmd="italic" title="Italique"><em>I</em></button>
                <div class="rte-tb-divider"></div>
                <button type="button" class="rte-tb-btn" data-cmd="bulletList" title="Liste à puces">• liste</button>
                <div class="rte-tb-divider"></div>
                <button type="button" class="rte-tb-btn" data-cmd="separator" title="Nouvelle étape (Ctrl+Entrée)">+ étape</button>
              </div>
              <div class="rte-mini-editor" id="profil-prep-rte" contenteditable="true" spellcheck="false" role="textbox" aria-multiline="true" aria-label="Préparation"></div>
            </div>
            <input type="hidden" id="editField-preparation" name="preparation" />
          </div>
          <div class="ci-ef-full">
            <label class="ci-ef-label">Photos <span class="ci-ef-label-hint">max 3 · ratio 3:2 · 2 Mo par photo · remplace les photos actuelles si modifiées</span></label>
            <div class="ci-ef-photo-slots" id="editPhotoSlots">
              <% for (var ps = 1; ps <= 3; ps++) { %>
              <div class="ci-ef-ps" id="edit-ps-<%= ps %>">
                <div class="ci-ef-ps__prev" id="edit-ps-prev-<%= ps %>"></div>
                <span class="ci-ef-ps__n"><%= ps === 1 ? '01 PRINC.' : '0' + ps %></span>
                <input type="file" name="pictures" id="edit-ps-input-<%= ps %>"
                  accept="image/jpeg,image/jpg,image/png,image/webp"
                  class="ci-ef-ps__file" />
                <button type="button" class="ci-ef-ps__del" id="edit-ps-del-<%= ps %>" title="Retirer">×</button>
              </div>
              <% } %>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn--ghost btn--sm" id="editModalCancel">Annuler</button>
          <button class="btn btn--primary btn--sm" id="editModalSave">Enregistrer</button>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="/js/profile-tabs.js" defer></script>
    <script src="/js/rte-mini.js"></script>
    <script src="/js/account.js" defer></script>
    <script>
    // Initialiser les RTEs du modal d'édition recette (une seule fois)
    document.addEventListener('DOMContentLoaded', function () {
      var ingRte  = document.getElementById('profil-ing-rte');
      var ingTb   = document.getElementById('profil-ing-tb');
      var prepRte = document.getElementById('profil-prep-rte');
      var prepTb  = document.getElementById('profil-prep-tb');
      if (ingRte  && ingTb  && window.RteMini) RteMini.initEditor({ rteEl: ingRte,  tbEl: ingTb,  mode: 'ingredients' });
      if (prepRte && prepTb && window.RteMini) RteMini.initEditor({ rteEl: prepRte, tbEl: prepTb, mode: 'preparation' });
    });
    </script>

    <!-- Upload bannière -->
    <script>
      (function () {
        const input = document.getElementById('bannerInput');
        if (!input) return;
        const userId = '<%= user.id %>';

        let bannerPollInterval = null;

        function stopBannerPoll() {
          if (bannerPollInterval) { clearInterval(bannerPollInterval); bannerPollInterval = null; }
        }

        function startBannerPoll() {
          stopBannerPoll();
          bannerPollInterval = setInterval(async function () {
            try {
              const r = await fetch('/auth/profil/' + userId + '/banner/status');
              const d = await r.json();
              if (!d.success) return;

              if (d.banner_status === 'approved') {
                stopBannerPoll();
                /* Afficher la bannière approuvée */
                const heroDiv = document.querySelector('.hero-banner');
                if (heroDiv) {
                  let img = heroDiv.querySelector('img');
                  if (img) { img.src = d.banner_image; }
                  else { img = document.createElement('img'); img.src = d.banner_image; img.alt = ''; heroDiv.prepend(img); }
                }
                /* Remettre le bouton "Modifier" */
                const wrap = document.querySelector('.hero-banner-status');
                if (wrap) {
                  wrap.innerHTML = '<button class="banner-btn banner-btn--upload" type="button" onclick="document.getElementById(\'bannerInput\').click()"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>Modifier la bannière</button>';
                }
              } else if (d.banner_status === 'rejected') {
                stopBannerPoll();
                const wrap = document.querySelector('.hero-banner-status');
                if (wrap) {
                  wrap.innerHTML = '<button class="banner-btn banner-btn--rejected" type="button" onclick="document.getElementById(\'bannerInput\').click()" title="Bannière refusée — cliquez pour réessayer"><span class="b-dot"></span>Bannière refusée — Réessayer</button>';
                }
              }
            } catch { /* silencieux */ }
          }, 5000);
        }

        /* Si au chargement la bannière est déjà en pending, démarrer le poll */
        <% if (user.banner_status === 'pending') { %>
        startBannerPoll();
        <% } %>

        input.addEventListener('change', async function () {
          const file = input.files[0];
          if (!file) return;
          if (!file.type.startsWith('image/')) return;

          const formData = new FormData();
          formData.append('banner', file);

          try {
            const res  = await fetch('/auth/profil/' + userId + '/banner', { method: 'POST', body: formData });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.message || 'Erreur upload.');

            /* Mettre le badge "en attente" et démarrer le poll */
            const wrap = document.querySelector('.hero-banner-status');
            if (wrap) {
              wrap.innerHTML = '<span class="banner-btn banner-btn--pending"><span class="b-dot"></span>Bannière en attente</span>';
            }
            startBannerPoll();
          } catch (err) {
            console.error('Banner upload error:', err);
          }

          input.value = '';
        });
      })();
    </script>
