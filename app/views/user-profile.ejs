                    <div class="crea-empty__icon">🎬</div>
                    <div class="crea-empty__title">Aucun film proposé</div>
                    <div class="crea-empty__sub">Suggérez un film à la communauté</div>
                  </div>
                  <% } %>
                  <div class="crea-no-results" style="display:none">Aucun résultat pour cette recherche.</div>
                </div>
              </section>

              <!-- ═══ MES AVIS ═══ -->
              <section id="creaAvisSection">
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Critiques &amp; évaluations</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">MES AVIS</div>
                </div>
                <div class="filter-bar" id="creaAvisFilters">
                  <button class="f-pill active" data-crea-filter="all" data-crea-grid="creaAvisGrid"><span class="f-pill__dot" style="background:var(--dore-clair)"></span>Tous</button>
                  <button class="f-pill fp--valide" data-crea-filter="approved" data-crea-grid="creaAvisGrid"><span class="f-pill__dot" style="background:var(--vert-clair)"></span>Validés</button>
                  <button class="f-pill fp--attente" data-crea-filter="pending" data-crea-grid="creaAvisGrid"><span class="f-pill__dot" style="background:var(--orange-clair)"></span>En attente</button>
                </div>
                <div class="avis-grid" id="creaAvisGrid">
                  <% if (_cn.length > 0) { %>
                    <% _cn.forEach(function(notice) { %>
                    <div class="avis-card account-item account-item--notice"
                      data-type="notice"
                      data-id="<%= notice.id %>"
                      data-delete-request="<%= notice.delete_request_status || 'none' %>"
                      data-crea-status="<%= notice.status %>"
                    >
                      <div class="avis-icon">
                        <i data-lucide="message-square" aria-hidden="true"></i>
                      </div>
                      <div class="avis-body">
                        <div class="avis-top">
                          <div class="avis-titles">
                            <% if (notice.Recipe) { %>
                            <div class="avis-recipe-name">Recette : <a class="account-item__link" href="/recipes-movie/details/<%= notice.Recipe.id %>"><%= notice.Recipe.name %></a></div>
                            <% if (notice.Recipe.Movie) { %><div class="avis-film-link">Film : <a class="account-item__link" href="/recipes-movie/<%= notice.Recipe.Movie.id %>"><%= notice.Recipe.Movie.title %></a></div><% } %>
