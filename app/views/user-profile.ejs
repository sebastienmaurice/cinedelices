                </div>
                <div class="list-grid" id="creaRecettesGrid">
                  <% if (_cr.length > 0) { %>
                    <% _cr.forEach(function(recipe) {
                      const rsCls = recipe.status === 'approved' ? 'lrs--valide' : recipe.status === 'pending' ? 'lrs--attente' : 'lrs--refuse';
                      const rsTxt = recipe.status === 'approved' ? 'Validée' : recipe.status === 'pending' ? 'En attente' : 'Refusée';
                      const diffCls = recipe.difficulty === 'Facile' ? 'lr-tag--diff' : recipe.difficulty === 'Difficile' ? 'lr-tag--diff-h' : 'lr-tag--diff-m';
                    %>
                    <div class="list-row list-row--recette account-item"
