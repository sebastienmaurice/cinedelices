              <!-- INFORMATIONS -->
              <section>
                <div class="sec-eyebrow">
                  <div class="sec-eyebrow__line"></div>
                  <span class="sec-eyebrow__label">Paramètres du compte</span>
                </div>
                <div class="sec-header">
                  <div class="sec-title">INFORMATIONS</div>
                  <button type="button" class="sec-link" id="editProfileBtn">Éditer →</button>
                </div>
                <div class="widget">
                  <div class="widget__form-body">
                    <form id="profileInfoForm">
                      <div class="pf-row">
                        <div class="pf-group">
                          <label class="pf-label" for="firstname">Prénom</label>
                          <input class="pf-input" type="text" id="firstname" name="first_name" value="<%= user.first_name %>" disabled />
                        </div>
                        <div class="pf-group">
                          <label class="pf-label" for="lastname">Nom</label>
                          <input class="pf-input" type="text" id="lastname" name="last_name" value="<%= user.last_name %>" disabled />
                        </div>
                      </div>
                      <div class="pf-row">
                        <div class="pf-group pf-group--full">
                          <label class="pf-label" for="email">Adresse e-mail</label>
                          <input class="pf-input" type="email" id="email" name="email" value="<%= user.email %>" disabled />
                        </div>
                      </div>
                      <div class="pf-row">
                        <div class="pf-group pf-group--full">
                          <label class="pf-label" for="password">Mot de passe</label>
                          <input class="pf-input" type="password" id="password" name="password" placeholder="••••••••" disabled />
                          <a href="/auth/forgot-password" class="pf-link">Mot de passe oublié ?</a>
                        </div>
                      </div>
                      <div class="pf-actions">
                        <button type="submit" class="lr-btn lr-btn--edit" id="saveProfileBtn" style="display:none;height:32px;padding:0 16px;">Enregistrer</button>
                        <button type="button" class="lr-btn lr-btn--view" id="cancelProfileBtn" style="display:none;height:32px;padding:0 16px;">Annuler</button>
                      </div>
                    </form>
                  </div>
