                  <button class="f-pill fp--attente" data-crea-filter="pending" data-crea-grid="creaRecettesGrid"><span class="f-pill__dot" style="background:var(--orange-clair)"></span>En attente</button>
                  <button class="f-pill fp--refuse" data-crea-filter="rejected" data-crea-grid="creaRecettesGrid"><span class="f-pill__dot" style="background:#e84020"></span>Refusées</button>
                  <div class="filter-sep"></div>
                  <div class="crea-search-wrap">
                    <i data-lucide="search" class="crea-search-icon" aria-hidden="true"></i>
