                      data-preparation="<%= encodeURIComponent(recipe.preparation || '') %>"
                      data-picture="<%= recipe.picture || '' %>"
                      data-pictures="<%= encodeURIComponent(JSON.stringify((recipe.RecipePictures || []).sort((a,b)=>a.position-b.position).map(p=>p.file_path))) %>"
