          <!-- LAYOUT 2 COLONNES -->
          <div class="crea-layout">

            <!-- ── SIDEBAR ── -->
            <aside class="crea-sidebar">

              <!-- Résumé -->
              <div class="widget">
                <div class="widget-head">
                  <div class="widget-head__line"></div>
                  <span class="widget-head__title">Mes collections</span>
                </div>
                <div class="stats-grid">
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= favoriteMoviesCount || 0 %></div>
                      <div class="stat-lbl">Films fav.</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= favoriteRecipesCount || 0 %></div>
                      <div class="stat-lbl">Recettes fav.</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= ratedMoviesCount || 0 %></div>
                      <div class="stat-lbl">Films notés</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= ratedRecipesCount || 0 %></div>
                      <div class="stat-lbl">Recettes notées</div>
                    </div>
                  </div>
                </div>
