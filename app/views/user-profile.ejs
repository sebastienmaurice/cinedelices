<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Gérez votre compte et vos préférences cinéma & recettes" />
    <title>Mon compte - Ciné Délices</title>
    <%- include("partials/head-resources") %>
    <link rel="stylesheet" href="/css/user-profile.css" />
  </head>

  <body class="profile-page">
    <%- include("partials/header") %>

    <% const bannerUrl = user.banner || user.banner_image || null; %>

    <!-- MAIN -->
    <main data-user-id="<%= user.id %>" data-picture-status="<%= user.picture_status || 'approved' %>">

      <h1 class="sr-only"><%= user.pseudo %> — Mon compte Ciné Délices</h1>

      <!-- ══════════════════════════════════════════
           HERO BANNER
      ══════════════════════════════════════════ -->
      <section class="profile-hero">

        <!-- Bannière -->
        <div class="hero-banner">
          <% if (bannerUrl) { %>
          <img src="<%= bannerUrl %>" alt="Bannière de <%= user.pseudo %>" />
          <% } %>
          <div class="hero-banner-grad"></div>
        </div>

        <!-- Déco cinématographique -->
        <div class="hero-reel hero-reel--1" aria-hidden="true"></div>
        <div class="hero-reel hero-reel--2" aria-hidden="true"></div>
        <div class="hero-scanlines" aria-hidden="true"></div>
        <div class="hero-vignette" aria-hidden="true"></div>

        <!-- Page auteur (top-left) -->
        <% if (userRecipes && userRecipes.length > 0) { %>
        <div class="hero-author-link">
          <a href="/movies" class="author-link">
            <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
            Ma page auteur
          </a>
        </div>
        <% } %>

        <!-- Statut bannière (top-right) -->
        <div class="hero-banner-status">
          <% if (user.banner_status === 'pending') { %>
            <span class="banner-btn banner-btn--pending"><span class="b-dot"></span>Bannière en attente</span>
          <% } else if (user.banner_status === 'rejected') { %>
            <span class="banner-btn banner-btn--rejected"><span class="b-dot"></span>Bannière refusée</span>
          <% } else { %>
            <button class="banner-btn banner-btn--upload" type="button" onclick="document.getElementById('bannerInput').click()">
              <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Modifier la bannière
            </button>
          <% } %>
        </div>
        <input id="bannerInput" type="file" name="banner" accept="image/*" hidden />

        <!-- Contenu hero bas -->
        <form id="profileAvatarForm" class="hero-content">

          <!-- Avatar -->
          <div class="avatar-block">
            <div class="avatar-frame">
              <div class="avatar-frame__ring"></div>
              <img
                src="<%= user.picture || '/images/image-default-profile.jpg' %>"
                alt="Avatar de <%= user.pseudo %>"
                class="avatar-img"
              />
              <% if (user.picture || user.picture_status === 'pending' || user.picture_status === 'rejected') { %>
              <span class="avatar-photo-status avatar-photo-status--<%= user.picture_status === 'pending' ? 'pending' : user.picture_status === 'rejected' ? 'rejected' : 'ok' %>">
                <span class="b-dot"></span>
                <%= user.picture_status === 'pending' ? 'En attente' : user.picture_status === 'rejected' ? 'Refusée' : 'Vérifié' %>
              </span>
              <% } %>
              <div class="avatar-actions">
                <label for="avatar" class="av-btn av-btn--upload" title="Changer la photo">
                  <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </label>
                <input type="file" id="avatar" name="avatar" accept="image/*" hidden />
                <button type="button" class="av-btn av-btn--del" id="removeAvatarBtn" title="Supprimer la photo">
                  <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Identité + XP -->
          <div class="hero-identity">
            <div class="hero-pseudo-row">
              <input
                class="hero-pseudo"
                id="username"
                name="pseudo"
                type="text"
                value="<%= user.pseudo %>"
                maxlength="30"
                disabled
              />
              <button type="button" class="hero-pseudo-edit" id="editPseudoBtn" title="Modifier le pseudo">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button type="button" class="hero-pseudo-save" id="savePseudoBtn">Sauvegarder</button>
            </div>
            <p class="hero-sub">Membre Ciné Délices</p>

            <div class="hero-stats-row">
              <div class="h-stat">
                <span class="h-stat__num"><%= userRecipes.length %></span>
                <span class="h-stat__lbl">Recettes</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userMovies.length %></span>
                <span class="h-stat__lbl">Films</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= userNoticesCount %></span>
                <span class="h-stat__lbl">Avis</span>
              </div>
              <div class="h-stat-div" aria-hidden="true"></div>
              <div class="h-stat">
                <span class="h-stat__num"><%= (favoriteMoviesCount || 0) + (favoriteRecipesCount || 0) %></span>
                <span class="h-stat__lbl">Favoris</span>
              </div>
            </div>
          </div>

        </form>
      </section>

      <!-- ══════════════════════════════════════════
           TABS NAVIGATION
      ══════════════════════════════════════════ -->
      <div class="profile-tabs-wrap">
        <nav class="profile-tabs" role="tablist" aria-label="Navigation du compte">
          <button class="ptab active" data-tab="overview" role="tab" aria-selected="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="ptab-text">Vue d'ensemble</span>
          </button>
          <button class="ptab" data-tab="profil" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="ptab-text">Profil</span>
          </button>
          <button class="ptab" data-tab="favoris" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span class="ptab-text">Favoris</span>
          </button>
          <button class="ptab" data-tab="creations" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span class="ptab-text">Créations</span>
            <% const totalCreations = userRecipes.length + userMovies.length + userNoticesCount; if (totalCreations > 0) { %>
            <span class="ptab-badge"><%= totalCreations %></span>
            <% } %>
          </button>
          <button class="ptab" data-tab="contributions" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="ptab-text">Contributions</span>
          </button>
        </nav>
      </div>

      <!-- ══════════════════════════════════════════
           CONTENT
      ══════════════════════════════════════════ -->
      <div class="profile-content">

        <!-- ─────────────────────────────────── -->
        <!-- TAB : VUE D'ENSEMBLE               -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane active" id="overview" role="tabpanel">

          <div class="section-head">
            <span class="section-eyebrow">Mon compte</span>
            <span class="section-title">VUE D'ENSEMBLE</span>
            <span class="section-rule"></span>
          </div>

          <div class="overview-grid">
            <div class="ov-card ov-card--recettes">
              <div class="ov-card__icon">
                <svg viewBox="0 0 24 24"><path d="M15 11h.01"/><path d="M11 15h.01"/><path d="M16 16h.01"/><path d="m2 16 20 6-6-20A20 20 0 0 0 2 16"/><path d="M5.71 17.11a17.04 17.04 0 0 1 11.4-11.4"/></svg>
              </div>
              <div class="ov-val"><%= userRecipes.length %></div>
              <div class="ov-label">Recettes publiées</div>
            </div>
            <div class="ov-card ov-card--films">
              <div class="ov-card__icon">
                <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
              </div>
              <div class="ov-val"><%= userMovies.length %></div>
              <div class="ov-label">Films ajoutés</div>
            </div>
            <div class="ov-card ov-card--avis">
              <div class="ov-card__icon">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="ov-val"><%= userNoticesCount %></div>
              <div class="ov-label">Avis rédigés</div>
            </div>
            <div class="ov-card ov-card--favoris">
              <div class="ov-card__icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </div>
              <div class="ov-val"><%= (favoriteMoviesCount || 0) + (favoriteRecipesCount || 0) %></div>
              <div class="ov-label">Favoris totaux</div>
            </div>
            <div class="ov-card ov-card--note">
              <div class="ov-card__icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="ov-val"><%= avgUserRating || '—' %></div>
              <div class="ov-label">Note moyenne</div>
            </div>
          </div>

        </div><!-- /tab-pane#overview -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : PROFIL                        -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="profil" role="tabpanel">

          <div class="section-head">
            <span class="section-eyebrow">Mon compte</span>
            <span class="section-title">MON PROFIL</span>
            <span class="section-rule"></span>
          </div>

          <div class="profil-grid">

            <!-- Colonne gauche : formulaires -->
            <div class="profil-left">

              <!-- Infos personnelles -->
              <div class="form-card">
                <div class="form-card__head">
                  <span class="form-card__title">INFORMATIONS</span>
                  <button type="button" class="btn btn--ghost btn--sm" id="editProfileBtn">Éditer</button>
                </div>
                <div class="form-card__body">
                  <form id="profileInfoForm">
                    <div class="form-row">
                      <div class="form-group">
                        <label class="form-label" for="firstname">Prénom</label>
                        <input class="form-input" type="text" id="firstname" name="first_name" value="<%= user.first_name %>" disabled />
                      </div>
                      <div class="form-group">
                        <label class="form-label" for="lastname">Nom</label>
                        <input class="form-input" type="text" id="lastname" name="last_name" value="<%= user.last_name %>" disabled />
                      </div>
                    </div>
                    <div class="form-row form-row--full">
                      <div class="form-group">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-input" type="email" id="email" name="email" value="<%= user.email %>" disabled />
                      </div>
                    </div>
                    <div class="form-row form-row--full">
                      <div class="form-group">
                        <label class="form-label" for="password">Mot de passe</label>
                        <input class="form-input" type="password" id="password" name="password" placeholder="••••••••" disabled />
                        <a href="/auth/forgot-password" class="form-pwd-link">Mot de passe oublié ?</a>
                      </div>
                    </div>
                    <div class="form-actions">
                      <button type="submit" class="btn btn--primary btn--sm" id="saveProfileBtn" style="display:none;">Enregistrer</button>
                      <button type="button" class="btn btn--ghost btn--sm" id="cancelProfileBtn" style="display:none;">Annuler</button>
                    </div>
                  </form>

                  <!-- Notifications -->
                  <form id="profilePrefsForm">
                    <div class="notif-block">
                      <div class="notif-row">
                        <div class="notif-info">
                          <span class="notif-label">Notifications recettes</span>
                          <span class="notif-sub">Nouvelles recettes sur vos films favoris</span>
                        </div>
                        <label class="toggle">
                          <input type="checkbox" name="notify_recipes" <%= user.notify_recipes ? 'checked' : '' %> disabled />
                          <span class="toggle-slider"></span>
                        </label>
                      </div>
                      <div class="notif-row">
                        <div class="notif-info">
                          <span class="notif-label">Notifications cinéma</span>
                          <span class="notif-sub">Nouveaux films ajoutés à la collection</span>
                        </div>
                        <label class="toggle">
                          <input type="checkbox" name="notify_cinema" <%= user.notify_cinema ? 'checked' : '' %> disabled />
                          <span class="toggle-slider"></span>
                        </label>
                      </div>
                    </div>
                  </form>
                </div>
              </div>

            </div><!-- /profil-left -->

            <!-- Colonne droite : stats + danger -->
            <div>
              <div class="side-stats">
                <div class="side-stats__head">
                  <div class="side-stats__title">MON COMPTE</div>
                </div>
                <div class="side-stats__rows">
                  <div class="ss-row">
                    <span class="ss-label">
                      <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      Pseudo
                    </span>
                    <span class="ss-val" style="color:var(--or-titre);font-size:.75rem"><%= user.pseudo %></span>
                  </div>
                  <div class="ss-row">
                    <span class="ss-label">
                      <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                      Avis publiés
                    </span>
                    <span class="ss-val"><%= userNoticesCount %></span>
                  </div>
                  <div class="ss-row">
                    <span class="ss-label">
                      <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      Note moyenne
                    </span>
                    <span class="ss-val" style="color:var(--dore-clair)"><%= avgUserRating || '—' %></span>
                  </div>
                </div>
              </div>

              <div class="danger-zone">
                <div class="danger-zone__head">
                  <span class="danger-zone__icon">⚠️</span>
                  <span class="danger-zone__title">Zone Danger</span>
                </div>
                <div class="danger-zone__body">
                  <p class="danger-zone__sub">La suppression de votre compte est irréversible. Toutes vos données, recettes, avis et favoris seront définitivement effacés.</p>
                  <div class="danger-zone__actions">
                    <button class="btn btn--red btn--sm" id="deleteAccountBtn" style="width:100%;">Supprimer mon compte</button>
                  </div>
                </div>
              </div>
            </div>

          </div><!-- /profil-grid -->
        </div><!-- /tab-pane#profil -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : FAVORIS                       -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="favoris" role="tabpanel">

          <div class="section-head">
            <span class="section-eyebrow">Mon compte</span>
            <span class="section-title">FAVORIS &amp; NOTES</span>
            <span class="section-rule"></span>
          </div>

          <div class="fav-cols">

            <!-- Films favoris -->
            <div class="fav-section">
              <div class="fav-section__head">
                <span class="fav-section__title">FILMS FAVORIS</span>
                <span class="fav-section__count"><%= favoriteMoviesCount || 0 %></span>
              </div>
              <div class="fav-list">
                <% if (favoriteMovies && favoriteMovies.length > 0) { %>
                  <% favoriteMovies.slice(0, 8).forEach(movie => { %>
                  <a href="/recipes-movie/<%= movie.id %>" class="fav-item">
                    <% if (movie.cardPath || movie.picture) { %>
                    <img class="fav-item__thumb fav-item__thumb--poster" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                    <% } else { %>
                    <div class="fav-item__thumb fav-item__thumb--poster fav-item__thumb--placeholder">🎬</div>
                    <% } %>
                    <div class="fav-item__info">
                      <span class="fav-item__title"><%= movie.title %></span>
                      <span class="fav-item__sub"><%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %></span>
                    </div>
                  </a>
                  <% }) %>
                  <% if (favoriteMoviesCount > 8) { %>
                  <span class="fav-more">Voir tous les <%= favoriteMoviesCount %> films favoris →</span>
                  <% } %>
                <% } else { %>
                  <p class="fav-empty">Aucun film en favoris pour l'instant.</p>
                <% } %>
              </div>
            </div>

            <!-- Recettes favorites -->
            <div class="fav-section">
              <div class="fav-section__head">
                <span class="fav-section__title">RECETTES FAVORITES</span>
                <span class="fav-section__count"><%= favoriteRecipesCount || 0 %></span>
              </div>
              <div class="fav-list">
                <% if (favoriteRecipes && favoriteRecipes.length > 0) { %>
                  <% favoriteRecipes.slice(0, 8).forEach(recipe => { %>
                  <a href="/recipes-movie/details/<%= recipe.id %>" class="fav-item">
                    <% if (recipe.picture) { %>
                    <img class="fav-item__thumb fav-item__thumb--recipe" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                    <% } else { %>
                    <div class="fav-item__thumb fav-item__thumb--recipe fav-item__thumb--placeholder">🍽️</div>
                    <% } %>
                    <div class="fav-item__info">
                      <span class="fav-item__title"><%= recipe.name %></span>
                      <span class="fav-item__sub"><%= recipe.category %> · <%= recipe.time %> min<% if (recipe.Movie) { %> · <%= recipe.Movie.title %><% } %></span>
                    </div>
                  </a>
                  <% }) %>
                  <% if (favoriteRecipesCount > 8) { %>
                  <span class="fav-more">Voir toutes les <%= favoriteRecipesCount %> recettes favorites →</span>
                  <% } %>
                <% } else { %>
                  <p class="fav-empty">Aucune recette en favoris pour l'instant.</p>
                <% } %>
              </div>
            </div>

            <!-- Films notés -->
            <div class="fav-section">
              <div class="fav-section__head">
                <span class="fav-section__title">FILMS NOTÉS</span>
                <span class="fav-section__count"><%= ratedMoviesCount || 0 %></span>
              </div>
              <div class="fav-list">
                <% if (ratedMovies && ratedMovies.length > 0) { %>
                  <% ratedMovies.slice(0, 8).forEach(movie => { %>
                  <a href="/recipes-movie/<%= movie.id %>" class="fav-item">
                    <% if (movie.cardPath || movie.picture) { %>
                    <img class="fav-item__thumb fav-item__thumb--poster" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                    <% } else { %>
                    <div class="fav-item__thumb fav-item__thumb--poster fav-item__thumb--placeholder">🎬</div>
                    <% } %>
                    <div class="fav-item__info">
                      <span class="fav-item__title"><%= movie.title %></span>
                      <span class="fav-item__sub"><%= movie.year %><% if (movie.genre) { %> · <%= movie.genre %><% } %></span>
                    </div>
                    <span class="fav-item__note">★ <%= movie.userScore %></span>
                  </a>
                  <% }) %>
                <% } else { %>
                  <p class="fav-empty">Aucun film noté pour l'instant.</p>
                <% } %>
              </div>
            </div>

            <!-- Recettes notées -->
            <div class="fav-section">
              <div class="fav-section__head">
                <span class="fav-section__title">RECETTES NOTÉES</span>
                <span class="fav-section__count"><%= ratedRecipesCount || 0 %></span>
              </div>
              <div class="fav-list">
                <% if (ratedRecipes && ratedRecipes.length > 0) { %>
                  <% ratedRecipes.slice(0, 8).forEach(recipe => { %>
                  <a href="/recipes-movie/details/<%= recipe.id %>" class="fav-item">
                    <% if (recipe.picture) { %>
                    <img class="fav-item__thumb fav-item__thumb--recipe" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                    <% } else { %>
                    <div class="fav-item__thumb fav-item__thumb--recipe fav-item__thumb--placeholder">🍽️</div>
                    <% } %>
                    <div class="fav-item__info">
                      <span class="fav-item__title"><%= recipe.name %></span>
                      <span class="fav-item__sub"><%= recipe.category %> · <%= recipe.time %> min</span>
                    </div>
                    <span class="fav-item__note">★ <%= recipe.userScore %></span>
                  </a>
                  <% }) %>
                <% } else { %>
                  <p class="fav-empty">Aucune recette notée pour l'instant.</p>
                <% } %>
              </div>
            </div>

          </div><!-- /fav-cols -->
        </div><!-- /tab-pane#favoris -->


        <!-- ─────────────────────────────────── -->
        <!-- TAB : CRÉATIONS                     -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="creations" role="tabpanel">

          <div class="section-head">
            <span class="section-eyebrow">Mon compte</span>
            <span class="section-title">MES CRÉATIONS</span>
            <span class="section-rule"></span>
          </div>

          <div class="creations-grid">

            <!-- ── RECETTES ── -->
            <div class="creation-section">
              <div class="creation-section__head">
                <span class="creation-section__title">MES RECETTES (<%= userRecipes.length %>)</span>
              </div>
              <div class="inline-filter">
                <input type="search" class="if-input collections-section__search-input" placeholder="Filtrer mes recettes…" />
              </div>
              <div class="creation-list collections-section__list" id="collections-recipes-list">
                <% if (userRecipes && userRecipes.length > 0) { %>
                  <% userRecipes.forEach(recipe => { %>
                  <article
                    class="account-item ci-item"
                    data-type="recipe"
                    data-id="<%= recipe.id %>"
                    data-name="<%= recipe.name %>"
                    data-category="<%= recipe.category %>"
                    data-time="<%= recipe.time %>"
                    data-difficulty="<%= recipe.difficulty %>"
                    data-edit-status="<%= recipe.edit_status || 'none' %>"
                  >
                    <div class="ci-top">
                      <% if (recipe.picture) { %>
                      <img class="ci-thumb ci-thumb--recipe" src="<%= recipe.picture %>" alt="<%= recipe.name %>" loading="lazy" />
                      <% } else { %>
                      <div class="ci-thumb ci-thumb--recipe ci-thumb--placeholder">🍽️</div>
                      <% } %>
                      <div class="ci-info account-item__content">
                        <div class="account-item__header">
                          <span class="ci-title account-item__title"><%= recipe.name %></span>
                          <span class="ci-status ci-status--<%= recipe.status === 'approved' ? 'ok' : recipe.status === 'rejected' ? 'refused' : 'pending' %> account-item__status <%= recipe.status === 'approved' ? 'is-approved' : recipe.status === 'rejected' ? 'is-rejected' : 'is-pending' %>">
                            <%= recipe.status === 'approved' ? 'Validé' : recipe.status === 'rejected' ? 'Refusé' : 'En attente' %>
                          </span>
                        </div>
                        <div class="ci-meta account-item__meta">
                          <%= recipe.category %>
                          <span class="ci-dot"></span>
                          <%= recipe.time %> min
                          <span class="ci-dot"></span>
                          <%= recipe.difficulty %>
                        </div>
                        <% if (recipe.Movie) { %><p class="account-item__hint">Film : <%= recipe.Movie.title %></p><% } %>
                        <% if (recipe.edit_status === 'pending') { %><p class="account-item__hint">Modification en attente de validation.</p><% } %>
                      </div>
                    </div>
                    <div class="ci-actions account-item__actions">
                      <button class="ci-btn ci-btn--edit account-edit-btn" <%= recipe.edit_status === 'pending' ? 'disabled' : '' %>>
                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Éditer
                      </button>
                      <button class="ci-btn ci-btn--del account-delete-btn">
                        <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg>
                        Supprimer
                      </button>
                    </div>
                    <div class="account-item__edit ci-edit-form">
                      <div class="ci-ef-row">
                        <div><label class="ci-ef-label">Titre</label><input class="ci-ef-input" type="text" name="name" value="<%= recipe.name %>" /></div>
                        <div><label class="ci-ef-label">Catégorie</label><input class="ci-ef-input" type="text" name="category" value="<%= recipe.category %>" /></div>
                      </div>
                      <div class="ci-ef-row">
                        <div><label class="ci-ef-label">Temps (min)</label><input class="ci-ef-input" type="number" name="time" value="<%= recipe.time %>" /></div>
                        <div><label class="ci-ef-label">Difficulté</label><input class="ci-ef-input" type="text" name="difficulty" value="<%= recipe.difficulty %>" /></div>
                      </div>
                      <div class="ci-ef-full"><label class="ci-ef-label">Description</label><textarea class="ci-ef-textarea" name="description" rows="2"><%= recipe.description %></textarea></div>
                      <div class="ci-ef-full"><label class="ci-ef-label">Ingrédients</label><textarea class="ci-ef-textarea" name="ingredients" rows="3"><%= recipe.ingredients %></textarea></div>
                      <div class="ci-ef-full"><label class="ci-ef-label">Préparation</label><textarea class="ci-ef-textarea" name="preparation" rows="4"><%= recipe.preparation %></textarea></div>
                      <div class="ci-ef-full">
                        <label class="ci-ef-label account-item__file">Photo de la recette<input type="file" name="recipeImage" accept="image/*" /></label>
                        <p class="account-item__preview">Aperçu : <span></span></p>
                      </div>
                      <div class="ci-ef-actions account-item__edit-actions">
                        <button class="btn btn--primary btn--sm account-save-btn">Enregistrer</button>
                        <button class="btn btn--ghost btn--sm account-cancel-btn">Annuler</button>
                      </div>
                    </div>
                  </article>
                  <% }) %>
                <% } else { %>
                  <p class="fav-empty account-empty">Aucune recette enregistrée pour le moment.</p>
                <% } %>
              </div>
              <p class="collections-section__no-results" style="display:none;color:rgba(232,232,232,.35);font-size:.7rem;padding:16px;text-align:center;">Aucun résultat.</p>
            </div>

            <!-- ── FILMS ── -->
            <div class="creation-section">
              <div class="creation-section__head">
                <span class="creation-section__title">MES FILMS (<%= userMovies.length %>)</span>
              </div>
              <div class="inline-filter">
                <input type="search" class="if-input collections-section__search-input" placeholder="Filtrer mes films…" />
              </div>
              <div class="creation-list collections-section__list" id="collections-movies-list">
                <% if (userMovies && userMovies.length > 0) { %>
                  <% userMovies.forEach(movie => { %>
                  <article
                    class="account-item ci-item"
                    data-type="movie"
                    data-id="<%= movie.id %>"
                    data-title="<%= movie.title %>"
                    data-year="<%= movie.year %>"
                    data-genre="<%= movie.genre %>"
                    data-status="<%= movie.status === 'approved' ? 'validated' : 'draft' %>"
                  >
                    <div class="ci-top">
                      <% if (movie.cardPath || movie.picture) { %>
                      <img class="ci-thumb" src="<%= movie.cardPath || movie.picture %>" alt="<%= movie.title %>" loading="lazy" />
                      <% } else { %>
                      <div class="ci-thumb ci-thumb--placeholder">🎬</div>
                      <% } %>
                      <div class="ci-info account-item__content">
                        <div class="account-item__header">
                          <span class="ci-title account-item__title"><%= movie.title %></span>
                          <span class="ci-status ci-status--<%= movie.status === 'approved' ? 'ok' : movie.status === 'rejected' ? 'refused' : 'pending' %> account-item__status <%= movie.status === 'approved' ? 'is-approved' : movie.status === 'rejected' ? 'is-rejected' : 'is-pending' %>">
                            <%= movie.status === 'approved' ? 'Validé' : movie.status === 'rejected' ? 'Refusé' : 'En attente' %>
                          </span>
                        </div>
                        <div class="ci-meta account-item__meta">
                          <%= movie.year %>
                          <% if (movie.genre) { %><span class="ci-dot"></span><%= movie.genre %><% } %>
                        </div>
                      </div>
                    </div>
                  </article>
                  <% }) %>
                <% } else { %>
                  <p class="fav-empty account-empty">Aucun film enregistré pour le moment.</p>
                <% } %>
              </div>
              <p class="collections-section__no-results" style="display:none;color:rgba(232,232,232,.35);font-size:.7rem;padding:16px;text-align:center;">Aucun résultat.</p>
            </div>

            <!-- ── AVIS ── -->
            <div class="creation-section">
              <div class="creation-section__head">
                <span class="creation-section__title">MES AVIS (<%= userNoticesCount %>)</span>
              </div>
              <div class="inline-filter">
                <input type="search" class="if-input collections-section__search-input" placeholder="Filtrer mes avis…" />
              </div>
              <div class="creation-list collections-section__list" id="collections-notices-list">
                <% if (userNotices && userNotices.length > 0) { %>
                  <% userNotices.forEach(notice => { %>
                  <article
                    class="account-item account-item--notice ci-item"
                    data-type="notice"
                    data-id="<%= notice.id %>"
                    data-delete-request="<%= notice.delete_request_status || 'none' %>"
                  >
                    <div class="ci-top">
                      <div class="ci-info account-item__content">
                        <div class="account-item__header">
                          <span class="ci-title account-item__title">Avis #<%= notice.id %></span>
                          <span class="ci-status ci-status--<%= notice.status === 'approved' ? 'ok' : notice.status === 'rejected' ? 'refused' : 'pending' %> account-item__status <%= notice.status === 'approved' ? 'is-approved' : notice.status === 'rejected' ? 'is-rejected' : 'is-pending' %>">
                            <%= notice.status === 'approved' ? 'Validé' : notice.status === 'rejected' ? 'Refusé' : 'En attente' %>
                          </span>
                        </div>
                        <div class="ci-meta account-item__meta">
                          <%= notice.createdAt ? new Date(notice.createdAt).toLocaleDateString('fr-FR') : '' %>
                          <span class="ci-dot"></span>
                          <span class="ci-note"><svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> <%= notice.quote %>/5</span>
                        </div>
                        <% if (notice.Recipe) { %>
                        <p class="account-item__hint">
                          Recette : <a class="account-item__link" href="/recipes-movie/details/<%= notice.Recipe.id %>"><%= notice.Recipe.name %></a>
                          <% if (notice.Recipe.Movie) { %> · Film : <a class="account-item__link" href="/recipes-movie/<%= notice.Recipe.Movie.id %>"><%= notice.Recipe.Movie.title %></a><% } %>
                        </p>
                        <% } %>
                        <p class="account-item__text" style="font-size:.65rem;color:rgba(232,232,232,.5);margin-top:4px;line-height:1.5;"><%= notice.content %></p>
                        <% if (notice.delete_request_status === 'pending') { %>
                        <p class="account-item__hint">Suppression en attente de validation admin.</p>
                        <% } %>
                      </div>
                    </div>
                    <div class="ci-actions account-item__actions">
                      <button class="ci-btn ci-btn--del account-delete-btn" <%= notice.delete_request_status === 'pending' ? 'disabled' : '' %>>
                        <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg>
                        Supprimer
                      </button>
                    </div>
                  </article>
                  <% }) %>
                <% } else { %>
                  <p class="fav-empty account-empty">Aucun avis enregistré pour le moment.</p>
                <% } %>
              </div>
              <p class="collections-section__no-results" style="display:none;color:rgba(232,232,232,.35);font-size:.7rem;padding:16px;text-align:center;">Aucun résultat.</p>
            </div>

          </div><!-- /creations-grid -->
        </div><!-- /tab-pane#creations -->

        <!-- ─────────────────────────────────── -->
        <!-- TAB : CONTRIBUTIONS                -->
        <!-- ─────────────────────────────────── -->
        <div class="tab-pane" id="contributions" role="tabpanel">
          <div class="contrib-soon">
            <div class="contrib-soon__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <h2 class="contrib-soon__title">Espace contributeur</h2>
            <p class="contrib-soon__sub">À venir très prochainement</p>
            <div class="contrib-soon__sep" aria-hidden="true"></div>
            <p class="contrib-soon__desc">
              Cet espace mettra en avant tes contributions à la communauté Ciné Délices —
              recettes ajoutées, films proposés, avis partagés — et te permettra de suivre
              ton impact sur la plateforme.
            </p>
          </div>
        </div><!-- /tab-pane#contributions -->

      </div><!-- /profile-content -->

    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Toast global -->
    <div class="toast-wrap" id="toastWrap" aria-live="polite"></div>

    <!-- Modal confirmation suppression -->
    <div class="modal-overlay" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-box">
        <div class="modal-stripe"></div>
        <div class="modal-head">
          <div class="modal-ico">⚠️</div>
          <div class="modal-titles">
            <div class="modal-title" id="modalTitle">SUPPRESSION</div>
            <div class="modal-sub">Cette action est irréversible</div>
          </div>
        </div>
        <div class="modal-body">
          <p>Vous êtes sur le point de supprimer définitivement :</p>
          <div class="modal-target" id="modalTarget"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn--ghost btn--sm" id="modalCancel">Annuler</button>
          <button class="btn btn--red btn--sm" id="modalConfirm">Confirmer</button>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="/js/profile-tabs.js" defer></script>
    <script src="/js/account.js" defer></script>
  </body>
</html>
