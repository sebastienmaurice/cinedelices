                  <div class="status-bar-row sb--valide">
                    <span class="sb-label">Validées</span>
                    <div class="sb-track"><div class="sb-fill" data-sb-w="<%= _sbValide %>" style="width:0%"></div></div>
                    <span class="sb-count"><%= _crApproved %></span>
                  </div>
                  <div class="status-bar-row sb--attente">
                    <span class="sb-label">En attente</span>
                    <div class="sb-track"><div class="sb-fill" data-sb-w="<%= _sbAttente %>" style="width:0%"></div></div>
                    <span class="sb-count"><%= _crPending %></span>
                  </div>
                  <div class="status-bar-row sb--refuse">
                    <span class="sb-label">Refusées</span>
                    <div class="sb-track"><div class="sb-fill" data-sb-w="<%= _sbRefuse %>" style="width:0%"></div></div>
                    <span class="sb-count"><%= _crRejected %></span>
