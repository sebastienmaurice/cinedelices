                    <div class="stat-text">
                      <div class="stat-num"><%= avgUserRating || '—' %></div>
                      <div class="stat-lbl">Note moy.</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= userRecipes.length %></div>
                      <div class="stat-lbl">Recettes</div>
                    </div>
                  </div>
                  <div class="stat-cell">
                    <div class="stat-icon"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4"/></svg></div>
                    <div class="stat-text">
                      <div class="stat-num"><%= userMovies.length %></div>
                      <div class="stat-lbl">Films</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ZONE DANGER -->
