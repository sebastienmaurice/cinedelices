                      <div class="qa-title">Nouvelle recette</div>
                      <div class="qa-sub">Partager une création culinaire</div>
                    </div>
                  </a>
                  <a href="/add-recipes-movies" class="qa-btn qa-btn--violet">
                    <div class="qa-icon"><i data-lucide="film" aria-hidden="true"></i></div>
                    <div class="qa-text">
                      <div class="qa-title">Proposer un film</div>
                      <div class="qa-sub">Suggérer un film à la communauté</div>
                    </div>
                  </a>
                  <a href="/all-recipes" class="qa-btn qa-btn--vert">
                    <div class="qa-icon"><i data-lucide="message-square" aria-hidden="true"></i></div>
                    <div class="qa-text">
                      <div class="qa-title">Rédiger un avis</div>
                      <div class="qa-sub">Évaluer une recette existante</div>
                    </div>
                  </a>
                </div>
              </div>

              <!-- FILMS PROPOSÉS -->
