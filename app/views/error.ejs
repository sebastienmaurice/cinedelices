<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ciné Délices — Le goût du cinéma : découvrez des recettes inspirées des films cultes !"
    />
    <title>Ciné Délices - Le goût du cinéma</title>

    <!-- Ressources globales : Google Fonts, FontAwesome, base.css -->
    <%- include("partials/head-resources") %>

    <!-- Styles spécifiques à la page -->
    <link rel="stylesheet" href="/css/home.css" />


  </head>

  <body>

  
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <main>
      <section style="padding: 2rem; text-align: center">
        <h1>Oups ! Une erreur est survenue 😢</h1>

      <% if (typeof error === "undefined") { %> 
        <p>route invalide</p>
        <p>recuperation Ip: terminée ✅ </p>
        <h3>adresse ip public: 81.278.125.900</h3>
        <p> Si tu recommence, <br>
          je te retrouverai et  <br> 
          "j'enfoncerai tes dents si loin dans ta gorge <br>
          que tu te mettras une brosse à dents dans le cul pour les brosser".</p> 
          <br><br>
        <img src="https://www.pngplay.com/wp-content/uploads/13/WWE-The-Rock-Transparent-File.png" alt="" height="400">
          <br><br>
      <% } else if (error !== "" ) { %>
        <h3>erreur <%= error %></h3>
        <p><%- message %></p>
        <br><br>
      <% } else { %>
        <h3>erreur </h3>
        <p>erreur inconnue</p>
        <br><br>

      <% } %>
         

        <a href="/" class="btn btn--red btn--sm">Retour </a>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- Scripts JS globaux -->
    <script src="/js/burger-menu.js" defer></script>

    <!-- Scripts JS spécifiques à la page -->
    <script src="/js/popup-connexion.js" defer></script>

    <!-- Script pour ouvrir automatiquement le popup de connexion -->
    <% if (typeof openLoginPopup !== 'undefined' && openLoginPopup) { %>
    <script>
      // On attend que le DOM et popup-connexion.js soient chargés
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const modal = document.getElementById("authModal");
          if (modal && typeof openModal === 'function') {
            openModal("login");
          }
        }, 100);
      });
    </script>
    <% } %>

    <!-- Scripts JS spécifiques à la page -->
    <script
      type="module"
      src=";Wickhttps://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"
    ></script>
  </body>
</html>