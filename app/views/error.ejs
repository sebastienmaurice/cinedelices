<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  const _errCode = (typeof error !== 'undefined' && error) ? String(error) : '404';
  const _is404 = _errCode === '404';
  const _is403 = _errCode === '403';
  const _is401 = _errCode === '401';
  const _is500 = _errCode === '500';
  const _pageTitle = _is404 ? 'Scène Introuvable'
                   : _is403 ? 'Accès Refusé'
                   : _is401 ? 'Identification Impossible'
                   : _is500 ? 'Erreur de Projection'
                   : 'Erreur';
  const _eyebrow  = _is404 ? 'Scène introuvable'
                  : _is403 ? 'Accès interdit'
                  : _is401 ? 'Identifiants invalides'
                  : _is500 ? 'Erreur serveur'
                  : 'Une erreur est survenue';
  const _title    = _is404 ? 'Cette page a été <em>coupée au montage</em>'
                  : _is403 ? 'Vous n\'avez pas accès à <em>cette salle</em>'
                  : _is401 ? 'Les identifiants ne <em>correspondent pas</em>'
                  : _is500 ? 'Le projecteur a <em>rencontré un problème</em>'
                  : 'Une erreur <em>inattendue</em> est survenue';
  const _sub      = _is401
                  ? 'Pseudo ou mot de passe invalide. Vérifiez vos informations, ou réinitialisez votre mot de passe si vous l\'avez oublié.'
                  : (typeof message !== 'undefined' && message && message !== _errCode + '.')
                  ? message
                  : _is404 ? 'Comme une scène supprimée au dernier moment, cette page n\'existe plus ou n\'a jamais existé. Retournez en salle avant que les lumières s\'allument.'
                  : _is403 ? 'Cette section est réservée. Connectez-vous avec le bon compte ou retournez à l\'accueil.'
                  : _is500 ? 'Le serveur a rencontré une erreur inattendue. Notre équipe en a été informée. Revenez dans quelques instants.'
                  : 'Quelque chose s\'est mal passé. Retournez à l\'accueil et réessayez.';
%>
<meta name="description" content="Ciné Délices — <%= _pageTitle %>">
<title><%= _errCode %> — <%= _pageTitle %> · Ciné Délices</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --bleu-nuit:       #142234;
  --bleu-inter:      #1b263b;
  --surface-card:    #0f1e30;
  --bleu-clair:      #415a77;
  --or-titre:        #C4A052;
  --or-100:          #D4A843;
  --or-200:          #B8882A;
  --dore-clair:      #F2C84B;
  --jaune-blond:     #FFE085;
  --rouge-cta:       #C23018;
  --argent:          #e8e8e8;
  --gold-gradient:   linear-gradient(135deg, #B8882A 0%, #D4A843 30%, #F2C84B 55%, #FFE085 80%, #D4A843 100%);
  --gold-gradient-h: linear-gradient(90deg,  #B8882A 0%, #D4A843 30%, #F2C84B 55%, #FFE085 80%, #D4A843 100%);
  --f-display:  'Bebas Neue', cursive;
  --f-title:    'Cinzel', serif;
  --f-editorial:'Playfair Display', serif;
  --f-body:     'Lato', sans-serif;
  --nav-h: 68px;
  --page-px: 64px;
  --max-w: 1440px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; min-height: 100vh; }
body {
  background: var(--bleu-nuit);
  font-family: var(--f-body);
  color: var(--argent);
  overflow-x: hidden;
  overflow-y: hidden;
}

/* ── CANVAS PARTICULES ── */
#particleCanvas {
  position: fixed; inset: 0;
  pointer-events: none; z-index: 0;
}

/* ══ NAV ══ */
.site-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200; height: var(--nav-h);
  display: flex; align-items: center;
  padding: 0 var(--page-px);
  background: rgba(20,34,52,.72); backdrop-filter: blur(20px) saturate(1.5);
  border-bottom: 1px solid rgba(196,160,82,.1);
}
.nav-inner {
  width: 100%; max-width: var(--max-w); margin: 0 auto;
  display: flex; align-items: center;
}
.nav-logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
.nav-logo__img { height: 38px; width: auto; display: block; }
.nav-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.nav-btn-home {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 0 18px; height: 34px; border-radius: 7px;
  background: transparent; border: 1px solid rgba(196,160,82,.35); cursor: pointer;
  font-family: var(--f-title); font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--or-titre); text-decoration: none; transition: all .25s;
}
.nav-btn-home:hover { background: rgba(196,160,82,.1); border-color: rgba(196,160,82,.6); }

/* ══ PAGE ══ */
.page-error {
  position: relative; width: 100%; min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: var(--nav-h) var(--page-px) 0;
  overflow: hidden; z-index: 1;
}

/* ── FOND RADIAL ── */
.bg-glow {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse 65% 55% at 50% 50%, rgba(194,48,24,.11) 0%, transparent 60%),
    radial-gradient(ellipse 90% 70% at 20% 20%, rgba(196,160,82,.07) 0%, transparent 55%),
    radial-gradient(ellipse 80% 80% at 80% 80%, rgba(65,90,119,.15) 0%, transparent 55%);
}

/* ── SCANLINES ── */
.scanlines {
  position: fixed; inset: 0; pointer-events: none; z-index: 2;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,.028) 2px, rgba(0,0,0,.028) 4px);
}

/* ── REELS DÉCO ── */
.reel {
  position: fixed; border-radius: 50%;
  border: 2px solid rgba(196,160,82,.07);
  pointer-events: none; z-index: 0;
}
.reel::before { content: ""; position: absolute; inset: 18px; border-radius: 50%; border: 1px solid rgba(196,160,82,.05); }
.reel::after  { content: ""; position: absolute; inset: 36px; border-radius: 50%; border: 1px solid rgba(196,160,82,.03); }
.reel--a { width: 420px; height: 420px; right: -160px; top: -100px; animation: rotReel 50s linear infinite; }
.reel--b { width: 300px; height: 300px; left: -120px; bottom: -100px; animation: rotReel 38s linear infinite reverse; }
@keyframes rotReel { to { transform: rotate(360deg); } }

/* ── VIGNETTE ── */
.vignette {
  position: fixed; inset: 0; pointer-events: none; z-index: 1;
  background: radial-gradient(ellipse 100% 100% at 50% 50%, transparent 40%, rgba(10,16,26,.65) 100%);
}

/* ══ CONTENU CENTRAL ══ */
.error-content {
  position: relative; z-index: 5;
  width: 100%; max-width: var(--max-w);
  display: flex; flex-direction: column; align-items: center;
  text-align: center;
}

/* ── NUMÉRO D'ERREUR ── */
.error-number {
  font-family: var(--f-display);
  font-size: clamp(8rem, 20vw, 16rem);
  letter-spacing: 0.06em; line-height: 0.85;
  background: var(--gold-gradient);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  filter: drop-shadow(0 0 60px rgba(196,160,82,.22));
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .2s both;
  position: relative;
}
.error-number::after {
  content: attr(data-code); position: absolute; inset: 0;
  font-family: var(--f-display); font-size: inherit; letter-spacing: inherit; line-height: inherit;
  background: linear-gradient(135deg, rgba(194,48,24,.35), rgba(194,48,24,.05));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  transform: translate(3px, 4px); z-index: -1;
}
@keyframes glitch1 {
  0%,95%,100% { clip-path: inset(0 0 100% 0); transform: translate(0); }
  96% { clip-path: inset(20% 0 60% 0); transform: translate(-4px, 1px); }
  97% { clip-path: inset(50% 0 30% 0); transform: translate(4px, -1px); }
  98% { clip-path: inset(70% 0 10% 0); transform: translate(-2px, 2px); }
  99% { clip-path: inset(0 0 100% 0); transform: translate(0); }
}
.glitch-layer {
  position: absolute; inset: 0;
  font-family: var(--f-display); font-size: inherit; letter-spacing: inherit; line-height: inherit;
  background: linear-gradient(135deg, rgba(194,48,24,.7), rgba(194,48,24,.3));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  animation: glitch1 6s ease-in-out infinite 2s;
}

/* SÉPARATEUR */
.gold-rule {
  width: 200px; height: 1px; margin: 12px auto 24px;
  background: linear-gradient(90deg, transparent, rgba(196,160,82,.5), transparent);
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .32s both;
}

/* EYEBROW */
.error-eyebrow {
  font-family: var(--f-title); font-size: .62rem; font-weight: 600;
  letter-spacing: .22em; text-transform: uppercase; color: rgba(196,160,82,.6);
  margin-bottom: 12px;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .28s both;
  display: flex; align-items: center; gap: 10px;
}
.eyebrow-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--rouge-cta); flex-shrink: 0; }

/* TITRE */
.error-title {
  font-family: var(--f-display); font-size: clamp(1.8rem, 4vw, 2.8rem);
  letter-spacing: .1em; color: #fff; margin-bottom: 10px;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .38s both;
}
.error-title em { color: var(--or-titre); font-style: normal; }

/* SOUS-TITRE */
.error-sub {
  font-family: var(--f-editorial); font-style: italic; font-weight: 400;
  font-size: clamp(.95rem, 1.8vw, 1.1rem); color: rgba(232,232,232,.45);
  max-width: 500px; line-height: 1.65; margin-bottom: 38px;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .46s both;
}

/* CTA */
.cta-group {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center;
  animation: fadeUp .6s cubic-bezier(.22,1,.36,1) .56s both;
}
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 0 28px; height: 44px; border-radius: 8px;
  background: var(--gold-gradient); border: none; cursor: pointer;
  font-family: var(--f-title); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  color: var(--bleu-nuit); text-decoration: none;
  box-shadow: 0 4px 20px rgba(196,160,82,.28);
  transition: filter .25s, transform .2s, box-shadow .25s;
}
.btn-primary:hover { filter: brightness(1.12); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(196,160,82,.38); }
.btn-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 0 24px; height: 44px; border-radius: 8px;
  background: transparent; border: 1px solid rgba(196,160,82,.35); cursor: pointer;
  font-family: var(--f-title); font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
  color: var(--or-titre); text-decoration: none;
  transition: background .25s, border-color .25s, transform .2s;
}
.btn-secondary:hover { background: rgba(196,160,82,.08); border-color: rgba(196,160,82,.6); transform: translateY(-2px); }
.btn-icon { width: 16px; height: 16px; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>
</head>
<body>

<canvas id="particleCanvas"></canvas>
<div class="bg-glow"></div>
<div class="scanlines"></div>
<div class="vignette"></div>
<div class="reel reel--a"></div>
<div class="reel reel--b"></div>

<!-- NAV -->
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img class="nav-logo__img" src="/images/Logo/logo-cine-delices-2026-1.png" alt="Ciné Délices">
    </a>
    <div class="nav-right">
      <a href="/" class="nav-btn-home">← Accueil</a>
    </div>
  </div>
</nav>

<!-- CONTENU ERREUR -->
<main class="page-error">
  <div class="error-content">

    <div class="error-number" data-code="<%= _errCode %>" aria-label="Erreur <%= _errCode %>">
      <%= _errCode %>
      <span class="glitch-layer" aria-hidden="true"><%= _errCode %></span>
    </div>

    <div class="gold-rule"></div>

    <p class="error-eyebrow">
      <span class="eyebrow-dot"></span>
      <%- _eyebrow %>
      <span class="eyebrow-dot"></span>
    </p>

    <h1 class="error-title"><%- _title %></h1>

    <p class="error-sub"><%- _sub %></p>

    <div class="cta-group">
      <% if (_is401) { %>
        <a href="/auth/forgot-password" class="btn-primary">
          <svg class="btn-icon" viewBox="0 0 16 16" fill="none">
            <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
            <path d="M5 7V5a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          Mot de passe oublié ?
        </a>
        <a href="/" class="btn-secondary">
          <svg class="btn-icon" viewBox="0 0 16 16" fill="none">
            <path d="M8 1L1 8l7 7M1 8h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Retour à l'accueil
        </a>
      <% } else { %>
        <a href="/" class="btn-primary">
          <svg class="btn-icon" viewBox="0 0 16 16" fill="none">
            <path d="M8 1L1 8l7 7M1 8h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Retour à l'accueil
        </a>
        <a href="/films" class="btn-secondary">
          <svg class="btn-icon" viewBox="0 0 16 16" fill="none">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/>
            <path d="M11 11l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          Rechercher un film
        </a>
      <% } %>

  </div>
</main>

<script>
const canvas = document.getElementById('particleCanvas');
const ctx = canvas.getContext('2d');
let W, H, particles = [];

function resize() {
  W = canvas.width  = window.innerWidth;
  H = canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

const GOLD_COLORS = ['rgba(196,160,82,','rgba(212,168,67,','rgba(242,200,75,','rgba(255,224,133,','rgba(184,136,42,'];

function mkParticle() {
  return {
    x: Math.random() * W, y: H + Math.random() * 60,
    vx: (Math.random() - .5) * .6, vy: -(0.4 + Math.random() * 1.1),
    r: .8 + Math.random() * 2.2, alpha: 0, life: 0,
    maxLife: 120 + Math.random() * 200,
    color: GOLD_COLORS[Math.floor(Math.random() * GOLD_COLORS.length)],
    twinkle: Math.random() * Math.PI * 2,
    twinkleSpeed: .03 + Math.random() * .05,
  };
}

for (let i = 0; i < 55; i++) {
  const p = mkParticle(); p.y = Math.random() * H; p.life = Math.random() * p.maxLife;
  particles.push(p);
}

function tick() {
  ctx.clearRect(0, 0, W, H);
  if (particles.length < 70 && Math.random() < .4) particles.push(mkParticle());
  particles.forEach((p, i) => {
    p.life++; p.x += p.vx; p.y += p.vy; p.twinkle += p.twinkleSpeed;
    const ratio = p.life / p.maxLife;
    if (ratio < .15) p.alpha = ratio / .15;
    else if (ratio > .75) p.alpha = 1 - (ratio - .75) / .25;
    else p.alpha = 1;
    const a = p.alpha * (.65 + .35 * Math.sin(p.twinkle)) * .75;
    const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
    g.addColorStop(0, p.color + (a * .55).toFixed(3) + ')');
    g.addColorStop(1, p.color + '0)');
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = p.color + a.toFixed(3) + ')';
    ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
    if (p.life >= p.maxLife) particles[i] = mkParticle();
  });
  requestAnimationFrame(tick);
}
tick();
</script>
</body>
</html>
