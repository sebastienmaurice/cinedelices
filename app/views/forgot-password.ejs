<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ciné Délices — Réinitialisez votre mot de passe ou récupérez votre identifiant." />
    <title>Mot de passe oublié · Ciné Délices</title>

    <%- include("partials/head-resources") %>

    <style>
      /* Page auth : masquer prefooter + footer pour ne garder que la tâche */
      body.forgot-password-page .ft__pre,
      body.forgot-password-page .ft { display: none !important; }

      .auth-recovery {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px 60px;
        position: relative;
      }
      .auth-card {
        width: 100%;
        max-width: 460px;
        background: rgba(15, 30, 48, 0.85);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(196, 160, 82, 0.18);
        border-radius: 16px;
        padding: 40px 36px;
        color: var(--argent, #e8e8e8);
        box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
      }
      .auth-card__eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--or-titre, #c4a052);
        margin: 0 0 10px;
      }
      .auth-card__title {
        font-family: var(--ft-f-title, Georgia, serif);
        font-size: 1.65rem;
        margin: 0 0 10px;
        color: #f2e5c2;
      }
      .auth-card__title em {
        color: var(--or-titre, #c4a052);
        font-style: italic;
      }
      .auth-card__desc {
        font-size: 0.92rem;
        line-height: 1.55;
        color: rgba(232, 232, 232, 0.75);
        margin: 0 0 24px;
      }
      .auth-card__form { display: flex; flex-direction: column; gap: 14px; }
      .auth-card__input {
        width: 100%;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(196, 160, 82, 0.25);
        border-radius: 8px;
        color: #fff;
        font-size: 0.95rem;
      }
      .auth-card__input:focus {
        outline: none;
        border-color: var(--or-titre, #c4a052);
        background: rgba(255, 255, 255, 0.08);
      }
      .auth-card__btn {
        width: 100%;
        padding: 12px 16px;
        background: var(--rouge-cta, #c23018);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .auth-card__btn:hover { background: #a02614; }
      .auth-card__alert {
        padding: 12px 14px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .auth-card__alert--error {
        background: rgba(194, 48, 24, 0.14);
        border: 1px solid rgba(194, 48, 24, 0.4);
        color: #ffb8a8;
      }
      .auth-card__alert--success {
        background: rgba(76, 175, 80, 0.12);
        border: 1px solid rgba(76, 175, 80, 0.35);
        color: #b8e6ba;
      }
      .auth-card__links {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 22px;
        font-size: 0.82rem;
      }
      .auth-card__links a {
        color: var(--or-titre, #c4a052);
        text-decoration: none;
      }
      .auth-card__links a:hover { text-decoration: underline; }
    </style>
  </head>

  <body class="forgot-password-page">
    <%- include("partials/header") %>

    <main class="auth-recovery">
      <section class="auth-card" role="region" aria-labelledby="fp-title">
        <p class="auth-card__eyebrow">Récupération de compte</p>
        <h1 class="auth-card__title" id="fp-title">Mot de passe ou <em>identifiant oublié</em> ?</h1>

        <% if (sent) { %>
          <div class="auth-card__alert auth-card__alert--success" role="status">
            Si un compte existe avec cet email ou cet identifiant, un lien de réinitialisation vient de vous être envoyé.
            Pensez à vérifier vos spams.
          </div>
          <p class="auth-card__desc" style="margin-bottom:0;">
            Le lien est valable <strong>30 minutes</strong> et ne peut être utilisé qu'une seule fois.
          </p>
        <% } else { %>
          <p class="auth-card__desc">
            Renseignez l'adresse email <strong>ou</strong> l'identifiant associé à votre compte.
            Nous vous enverrons un lien sécurisé pour choisir un nouveau mot de passe.
          </p>

          <% if (error) { %>
            <div class="auth-card__alert auth-card__alert--error" role="alert"><%= error %></div>
          <% } %>

          <form class="auth-card__form" method="POST" action="/auth/forgot-password" novalidate>
            <label for="fp-identifier" class="sr-only">Email ou identifiant</label>
            <input
              id="fp-identifier"
              class="auth-card__input"
              type="text"
              name="identifier"
              placeholder="Adresse email ou identifiant"
              autocomplete="username"
              required
            />
            <button type="submit" class="auth-card__btn">Envoyer le lien</button>
          </form>
        <% } %>

        <div class="auth-card__links">
          <a href="#" class="js-open-login">← Retour à la connexion</a>
          <a href="/">Accueil</a>
        </div>
      </section>
    </main>

  </body>
</html>
